async def handle_voice(update, context):
    ud = get_user_data(update.effective_user.id)
    mode = ud.get("teacher_mode")
    if not mode:
        await update.message.reply_text(
            "ℹ️ បើអ្នកចង់និយាយសំឡេងជាមួយ AI Teacher សូមប្រើ /teacher ជ្រើសរើសគ្រូជាមុនសិន។")
        return

    listening_msg = await update.message.reply_text("🎤 កំពុងស្តាប់សំឡេង...")
    voice = update.message.voice or update.message.audio
    try:
        file = await context.bot.get_file(voice.file_id)
        audio_bytes = await _download_file_bytes(file)
    except Exception as e:
        logger.warning(f"Teacher Voice [{mode}]: download failed — {e}")
        await listening_msg.edit_text("❌ មិនអាចទាញយកសំឡេងនេះបានទេ។ សូមសាកល្បងផ្ញើម្តងទៀត។")
        return
    text, error = await transcribe_audio(audio_bytes, filename="voice.ogg")

    if not text:
        logger.warning(f"Teacher Voice [{mode}]: transcription failed — {error} (Admin: check GROQ_API_KEY)")
        await listening_msg.edit_text("❌ មិនអាចស្តាប់សំឡេងបានទេ។ សូមសាកល្បងផ្ញើម្តងទៀត ឬសរសេរជាអត្ថបទជំនួសវិញ។")
        return

    await listening_msg.edit_text(f"📝 អ្វីដែលខ្ញុំបានស្តាប់៖\n\"{text}\"")

    await teacher_handle_text(update, context, ud, text)




