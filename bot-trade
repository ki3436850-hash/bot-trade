def to_pair_symbol(symbol):
    """បម្លែង 'EURUSD' -> 'EUR/USD' (Twelve Data ត្រូវការទ្រង់ទ្រាយនេះ)។"""
    s = symbol.upper()
    if len(s) == 6 and s.isalpha():
        return f"{s[:3]}/{s[3:]}"
    return s

async def fetch_coingecko_data(coin_id, days="1"):
    url = f"{COINGECKO_API_URL}/coins/{coin_id}/market_chart?vs_currency=usd&days={days}&interval=hourly"
    try:
        res = await async_get(url, timeout=10)
        data = res.json()
        if "prices" in data:
            prices = data["prices"]
            df = pd.DataFrame(prices, columns=["timestamp", "close"])
            df["datetime"] = pd.to_datetime(df["timestamp"], unit="ms")
            df["open"] = df["close"]
            df["high"] = df["close"]
            df["low"] = df["close"]
            return df[["datetime", "open", "high", "low", "close"]]
        logger.warning(f"CoinGecko no prices for {coin_id}: {data}")
    except Exception as e:
        logger.warning(f"CoinGecko error for {coin_id}: {e}")
    return None

async def fetch_twelve_data(symbol, interval="1h", outputsize="500"):
    pair = to_pair_symbol(symbol)
    url = (
        f"https://api.twelvedata.com/time_series?symbol={pair}&interval={interval}"
        f"&outputsize={outputsize}&apikey={TWELVE_DATA_API_KEY}"
    )
    try:
        res = await async_get(url, timeout=10)
        data = res.json()
        if "values" in data:
            df = pd.DataFrame(data["values"]).iloc[::-1].reset_index(drop=True)
            df["datetime"] = pd.to_datetime(df["datetime"])
            for col in ["open", "high", "low", "close"]:
                df[col] = df[col].astype(float)
            return df
        logger.warning(f"Twelve Data no values for {pair}: {data.get('message') or data}")
    except Exception as e:
        logger.warning(f"Twelve Data error for {pair}: {e}")
    return None

async def fetch_alpha_vantage_data(symbol, timeframe="H1"):
    av_interval = ALPHA_VANTAGE_INTERVAL_MAP.get(timeframe)
    if not av_interval:
        return None  # Alpha Vantage intraday only supports up to 60min here
    s = symbol.upper()
    if len(s) == 6 and s.isalpha():
        from_symbol, to_symbol = s[:3], s[3:]
        url = (
            "https://www.alphavantage.co/query?function=FX_INTRADAY"
            f"&from_symbol={from_symbol}&to_symbol={to_symbol}"
            f"&interval={av_interval}&outputsize=full&apikey={ALPHA_VANTAGE_API_KEY}"
        )
    else:
        url = (
            "https://www.alphavantage.co/query?function=TIME_SERIES_INTRADAY"
            f"&symbol={s}&interval={av_interval}&outputsize=full&apikey={ALPHA_VANTAGE_API_KEY}"
        )
    try:
        res = await async_get(url, timeout=10)
        data = res.json()
        series_key = next((k for k in data if "Time Series" in k), None)
        if not series_key:
            logger.warning(f"Alpha Vantage no data for {symbol}: {data.get('Note') or data.get('Information') or data}")
            return None
        rows = []
        for ts, vals in data[series_key].items():
            rows.append({
                "datetime": ts,
                "open": float(vals["1. open"]),
                "high": float(vals["2. high"]),
                "low": float(vals["3. low"]),
                "close": float(vals["4. close"]),
            })
        df = pd.DataFrame(rows)
        df["datetime"] = pd.to_datetime(df["datetime"])
        df = df.sort_values("datetime").reset_index(drop=True)
        return df
    except Exception as e:
        logger.warning(f"Alpha Vantage error for {symbol}: {e}")
        return None

async def fetch_finnhub_data(symbol, timeframe="H1", count=500):
    resolution = FINNHUB_RESOLUTION_MAP.get(timeframe, "60")
    s = symbol.upper()
    try:
        if s in CRYPTO_MAP:
            # s[:-3] strips the trailing "USD" (works for both 3-letter
            # tickers like BTC and 4-letter ones like DOGE), unlike a fixed
            # s[:3] which mis-split anything longer than "XXXUSD".
            fh_symbol = f"BINANCE:{s[:-3]}USDT"
            endpoint = "crypto/candle"
        elif len(s) == 6 and s.isalpha():
            fh_symbol = f"OANDA:{s[:3]}_{s[3:]}"
            endpoint = "forex/candle"
        else:
            return None
        seconds_per_bar = {"1": 60, "5": 300, "15": 900, "30": 1800, "60": 3600,
                            "D": 86400, "W": 604800}.get(resolution, 3600)
        now_ts = int(datetime.utcnow().timestamp())
        start_ts = now_ts - seconds_per_bar * count
        url = (
            f"https://finnhub.io/api/v1/{endpoint}?symbol={fh_symbol}"
            f"&resolution={resolution}&from={start_ts}&to={now_ts}&token={FINNHUB_API_KEY}"
        )
        res = await async_get(url, timeout=10)
        data = res.json()
        if data.get("s") != "ok":
            logger.warning(f"Finnhub no data for {symbol}: {data}")
            return None
        df = pd.DataFrame({
            "datetime": pd.to_datetime(data["t"], unit="s"),
            "open": data["o"], "high": data["h"], "low": data["l"], "close": data["c"],
        })
        return df
    except Exception as e:
        logger.warning(f"Finnhub error for {symbol}: {e}")
        return None

async def fetch_market_data(symbol, interval="1h", outputsize="500", timeframe="H1"):
    s = symbol.upper()
    providers_tried = []
    if s in CRYPTO_MAP:
        # សម្រាប់ Crypto៖ CoinGecko -> Twelve Data -> Finnhub
        coin_id = CRYPTO_MAP[s]
        df = await fetch_coingecko_data(coin_id)
        providers_tried.append("CoinGecko")
        if df is not None and len(df) >= 30:
            return df, providers_tried
        df = await fetch_twelve_data(symbol, interval, outputsize)
        providers_tried.append("Twelve Data")
        if df is not None and len(df) >= 30:
            return df, providers_tried
        df = await fetch_finnhub_data(symbol, timeframe)
        providers_tried.append("Finnhub")
        return df, providers_tried
    else:
        # សម្រាប់ Forex/Metals/Stocks៖ Twelve Data -> Alpha Vantage -> Finnhub
        df = await fetch_twelve_data(symbol, interval, outputsize)
        providers_tried.append("Twelve Data")
        if df is not None and len(df) >= 30:
            return df, providers_tried
        df = await fetch_alpha_vantage_data(symbol, timeframe)
        providers_tried.append("Alpha Vantage")
        if df is not None and len(df) >= 30:
            return df, providers_tried
        df = await fetch_finnhub_data(symbol, timeframe)
        providers_tried.append("Finnhub")
        return df, providers_tried

