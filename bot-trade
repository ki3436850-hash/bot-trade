def compute_news_signal(articles):
    """ធ្វើការវិភាគអារម្មណ៍ (sentiment) សាមញ្ញពីចំណងជើងព័ត៌មាន ដើម្បីផ្តល់ Signal ទូទៅ។"""
    blob = " ".join(
        f"{a.get('title', '')} {a.get('description') or ''}" for a in articles
    ).lower()
    bull = sum(blob.count(k) for k in NEWS_BULLISH_KEYWORDS)
    bear = sum(blob.count(k) for k in NEWS_BEARISH_KEYWORDS)
    if bull > bear:
        return "BUY (មានទំនោរវិជ្ជមាន)", "🟢📈", bull, bear
    elif bear > bull:
        return "SELL (មានទំនោរអវិជ្ជមាន)", "🔴📉", bull, bear
    else:
        return "HOLD (មិនទាន់ច្បាស់លាស់)", "🟡➖", bull, bear

async def perform_news_analysis(query, symbol=None):
    label = (FOREX_SYMBOLS.get(symbol) or CRYPTO_SYMBOLS.get(symbol) or symbol) if symbol else None
    search_terms = NEWS_QUERY_MAP.get(symbol, "forex OR gold OR crypto")
    try:
        res = await async_get(
            "https://newsapi.org/v2/everything",
            params={
                "q": search_terms,
                "language": "en",
                "sortBy": "publishedAt",
                "pageSize": 5,
                "apiKey": NEWSAPI_KEY,
            },
            timeout=10,
        )
        data = res.json()
        articles = data.get("articles", [])
        if not articles:
            logger.warning(f"NewsAPI no articles: {data.get('message') or data}")
    except Exception as e:
        logger.warning(f"NewsAPI error: {e}")
        articles = []

    fred_trend = await fetch_fred_trend("DFF")

    if not articles and not fred_trend:
        await query.message.reply_text(
            "❌ មិនអាចទាញយកព័ត៌មានទីផ្សារបានទេពេលនេះ។ សូមព្យាយាមម្តងទៀត។"
        )
        return

    header = f"📰✨ *ព័ត៌មានទីផ្សារ — {label}*\n" if label else "📰✨ *ព័ត៌មានទីផ្សារចុងក្រោយ*\n"
    lines = [header]
    if not articles:
        lines.append("_(មិនមានអត្ថបទព័ត៌មានថ្មីសម្រាប់ Symbol នេះទេ ពេលនេះ)_")
    for a in articles[:5]:
        title = a.get("title", "")
        source = (a.get("source") or {}).get("name", "")
        lines.append(f"🔸 {title} _({source})_")

    if fred_trend:
        if fred_trend.get("trend"):
            lines.append(
                f"\n🏦 *Fed Funds Rate (FRED):* {fred_trend['trend']} "
                f"(និន្នាការក្នុងរយៈពេល ~{fred_trend['window_label']} ចុងក្រោយ)\n"
                f"   📌 តម្លៃចុងក្រោយ៖ {fred_trend['latest_value']}% 🗓️ ({fred_trend['latest_date']})"
            )
        else:
            lines.append(
                f"\n🏦 *Fed Funds Rate (FRED):* {fred_trend['latest_value']}% "
                f"🗓️ (គិតត្រឹមថ្ងៃ {fred_trend['latest_date']})"
            )

    signal_dir, signal_emoji, bull, bear = compute_news_signal(articles)
    signal_title = f"Market Signal សម្រាប់ {label}" if label else "Market Signal"
    lines.append(f"\n🚦 *{signal_title}:* {signal_emoji} *{signal_dir}*")
    lines.append(f"   🌱 និន្នាការវិជ្ជមាន៖ {bull}  |  🍂 និន្នាការអវិជ្ជមាន៖ {bear}")

    lines.append("\n⚠️ *ការព្រមាន៖* នេះជាព័ត៌មានទូទៅ មិនមែនជាការណែនាំហិរញ្ញវត្ថុទេ។")
    await query.message.reply_text("\n".join(lines), parse_mode="Markdown")

