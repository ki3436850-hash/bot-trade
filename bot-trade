        if await customer_handle_text(update, context, ud, text):
            return
    if ud.get("dj_state"):
        if await dj_handle_text(update, context, ud, text):
            return
    if ud.get("schedule_state") == "awaiting_content" and (ud.get("schedule_temp") or {}).get("content_type") in ("text", "reminder"):
        await schedule_handle_text_content(update, context, ud, text)
        return
    if ud.get("schedule_state") == "awaiting_datetime":
        await schedule_handle_datetime_text(update, context, ud, text)
        return
    if ud.get("post_state") == "awaiting_video":
        await post_handle_video_fileid_text(update, context, ud, text)
        return
    if ud.get("post_state") == "awaiting_caption":
        await post_handle_caption_text(update, context, ud, text)
        return
    if ud.get("post_state") == "awaiting_schedule":
        await post_handle_schedule_text(update, context, ud, text)
        return
    if str(ud.get("store_state") or "").startswith("mk_"):
        if await market_handle_text(update, context, ud, text):
            return
    if ud.get("store_state") in ("awaiting_name", "awaiting_price", "awaiting_discount",
                                  "awaiting_stock", "awaiting_details", "awaiting_link", "awaiting_link_lookup",
                                  "awaiting_job_company", "awaiting_job_location", "awaiting_job_salary",
                                  "awaiting_job_positions", "awaiting_job_requirements", "awaiting_job_benefits"):
        if await store_handle_text(update, context, ud, text):
            return
    if ud.get("cat_admin_state"):
        if await category_admin_handle_text(update, context, ud, text):
            return
    if ud.get("pending_candlestick_symbol"):
        ud["candlestick_symbol"] = text.upper()[:20]
        ud["pending_candlestick_symbol"] = False
        ud["pending_candlestick"] = True
        save_data()
        await update.message.reply_text(
            f"✅ យល់ព្រម — Symbol *{ud['candlestick_symbol']}*។\n"
            "ឥឡូវសូមផ្ញើរូបភាព Candlestick chart របស់អ្នក។",
            parse_mode="Markdown")
        return
    if ud.get("ea_state"):
        if await ea_handle_text(update, context, ud, text):
            return
    if ud.get("pending_bank_action"):
        try:
            amount = int(text)
            if amount <= 0:
                await update.message.reply_text("ចំនួនត្រូវតែធំជាង 0។")
                return
            if ud["pending_bank_action"] == "deposit":
                if amount > ud["money"]:
                    await update.message.reply_text("❌ អ្នកមិនមានប្រាក់គ្រប់គ្រាន់ក្នុងដៃ។")
                else:
                    ud["money"] -= amount
                    ud["bank_balance"] += amount
                    await update.message.reply_text(f"✅ បានដាក់ប្រាក់ {amount} ចូលធនាគារ។ សមតុល្យធនាគារ៖ {ud['bank_balance']}")
            elif ud["pending_bank_action"] == "withdraw":
                if amount > ud["bank_balance"]:
                    await update.message.reply_text("❌ សមតុល្យធនាគារមិនគ្រប់។")
                else:
                    ud["bank_balance"] -= amount
                    ud["money"] += amount
                    await update.message.reply_text(f"✅ បានដកប្រាក់ {amount} ពីធនាគារ។ ប្រាក់ដៃ៖ {ud['money']}")
            ud["pending_bank_action"] = None
            save_data()
            return
        except ValueError:
            await update.message.reply_text("❌ សូមបញ្ចូលលេខត្រឹមត្រូវ។")
            return
    if await teacher_handle_text(update, context, ud, text):
        return
    await update.message.reply_text("សូមប្រើ Command ដូចជា /today, /bank, /library, /invite, /battle ឬ /help។")

