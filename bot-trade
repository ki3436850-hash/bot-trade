async def _download_file_bytes(file):
    """Download File content ត្រឹមត្រូវ ទោះបីជា file.file_path ជា Absolute Local Path
    (ករណី Local Bot API Server Run ជាមួយ --local) ឬ Relative Path ធម្មតា (Cloud API)
    ក៏ដោយ។ ករណី Absolute Path យើងស្រង់យក Path ក្រោយ Bot Token Folder ចេញ ហើយផ្សំជា
    HTTP URL ដោយផ្ទាល់ (មិនប្រើ file.download_as_bytearray() ព្រោះ Library ច្រឡំ
    Absolute Path ថាជា URL Segment)។"""
    file_path = file.file_path or ""
    logger.info(f"🔎 _download_file_bytes: file_path={file_path!r}")
    marker = f"{BOT_TOKEN}/"
    occurrences = file_path.count(marker)
    # python-telegram-bot ជានិច្ចនឹង Pre-build file.file_path ទៅជា URL ពេញ (base_file_url +
    # token + Path ដើម)។ ករណីធម្មតា (Cloud API ឬ Local Server ដែលមិនប្រើ --local) Token
    # លេចឡើងតែម្តង ហើយ URL នោះអាច Download បានដោយផ្ទាល់ស្រាប់ៗ។ ករណី --local Mode វិញ
    # Path ដើមដែល Server ត្រឡប់មកគឺ Absolute Local Path ("/var/lib/...") ដែលខ្លួនវាផ្ទាល់ក៏
    # មាន Token ដែរ (ជា Folder Name) ធ្វើឲ្យ Token លេចឡើង 2 ដង ក្នុង file_path ចុងក្រោយ —
    # ករណីនេះទើបត្រូវផ្សំ URL ដោយផ្ទាល់ខ្លួនឯងឡើងវិញ។
    if occurrences >= 2:
        idx = file_path.rfind(marker)
        relative_path = file_path[idx + len(marker):]
        # Local Bot API Server មិនអនុញ្ញាតឲ្យ Download File តាម HTTP Endpoint របស់វា
        # ផ្ទាល់ទេ ពេល Run ជាមួយ --local (បញ្ជាក់ដោយ Telegram ខ្លួនឯង) ដូច្នេះយើងប្រើ File
        # Server ធម្មតា (python http.server) ដាច់ដោយឡែកដែល Serve Folder
        # /var/lib/telegram-bot-api ជា Plain HTTP ជំនួសវិញ — កំណត់ Base URL របស់វាតាម
        # Environment Variable LOCAL_FILE_HTTP_BASE (ឧ. https://<service>.up.railway.app)។
        local_file_http_base = (os.environ.get("LOCAL_FILE_HTTP_BASE") or "").rstrip("/")
        if not local_file_http_base:
            raise RuntimeError("LOCAL_FILE_HTTP_BASE មិនទាន់កំណត់ — ត្រូវការសម្រាប់ Download File ក្នុង Local Mode")
        url = f"{local_file_http_base}/{BOT_TOKEN}/{relative_path}"
        logger.info(f"🔎 _download_file_bytes: local-mode URL constructed url={url!r}")
    elif file_path.startswith("http://") or file_path.startswith("https://"):
        url = file_path
        logger.info(f"🔎 _download_file_bytes: using PTB-provided URL directly url={url!r}")
    else:
        logger.info("🔎 _download_file_bytes: no usable URL, using normal download_as_bytearray()")
        return bytes(await file.download_as_bytearray())
    resp = await asyncio.to_thread(requests.get, url, timeout=120)
    resp.raise_for_status()
    return resp.content


async def post_download_and_save_video(update, context, ud, file_id, file_size=None):
    """ចែករំលែក Logic ទាញយក + រក្សាទុក Video — ប្រើបានទាំងពី Video Message ដោយផ្ទាល់
    និងពី File ID ដែល Admin/User បិទភ្ជាប់ជា Text។ file_size អាចជា None បើមិនស្គាល់
    ជាមុន (ករណី File ID Text — Telegram មិនប្រាប់ទំហំរហូតដល់ get_file ត្រូវបានហៅ)។"""
    max_bytes = POST_MAX_VIDEO_MB * 1024 * 1024
    if file_size and file_size > max_bytes:
        await update.message.reply_text(
            f"❌ Video ធំពេក ({file_size // (1024*1024)}MB)។ "
            f"Telegram Bot កំណត់ Download បានត្រឹមតែ {POST_MAX_VIDEO_MB}MB។\n"
            "សូម Compress Video ឲ្យតូចជាងនេះ រួចផ្ញើម្តងទៀត។"
        )
        return False
    msg = await update.message.reply_text("⬇️ កំពុងទាញយក Video...")
    try:
        file = await context.bot.get_file(file_id)
        if file.file_size and file.file_size > max_bytes:
            await msg.edit_text(
                f"❌ Video ធំពេក ({file.file_size // (1024*1024)}MB)។ "
                f"Bot កំណត់ Download បានត្រឹមតែ {POST_MAX_VIDEO_MB}MB (Environment Variable "
                "POST_MAX_VIDEO_MB) — បើអ្នកបាន Setup Local Bot API Server រួច សូមតាំង "
                "POST_MAX_VIDEO_MB ខ្ពស់ជាងនេះ។"
            )
            return False
        video_bytes = await _download_file_bytes(file)
    except Exception as e:
        logger.warning(f"post video download failed: {e}")
        await msg.edit_text(f"❌ មិនអាចទាញយក Video បានទេ: {e}\nសូមព្យាយាមម្តងទៀត (ត្រូវប្រាកដថា File ID ត្រឹមត្រូវ)។")
        return False
    try:
        os.makedirs(POST_VIDEO_DIR, exist_ok=True)
        path = os.path.join(POST_VIDEO_DIR, f"{update.effective_user.id}_{int(time.time())}.mp4")
        with open(path, "wb") as f:
            f.write(video_bytes)
    except Exception as e:
