async def ea_show_card(q, text, kb):
    """Edit the message the button lives on (so Refresh never spams new messages).
    Falls back to a plain-text send if Markdown parsing fails; 'not modified' is ignored."""
    try:
        await q.edit_message_text(text, parse_mode="Markdown", reply_markup=kb)
        return
    except Exception as e:
        if "not modified" in str(e).lower():
            return
        logger.warning(f"card markdown edit failed ({e}); retrying as plain text")
    plain = text.replace("*", "").replace("`", "")
    try:
        await q.edit_message_text(plain, reply_markup=kb)
    except Exception as e:
        if "not modified" not in str(e).lower():
            await q.message.reply_text(plain, reply_markup=kb)

async def ea_render_trade_signal_section(symbol, tf_label, primary_tf, result, plan, ud, snap):
    """Shared tail step for Signals/Analysis: fetch (cached) the primary
    timeframe's OHLC, build its technical readout, run the real Risk Engine
    check, and assemble the full block. Reuses ea_get_ohlc_cached (spec:
    don't re-download the same candles the confluence engine just fetched)."""
    df, _ = await ea_get_ohlc_cached(symbol, primary_tf)
    tech = ea_technical_readout(symbol, df, primary_tf) if df is not None and len(df) >= 30 else None
    if result["direction"] in ("BUY", "SELL"):
        risk_ok, risk_reasons = ea_risk_check(ud, snap, result)
    else:
        risk_ok, risk_reasons = None, []  # nothing to gate — WAIT/NO TRADE never reaches execution
    return ea_format_trade_signal_block(symbol, tf_label, result, plan, risk_ok, risk_reasons, tech)

# ------------------------------------------------------------
# Signal / Trade Journal + Performance Analytics (spec §25/§26/§30) — every
# generated signal is journaled with its full confluence breakdown; every
# signal that's actually sent to the EA gets a linked trade-journal entry
# that's filled in as TRADE_OPENED/TRADE_CLOSED events arrive from the EA.
# Analytics are computed ONLY from these real records — never fabricated.
# ------------------------------------------------------------
EA_JOURNAL_MAX = 500

def ea_record_signal(ud, symbol, preset_key, result, plan=None, timeframe=None):
    """Journal every generated signal (regardless of whether it's executed) so
    §25's 'Total Signals' and signal-accuracy stats are measurable later.

    When `plan` (an ea_build_execution_plan() result) is supplied for a BUY/
    SELL signal, the entry also carries everything Strategy Performance (spec
    §5/§6) needs to evaluate the signal against real historical candles later
    — reference/entry price, SL, TP, R:R target and the timeframe those
    levels were computed on — with status PENDING until
    ea_evaluate_signal_outcome() resolves it. WAIT/NO TRADE signals, or a
    BUY/SELL signal recorded without a plan (e.g. SL/TP couldn't be computed),
    get status "N/A" — there's nothing to evaluate, so they're never fabricated
    a PENDING state."""
    tradeable = result["direction"] in ("BUY", "SELL") and plan is not None
    if tradeable and not timeframe:
        # Falls back to the preset's fastest timeframe — the same one
        # ea_build_execution_plan() itself used to compute this plan's SL/TP.
        timeframe = EA_MTF_PRESETS[preset_key]["timeframes"][0]
    entry = {
        "id": str(uuid.uuid4())[:8], "at": time.time(), "symbol": symbol, "preset": preset_key,
        "direction": result["direction"], "confidence": result["confidence"],
        "components": result.get("components"), "news_level": (result.get("news") or {}).get("level"),
        "bulls": result.get("bulls"), "bears": result.get("bears"),
        # --- Strategy Performance fields (spec §5) ---
        "timeframe": timeframe if tradeable else None,
        "reference_price": plan.get("reference_price") if plan else None,
        "sl": plan.get("sl") if plan else None,
        "tp": plan.get("tp") if plan else None,
        "rr_target": plan.get("rr") if plan else None,
        "status": "PENDING" if tradeable else "N/A",
        "outcome": None,
        "exit_price": None,
        "r_multiple": None,
        "evaluated_at": None,
    }
    journal = ud.setdefault("ea_signal_journal", [])
    # Signal deduplication: signals are decided on CLOSED candles, so a refresh within
    # the same candle gives the same call. Reuse the existing entry instead of
    # journaling (and later scoring) the identical signal again.
    ref_bar = None
    try:
        prim = next((r for r in (result.get("per_tf") or []) if r.get("timeframe") == (timeframe or EA_MTF_PRESETS[preset_key]["timeframes"][0])), None)
        ref_bar = ((prim or {}).get("bar_meta") or {}).get("ref_bar_raw")
    except Exception:
        ref_bar = None
    if ref_bar:
        entry["ref_bar"] = ref_bar
        for old in journal[:20]:
            if (old.get("ref_bar") == ref_bar and old.get("symbol") == symbol and old.get("preset") == preset_key
                    and old.get("direction") == result["direction"]
                    and (old.get("status") == "N/A") == (not tradeable)):
                try:
                    ea_record_prediction(ud, symbol, preset_key, result, timeframe)  # no-op if already stored
                except Exception:
                    pass
                return old["id"]
    journal.insert(0, entry)
    del journal[EA_JOURNAL_MAX:]
    try:  # prediction tracking must never break the signal flow
        ea_record_prediction(ud, symbol, preset_key, result, timeframe)
    except Exception as e:
        logger.warning(f"prediction record failed: {e}")
    return entry["id"]

# ------------------------------------------------------------
# Prediction tracking (prediction_tracker.py): every BUY/SELL call - and every
# call the Direction Validator vetoed - is stored with its reference candle and
# later scored against the next CLOSED candle. See that module's header for
# the exact outcome rule.
# ------------------------------------------------------------
def ea_record_prediction(ud, symbol, preset_key, result, timeframe=None):
    tf = timeframe or EA_MTF_PRESETS[preset_key]["timeframes"][0]
    pred = PT.build_prediction(result, symbol, tf, preset=preset_key)
    preds = ud.setdefault("ea_predictions", [])
    if PT.add_prediction(preds, pred):
        PT.fold_old(preds, ud.setdefault("ea_pred_archive", {}))
        return pred["id"]
    return None

async def ea_evaluate_pending_predictions(ud):
    """Resolve PENDING predictions against real closed candles (one fetch per
    symbol/timeframe, via the 60s OHLC cache). Returns True if anything changed -
    the caller save_data()s. Resolved predictions are never modified again."""
    preds = ud.get("ea_predictions") or []
    pending = [p for p in preds if p.get("status") == "PENDING"]
    if not pending:
        return False
    changed = False
    groups = {}
    for p in pending:
        groups.setdefault((p["symbol"], p["tf"]), []).append(p)
    for (symbol, tf), items in list(groups.items())[:12]:
        try:
            df, _prov = await ea_get_ohlc_cached(symbol, tf, outputsize="500")
        except Exception as e:
            logger.warning(f"prediction eval fetch failed {symbol} {tf}: {e}")
            continue
        for p in items:
            try:
                upd = PT.resolve_prediction(p, df, utc_offset_hours=EA_BAR_UTC_OFFSET_HOURS)
            except Exception as e:
                logger.warning(f"prediction eval error {p.get('id')}: {e}")
                upd = None
            if upd:
                p.update(upd)
                changed = True
    return changed

def ea_validated_accuracy(ud, symbol=None, tf=None):
    """('61.4%', 428) when the sample is reliable, else None - for signal cards."""
    st = PT.compute_stats(ud.get("ea_predictions") or [], ud.get("ea_pred_archive"), symbol=symbol, tf=tf)
    return PT.accuracy_line(st["overall"])

def ea_record_trade_request(ud, signal_id, cmd_id, plan, result):
    """Called the moment a signal is sent to the EA (ea_xgo) — creates the
    'REQUESTED' trade-journal entry that TRADE_OPENED/TRADE_CLOSED events
    later fill in. Carries a snapshot of the confidence/components/news at
    the moment of execution, since ea_signal_journal entries can age out."""
    entry = {
        "id": str(uuid.uuid4())[:8], "signal_id": signal_id, "cmd_id": cmd_id, "status": "REQUESTED",
        "symbol": plan["symbol"], "preset": result.get("preset"), "direction": plan["direction"],
        "confidence": result.get("confidence"), "components": result.get("components"),
        "news_level": (result.get("news") or {}).get("level"),
        "sl": plan.get("sl"), "tp": plan.get("tp"), "rr_target": plan.get("rr"),
        "reference_price": plan.get("reference_price"),
        "requested_at": time.time(), "opened_at": None, "closed_at": None,
        "entry_price": None, "exit_price": None, "pl": None,
    }
    journal = ud.setdefault("ea_trade_journal", [])
    journal.insert(0, entry)
    del journal[EA_JOURNAL_MAX:]
    return entry["id"]

def ea_find_trade_by_cmd(ud, cmd_id):
    for t in ud.get("ea_trade_journal", []):
        if t.get("cmd_id") == cmd_id:
            return t
    return None

def ea_apply_trade_event(ud, event: dict):
    """Feed a TRADE_OPENED/TRADE_CLOSED event from the EA into the matching
    journal entry, keyed by the 'request_id' the EA is expected to echo back
    (the cmd_id it received in the EXECUTE command, per spec §18/§33). Events
    with no matching request_id, or types we don't track, are ignored — the
    raw EA_STATE event feed (ea_add_event) still records everything as-is."""
    etype = event.get("type")
    cmd_id = event.get("request_id") or event.get("cmd_id")
    if etype not in ("TRADE_OPENED", "TRADE_CLOSED") or not cmd_id:
        return
    trade = ea_find_trade_by_cmd(ud, cmd_id)
    if not trade:
        return
    if etype == "TRADE_OPENED":
        trade["status"] = "OPEN"
        trade["opened_at"] = event.get("at", time.time())
        trade["entry_price"] = event.get("entry_price") or event.get("price")
    elif etype == "TRADE_CLOSED":
        trade["status"] = "CLOSED"
        trade["closed_at"] = event.get("at", time.time())
        trade["exit_price"] = event.get("exit_price") or event.get("price")
        try:
            trade["pl"] = float(event.get("pl", 0) or 0)
        except (TypeError, ValueError):
            trade["pl"] = 0.0
        risk_amount = None
        if trade.get("sl") and trade.get("reference_price"):
            risk_amount = abs(trade["reference_price"] - trade["sl"])
        trade["rr_realized"] = None
        if risk_amount and trade.get("entry_price") and trade.get("exit_price"):
            moved = (trade["exit_price"] - trade["entry_price"]) if trade["direction"] == "BUY" \
                else (trade["entry_price"] - trade["exit_price"])
            trade["rr_realized"] = round(moved / risk_amount, 2) if risk_amount else None

# ------------------------------------------------------------
# Historical Outcome Engine (spec §6) — resolves a PENDING ea_signal_journal
# entry (one with reference_price/sl/tp/timeframe from ea_record_signal) by
# replaying real OHLC candles fetched AFTER the signal's own timestamp, using
# the exact same SL-first-if-both-touched convention _ea_backtest_scan
# already uses (spec §6: "use the project's existing conservative backtest
# convention"). Never fabricates a result: a provider failure, or simply not
# enough new candles yet, leaves the entry untouched (still PENDING) unless
# it has aged past EA_SIGNAL_EXPIRY_BARS bars for its timeframe, in which
# case it's marked EXPIRED/UNRESOLVED rather than left pending forever.
# ------------------------------------------------------------
EA_SIGNAL_EXPIRY_BARS = 300

def _ea_maybe_expire_signal(entry):
    tf_secs = TIMEFRAME_SECONDS.get(entry.get("timeframe"))
    at = entry.get("at")
    if not tf_secs or not at:
        return None
    if (time.time() - at) > tf_secs * EA_SIGNAL_EXPIRY_BARS:
        return {"status": "EXPIRED", "outcome": "UNRESOLVED", "evaluated_at": time.time()}
    return None

async def ea_evaluate_signal_outcome(entry):
    """Returns a dict of fields to merge into `entry` (via dict.update) if its
    outcome could be determined or it has expired, else None (no change —
    caller must leave the entry exactly as it was, never guess)."""
    symbol, tf = entry.get("symbol"), entry.get("timeframe")
    direction = entry.get("direction")
    entry_price, sl, tp = entry.get("reference_price"), entry.get("sl"), entry.get("tp")
    at = entry.get("at")
    if entry.get("status") != "PENDING" or direction not in ("BUY", "SELL"):
        return None
    if not (symbol and tf and entry_price and sl and tp and at):
        return None
    try:
        df, providers_tried = await ea_get_ohlc_cached(symbol, tf, outputsize="500")
    except Exception as e:
        logger.warning(f"Strategy Performance: OHLC fetch failed for {symbol} {tf}: {e}")
        return None
    if df is None or df.empty:
        return _ea_maybe_expire_signal(entry)  # provider unavailable — never convert to LOSS/WIN
    entry_dt = pd.Timestamp(datetime.utcfromtimestamp(at))
    future = df[df["datetime"] > entry_dt]
    if future.empty:
        return _ea_maybe_expire_signal(entry)  # no new candles since the signal yet
    for _, row in future.iterrows():
        hit_sl = (row["low"] <= sl) if direction == "BUY" else (row["high"] >= sl)
        hit_tp = (row["high"] >= tp) if direction == "BUY" else (row["low"] <= tp)
        if hit_sl:  # SL-first assumption even if TP also touched this candle — matches _ea_backtest_scan
            return {"status": "RESOLVED", "outcome": "LOSS", "outcome_at": row["datetime"].isoformat(),
                    "exit_price": float(sl), "r_multiple": -1.0, "evaluated_at": time.time()}
        if hit_tp:
            rr = entry.get("rr_target") or 2.0
            return {"status": "RESOLVED", "outcome": "WIN", "outcome_at": row["datetime"].isoformat(),
                    "exit_price": float(tp), "r_multiple": round(float(rr), 2), "evaluated_at": time.time()}
    return _ea_maybe_expire_signal(entry)  # ran off the end of available data still open — don't guess

async def ea_evaluate_pending_signals(ud, limit=200):
    """Walks the signal journal's PENDING entries (newest first, capped per
    call so opening Performance stays fast — spec §24) and resolves whatever
    it can. Mutates ud['ea_signal_journal'] in place; caller is responsible
    for save_data() afterward so results survive a restart (spec §23)."""
    journal = ud.get("ea_signal_journal", [])
    checked = 0
    changed = False
    for e in journal:
        if e.get("status") != "PENDING":
            continue
        if checked >= limit:
            break
        checked += 1
        try:
            update = await ea_evaluate_signal_outcome(e)
        except Exception as ex:
            logger.warning(f"Strategy Performance: evaluation error for signal {e.get('id')}: {ex}")
            update = None
        if update:
            e.update(update)
            changed = True
    try:
        if await ea_evaluate_pending_predictions(ud):
            changed = True
    except Exception as ex:
        logger.warning(f"prediction evaluation error: {ex}")
    return changed

def ea_session_for_ts(ts):
    """Rough, timezone-configurable-later session split (spec §17) by UTC
    hour: Asian 00-07, London 07-15, New York 15-24. Overlaps are approximate
    by design — precise session-boundary logic is a later refinement."""
    if not ts:
        return "UNKNOWN"
    hour = datetime.fromtimestamp(ts, tz=timezone.utc).hour
    if hour < 7:
        return "Asian"
    if hour < 15:
        return "London"
    return "New York"

def ea_confidence_bucket(conf):
    if conf is None:
        return "UNKNOWN"
    if conf >= 90:
        return "90-100"
    if conf >= 80:
        return "80-89"
    if conf >= 70:
        return "70-79"
    return "<70"

def ea_compute_performance(trades):
    """Core Performance Analytics (spec §25) over a list of trade-journal
    entries. Only CLOSED trades count toward win/loss stats — never fabricated,
    and returns None fields (not zeros) when there isn't enough data yet."""
    closed = [t for t in trades if t.get("status") == "CLOSED" and t.get("pl") is not None]
    stats = {"total_signals": None, "total_trades": len(closed)}
    if not closed:
        return stats
    wins = [t for t in closed if t["pl"] > 0]
    losses = [t for t in closed if t["pl"] < 0]
    breakeven = [t for t in closed if t["pl"] == 0]
    gross_win = sum(t["pl"] for t in wins)
    gross_loss = sum(t["pl"] for t in losses)
    win_rate = len(wins) / len(closed) * 100
    avg_win = gross_win / len(wins) if wins else 0.0
    avg_loss = gross_loss / len(losses) if losses else 0.0
    profit_factor = (gross_win / abs(gross_loss)) if gross_loss else (float("inf") if gross_win else 0.0)
    expectancy = (win_rate / 100 * avg_win) + ((1 - win_rate / 100) * avg_loss)
    rr_values = [t["rr_realized"] for t in closed if t.get("rr_realized") is not None]

    # Max drawdown from the closed trades' own cumulative P/L curve (in the
    # order they closed) — not account equity, since that also moves on
    # non-EA activity.
    ordered = sorted(closed, key=lambda t: t.get("closed_at") or 0)
    cum, peak, max_dd = 0.0, 0.0, 0.0
    streak_type, streak_len, cur_streak_type, cur_streak_len = None, 0, None, 0
    for t in ordered:
        cum += t["pl"]
        peak = max(peak, cum)
        max_dd = max(max_dd, peak - cum)
        this_type = "W" if t["pl"] > 0 else ("L" if t["pl"] < 0 else "B")
        if this_type == cur_streak_type:
            cur_streak_len += 1
        else:
            cur_streak_type, cur_streak_len = this_type, 1
        if this_type in ("W", "L") and cur_streak_len >= streak_len:
            streak_type, streak_len = this_type, cur_streak_len

    stats.update({
        "total_trades": len(closed), "wins": len(wins), "losses": len(losses), "breakeven": len(breakeven),
        "win_rate": round(win_rate, 1), "avg_win": round(avg_win, 2), "avg_loss": round(avg_loss, 2),
        "profit_factor": round(profit_factor, 2) if profit_factor != float("inf") else None,
        "expectancy": round(expectancy, 2),
        "avg_rr": round(sum(rr_values) / len(rr_values), 2) if rr_values else None,
        "max_drawdown": round(max_dd, 2),
        "best_trade": round(max(t["pl"] for t in closed), 2),
        "worst_trade": round(min(t["pl"] for t in closed), 2),
        "streak": f"{streak_len} {'wins' if streak_type == 'W' else 'losses'}" if streak_type else None,
    })
    return stats

def ea_group_performance(trades, key_fn):
    """Group trade-journal entries by an arbitrary key function (symbol,
    preset, confidence bucket, direction, news level, session — spec §26)
    and compute performance per group."""
    groups = {}
    for t in trades:
        groups.setdefault(key_fn(t), []).append(t)
    return {k: ea_compute_performance(v) for k, v in groups.items() if k is not None}

