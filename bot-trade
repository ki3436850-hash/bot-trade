def main():
    if not BOT_TOKEN or BOT_TOKEN == "YOUR_BOT_TOKEN_HERE":
        logger.error(
            "❌ BOT_TOKEN មិនទាន់បានកំណត់ទេ។ សូមកំណត់ Environment Variable "
            "BOT_TOKEN ក្នុង Railway (ឬ Environment ដែលកំពុងប្រើ) មុននឹងចាប់ផ្តើម Bot។"
        )
        sys.exit(1)
    load_data()
    threading.Thread(target=start_health_server, daemon=True).start()
    threading.Thread(target=ea_heartbeat_watcher, daemon=True).start()
    # Local Bot API Server (ស្រេចចិត្ត) — Telegram Cloud Bot API កំណត់ Download
    # File បានត្រឹមតែ 20MB ជានិច្ច។ បើចង់ Download Video ធំជាងនេះ (រហូតដល់ 2000MB)
    # ត្រូវ Self-host Local Bot API Server (https://github.com/tdlib/telegram-bot-api)
    # ដោយប្រើ api_id/api_hash ពី https://my.telegram.org រួចដាក់ Environment Variables
    # TELEGRAM_API_BASE_URL និង TELEGRAM_API_BASE_FILE_URL ទៅចង្អុលទៅ Server នោះ —
    # បើមិនកំណត់ Variable ទាំងនេះ Bot នឹងប្រើ Telegram Cloud API ធម្មតា (20MB Cap)។
    api_base_url = os.environ.get("TELEGRAM_API_BASE_URL")
    api_base_file_url = os.environ.get("TELEGRAM_API_BASE_FILE_URL")

    # Timeout ធំជាងលំនាំដើម (PTB Default = 5s ខ្លីពេកសម្រាប់ Video ធំៗ) — ចាំបាច់
    # ជាពិសេសពេលប្រើ Local Bot API Server ជាមួយ Video រហូតដល់ 100MB-2000MB។
    # អាច Override តាម Environment Variable TELEGRAM_MEDIA_TIMEOUT (គិតជាវិនាទី)។
    media_timeout = int(os.environ.get("TELEGRAM_MEDIA_TIMEOUT", "600"))
    request = HTTPXRequest(
        connect_timeout=30.0,
        read_timeout=media_timeout,
        write_timeout=media_timeout,
        pool_timeout=30.0,
        media_write_timeout=media_timeout,
    )

    builder = Application.builder().token(BOT_TOKEN).request(request).post_init(_post_init)
    if api_base_url:
        builder = builder.base_url(api_base_url)
    if api_base_file_url:
        builder = builder.base_file_url(api_base_file_url)
        # កំណត់ចំណាំ៖ មិនប្រើ builder.local_mode(True) ទេ ព្រោះវានឹងធ្វើឲ្យ PTB ព្យាយាម
        # អាន file_path ជា Local Disk Path ដោយផ្ទាល់ — ដំណើរការតែពេល Bot និង Local API
        # Server ស្ថិតក្នុង Container/Filesystem តែមួយប៉ុណ្ណោះ។ ដោយសារ Service ទាំងពីរ
        # ដាច់ដោយឡែក (Railway Service ខុសគ្នា) យើងប្រើ _download_file_bytes() ជំនួសវិញ
        # ដើម្បី Download តាម HTTP ដោយផ្ទាល់ សូម្បី file_path ជា Absolute Path ក៏ដោយ។
    app = builder.build()
    # ក្នុង main()
    commands = {
        "start": start,
        "profile": profile,
        "status": status,
        "version": version,
        "mission": mission,
        "today": today,
        "done": done,
        "shop": shop,
        "library": library,
        "bank": bank,
        "invite": invite,
        "battle": battle,
        "signal": signal,
        "analyze": analyze,
        "ea": ea_command,
        "ea_status": ea_status_command,
        "ea_analyze": ea_analyze_command,
        "ea_signal": ea_signal_command,
        "accuracy": accuracy_command,
        "ea_backtest": ea_backtest_command,
        "ea_performance": ea_performance_command,
        "ea_journal": ea_journal_command,
        "ea_settings": ea_settings_command,
        "feed": feed,
        "store": store_command,
        "love": love_command,
        "orders": orders_command,
        "help": help_command,
        "teacher": teacher_command,
        "getfileid": getfileid_command,
        "tiktokconnect": tiktokconnect_command,
        "tiktokaccounts": tiktokaccounts_command,
        "youtubeconnect": youtubeconnect_command,
        "facebookconnect": facebookconnect_command,
        "aistatus": aistatus_command,
        "post": post_command,
        "schedule": schedule_command,
        "customer": customer_command,
        "categories": categories_command,
        "uploadvideo": uploadvideo_command,
        "usevideo": usevideo_command,
        "cancel": cancel_command,
    }
    for cmd, handler in commands.items():
        app.add_handler(CommandHandler(cmd, handler))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    app.add_handler(MessageHandler(filters.VIDEO, handle_video))
    app.add_handler(MessageHandler(filters.VOICE | filters.AUDIO, handle_voice))
    app.add_handler(MessageHandler(filters.Document.ALL, handle_document))
    app.add_handler(MessageHandler(filters.LOCATION, handle_location))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_error_handler(global_error_handler)
    logger.info("Starting bot...")
    logger.info("🔖 BUILD MARKER: download-fix-2026-09-17-v3")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()

