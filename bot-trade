async def market_send_product_actions(send_text_fn, listing, viewer_id, bot_username):
    """Replaces the old bare 'ទំនិញ #id + buy button' message. Adds seller
    shop, share and — for the owner / admins — manage / remove buttons.
    Never raises: falls back to the legacy buy button."""
    lid = listing["id"]
