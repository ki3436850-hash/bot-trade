                     "សូមទាក់ទង Admin ប្រសិនបើមានសំណួរ។")
        except Exception as e:
            logger.warning(f"Notify seller of admin removal failed: {e}")
        return True

    # ---------- share & promote ----------
    if data == "mk_share":
        await market_share_center(q, context, uid)
        return True

    if data.startswith("mk_sharep_"):
        await market_share_products(q, context, uid, before_id=int(data[len("mk_sharep_"):]) or None)
        return True

    # ---------- shop settings ----------
    if data == "mk_set":
        shop = await db_get_shop_by_owner(uid) if await market_shops_available() else None
        if not shop:
            await safe_alert(q, "❌ អ្នកមិនទាន់មានហាងទេ។")
