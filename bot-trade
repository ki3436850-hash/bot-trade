TIMEFRAME_TO_INTERVAL = {
    "M1": "1min", "M5": "5min", "M15": "15min", "M30": "30min",
    "H1": "1h", "H4": "4h", "D1": "1day", "W1": "1week", "MN1": "1month",
}

# Timeframes the data providers don't offer natively (spec §7) are built by
# resampling OHLC bars from the nearest native timeframe below them, rather
# than silently substituting a different timeframe or fabricating candles.
# {target_timeframe: (native_base_timeframe, pandas_resample_rule)}
EA_RESAMPLE_MAP = {
    "M2":  ("M1", "2min"),  "M3":  ("M1", "3min"),  "M4":  ("M1", "4min"),
    "M6":  ("M1", "6min"),  "M10": ("M5", "10min"), "M12": ("M1", "12min"),
    "M20": ("M5", "20min"),
    "H2":  ("H1", "2h"),    "H3":  ("H1", "3h"),    "H6":  ("H1", "6h"),
    "H8":  ("H1", "8h"),    "H12": ("H1", "12h"),
}

def ea_resample_ohlc(df, rule):
    """Build a coarser OHLC frame from a finer, natively-fetched one."""
    d = df.set_index("datetime").sort_index()
    out = d.resample(rule).agg({"open": "first", "high": "max", "low": "min", "close": "last"})
    return out.dropna().reset_index()

async def ea_get_ohlc(symbol, tf, outputsize="500"):
    """Single OHLC-fetch path shared by the signal engine (ea_fetch_and_score)
    and the backtester (_ea_backtest_fetch): native timeframes go straight to
    fetch_market_data; the extra granularities in EA_RESAMPLE_MAP are built by
    resampling their native base; anything else is reported unavailable
    rather than silently mapped to a different timeframe."""
    if tf in TIMEFRAME_TO_INTERVAL:
        df, providers_tried = await fetch_market_data(
            symbol, interval=TIMEFRAME_TO_INTERVAL[tf], outputsize=outputsize, timeframe=tf
        )
        return df, providers_tried
    if tf in EA_RESAMPLE_MAP:
        base_tf, rule = EA_RESAMPLE_MAP[tf]
        base_df, providers_tried = await fetch_market_data(
            symbol, interval=TIMEFRAME_TO_INTERVAL[base_tf], outputsize=outputsize, timeframe=base_tf
        )
        if base_df is None:
            return None, providers_tried
        return ea_resample_ohlc(base_df, rule), providers_tried
    return None, []

# ------------------------------------------------------------
# 📈 Strategy Performance — shared timeframe/caching plumbing.
# EA_PERF_TIMEFRAMES reuses every timeframe TIMEFRAME_TO_INTERVAL already
# supports (M1..MN1) rather than a hand-picked subset, so Performance never
# silently drops a timeframe the provider layer can actually serve (spec §2/
# §11: "do not reduce timeframes" / "only display timeframes the repo
# actually supports"). TIMEFRAME_SECONDS is only used to turn a timeframe
# into a bar-duration for the PENDING→EXPIRED cutoff below (spec §5/§22) —
# it never changes what ea_get_ohlc fetches.
# ------------------------------------------------------------
EA_PERF_TIMEFRAMES = list(TIMEFRAME_TO_INTERVAL.keys())  # M1,M5,M15,M30,H1,H4,D1,W1,MN1
TIMEFRAME_SECONDS = {
    "M1": 60, "M2": 120, "M3": 180, "M4": 240, "M5": 300, "M6": 360,
    "M10": 600, "M12": 720, "M15": 900, "M20": 1200, "M30": 1800,
    "H1": 3600, "H2": 7200, "H3": 10800, "H4": 14400, "H6": 21600,
    "H8": 28800, "H12": 43200, "D1": 86400, "W1": 604800, "MN1": 2592000,
}

# Short-TTL cache in front of ea_get_ohlc, used ONLY by the Strategy
# Performance evaluator (ea_evaluate_signal_outcome) so opening Performance
# repeatedly, or evaluating several PENDING signals on the same symbol/
# timeframe, doesn't re-download the same ~500 candles on every call (spec
# §24). Signal generation itself keeps calling ea_get_ohlc directly since
# it needs the freshest possible bar.
_EA_OHLC_CACHE = {}
EA_OHLC_CACHE_TTL = 60  # seconds

async def ea_get_ohlc_cached(symbol, tf, outputsize="500"):
    key = (symbol, tf, outputsize)
    now = time.time()
    hit = _EA_OHLC_CACHE.get(key)
    if hit and (now - hit[0]) < EA_OHLC_CACHE_TTL:
        return hit[1], hit[2]
    df, providers_tried = await ea_get_ohlc(symbol, tf, outputsize=outputsize)
    if len(_EA_OHLC_CACHE) > 300:  # cheap unbounded-growth guard
        _EA_OHLC_CACHE.clear()
    _EA_OHLC_CACHE[key] = (now, df, providers_tried)
    return df, providers_tried

# Bar timestamps from the data providers are assumed UTC (Twelve Data returns
# UTC for forex/metals/crypto). If your feed is offset, set EA_BAR_UTC_OFFSET_HOURS.
EA_BAR_UTC_OFFSET_HOURS = float(os.environ.get("EA_BAR_UTC_OFFSET_HOURS", "0") or 0)

def ea_prepare_df(df, tf):
    """Closed-candle rule: drop the still-forming last bar before scoring, and
    capture freshness metadata. Shared by /ea (ea_fetch_and_score) and /analyze
    (analyze_gather) so both score the same closed candles. -> (df, meta)."""
    df2, meta = DC.drop_forming_candle(df, TIMEFRAME_SECONDS.get(tf), utc_offset_hours=EA_BAR_UTC_OFFSET_HOURS)
    if meta.get("age_since_close_s") is not None:
        logger.info(f"bars {tf}: last closed bar age={meta['age_since_close_s']}s forming_dropped={meta['forming_dropped']}")
    try:  # reference bar for prediction tracking (provider's own timestamp, unadjusted)
        if df2 is not None and len(df2) >= 2:
            meta["ref_bar_raw"] = str(df2["datetime"].iloc[-1])
            meta["ref_close"] = float(df2["close"].iloc[-1])
            d = float(df2["close"].iloc[-1]) - float(df2["close"].iloc[-2])
            meta["prev_dir"] = "BULLISH" if d > 0 else ("BEARISH" if d < 0 else "NEUTRAL")
    except Exception:
        pass
    return df2, meta

