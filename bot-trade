_ANALYZE_CACHE = {}          # key -> (timestamp, value)
ANALYZE_BUNDLE_TTL = 60      # seconds — matches EA_OHLC_CACHE_TTL, so button hops don't refetch
ANALYZE_NEWS_TTL = 600
ANALYZE_AI_TTL = 120
ANALYZE_AI_LANG = os.environ.get("ANALYZE_AI_LANG", "English")

def _analyze_cache_get(key, ttl):
    hit = _ANALYZE_CACHE.get(key)
    if hit and (time.time() - hit[0]) < ttl:
        return hit[1]
    return None

def _analyze_cache_put(key, value):
    if len(_ANALYZE_CACHE) > 200:
        _ANALYZE_CACHE.clear()
    _ANALYZE_CACHE[key] = (time.time(), value)

async def analyze_fetch_news(symbol):
    """-> (raw_articles | None, ok). Cached 10 min; only successful fetches are cached."""
    key = ("news", symbol)
    hit = _analyze_cache_get(key, ANALYZE_NEWS_TTL)
    if hit is not None:
        return hit
    prof = AI_INTEL.symbol_profile(symbol)
    if not prof["query"]:
        return [], True
    if not NEWSAPI_KEY or NEWSAPI_KEY == "YOUR_KEY":
        return None, False
    try:
        res = await async_get(
            "https://newsapi.org/v2/everything",
            params={"q": prof["query"], "language": "en", "sortBy": "publishedAt", "pageSize": 30, "apiKey": NEWSAPI_KEY},
            timeout=10,
        )
        data = res.json()
        if data.get("status") != "ok":
            logger.warning(f"NewsAPI (analyze) not ok: {data.get('message') or data}")
            return None, False
        out = (data.get("articles") or [], True)
        _analyze_cache_put(key, out)
        return out
    except Exception as e:
        logger.warning(f"NewsAPI (analyze) error: {e}")
        return None, False

async def analyze_gather(symbol, tf, mode, force=False):
    """Collect REAL data into one bundle. Anything that fails is left unavailable — never faked."""
    key = ("bundle", symbol, tf, mode)
    if not force:
        hit = _analyze_cache_get(key, ANALYZE_BUNDLE_TTL)
        if hit is not None:
            return hit
    now = datetime.now(timezone.utc)
    tf_list = [tf] if mode == "news" else list(dict.fromkeys(AI_INTEL.MTF_SET + [tf]))
    sem = asyncio.Semaphore(2)  # don't burst free-tier provider rate limits

    async def one(t):
        async with sem:
            if t not in TIMEFRAME_TO_INTERVAL and t not in EA_RESAMPLE_MAP:
                return t, None, [], None
            try:
                df, prov = await ea_get_ohlc_cached(symbol, t)
                meta = None
                if df is not None:
                    df, meta = ea_prepare_df(df, t)  # closed candles only, same as /ea
                return t, df, prov, meta
            except Exception as e:
                logger.warning(f"analyze fetch {symbol} {t} failed: {e}")
                return t, None, [], None

    fetched = await asyncio.gather(*[one(t) for t in tf_list])
    tfs, dfs, providers = {}, {}, []
    for t, df, prov, meta in fetched:
        if df is not None and len(df) >= 30:
            try:
                tfs[t] = ea_analyze_timeframe_bias(df, t)
                tfs[t]["bar_meta"] = meta
                dfs[t] = df
                continue
            except Exception as e:
                logger.warning(f"analyze scoring {symbol} {t} failed: {e}")
        tfs[t] = {"timeframe": t, "error": True}
        if prov and t == tf:
            providers = prov
    primary = tfs[tf] if not tfs[tf].get("error") else None
    df = dfs.get(tf)

    try:
        events = AI_INTEL.relevant_events(await ea_fetch_calendar(), symbol, now)
    except Exception as e:
        logger.warning(f"analyze calendar failed: {e}")
        events = None

    news, news_ok = [], False
    if mode in ("news", "cmb"):
        raw, news_ok = await analyze_fetch_news(symbol)
        news = AI_INTEL.filter_news(raw, symbol, now) if news_ok else []
    fred = None
    if mode == "news" and "USD" in AI_INTEL.symbol_profile(symbol)["ccys"]:
        try:
            fred = await fetch_fred_trend("DFF")
        except Exception:
            fred = None
    hist = {"available": False, "n": 0, "why": "not requested"}
    if mode != "news" and df is not None:
        try:
            hist = AI_INTEL.historical_observation(df)
        except Exception as e:
            hist = {"available": False, "n": 0, "why": f"error: {e}"}

    bundle = {"symbol": symbol, "tf": tf, "now": now, "tfs": tfs, "primary": primary, "df": df,
              "providers": ", ".join(str(p) for p in providers) or "no provider returned data",
              "events": events, "calendar_ok": events is not None,
              "news": news, "news_ok": news_ok, "fred": fred, "hist": hist}
    _analyze_cache_put(key, bundle)
    return bundle

async def analyze_ai_synthesis(b, d):
    """-> (text | None, error | None). Falls back silently to rules-only output on any failure."""
    key = ("ai", b["symbol"], b["tf"], id(b))
    hit = _analyze_cache_get(key, ANALYZE_AI_TTL)
    if hit is not None:
        return hit, None
    try:
        text, _prov, err = await asyncio.wait_for(
            ai_router_generate("prediction", AI_INTEL.build_ai_messages(b, d, ANALYZE_AI_LANG), max_tokens=600), timeout=45)
    except asyncio.TimeoutError:
        return None, "timeout"
    except Exception as e:
        return None, str(e)
    if text:
        _analyze_cache_put(key, text)
    return text, err

async def analyze_send(q, text, kb):
