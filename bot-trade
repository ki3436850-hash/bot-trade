def ensure_creature(ud, creature_name):
    if creature_name not in ud["creatures"]:
        ud["creatures"][creature_name] = {"level": 1, "xp": 0}
    return ud["creatures"][creature_name]

def apply_bank_interest(ud):
    today = datetime.now().date().isoformat()
    if ud["bank_interest_date"] != today:
        if ud["bank_balance"] > 0:
            interest = int(ud["bank_balance"] * 0.01)
            ud["bank_balance"] += interest
            ud["bank_interest_date"] = today
            save_data()
            return interest
        else:
            ud["bank_interest_date"] = today
            save_data()
            return 0
    return 0

