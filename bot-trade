def reset_daily_tasks(ud):
    today = datetime.now().date().isoformat()
    if ud["daily_date"] != today:
        ud["daily_tasks_list"] = generate_daily_tasks()
        ud["daily_tasks_done"] = [False] * len(ud["daily_tasks_list"])
        ud["daily_date"] = today
        save_data()

def reset_weekly_missions(ud):
    today = datetime.now().date()
    week_start = (today - timedelta(days=today.weekday())).isoformat()
    if ud["weekly_progress"]["week_start"] != week_start:
        ud["weekly_progress"]["missions"] = [False]*4
        ud["weekly_progress"]["exercise_count"] = 0
        ud["weekly_progress"]["week_start"] = week_start
        save_data()

def add_xp(user_id, amount):
    ud = get_user_data(user_id)
    old = ud["level"]
    ud["xp"] += amount
    ud["stats"]["total_xp_earned"] += amount
    new = 1
    for i, t in enumerate(LEVEL_THRESHOLDS, 1):
        if ud["xp"] >= t:
            new = i
    ud["level"] = max(old, new)
    save_data()
    return ud["level"] > old

def update_streak(ud):
    today = datetime.now().date().isoformat()
    if ud["last_completed_date"] == today:
        return
    yest = (datetime.now().date() - timedelta(days=1)).isoformat()
    ud["streak"] = ud["streak"] + 1 if ud["last_completed_date"] == yest else 1
    ud["last_completed_date"] = today
    ud["stats"]["total_days_played"] += 1
    save_data()

def get_level_progress(ud):
    lvl = ud["level"]
    if lvl >= len(LEVEL_THRESHOLDS):
        return f"Level {lvl} — MAX"
    cur = LEVEL_THRESHOLDS[lvl-1]
    nxt = LEVEL_THRESHOLDS[lvl]
    prog = max(0, ud["xp"] - cur) / (nxt - cur)
    filled = int(prog * 10)
    return f"Level: {lvl}\nXP: {ud['xp']} / {nxt}\nProgress: {'█'*filled}{'░'*(10-filled)} {int(prog*100)}%"

