async def dj_create_application(send_fn, context, uid, listing_id):
    """បង្កើត Order/Application ពិតប្រាកដ (បន្ទាប់ពី Profile រួច ឬ Confirm)."""
    listing = await db_get_listing(listing_id)
    if not listing or listing_is_removed(listing):
        await send_fn("⚠️ ការងារនេះលែងមានហើយ។")
        return
    seller_id = listing["seller_id"]
    if str(seller_id) == str(uid):
        await send_fn("អ្នកមិនអាចដាក់ពាក្យសុំការងាររបស់ខ្លួនឯងបានទេ។")
        return
    existing = await db_get_active_order(listing_id, uid)
    if existing:
        await send_fn(f"អ្នកបានដាក់ពាក្យសុំការងារនេះរួចហើយ (#{existing['id']}) — មើលតាម 📋 My Applications។")
        return
    order = await db_create_order(listing_id, uid, seller_id)
    if not order:
        await send_fn("❌ មិនអាចដាក់ពាក្យសុំបានទេ សូមសាកល្បងម្តងទៀត។")
        return
    await send_fn(f"✅ Application Sent\n\nអាចតាមដានតាម 📋 My Applications (#{order['id']})។")
    try:
        profile = await db_get_candidate_profile(uid)
        applicant_line = format_candidate_profile(profile) if profile else f"Telegram ID: {uid}"
        await context.bot.send_message(
            chat_id=int(seller_id),
            text=f"📩 New Application #{order['id']}\n\n💼 {listing.get('name') or 'ការងារ'}\n\n{applicant_line}",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("✅ Shortlist", callback_data=f"order_conf_{order['id']}"),
                InlineKeyboardButton("❌ Reject", callback_data=f"order_rej_{order['id']}"),
            ]]))
    except Exception as e:
        logger.warning(f"Notify employer of new application failed: {e}")

async def dj_handle_text(update, context, ud, text):
    """ត្រឡប់ True បើបាន Handle — Candidate Profile Wizard, Job Search Query, ឬ Interview Scheduling។"""
    if ud.get("dj_state") in ("interview_datetime", "interview_suggest"):
        temp = ud.get("dj_temp") or {}
        order_id = temp.get("order_id")
        try:
            naive = datetime.strptime(text.strip(), "%Y-%m-%d %H:%M")
        except ValueError:
            await update.message.reply_text(
                "❌ ទម្រង់ម៉ោងមិនត្រឹមត្រូវ។ សូមប្រើទម្រង់៖ `YYYY-MM-DD HH:MM`\nឧ. `2026-09-28 14:00`",
                parse_mode="Markdown")
            return True
        dt = naive.replace(tzinfo=PHNOM_PENH_TZ)
        if dt <= datetime.now(PHNOM_PENH_TZ):
            await update.message.reply_text("❌ ម៉ោងនេះកន្លងផុតទៅហើយ។ សូមបញ្ចូលម៉ោងនាពេលអនាគត។")
            return True
        if ud["dj_state"] == "interview_datetime":
            temp["pending_interview_dt"] = dt.isoformat()
            ud["dj_temp"] = temp
            ud["dj_state"] = None
            save_data()
            kb = InlineKeyboardMarkup([
                [InlineKeyboardButton(INTERVIEW_MODE_LABELS["onsite"], callback_data=f"dj_ivmode_onsite_{order_id}")],
                [InlineKeyboardButton(INTERVIEW_MODE_LABELS["online"], callback_data=f"dj_ivmode_online_{order_id}")],
            ])
            await update.message.reply_text("🏢/💻 ជ្រើសរើសទម្រង់សម្ភាសន៍៖", reply_markup=kb)
            return True
        else:  # interview_suggest — either party proposing a new time directly
            order = await db_set_interview(order_id, dt.isoformat(),
                                            (temp.get("prev_mode") or "online"), "employer_suggested")
            ud["dj_state"] = None
            ud["dj_temp"] = {}
            save_data()
            if not order:
                await update.message.reply_text("❌ មិនអាចរក្សាទុកបានទេ។")
                return True
            dt_label = dt.strftime("%Y-%m-%d %H:%M")
            role = temp.get("role")
            other_id = order["buyer_id"] if role == "employer" else order["seller_id"]
            await update.message.reply_text(f"🔄 បានស្នើពេលវេលាថ្មី៖ {dt_label}។ រង់ចាំគេឆ្លើយតប។")
            try:
                await context.bot.send_message(
                    chat_id=int(other_id),
                    text=f"🔄 New interview time suggested: {dt_label}",
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton("✅ យល់ព្រម", callback_data=f"dj_ivcandacc_{order_id}"),
                         InlineKeyboardButton("❌ បដិសេធ", callback_data=f"dj_ivcanddec_{order_id}")],
                    ]))
            except Exception as e:
                logger.warning(f"Notify of interview suggestion failed: {e}")
            return True

    if ud.get("dj_state") == "job_search":
        ud["dj_state"] = None
        save_data()
        results = await db_search_listings(text.strip(), category="job", limit=20)
        await dj_render_job_results(update.message, context, update.effective_user.id, results,
                                      title=f"🔎 លទ្ធផលសម្រាប់ \"{text.strip()[:40]}\"")
        return True
    if ud.get("dj_state") != "profile_field":
        return False
    temp = ud.get("dj_temp") or {}
    idx = temp.get("field_index", 0)
    field_key = DJ_PROFILE_FIELDS[idx][0]
    value = None if text.strip().lower() in ("skip", "-") else text[:300]
    temp[field_key] = value
    idx += 1
    if idx < len(DJ_PROFILE_FIELDS):
        temp["field_index"] = idx
        ud["dj_temp"] = temp
        save_data()
        await update.message.reply_text(DJ_PROFILE_FIELDS[idx][1])
        return True
    # Profile complete — save it.
    fields = {k: temp.get(k) for k, _ in DJ_PROFILE_FIELDS}
    await db_upsert_candidate_profile(update.effective_user.id, fields)
    next_after = temp.get("next_after", "preview")
    ud["dj_state"] = None
    ud["dj_temp"] = {}
    save_data()
    await update.message.reply_text("✅ Profile Saved!\n\n" + format_candidate_profile(fields))
    if next_after.startswith("apply_"):
        listing_id = next_after[len("apply_"):]
        await dj_create_application(update.message.reply_text, context, update.effective_user.id, listing_id)
    return True



async def market_commit_edit(msg, ud, uid, text):
    """Validate + save one product edit. `text` is what the seller typed, or a value
    injected by a button ('skip' = clear, '0' = sold out). Ownership is re-checked here."""
    edit = (ud.get("mk_temp") or {}).get("edit") or {}
    listing_id, field = edit.get("listing_id"), edit.get("field")
    listing = await db_get_listing(listing_id) if listing_id else None
    # Re-validate ownership at commit time — never trust stored state alone.
    if (not listing or listing_is_removed(listing) or str(listing["seller_id"]) != str(uid)
            or field not in _MK_EDIT_PROMPTS):
        _mk_clear_state(ud); save_data()
        await msg.reply_text("❌ រកមិនឃើញទំនិញនេះ ឬអ្នកមិនមានសិទ្ធិកែ។")
        return True
    value = text.strip()
    skip = value.lower() in ("skip", "-")
    fields, note = {}, ""
    if field == "name":
        if not value:
            await msg.reply_text("❌ សូមវាយឈ្មោះទំនិញ។")
            return True
        fields["name"] = value[:120]
    elif field == "desc":
        if not value:
            await msg.reply_text("❌ សូមវាយការពិពណ៌នា។")
            return True
        if len(value) > MK_PRODUCT_DESC_MAX:
            await msg.reply_text(f"❌ ការពិពណ៌នាវែងពេក (អតិបរមា {MK_PRODUCT_DESC_MAX} តួអក្សរ)។")
            return True
        fields["text"] = value
    elif field in ("price", "disc"):
        if skip:
            amount = None
        else:
            try:
                amount = _parse_money(value.replace("$", "").replace(",", ""))
            except ValueError:
                await msg.reply_text("❌ សូមវាយជាលេខ (ឧ. 12.5) ឬ skip។")
                return True
        if field == "price":
            fields["price"] = amount
            old_disc = listing.get("discount_price")
            if amount is None and old_disc is not None:
                fields["discount_price"] = None
                note = "\nℹ️ តម្លៃបញ្ចុះត្រូវបានលុបផងដែរ។"
            elif amount is not None and old_disc is not None:
                try:
                    if float(old_disc) >= amount:
                        fields["discount_price"] = None
                        note = "\nℹ️ តម្លៃបញ្ចុះត្រូវបានលុប ព្រោះមិនតិចជាងតម្លៃថ្មី។"
                except (TypeError, ValueError):
                    pass
        else:
            if amount is not None:
                price = listing.get("price")
                if price is None:
                    await msg.reply_text("❌ សូមកំណត់តម្លៃដើមជាមុនសិន។")
                    return True
                try:
                    if amount >= float(price):
                        await msg.reply_text("❌ តម្លៃបញ្ចុះត្រូវតិចជាងតម្លៃដើម។")
                        return True
                except (TypeError, ValueError):
                    pass
            fields["discount_price"] = amount
    elif field == "stock":
        if skip:
            new_stock = None
        else:
            try:
                new_stock = int(value)
                if new_stock < 0:
                    raise ValueError
            except ValueError:
                await msg.reply_text("❌ សូមវាយជាលេខគត់ (ឧ. 5) ឬ skip។")
                return True
        fields["stock"] = new_stock
        status = listing.get("status") or "active"
        if new_stock == 0:
            fields["status"] = "sold_out"
        elif status == "sold_out":
            fields["status"] = "active"
    row = await db_update_listing_owned(listing["id"], uid, fields)
    _mk_clear_state(ud); save_data()
    if not row:
        await msg.reply_text("❌ មិនអាចកែប្រែបានទេ សូមសាកល្បងម្តងទៀត។")
        return True
    await msg.reply_text(
        "✅ បានកែប្រែរួចរាល់។" + note,
        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 គ្រប់គ្រងទំនិញ", callback_data=f"mk_pm_{listing['id']}")]]))
    return True

