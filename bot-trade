_SE_SRC = r'''"""strategy_ensemble.py - modular strategy layer (master prompt sections 7-12).

Pure functions: pandas in, plain dicts out. No network, no Telegram, no storage.
Every strategy returns STRUCTURED EVIDENCE, never a bare BUY/SELL string:

    {"strategy": "pullback", "direction": "BUY"|"SELL"|"NONE", "score": 0-100,
     "reason": "...", "valid": bool, "active": bool, "tf": "M15"}

  active - the strategy suits the current market regime (see REGIME_ACTIVE).
           Inactive strategies are still reported (so the Details view can show
           why they were ignored) but never count toward a decision.
  valid  - the setup's own conditions are met (e.g. a breakout CLOSED beyond the
           level, a pullback has a confirmation candle).

All inputs are CLOSED candles (bot.ea_prepare_df drops the forming bar first).
Nothing here looks at future data, and nothing is invented: when an input is
missing the strategy reports valid=False with the reason.

ctx keys used (all optional, strategies degrade to invalid when absent):
  tf, atr, regime (dict with "regime"), adx, structure_bias, support, resistance
"""
import math

import pandas as pd

BUY, SELL, NONE = "BUY", "SELL", "NONE"

# Which strategies may act in which market regime (spec section 6).
REGIME_ACTIVE = {
    "TRENDING":        {"trend_following", "pullback", "momentum", "market_structure"},
    "BREAKOUT":        {"breakout", "momentum", "trend_following", "market_structure"},
    "RANGING":         {"mean_reversion", "support_resistance", "market_structure"},
    "LOW_VOLATILITY":  {"mean_reversion", "support_resistance"},
    "HIGH_VOLATILITY": {"breakout", "trend_following", "pullback", "market_structure"},
    "UNSTABLE":        set(),     # the read itself is untrustworthy -> nothing may trade
    "UNKNOWN":         set(),
}
ALWAYS_ACTIVE = {"news_event"}   # event risk matters in every regime

STRATEGY_NAMES = ["trend_following", "breakout", "pullback", "mean_reversion",
                  "momentum", "support_resistance", "market_structure", "news_event"]


def _ev(name, direction, score, reason, valid, ctx):
    return {"strategy": name, "direction": direction, "score": int(max(0, min(100, round(score)))),
            "reason": reason, "valid": bool(valid), "active": True, "tf": (ctx or {}).get("tf")}


def _none(name, reason, ctx):
    return _ev(name, NONE, 0, reason, False, ctx)


# ------------------------------------------------------------------ helpers
def _ema(df, span):
    return df["close"].ewm(span=span, adjust=False).mean()


def _rsi_last(df, period=14):
    d = df["close"].diff()
    g = d.clip(lower=0).rolling(period).mean()
    l = (-d.clip(upper=0)).rolling(period).mean()
    v = (100 - 100 / (1 + g / l)).iloc[-1]
    return None if pd.isna(v) else float(v)


def _macd_hist(df):
    macd = _ema(df, 12) - _ema(df, 26)
    return macd - macd.ewm(span=9, adjust=False).mean()


def swing_points(df, window=3):
    """Confirmed swing highs/lows as [(index, price)]. A swing at i needs `window`
    bars on BOTH sides, so only bars up to len-1-window can be swings (no look-ahead)."""
    hi = df["high"].to_numpy(dtype=float)
    lo = df["low"].to_numpy(dtype=float)
    highs, lows = [], []
    for i in range(window, len(hi) - window):
        if hi[i] == hi[i - window:i + window + 1].max():
            highs.append((i, float(hi[i])))
        if lo[i] == lo[i - window:i + window + 1].min():
            lows.append((i, float(lo[i])))

    def collapse(points, keep_high):
        """Equal/adjacent extremes (a plateau) are ONE swing, not two - otherwise a flat top
        reads as 'neither higher nor lower' and hides the real structure."""
        out = []
        for p in points:
            if out and p[0] - out[-1][0] <= window:
                better = p[1] > out[-1][1] if keep_high else p[1] < out[-1][1]
                if better:
                    out[-1] = p
            else:
                out.append(p)
        return out
    return collapse(highs, True), collapse(lows, False)


def _bar(df, k=-1):
    r = df.iloc[k]
    return float(r["open"]), float(r["high"]), float(r["low"]), float(r["close"])


def _atr_ok(ctx):
    a = (ctx or {}).get("atr")
    return a if (a is not None and a == a and a > 0) else None


# --------------------------------------------------------------- strategies
def trend_following(df, ctx):
    n = "trend_following"
    atr = _atr_ok(ctx)
    if atr is None or len(df) < 60:
        return _none(n, "Not enough data/ATR", ctx)
    e20, e50 = _ema(df, 20), _ema(df, 50)
    close = float(df["close"].iloc[-1])
    slope = float(e20.iloc[-1] - e20.iloc[-6])
    adx = ctx.get("adx")
    up = e20.iloc[-1] > e50.iloc[-1] and close > e50.iloc[-1] and slope > 0
    dn = e20.iloc[-1] < e50.iloc[-1] and close < e50.iloc[-1] and slope < 0
    if not (up or dn):
        return _none(n, "EMA20/EMA50 not stacked with slope - no trend", ctx)
    if adx is not None and adx < 20:
        return _none(n, f"ADX {adx:.0f} < 20 - trend too weak", ctx)
    side = BUY if up else SELL
    ext = abs(close - float(e20.iloc[-1])) / atr
    st = ctx.get("structure_bias")
    agrees = (st == "BULL" and up) or (st == "BEAR" and dn)
    score = 55 + (min(25, max(0, (adx or 20) - 20)) if adx else 5) + (12 if agrees else 0)
    if ext > 2.5:
        return _ev(n, side, score - 25, f"Trend {side} but price is {ext:.1f} ATR from EMA20 - extended, do not chase", False, ctx)
    return _ev(n, side, score, f"EMA20/50 stacked {side}" + (f", ADX {adx:.0f}" if adx else "")
               + (", structure agrees" if agrees else ""), True, ctx)


def breakout(df, ctx, lookback=20):
    n = "breakout"
    atr = _atr_ok(ctx)
    if atr is None or len(df) < lookback + 3:
        return _none(n, "Not enough data/ATR", ctx)
    prior = df.iloc[-(lookback + 1):-1]
    res, sup = float(prior["high"].max()), float(prior["low"].min())
    o, h, l, c = _bar(df)
    rng = max(h - l, 1e-12)
    body = abs(c - o) / rng
    st = ctx.get("structure_bias")
    # --- bullish
    if h > res:
        if c <= res:
            return _ev(n, NONE, 0, f"Wick above {res:g} but candle closed back under - NOT a confirmed breakout", False, ctx)
        confirmed = (c - res) >= 0.1 * atr and body >= 0.5 and (c - l) / rng >= 0.7
        late = (c - res) > 1.5 * atr
        if st == "BEAR":
            return _ev(n, BUY, 35, f"Close above {res:g} but structure is bearish", False, ctx)
        if not confirmed:
            return _ev(n, BUY, 40, f"Close above {res:g} lacks momentum (weak body/close)", False, ctx)
        if late:
            return _ev(n, BUY, 45, f"Breakout already {(c - res) / atr:.1f} ATR extended - late", False, ctx)
        return _ev(n, BUY, 70 + (10 if st == "BULL" else 0), f"Closed above {lookback}-bar high {res:g} with momentum", True, ctx)
    # --- bearish
    if l < sup:
        if c >= sup:
            return _ev(n, NONE, 0, f"Wick below {sup:g} but candle closed back above - NOT a confirmed breakdown", False, ctx)
        confirmed = (sup - c) >= 0.1 * atr and body >= 0.5 and (h - c) / rng >= 0.7
        late = (sup - c) > 1.5 * atr
        if st == "BULL":
            return _ev(n, SELL, 35, f"Close below {sup:g} but structure is bullish", False, ctx)
        if not confirmed:
            return _ev(n, SELL, 40, f"Close below {sup:g} lacks momentum (weak body/close)", False, ctx)
        if late:
            return _ev(n, SELL, 45, f"Breakdown already {(sup - c) / atr:.1f} ATR extended - late", False, ctx)
        return _ev(n, SELL, 70 + (10 if st == "BEAR" else 0), f"Closed below {lookback}-bar low {sup:g} with momentum", True, ctx)
    return _none(n, "No break of the recent range", ctx)


def pullback(df, ctx):
    n = "pullback"
    atr = _atr_ok(ctx)
    if atr is None or len(df) < 60:
        return _none(n, "Not enough data/ATR", ctx)
    e20, e50 = _ema(df, 20), _ema(df, 50)
    up = e20.iloc[-1] > e50.iloc[-1] and e50.iloc[-1] > e50.iloc[-6]
    dn = e20.iloc[-1] < e50.iloc[-1] and e50.iloc[-1] < e50.iloc[-6]
    if not (up or dn):
        return _none(n, "No established trend to pull back within", ctx)
    st = ctx.get("structure_bias")
    rsi = _rsi_last(df)
    o, h, l, c = _bar(df)
    po, ph, pl, pc = _bar(df, -2)
    recent = df.iloc[-6:-1]
    if up:
        if st == "BEAR":
            return _none(n, "Uptrend EMAs but bearish structure - skip", ctx)
        touched = float(recent["low"].min()) <= float(e20.iloc[-1]) + 0.25 * atr
        dipped = float(recent["close"].min()) < float(recent["close"].max()) - 0.4 * atr
        confirm = c > o and c > float(e20.iloc[-1]) and (c > ph or (c > po and pc < po))
        if not (touched and dipped):
            return _none(n, "No real pullback into EMA20/support yet", ctx)
        if not confirm:
            return _ev(n, BUY, 40, "Price touched the EMA but there is no bullish confirmation candle", False, ctx)
        if rsi is not None and rsi > 75:
            return _ev(n, BUY, 40, f"Pullback confirmed but RSI {rsi:.0f} is stretched", False, ctx)
        return _ev(n, BUY, 68 + (8 if st == "BULL" else 0), "Uptrend pullback to EMA20 with bullish confirmation candle", True, ctx)
    if st == "BULL":
        return _none(n, "Downtrend EMAs but bullish structure - skip", ctx)
    touched = float(recent["high"].max()) >= float(e20.iloc[-1]) - 0.25 * atr
    rallied = float(recent["close"].max()) > float(recent["close"].min()) + 0.4 * atr
    confirm = c < o and c < float(e20.iloc[-1]) and (c < pl or (c < po and pc > po))
    if not (touched and rallied):
        return _none(n, "No real rally into EMA20/resistance yet", ctx)
    if not confirm:
        return _ev(n, SELL, 40, "Price touched the EMA but there is no bearish confirmation candle", False, ctx)
    if rsi is not None and rsi < 25:
        return _ev(n, SELL, 40, f"Pullback confirmed but RSI {rsi:.0f} is stretched", False, ctx)
    return _ev(n, SELL, 68 + (8 if st == "BEAR" else 0), "Downtrend rally to EMA20 with bearish confirmation candle", True, ctx)


def mean_reversion(df, ctx, lookback=30):
    n = "mean_reversion"
    atr = _atr_ok(ctx)
    adx = ctx.get("adx")
    if atr is None or len(df) < lookback + 2:
        return _none(n, "Not enough data/ATR", ctx)
    if adx is not None and adx >= 25:
        return _none(n, f"ADX {adx:.0f} >= 25 - strong trend, mean reversion disabled", ctx)
    win = df.iloc[-lookback - 1:-1]
    lo, hi = float(win["low"].min()), float(win["high"].max())
    rng = hi - lo
    if rng < 1.5 * atr:
        return _none(n, "Range too narrow relative to ATR", ctx)
    o, h, l, c = _bar(df)
    candle_rng = max(h - l, 1e-12)
    rsi = _rsi_last(df)
    pos = (c - lo) / rng
    if pos <= 0.2 and c > o and (min(o, c) - l) / candle_rng >= 0.3 and (rsi is None or rsi < 45):
        return _ev(n, BUY, 66, f"Range low ({lo:g}) rejection with bullish close", True, ctx)
    if pos >= 0.8 and c < o and (h - max(o, c)) / candle_rng >= 0.3 and (rsi is None or rsi > 55):
        return _ev(n, SELL, 66, f"Range high ({hi:g}) rejection with bearish close", True, ctx)
    if pos <= 0.2 or pos >= 0.8:
        return _ev(n, BUY if pos <= 0.2 else SELL, 35, "At the range edge but no rejection confirmation yet", False, ctx)
    return _none(n, "Price is mid-range - nothing to fade", ctx)


def momentum(df, ctx):
    n = "momentum"
    if len(df) < 40:
        return _none(n, "Not enough data", ctx)
    h = _macd_hist(df)
    rsi = _rsi_last(df)
    e20 = float(_ema(df, 20).iloc[-1])
    c = float(df["close"].iloc[-1])
    rising, falling = h.iloc[-1] > h.iloc[-2] > h.iloc[-3], h.iloc[-1] < h.iloc[-2] < h.iloc[-3]
    if h.iloc[-1] > 0 and rising and c > e20 and rsi is not None and 50 <= rsi <= 72:
        return _ev(n, BUY, 62 + min(15, abs(float(h.iloc[-1] - h.iloc[-3])) * 0 + (rsi - 50)), f"MACD histogram rising above 0, RSI {rsi:.0f}, above EMA20", True, ctx)
    if h.iloc[-1] < 0 and falling and c < e20 and rsi is not None and 28 <= rsi <= 50:
        return _ev(n, SELL, 62 + min(15, 50 - rsi), f"MACD histogram falling below 0, RSI {rsi:.0f}, below EMA20", True, ctx)
    return _none(n, "Momentum not aligned (MACD/RSI/EMA20 disagree)", ctx)


def support_resistance(df, ctx):
    n = "support_resistance"
    atr = _atr_ok(ctx)
    sup, res = ctx.get("support"), ctx.get("resistance")
    price = float(df["close"].iloc[-1]) if len(df) else None
    if atr is None or not price:
        return _none(n, "Not enough data/ATR", ctx)

    def real(level):  # find_support_resistance() returns price*0.98 / *1.02 when it finds no swing
        return level is not None and abs(level - price * 1.02) > price * 1e-9 and abs(level - price * 0.98) > price * 1e-9

    o, h, l, c = _bar(df)
    rng = max(h - l, 1e-12)
    if real(sup) and abs(price - sup) <= 0.6 * atr:
        if c > o and (min(o, c) - l) / rng >= 0.35:
            return _ev(n, BUY, 66, f"Bullish rejection at support {sup:g}", True, ctx)
        return _ev(n, BUY, 35, f"Near support {sup:g} but no rejection candle", False, ctx)
    if real(res) and abs(res - price) <= 0.6 * atr:
        if c < o and (h - max(o, c)) / rng >= 0.35:
            return _ev(n, SELL, 66, f"Bearish rejection at resistance {res:g}", True, ctx)
        return _ev(n, SELL, 35, f"Near resistance {res:g} but no rejection candle", False, ctx)
    return _none(n, "Price is not at a real support/resistance level", ctx)


def market_structure(df, ctx):
    n = "market_structure"
    if len(df) < 20:
        return _none(n, "Not enough data", ctx)
    highs, lows = swing_points(df, 3)
    if len(highs) < 2 or len(lows) < 2:
        return _none(n, "No clear swing structure", ctx)
    c = float(df["close"].iloc[-1])
    hh, hl = highs[-1][1] > highs[-2][1], lows[-1][1] > lows[-2][1]
    lh, ll = highs[-1][1] < highs[-2][1], lows[-1][1] < lows[-2][1]
    if hh and hl:
        if c < lows[-1][1]:
            return _ev(n, SELL, 55, f"Structure was HH/HL but close broke the last higher low {lows[-1][1]:g} - possible reversal", False, ctx)
        bos = c > highs[-1][1]
        return _ev(n, BUY, 78 if bos else 66, "HH + HL" + (f", close broke the last swing high {highs[-1][1]:g}" if bos else ""), True, ctx)
    if lh and ll:
        if c > highs[-1][1]:
            return _ev(n, BUY, 55, f"Structure was LH/LL but close broke the last lower high {highs[-1][1]:g} - possible reversal", False, ctx)
        bos = c < lows[-1][1]
        return _ev(n, SELL, 78 if bos else 66, "LH + LL" + (f", close broke the last swing low {lows[-1][1]:g}" if bos else ""), True, ctx)
    return _none(n, "Mixed swings - range / no structural edge", ctx)


def news_event(news, recent_bars, atr, tf_seconds, now_utc=None, bar_utc_offset_hours=0.0):
    """Pre-news: event risk, no direction (the Signal Quality Gate decides WAIT).
    Post-news: the PRICE reaction on CLOSED candles since the release. The free
    calendar feed carries no Actual value, so the 'surprise' (Actual vs Forecast)
    is NOT used - and is never invented. recent_bars = [(bar_open_iso, close), ...]."""
    n = "news_event"
    ctx = {"tf": None}
    if not news or news.get("level") in (None, "LOW"):
        return _none(n, "No relevant high/medium-impact event in the window", ctx)
    mins = news.get("minutes_to_event")
    detail = news.get("detail") or "event"
    if mins is None or mins >= 0:
        return _ev(n, NONE, 0, f"Event risk ahead: {detail}", False, ctx)
    # released: measure price reaction since the event
    if not recent_bars or atr is None or not (atr > 0) or not tf_seconds:
        return _ev(n, NONE, 0, f"Released: {detail}; reaction unavailable (no data)", False, ctx)
    from datetime import datetime, timedelta
    now = now_utc or datetime.utcnow()
    event_t = now + timedelta(minutes=mins)
    pre, post = None, None
    for iso, close in recent_bars:
        try:
            t = pd.Timestamp(iso).to_pydatetime() - timedelta(hours=bar_utc_offset_hours)
        except Exception:
            continue
        if t + timedelta(seconds=tf_seconds) <= event_t:
            pre = close            # last bar CLOSED before the release
        else:
            post = close
    if pre is None or post is None:
        return _ev(n, NONE, 0, f"Released: {detail}; no closed candle after the release yet", False, ctx)
    mv = (post - pre) / atr
    if abs(mv) < 1.0:
        return _ev(n, NONE, 0, f"Released: {detail}; reaction {mv:+.1f} ATR - not decisive", False, ctx)
    side = BUY if mv > 0 else SELL
    return _ev(n, side, 55 + min(20, abs(mv) * 8), f"Released: {detail}; price reacted {mv:+.1f} ATR (price only, Actual value not used)", True, ctx)


_PRICE_STRATS = {"trend_following": trend_following, "breakout": breakout, "pullback": pullback,
                 "mean_reversion": mean_reversion, "momentum": momentum,
                 "support_resistance": support_resistance, "market_structure": market_structure}


def evaluate_all(df, ctx):
    """Run the 7 price-based strategies on CLOSED candles and mark each active/inactive
    for the current regime. (news_event is added by the caller, which owns the news data.)"""
    ctx = ctx or {}
    regime = ((ctx.get("regime") or {}).get("regime")) or "UNKNOWN"
    active = REGIME_ACTIVE.get(regime, set())
    out = []
    for name in STRATEGY_NAMES:
        fn = _PRICE_STRATS.get(name)
        if fn is None:
            continue
        try:
            e = fn(df, ctx)
        except Exception as ex:  # a broken strategy must never break the signal
            e = _none(name, f"error: {type(ex).__name__}", ctx)
        e["active"] = name in active
        out.append(e)
    return out


def regime_support(evidence, want_side, news_ev=None, min_score=60):
    """Summarise evidence for the direction the HTF model proposes. Suitability decides
    what counts - NOT a vote count: only strategies that are ACTIVE in this regime and
    VALID can support or oppose. Returns dict(support, oppose, supporters, opposers, active_valid)."""
    items = list(evidence or []) + ([news_ev] if news_ev else [])
    live = [e for e in items if e.get("active") and e.get("valid") and e.get("direction") in (BUY, SELL)]
    sup = [e for e in live if e["direction"] == want_side]
    opp = [e for e in live if e["direction"] != want_side]
    best = lambda xs: max(xs, key=lambda e: e["score"]) if xs else None
    bs, bo = best(sup), best(opp)
    return {"support": bs["score"] if bs else 0, "oppose": bo["score"] if bo else 0,
            "supporters": [e["strategy"] for e in sup], "opposers": [e["strategy"] for e in opp],
            "best_support": bs, "best_oppose": bo, "active_valid": len(live), "min_score": min_score}
'''
