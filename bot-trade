        text = f"⚙️ <b>ការកំណត់ហាង</b>\n\n🏪 {_h(shop['name'])}\n📝 {_h(shop.get('description') or '—')}"
        kb = InlineKeyboardMarkup([
            [InlineKeyboardButton("✏️ ឈ្មោះ", callback_data="mk_sf_name"),
             InlineKeyboardButton("📝 ពិពណ៌នា", callback_data="mk_sf_desc")],
            [InlineKeyboardButton("🖼️ Logo", callback_data="mk_sf_logo"),
             InlineKeyboardButton("🔙 Seller Center", callback_data="mk_sc")],
        ])
        await market_show(q, text, kb)
        return True

    if data.startswith("mk_sf_"):
        field = data[len("mk_sf_"):]
        shop = await db_get_shop_by_owner(uid, use_cache=False) if await market_shops_available() else None
        if not shop:
            await safe_alert(q, "❌ អ្នកមិនទាន់មានហាងទេ។")
            return True
        prompts = {
            "name": "✏️ វាយ <b>ឈ្មោះហាងថ្មី</b>៖",
            "desc": "📝 វាយ <b>ការពិពណ៌នាថ្មី</b> ឬចុចប៊ូតុងខាងក្រោមដើម្បីលុប៖",
            "logo": "🖼️ ផ្ញើ <b>រូប Logo ថ្មី</b>៖",
        }
        if field not in prompts:
            await safe_alert(q, "❌ ជម្រើសមិនត្រឹមត្រូវ។")
            return True
        clear_conversation_modes(ud)
        ud["store_state"] = "mk_shop_edit"
        ud["mk_temp"] = {"shop_edit": {"field": field}}
        save_data()
        kb = _mk_cancel_kb()
        if field == "desc":
            kb = InlineKeyboardMarkup([[InlineKeyboardButton("🗑️ លុបការពិពណ៌នា", callback_data="mk_sf_descclear")],
                                       [InlineKeyboardButton("❌ បោះបង់", callback_data="mk_cancel")]])
        await q.message.reply_text(prompts[field], parse_mode="HTML", reply_markup=kb)
        return True

    return False

