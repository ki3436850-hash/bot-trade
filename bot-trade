# NEW table (additive — run once in Supabase SQL Editor; referral tracking
# degrades to "no referral recorded" if not yet run, everything else in the
# bot keeps working):
#
#   CREATE TABLE IF NOT EXISTS referrals (
#       id BIGSERIAL PRIMARY KEY,
#       referrer_id TEXT NOT NULL,
#       referred_user_id TEXT UNIQUE NOT NULL,
#       created_at TIMESTAMPTZ DEFAULT now()
#   );
#
# The referral code IS the referrer's own Telegram user ID (no separate
# short-code table needed) — link is https://t.me/<bot>?start=ref_<user_id>.
# Funnel stages (Registered/Profile Created/Applied) are computed by joining
# the referred-user list against tables that already exist (candidate_profiles,
# orders) rather than logging separate funnel events, per the master prompt's
# "reuse existing infra" instruction. NOT tracked (would need a landing page,
# not just a bot): raw link clicks before /start, and per-channel source
# (Telegram/Facebook/TikTok/QR) — every referral here is attributed only to
# the referrer, not to a specific channel.
async def db_record_referral(referrer_id, referred_user_id):
    if str(referrer_id) == str(referred_user_id):
        return  # ការពារ Self-Referral
    def _run():
        return supabase.table("referrals").insert(
            {"referrer_id": str(referrer_id), "referred_user_id": str(referred_user_id)}).execute()
    try:
        await _sb_call(_run)
    except Exception as e:
        if "duplicate" not in str(e).lower():
            logger.warning(f"db_record_referral failed: {e}")

async def db_get_referrals(referrer_id):
    def _run():
        return supabase.table("referrals").select("referred_user_id") \
            .eq("referrer_id", str(referrer_id)).execute()
    try:
        res = await _sb_call(_run)
        return [r["referred_user_id"] for r in (res.data or [])]
    except Exception as e:
        logger.warning(f"db_get_referrals failed: {e}")
        return []

