def ea_technical_readout(symbol, df, tf):
    """Shared raw-indicator readout (bias/EMA/MACD/ATR/Bollinger/Stochastic/
    Support&Resistance) computed off one OHLC frame. Factored out of Live
    Chart so the new unified Signal Output's 'Technical Confirmation' section
    (used by Signals/Analysis) reads the exact same numbers, off the exact
    same indicator functions, as Live Chart already does — no second/duplicate
    indicator engine (spec: 'do not create duplicate indicator calculations')."""
    bias = ea_analyze_timeframe_bias(df, tf)
    price = df["close"].iloc[-1]
    ema20 = calculate_ema(df, 20)
    ema50 = calculate_ema(df, 50)
    macd_line, signal_line, _hist = calculate_macd(df)
    atr = calculate_atr(df)
    bb_upper, bb_mid, bb_lower = calculate_bollinger(df)
    stoch_k, stoch_d = calculate_stochastic(df)
    support, resistance = find_support_resistance(df)
    return {
        "symbol": symbol, "tf": tf, "price": price, "bias": bias,
        "ema20": ema20, "ema50": ema50,
        "macd_bullish": macd_line > signal_line,
        "atr": atr, "bb_upper": bb_upper, "bb_mid": bb_mid, "bb_lower": bb_lower,
        "stoch_k": stoch_k, "stoch_d": stoch_d,
        "support": support, "resistance": resistance,
    }

async def ea_build_live_chart(symbol, tf, risk=None):
    """Returns (dashboard_dict, providers_tried) on success, or (None,
    providers_tried) if there isn't enough real market data to report on."""
    risk = risk or {}
    df, providers_tried = await ea_get_ohlc(symbol, tf, outputsize="200")
    if df is None or len(df) < 30:
        return None, providers_tried

    tech = ea_technical_readout(symbol, df, tf)

    # Chart image and AI vision are both additive and best-effort — neither
    # blocks the technical dashboard if it fails or is disabled (spec: "AI
    # failure does not break technical analysis", "never generate fake data").
    try:
        chart_bytes = await fetch_chart_image(symbol, tf)
    except Exception as e:
        logger.warning(f"Live Chart image fetch failed for {symbol} {tf}: {e}")
        chart_bytes = None

    vision = None
    if risk.get("chart_vision_enabled", False):
        try:
            vision = await ea_chart_vision_bias(symbol, tf)
        except Exception as e:
            logger.info(f"Live Chart AI vision skipped for {symbol} {tf} (non-blocking): {e}")
            vision = None

    return {
        **tech,
        "chart_bytes": chart_bytes, "vision": vision,
        "data_source": providers_tried[-1] if providers_tried else "N/A",
        "updated_at": datetime.now().strftime("%H:%M:%S"),
    }, providers_tried

