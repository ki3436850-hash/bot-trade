        return "\n".join(lines)
    lines += [
        f"Total Trades: {stats['total_trades']}",
        f"Wins: {stats['wins']}  |  Losses: {stats['losses']}  |  Breakeven: {stats['breakeven']}",
        f"Win Rate: {stats['win_rate']}%",
        f"Avg R:R (realized): {stats['avg_rr'] if stats['avg_rr'] is not None else '—'}",
        f"Profit Factor: {stats['profit_factor'] if stats['profit_factor'] is not None else '∞'}",
        f"Expectancy/trade: {stats['expectancy']}",
