async def db_update_order_status(order_id, new_status, expected_status):
    """Atomic conditional update at the database level: only succeeds if the
    order is still in expected_status. This is what makes it safe for two
    admins/sellers to click competing buttons at the same time — whichever
    request reaches Postgres first wins, and the second gets back no row."""
    def _run():
        res = supabase.table("orders").update({"status": new_status}) \
            .eq("id", int(order_id)).eq("status", expected_status).execute()
        return res.data[0] if res.data else None
    try:
        return await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_update_order_status failed: {e}")
        return None

