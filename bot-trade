async def safe_alert(q, text, show_alert=True):
    """បង្ហាញសារ Alert (Popup) លើ Callback Query។ បើការឆ្លើយតបនេះបរាជ័យ
    ដោយហេតុផលណាមួយ (ឧ. Callback ចាស់ពេក ឬ Query លែងត្រឹមត្រូវ) យើងផ្ញើជា
    សារធម្មតាទៅវិញ ដើម្បីធានាថា User តែងតែទទួលបានចម្លើយ មិនថាករណីណាក៏ដោយ
    (ឧ. XP មិនគ្រប់, Link ខុស ។ល។)"""
    try:
        await q.answer(text, show_alert=show_alert)
        return
    except Exception as e:
        logger.warning(f"q.answer() failed (likely already answered), falling back to message: {e}")
    try:
        await q.message.reply_text(text)
    except Exception as e2:
        logger.warning(f"Fallback reply_text also failed: {e2}")

