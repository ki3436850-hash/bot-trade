        updated = await db_update_category(key, label=text[:80])
        ud["cat_admin_state"] = None
        ud["cat_admin_temp"] = {}
        save_data()
        if updated is not None:
            await update.message.reply_text(f"✅ បានប្តូរឈ្មោះទៅជា *{text[:80]}* រួចរាល់។", parse_mode="Markdown")
        else:
            await update.message.reply_text("❌ មិនអាចប្តូរបានទេ សូមសាកល្បងម្តងទៀត។")
        await update.message.reply_text(
            "🗂️ *គ្រប់គ្រងប្រភេទទំនិញ (Categories)*",
            parse_mode="Markdown", reply_markup=await category_admin_list_keyboard())
