async def db_get_active_order(listing_id, buyer_id):
    """ត្រឡប់ Order ណាដែលកំពុង Active (pending/confirmed) របស់ Buyer ម្នាក់នេះលើ Listing នេះ
    បើមាន — ការពារកុំឲ្យ Buyer ម្នាក់បង្កើត Order ជាច្រើនស្ទួនគ្នាលើទំនិញតែមួយ។ (Best-effort at the
    application level — for full race-condition safety, add a Postgres partial unique index:
    CREATE UNIQUE INDEX ON orders (listing_id, buyer_id) WHERE status IN ('pending','confirmed');)"""
    def _run():
        res = supabase.table("orders").select("*") \
            .eq("listing_id", int(listing_id)).eq("buyer_id", str(buyer_id)) \
            .in_("status", ["pending", "confirmed"]).limit(1).execute()
        return res.data[0] if res.data else None
    try:
        return await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_get_active_order failed: {e}")
