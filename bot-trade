     "pages": [
  {"image": "", "text": "១. វិភាគដីមុនដាំ៖ ត្រូវយកគំរូដីទៅវិភាគឲ្យបានទៀងទាត់ ដើម្បីដឹងពីកម្រិត pH សារធាតុចិញ្ចឹម និងសារធាតុសរីរាង្គក្នុងដី។ ការវិភាគដីជួយឲ្យយើងដឹងថាត្រូវបន្ថែមជីប្រភេទណា និងប៉ុន្មាន ដើម្បីឲ្យដីមានជីជាតិល្អបំផុតសម្រាប់ដំណាំនីមួយៗ។"},

  {"image": "", "text": "២. បង្ហូរទឹកឲ្យបានល្អ៖ ត្រូវរៀបចំប្រព័ន្ធលូបង្ហូរទឹកឲ្យបានត្រឹមត្រូវ ដើម្បីការពារកុំឲ្យទឹកជន់លិចឫសរុក្ខជាតិ។ ទឹកឈរយូរអាចបណ្តាលឲ្យឫសរលួយ និងកើតជំងឺផ្សិត។ គួរជីកប្រឡាយបង្ហូរទឹកជុំវិញចម្ការ ឬប្រើប្រព័ន្ធលូក្រោមដីសម្រាប់កសិដ្ឋានធំៗ។"},

  {"image": "", "text": "៣. ប្រើប្រាស់ជីសរីរាង្គ៖ ជីសរីរាង្គដូចជា លាមកសត្វ ជីកំប៉ុស និងជីបៃតង ជួយបង្កើនជីជាតិដី និងធ្វើឲ្យដីរលុង។ ជីសរីរាង្គក៏ជួយរក្សាសំណើមដី និងជំរុញការលូតលាស់របស់មីក្រុបដែលមានប្រយោជន៍ក្នុងដីផងដែរ។"},

  {"image": "", "text": "៤. ប្រើជីគីមីឲ្យបានត្រឹមត្រូវ៖ ត្រូវប្រើជីគីមីតាមកម្រិតដែលបានណែនាំ និងតាមប្រភេទដំណាំ។ ការប្រើជីច្រើនពេកអាចបង្កគ្រោះថ្នាក់ដល់ដំណាំ បំពុលដី និងទឹកក្រោមដី។ គួរលាយជីគីមីជាមួយជីសរីរាង្គដើម្បីបង្កើនប្រសិទ្ធភាព។"},

  {"image": "", "text": "៥. បង្វិលដំណាំ៖ ការបង្វិលដំណាំជួយការពារការថយចុះជីជាតិដី កាត់បន្ថយសត្វល្អិត និងជំងឺដំណាំ។ គួរដាំដំណាំពីរប្រភេទផ្សេងគ្នាឆ្លាស់គ្នាតាមរដូវ ដើម្បីឲ្យដីមានពេលសម្រាក និងងើបឡើងវិញ។"},

  {"image": "", "text": "៦. ដាំដំណាំគម្របដី៖ ដំណាំគម្របដីដូចជា សណ្តែក ឬស្មៅ ជួយការពារសំណឹកដី រក្សាសំណើម និងបន្ថែមសារធាតុសរីរាង្គដល់ដី។ វាក៏ជួយទប់ស្កាត់ស្មៅដុះផងដែរ។"},

  {"image": "", "text": "៧. ស្រោចទឹកឲ្យបានត្រឹមត្រូវ៖ ត្រូវស្រោចទឹកឲ្យបានគ្រប់គ្រាន់ និងទាន់ពេលវេលា ជាពិសេសក្នុងរដូវប្រាំង។ គួរស្រោចទឹកពេលព្រឹកព្រលឹម ឬល្ងាច ដើម្បីកាត់បន្ថយការហួត។ ប្រើប្រព័ន្ធស្រោចទឹកដោយស្វ័យប្រវត្តិ ឬប្រព័ន្ធដំណក់ទឹកដើម្បីសន្សំសំចៃទឹក។"},

  {"image": "", "text": "៨. ការពារសត្វល្អិតចង្រៃ៖ ត្រូវតាមដានចម្ការជាប្រចាំ ដើម្បីរកឃើញសត្វល្អិតចង្រៃទាន់ពេល។ ប្រើវិធីសាស្ត្រជីវសាស្ត្រ ដូចជា ការចិញ្ចឹមសត្វខ្មាំងសត្រូវ ឬប្រើថ្នាំសម្លាប់សត្វល្អិតធម្មជាតិ មុននឹងប្រើថ្នាំគីមី។"},

  {"image": "", "text": "៩. កាត់ចេញមែកឈើឲ្យបានត្រឹមត្រូវ៖ ការកាត់ចេញមែកឈើដែលស្ងួត ឬឈឺ ជួយឲ្យដើមឈើមានខ្យល់ចេញចូលបានល្អ និងកាត់បន្ថយជំងឺ។ ការកាត់ចេញក៏ជួយជំរុញការលូតលាស់ថ្មី និងបង្កើនទិន្នផលផងដែរ។"},

  {"image": "", "text": "១០. ធ្វើស្មៅឲ្យបានទៀងទាត់៖ ស្មៅប្រកួតប្រជែងយកសារធាតុចិញ្ចឹម និងទឹកពីដំណាំ។ ត្រូវធ្វើស្មៅឲ្យបានទៀងទាត់ ជាពិសេសក្នុងដំណាក់កាលដំបូងនៃការលូតលាស់ដំណាំ។ អាចប្រើកម្រាលគ្របដីដើម្បីទប់ស្កាត់ស្មៅ។"},

  {"image": "", "text": "១១. ប្រើប្រាស់ទឹកភ្លៀងប្រកបដោយប្រសិទ្ធភាព៖ ត្រូវស្តុកទឹកភ្លៀងក្នុងអាង ឬស្រះ សម្រាប់ប្រើប្រាស់ក្នុងរដូវប្រាំង។ ការប្រើប្រាស់ទឹកភ្លៀងជួយសន្សំសំចៃថ្លៃទឹក និងការពារបរិស្ថាន។"},

  {"image": "", "text": "១២. ថែទាំប្រព័ន្ធធារាសាស្ត្រ៖ ត្រូវពិនិត្យប្រព័ន្ធធារាសាស្ត្រឲ្យបានទៀងទាត់ ដើម្បីរកមើលការលេចធ្លាយ ឬស្ទះ។ ជួសជុលបំពង់ទឹក និងក្បាលបាញ់ទឹកដែលខូចឲ្យបានទាន់ពេលវេលា។"},

  {"image": "", "text": "១៣. ប្រើប្រាស់ជីវៈជំនួយដំណាំ៖ ជីវៈដូចជា បាក់តេរី និងផ្សិតមានប្រយោជន៍ ជួយបង្កើនការស្រូបយកសារធាតុចិញ្ចឹមរបស់រុក្ខជាតិ។ វាក៏ជួយទប់ស្កាត់ជំងឺដំណាំផងដែរ។"},

  {"image": "", "text": "១៤. ការពារដំណាំពីអាកាសធាតុធ្ងន់ធ្ងរ៖ ត្រូវរៀបចំផែនការការពារដំណាំពីព្យុះ ទឹកជំនន់ និងគ្រោះរាំងស្ងួត។ អាចប្រើស្រោមគ្របដំណាំ ឬដាំដើមឈើបង្ការខ្យល់។"},

  {"image": "", "text": "១៥. ធ្វើកំណត់ត្រាកសិដ្ឋាន៖ ត្រូវកត់ត្រារាល់សកម្មភាពក្នុងកសិដ្ឋាន ដូចជា កាលបរិច្ឆេទដាំ ការប្រើជី ការស្រោចទឹក និងទិន្នផល។ កំណត់ត្រាទាំងនេះជួយវាយតម្លៃប្រសិទ្ធភាព និងរៀបចំផែនការអនាគត។"},

  {"image": "", "text": "១៦. ជ្រើសរើសពូជដំណាំដែលសមស្របនឹងតំបន់៖ ត្រូវជ្រើសរើសពូជដំណាំដែលសម្របខ្លួនបានល្អទៅនឹងអាកាសធាតុ និងដីក្នុងតំបន់។ ពូជដែលសមស្របនឹងផ្តល់ទិន្នផលខ្ពស់ និងធន់នឹងជំងឺ។"},

  {"image": "", "text": "១៧. ប្រើគ្រាប់ពូជដែលមានគុណភាព៖ ត្រូវទិញគ្រាប់ពូជពីប្រភពដែលទុកចិត្តបាន មានស្លាកយីហោ និងកាលបរិច្ឆេទផុតកំណត់ច្បាស់លាស់។ គ្រាប់ពូជល្អផ្តល់ដំណុះខ្ពស់ និងដំណាំរឹងមាំ។"},

  {"image": "", "text": "១៨. ដាំតាមរដូវកាល៖ ត្រូវដាំដំណាំតាមរដូវកាលសមស្រប ដើម្បីឲ្យដំណាំលូតលាស់បានល្អ និងជៀសវាងបញ្ហាអាកាសធាតុ។ ការដាំក្រៅរដូវអាចត្រូវការការថែទាំពិសេស។"},

  {"image": "", "text": "១៩. ប្រើបច្ចេកទេសដាំសន្សំសំចៃទឹក៖ ដូចជា ការដាំលើដីខ្ពស់ ឬប្រើប្រព័ន្ធដំណក់ទឹក ដើម្បីសន្សំសំចៃទឹក និងបង្កើនប្រសិទ្ធភាពស្រោចស្រព។"},

  {"image": "", "text": "២០. បង្កើនជីជាតិដីដោយប្រើដំណាំបង្កបង្កើនជីជាតិ៖ ដំណាំដូចជា សណ្តែក និងម្ទេសបារាំង អាចចាប់យកអាសូតពីបរិយាកាស និងបន្ថែមវាទៅក្នុងដី ជួយបង្កើនជីជាតិដីដោយធម្មជាតិ។"},

  {"image": "", "text": "២១. គ្រប់គ្រងស្មៅដោយប្រើកម្រាលគ្របដី៖ កម្រាលគ្របដីដូចជា ចំបើង ឬប្លាស្ទិក ជួយទប់ស្កាត់ស្មៅ រក្សាសំណើមដី និងការពារសំណឹកដី។"},

  {"image": "", "text": "២២. បង្កើនជីវៈចម្រុះក្នុងដី៖ ត្រូវបន្ថែមសារធាតុសរីរាង្គទៅក្នុងដី ដើម្បីជំរុញការលូតលាស់របស់មីក្រុប និងបង្កើនជីវៈចម្រុះក្នុងដី ដែលជួយឲ្យដីមានសុខភាពល្អ។"},

  {"image": "", "text": "២៣. ធ្វើតេស្តដីរៀងរាល់ឆ្នាំ៖ ត្រូវធ្វើតេស្តដីយ៉ាងហោចណាស់ម្តងក្នុងមួយឆ្នាំ ដើម្បីតាមដានការប្រែប្រួលនៃជីជាតិដី និងកែសម្រួលការប្រើជីឲ្យបានសមស្រប។"},

  {"image": "", "text": "២៤. ប្រើថ្នាំសម្លាប់សត្វល្អិតតាមការណែនាំ៖ ត្រូវប្រើថ្នាំសម្លាប់សត្វល្អិតតាមកម្រិតដែលបានណែនាំ និងពេលវេលាសមស្រប ដើម្បីការពារសុខភាពមនុស្ស និងបរិស្ថាន។"},

  {"image": "", "text": "២៥. បង្កើតប្រព័ន្ធព្រមានជំងឺដំណាំ៖ ត្រូវតាមដានចម្ការជាប្រចាំ និងបង្កើតប្រព័ន្ធព្រមានជំងឺដំណាំ ដើម្បីអាចចាត់វិធានការបានទាន់ពេលវេលា។"},

  {"image": "", "text": "២៦. ប្រមូលផលឲ្យបានត្រឹមត្រូវ៖ ត្រូវប្រមូលផលនៅពេលដំណាំទុំពេញលេញ ដើម្បីឲ្យផលិតផលមានគុណភាពល្អ និងរក្សាទុកបានយូរ។ ការប្រមូលផលមុនពេល ឬក្រោយពេលអាចប៉ះពាល់ដល់គុណភាព។"},

  {"image": "", "text": "២៧. រក្សាទុកផលិតផលក្រោយប្រមូលផល៖ ត្រូវរក្សាទុកផលិតផលក្នុងកន្លែងស្ងួត មានខ្យល់ចេញចូល និងការពារពីសត្វល្អិត និងជំងឺ។ ការរក្សាទុកបានល្អជួយកាត់បន្ថយការខូចខាតក្រោយប្រមូលផល។"},

  {"image": "", "text": "២៨. លាងសម្អាតឧបករណ៍កសិកម្ម៖ ត្រូវលាងសម្អាតឧបករណ៍កសិកម្មឲ្យបានទៀងទាត់ ដើម្បីការពារការចម្លងជំងឺពីដំណាំមួយទៅដំណាំមួយទៀត។"},

  {"image": "", "text": "២៩. ប្រើបច្ចេកទេសដាំជាជួរ៖ ការដាំជាជួរជួយឲ្យដំណាំមានខ្យល់ចេញចូលបានល្អ កាត់បន្ថយជំងឺ និងងាយស្រួលក្នុងការថែទាំ និងប្រមូលផល។"},

  {"image": "", "text": "៣០. គ្រប់គ្រងសត្វល្អិតដោយប្រើអន្ទាក់៖ អន្ទាក់សត្វល្អិតដូចជា អន្ទាក់ពន្លឺ ឬអន្ទាក់ផេរ៉ូម៉ូន ជួយកាត់បន្ថយចំនួនសត្វល្អិតដោយមិនចាំបាច់ប្រើថ្នាំគីមី។"},

  {"image": "", "text": "៣១. ប្រើប្រាស់ទឹកឲ្យមានប្រសិទ្ធភាព៖ ត្រូវប្រើប្រព័ន្ធស្រោចទឹកដែលសន្សំសំចៃទឹក ដូចជា ប្រព័ន្ធដំណក់ទឹក ឬប្រព័ន្ធបាញ់ទឹកជាដំណក់តូចៗ ដើម្បីកាត់បន្ថយការហួត និងខ្ជះខ្ជាយទឹក។"},

  {"image": "", "text": "៣២. បង្កើនចំណេះដឹងអំពីកសិកម្ម៖ ត្រូវចូលរួមវគ្គបណ្តុះបណ្តាល អានសៀវភៅ និងស្រាវជ្រាវពីបច្ចេកទេសកសិកម្មថ្មីៗ ដើម្បីបង្កើនប្រសិទ្ធភាពក្នុងការថែទាំកសិដ្ឋាន។"},

  {"image": "", "text": "៣៣. ប្រើប្រាស់ថាមពលកកើតឡើងវិញ៖ ដូចជា ថាមពលព្រះអាទិត្យ ឬថាមពលខ្យល់ សម្រាប់បូមទឹក ឬប្រតិបត្តិការកសិដ្ឋាន ដើម្បីកាត់បន្ថយថ្លៃដើម និងការពារបរិស្ថាន។"},

  {"image": "", "text": "៣៤. រៀបចំផែនការដាំដំណាំឲ្យបានច្រើនប្រភេទ៖ ការដាំដំណាំច្រើនប្រភេទជួយកាត់បន្ថយហានិភ័យពីការប្រែប្រួលតម្លៃ និងអាកាសធាតុ និងបង្កើនប្រាក់ចំណូល។"},

  {"image": "", "text": "៣៥. ប្រើប្រាស់ជីកំប៉ុសពីសំណល់កសិដ្ឋាន៖ ត្រូវប្រមូលសំណល់ពីកសិដ្ឋាន ដូចជា ស្លឹកឈើ និងសំបកផ្លែឈើ មកធ្វើជីកំប៉ុស ដើម្បីបង្កើនជីជាតិដី និងកាត់បន្ថយសំរាម។"},

  {"image": "", "text": "៣៦. ការពារសត្វចិញ្ចឹមពីជំងឺ៖ ត្រូវចាក់វ៉ាក់សាំង និងពិនិត្យសុខភាពសត្វចិញ្ចឹមឲ្យបានទៀងទាត់ ដើម្បីការពារការរីករាលដាលនៃជំងឺនៅក្នុងកសិដ្ឋាន។"},

  {"image": "", "text": "៣៧. គ្រប់គ្រងកាកសំណល់កសិដ្ឋាន៖ ត្រូវរៀបចំប្រព័ន្ធគ្រប់គ្រងកាកសំណល់ឲ្យបានត្រឹមត្រូវ ដើម្បីការពារការបំពុលបរិស្ថាន និងប្រភពទឹក។"},

  {"image": "", "text": "៣៨. ប្រើប្រាស់ប្រព័ន្ធព័ត៌មានកសិកម្ម៖ ប្រើកម្មវិធី ឬឧបករណ៍ឌីជីថល ដើម្បីតាមដានការលូតលាស់ដំណាំ អាកាសធាតុ និងទីផ្សារ ដើម្បីធ្វើការសម្រេចចិត្តបានត្រឹមត្រូវ។"},

  {"image": "", "text": "៣៩. បង្កើតទំនាក់ទំនងជាមួយកសិករដទៃ៖ ការចែករំលែកបទពិសោធន៍ និងចំណេះដឹងជាមួយកសិករដទៃ ជួយបង្កើនជំនាញ និងស្វែងរកដំណោះស្រាយថ្មីៗសម្រាប់បញ្ហាកសិដ្ឋាន។"},

  {"image": "", "text": "៤០. ប្រើប្រាស់បច្ចេកវិទ្យាទំនើបក្នុងកសិកម្ម៖ ដូចជា យន្តហោះដ្រូន ឬឧបករណ៍ចាប់សញ្ញា ដើម្បីតាមដានសុខភាពដំណាំ និងដី បង្កើនប្រសិទ្ធភាពក្នុងការថែទាំ។"},

  {"image": "", "text": "៤១. ការពារដំណាំពីសត្វព្រៃ៖ ត្រូវរៀបចំរបង ឬប្រើវិធីសាស្ត្រផ្សេងទៀត ដើម្បីការពារដំណាំពីសត្វព្រៃដែលអាចបំផ្លាញដំណាំ។"},

  {"image": "", "text": "៤២. ធ្វើកសិកម្មបែបសរីរាង្គ៖ ការប្រើប្រាស់វិធីសាស្ត្រធម្មជាតិ ដោយគ្មានជីគីមី និងថ្នាំសម្លាប់សត្វល្អិត ជួយការពារបរិស្ថាន និងសុខភាពអ្នកប្រើប្រាស់។"},

  {"image": "", "text": "៤៣. ប្រើប្រាស់ទឹកឲ្យបានគ្រប់គ្រាន់សម្រាប់ដំណាំនីមួយៗ៖ ត្រូវដឹងពីតម្រូវការទឹករបស់ដំណាំនីមួយៗ ដើម្បីស្រោចទឹកឲ្យបានត្រឹមត្រូវ និងគ្រប់គ្រាន់ ជៀសវាងការស្រោចទឹកច្រើនពេក ឬតិចពេក។"},

  {"image": "", "text": "៤៤. បង្កើនជីជាតិដីដោយប្រើដីឥដ្ឋ ឬដីល្បាប់៖ ដីឥដ្ឋ និងដីល្បាប់ជួយបង្កើនសមត្ថភាពរក្សាទឹក និងសារធាតុចិញ្ចឹមក្នុងដី ធ្វើឲ្យដីមានជីជាតិល្អប្រសើរ។"},

  {"image": "", "text": "៤៥. រៀបចំផែនការប្រើប្រាស់ដីឲ្យបានត្រឹមត្រូវ៖ ត្រូវរៀបចំផែនការប្រើប្រាស់ដីឲ្យបានសមស្រប ដោយបែងចែកដីសម្រាប់ដំណាំផ្សេងៗ និងការបង្វិលដំណាំឲ្យបានត្រឹមត្រូវ។"},

  {"image": "", "text": "៤៦. ប្រើប្រាស់ថ្នាំសម្លាប់ស្មៅដោយប្រុងប្រយ័ត្ន៖ ត្រូវប្រើថ្នាំសម្លាប់ស្មៅតាមការណែនាំ និងពេលវេលាសមស្រប ដើម្បីការពារកុំឲ្យប៉ះពាល់ដល់ដំណាំ និងបរិស្ថាន។"},

  {"image": "", "text": "៤៧. បង្កើនផលិតភាពដំណាំដោយប្រើបច្ចេកទេសដាំថ្មីៗ៖ ដូចជា ការដាំក្នុងផ្ទះកញ្ចក់ ឬការប្រើប្រាស់ប្រព័ន្ធ Hydroponics ដើម្បីបង្កើនទិន្នផល និងគុណភាពដំណាំ។"},

  {"image": "", "text": "៤៨. គ្រប់គ្រងការចំណាយក្នុងកសិដ្ឋាន៖ ត្រូវរៀបចំថវិកាឲ្យបានត្រឹមត្រូវ តាមដានការចំណាយ និងប្រាក់ចំណូល ដើម្បីធានាបាននូវប្រាក់ចំណេញ និងការអភិវឌ្ឍប្រកបដោយចីរភាព។"},

  {"image": "", "text": "៤៩. ស្វែងរកទីផ្សារសម្រាប់ផលិតផលកសិកម្ម៖ ត្រូវស្រាវជ្រាវ និងស្វែងរកទីផ្សារសមស្របសម្រាប់ផលិតផលរបស់ខ្លួន ដើម្បីធានាបាននូវការលក់ដូរ និងតម្លៃសមរម្យ។"},

  {"image": "", "text": "៥០. ថែទាំកសិដ្ឋានឲ្យមានអនាម័យល្អ៖ ត្រូវរក្សាកសិដ្ឋានឲ្យស្អាត និងមានអនាម័យល្អ ដើម្បីការពារជំងឺ និងសត្វល្អិត និងបង្កើនគុណភាពផលិតផល។"}]},
     
