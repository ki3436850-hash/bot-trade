# ============================================================
# Global error handler
# ============================================================
# Without this, any unhandled exception in a handler (network error,
# malformed update, a bug in a new feature, etc.) is only logged internally
# by python-telegram-bot — the user who triggered it gets silence, and any
# "កំពុងគិត..." placeholder message is left hanging forever. This ensures
# every user always gets *some* reply, and admins get notified with the
# real error so it can be diagnosed.

async def global_error_handler(update, context):
    logger.error("Unhandled exception while processing update", exc_info=context.error)

    # Best-effort: let the user know something went wrong, instead of silence.
    try:
        if isinstance(update, Update) and update.effective_message:
            await update.effective_message.reply_text(
                "⚠️ មានបញ្ហាបច្ចេកទេសកើតឡើង។ សូមសាកល្បងម្តងទៀត ឬប្រើ /help ។"
            )
    except Exception as e:
        logger.warning(f"global_error_handler: could not notify user: {e}")

    # Best-effort: let admins know, with the actual error, so it can be fixed.
    try:
        err_text = f"🚨 Bot Error:\n{type(context.error).__name__}: {context.error}"
        await notify_admins(context.bot, text=err_text, parse_mode=None)
    except Exception as e:
        logger.warning(f"global_error_handler: could not notify admins: {e}")

# ============================================================
# Auto-Post (/post) — schedule a video to publish to YouTube / TikTok
# ============================================================
# Flow: /post -> pick platform(s) -> send video (Telegram file) -> caption
# -> schedule time -> confirm. A background loop (started from post_init)
# wakes up every 60s, finds due posts, publishes to each selected platform,
# and DMs the user success/failure. Scheduled-post records live in the same
# user_data blob as everything else, under the pseudo-user key
# "_scheduled_posts" — this reuses save_data()/load_data() as-is (same
# trick the marketplace's old _store blob used) instead of standing up a
# new table.
#
# Known limitation: the video file itself is kept on local disk
# (POST_VIDEO_DIR) until its scheduled time, not in Supabase. Railway's
# filesystem is ephemeral, so a bot restart/redeploy between scheduling and
# the scheduled time will lose the video and that post will fail with a
# clear "video file not found" message. Fine for posts scheduled minutes to
# a few hours out; for anything scheduled far in advance, moving video
# storage to Supabase Storage would be the next step (not done here to
# avoid a bucket/RLS setup you haven't necessarily done yet).

def _posts_root():
    root = user_data.setdefault("_scheduled_posts", {"next_id": 1, "posts": {}})
    root.setdefault("next_id", 1)
    root.setdefault("posts", {})
    return root

def create_scheduled_post(user_id, platforms, caption, video_path, scheduled_at_iso, tiktok_account=None):
    root = _posts_root()
    post_id = root["next_id"]
    root["next_id"] += 1
    root["posts"][str(post_id)] = {
        "id": post_id,
        "user_id": str(user_id),
        "platforms": list(platforms),
        "caption": caption,
        "video_path": video_path,
        "scheduled_at": scheduled_at_iso,
        "tiktok_account": tiktok_account,
        "status": "pending",  # pending -> posting -> completed/partial/failed
        "results": {},
        "created_at": datetime.now(PHNOM_PENH_TZ).isoformat(),
    }
    _dirty_uids.add("_scheduled_posts")
    save_data()
    return post_id

def get_due_scheduled_posts(now_dt):
    root = _posts_root()
    due = []
    for p in root["posts"].values():
        if p.get("status") != "pending":
            continue
        try:
            sched = datetime.fromisoformat(p["scheduled_at"])
        except Exception:
            continue
        if sched <= now_dt:
            due.append(p)
    return due

def update_scheduled_post(post_id, **fields):
    root = _posts_root()
    p = root["posts"].get(str(post_id))
    if not p:
        return
    p.update(fields)
    _dirty_uids.add("_scheduled_posts")
    save_data()

