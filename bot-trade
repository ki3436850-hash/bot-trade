# ---------------------------------------------------------------- closed candles
def drop_forming_candle(df, tf_seconds, now=None, utc_offset_hours=0.0):
    """Remove the still-forming last bar so decisions use CLOSED candles only.

    Assumes df["datetime"] holds the bar OPEN time (naive, UTC + utc_offset_hours).
    Returns (df, meta). meta = {forming_dropped, tf_seconds, age_since_close_s,
    last_bar}; meta values are None when they cannot be determined (no data is
    invented). The frame is never mutated.
    """
    meta = {"forming_dropped": False, "tf_seconds": tf_seconds,
            "age_since_close_s": None, "last_bar": None}
    if df is None or not tf_seconds or "datetime" not in getattr(df, "columns", []) or len(df) < 2:
        return df, meta
    now = now or datetime.utcnow()
    try:
        last = df["datetime"].iloc[-1]
        if getattr(last, "tzinfo", None) is not None:
            last = last.tz_convert("UTC").tz_localize(None)
        last = last.to_pydatetime() - timedelta(hours=utc_offset_hours)
    except Exception:
        return df, meta
    close_ts = last + timedelta(seconds=tf_seconds)
    if close_ts > now:  # bar is still open
        df = df.iloc[:-1].reset_index(drop=True)
        meta["forming_dropped"] = True
        try:
            prev = df["datetime"].iloc[-1]
            if getattr(prev, "tzinfo", None) is not None:
                prev = prev.tz_convert("UTC").tz_localize(None)
            prev = prev.to_pydatetime() - timedelta(hours=utc_offset_hours)
            last, close_ts = prev, prev + timedelta(seconds=tf_seconds)
        except Exception:
            return df, meta
    meta["last_bar"] = last.isoformat()
    meta["age_since_close_s"] = max(0, int((now - close_ts).total_seconds()))
    return df, meta


def stale_timeframes(valid, risk=None):
    """Timeframes whose last CLOSED bar is older than stale_bars bars.

    Daily and slower frames are skipped (weekend gaps make the test meaningless).
    Timeframes without bar metadata (e.g. backtest windows) are skipped.
    """
    limit = _cfg(risk, "stale_bars")
    out = []
    for r in valid:
        m = r.get("bar_meta") or {}
        age, tfs_ = m.get("age_since_close_s"), m.get("tf_seconds")
        if age is None or not tfs_ or tfs_ >= 86400:
            continue
        if age > limit * tfs_:
            out.append((r["timeframe"], age))
    return out


# ------------------------------------------------------- entry confirmation
def entry_confirmation(ltf_results, htf_bias, strong=None):
    """Lower timeframes confirm (or contradict) the HTF direction.

    Fix vs the old logic: a strong opposing LTF read now wins over a lone
    agreeing one (previously ANY agreeing LTF returned CONFIRMED and hid the
    conflict). Weak/neutral opposition is a pullback, not a conflict.
    """
    strong = DEFAULTS["ltf_strong"] if strong is None else strong
    if not ltf_results:
        return {"status": "NONE", "reasons": ["No entry-timeframe data available"]}
    want = "BULL" if htf_bias == "BULLISH" else ("BEAR" if htf_bias == "BEARISH" else None)
    if want is None:
        return {"status": "NEUTRAL", "reasons": ["No higher-timeframe bias to confirm against"]}
    agree = [r for r in ltf_results if r["bias"] == want]
    oppose = [r for r in ltf_results if r["bias"] not in (want, "NEUTRAL") and r["strength"] >= strong]
    if oppose:
        return {"status": "CONFLICT",
                "reasons": [f"{r['timeframe']}: {r['bias']} against HTF {htf_bias} ({r['strength']}/100)"
                            for r in oppose]}
    if agree:
        return {"status": "CONFIRMED",
                "reasons": [f"{r['timeframe']}: {r['bias']} confirms ({r['strength']}/100)" for r in agree]}
    return {"status": "PULLBACK",
            "reasons": ["Entry timeframe is neutral/pulling back - no confirmation yet"]}


# ----------------------------------------------------------------- alignment
def mtf_alignment(valid, tfs, want):
    """Per-timeframe rows + agreement count toward `want` ('BULL'/'BEAR').

    want=None (no direction proposed) counts the larger side, for display only.
    """
    order = {tf: i for i, tf in enumerate(tfs)}
    rows = sorted(valid, key=lambda r: order.get(r["timeframe"], 99))
    if want is None:
        bulls = sum(1 for r in rows if r["bias"] == "BULL")
        bears = sum(1 for r in rows if r["bias"] == "BEAR")
        want = "BULL" if bulls >= bears else "BEAR"
    agree = sum(1 for r in rows if r["bias"] == want)
    return {"agree": agree, "total": len(rows), "label": f"{agree}/{len(rows)}", "side": want,
            "rows": [{"tf": r["timeframe"], "bias": r["bias"], "strength": r["strength"]} for r in rows]}


def _is_fallback_level(level, price):
    """find_support_resistance() returns price*1.02 / price*0.98 when it finds
    no real swing level. Those are placeholders, not market levels - ignore."""
    if level is None or not price:
        return True
    return abs(level - price * 1.02) < price * 1e-9 or abs(level - price * 0.98) < price * 1e-9


# ----------------------------------------------------------------- validator
def validate_direction(*, valid, tfs, htf_tfs, ltf_tfs, htf, entry_conf,
                       confluence_score, risk=None, strategy_summary=None):
    """Decide whether the HTF-derived direction is allowed to become BUY/SELL.

    Returns:
      wait_reasons  - soft reasons -> direction WAIT
      block_reasons - hard reasons -> direction NO TRADE (stale data)
      mtf           - alignment summary for display
      checks        - name -> "pass" | "fail" | "skipped" (for a Details view)
      proposed      - "BUY" / "SELL" / None
    """
    wait, block, checks = [], [], {}
    want = {"BULLISH": "BULL", "BEARISH": "BEAR"}.get(htf.get("bias"))
    proposed = {"BULL": "BUY", "BEAR": "SELL"}.get(want)
    mtf = mtf_alignment(valid, tfs, want)

    # 1. stale data (hard block)
    stale = stale_timeframes(valid, risk)
    if stale:
        tf_, age = stale[0]
        block.append(f"Stale data ({tf_}: last closed bar {age // 60} min old) - market may be closed or feed delayed")
        checks["fresh_data"] = "fail"
    else:
        checks["fresh_data"] = "pass"

    # 2. HTF direction must exist
    if want is None:
        wait.append("HTF bias NEUTRAL - no clear higher-timeframe direction "
                    f"(bull weight {htf.get('bull_weight', 0)} vs bear weight {htf.get('bear_weight', 0)})")
        checks["htf_direction"] = "fail"
        mtf["status"] = "MIXED"
        return {"wait_reasons": wait, "block_reasons": block, "mtf": mtf, "checks": checks, "proposed": None}
    checks["htf_direction"] = "pass"

    # 3. entry confirmation (strict version)
    st = entry_conf["status"]
    if st == "CONFLICT":
        wait.append(f"HTF/LTF conflict - HTF is {htf['bias']} but the entry timeframe is pushing the other way")
        wait.extend(entry_conf["reasons"])
    elif st == "PULLBACK":
        wait.append(f"HTF is {htf['bias']} but entry timeframe has no confirmation yet (pullback in progress)")
    elif st == "NONE":
        wait.append("Insufficient entry-timeframe data for confirmation")
    checks["entry_confirmation"] = "pass" if st == "CONFIRMED" else "fail"

    # 4. a single strong opposing HTF read (weighted vote can hide it)
    htf_strong = _cfg(risk, "htf_strong")
    opp_htf = [r for r in valid if r["timeframe"] in htf_tfs
               and r["bias"] not in (want, "NEUTRAL") and r["strength"] >= htf_strong]
    if opp_htf:
        wait.append("HTF disagreement - " + ", ".join(
            f"{r['timeframe']} {r['bias']} ({r['strength']}/100)" for r in opp_htf) + f" vs overall {htf['bias']}")
        checks["htf_consistency"] = "fail"
    else:
        checks["htf_consistency"] = "pass"

    # 5. multi-timeframe alignment
    regime_exec = None
    exec_r = next((r for r in reversed(valid) if r["timeframe"] in ltf_tfs), None) or valid[0]
    regime_exec = (exec_r.get("components") or {}).get("regime") or {}
    hv = regime_exec.get("regime") == "HIGH_VOLATILITY"
    min_align = _cfg(risk, "hv_min_alignment") if hv else _cfg(risk, "min_alignment")
    ratio = mtf["agree"] / mtf["total"] if mtf["total"] else 0
    if ratio + 1e-9 < min_align:
        wait.append(f"MTF alignment too low ({mtf['label']}, need {round(min_align * 100)}%"
                    + (" in high volatility" if hv else "") + ")")
        checks["mtf_alignment"] = "fail"
    else:
        checks["mtf_alignment"] = "pass"
    if opp_htf or st == "CONFLICT":
        mtf["status"] = "CONFLICT"
    elif checks["mtf_alignment"] == "pass":
        mtf["status"] = "ALIGNED"
    else:
        mtf["status"] = "MIXED"

    # 6. room to the opposing support/resistance (primary-timeframe ATR units)
    primary = next((r for r in valid if r["timeframe"] == tfs[0]), valid[0])
    price, atr = primary.get("price"), primary.get("atr")
    if not atr or atr != atr or atr <= 0 or not price:
        checks["sr_room"] = "skipped"
    else:
        need = _cfg(risk, "min_room_atr")
        near = []
        for r in [primary] + [x for x in valid if x["timeframe"] in htf_tfs and x is not primary]:
            lvl = r.get("resistance") if want == "BULL" else r.get("support")
            if _is_fallback_level(lvl, r.get("price")):
                continue
            dist = ((lvl - price) if want == "BULL" else (price - lvl)) / atr
            if 0 < dist < need:
                near.append((r["timeframe"], lvl, dist))
        if near:
            name = "resistance" if want == "BULL" else "support"
            tf_, lvl, dist = min(near, key=lambda x: x[2])
            wait.append(f"Major {name} nearby ({tf_} {lvl:g} is only {dist:.2f} ATR away, need {need:g}+)")
            checks["sr_room"] = "fail"
        else:
            checks["sr_room"] = "pass"

    # 7a. strategy ensemble (when evidence is supplied): only strategies that suit the
    #     current regime AND have a valid setup may support or oppose the direction.
    #     This replaces the blunt regime gate - e.g. in a RANGING market a trend setup
    #     is allowed only if a range strategy confirms it at the range edge.
    rg0 = regime_exec.get("regime")
    if strategy_summary is not None:
        if rg0 in ("UNSTABLE", "UNKNOWN"):
            wait.append(f"Market regime {regime_exec.get('label', rg0)} - read not trustworthy, no strategy may trade")
            checks["strategy_support"] = "fail"
        else:
            need = _cfg(risk, "min_strategy_score")
            sup, opp = strategy_summary.get("support", 0), strategy_summary.get("oppose", 0)
            bo = strategy_summary.get("best_oppose") or {}
            if strategy_summary.get("active_valid", 0) == 0 or sup < need:
                wait.append(f"No regime-appropriate strategy confirms {proposed} "
                            f"({regime_exec.get('label', rg0)}; best supporting score {sup}, need {need}+)")
                checks["strategy_support"] = "fail"
            elif opp and opp >= sup:
                wait.append(f"Active strategy {bo.get('strategy')} ({bo.get('direction')} {opp}) "
                            f"outweighs the best {proposed} strategy ({sup})")
                checks["strategy_support"] = "fail"
            else:
                checks["strategy_support"] = "pass"
        if rg0 in ("TRENDING", "BREAKOUT") and regime_exec.get("bias") not in (want, "NEUTRAL", None):
            wait.append(f"Regime direction ({regime_exec.get('bias')}) opposes the {proposed} setup")
            checks["regime"] = "fail"
        else:
            checks["regime"] = "pass"
    # 7b. legacy regime gate (no strategy evidence, e.g. backtests)
    elif _cfg(risk, "regime_gate"):
        rg = regime_exec.get("regime")
        if rg in _NO_TREND_REGIMES:
            wait.append(f"Market regime {regime_exec.get('label', rg)} - trend setup not valid here")
            checks["regime"] = "fail"
        elif rg in ("TRENDING", "BREAKOUT") and regime_exec.get("bias") not in (want, "NEUTRAL", None):
            wait.append(f"Regime direction ({regime_exec.get('bias')}) opposes the {proposed} setup")
            checks["regime"] = "fail"
        else:
            checks["regime"] = "pass"
    else:
        checks["regime"] = "skipped"

    # 8. signal score floor (heuristic score, NOT a probability)
    floor = _cfg(risk, "hv_min_score") if hv else _cfg(risk, "min_score")
    if confluence_score is not None and confluence_score < floor:
        wait.append(f"Signal score {confluence_score}/100 below the {floor} minimum")
        checks["score_floor"] = "fail"
    else:
        checks["score_floor"] = "pass"

    return {"wait_reasons": wait, "block_reasons": block, "mtf": mtf, "checks": checks, "proposed": proposed}
'''
