# ------------------------------------------------------------
# EA Bridge (Phase 2) — real connection between the MT5 EA and this backend.
# ------------------------------------------------------------
# The EA (running on a Windows VPS/terminal, see the companion .mq5 file)
# calls POST /api/ea/heartbeat every ~15-30s via MQL5's WebRequest(). That
# single call both reports its status AND picks up any pending command
# (Start/Pause/Emergency Stop) Telegram queued for it, since MQL5 WebRequest
# targets must be individually allow-listed in the terminal — fewer distinct
# endpoints is easier for the user to set up.
#
# Auth: every /api/ea/* request must send header "X-EA-Token" matching
# EA_BRIDGE_TOKEN (env var, acts as the account/API-key id). If that env var
# isn't set, the endpoints refuse everything — there is no "open by default"
# mode.
#
# On top of the token, set EA_BRIDGE_HMAC_SECRET to turn on full request
# signing (spec §41: HMAC signing, timestamp validation, nonce/replay
# protection, rate limiting). When this secret is set, every /api/ea/*
# request must ALSO include:
#   X-EA-Timestamp  — unix seconds when the request was signed
#   X-EA-Nonce      — a random string, unique per request (<=128 chars)
#   X-EA-Signature  — hex HMAC-SHA256(secret, canonical_string)
# where canonical_string is:
#   f"{METHOD}\n{PATH}\n{TIMESTAMP}\n{NONCE}\n{SHA256_HEX(raw_request_body)}"
# (METHOD is "POST", PATH is e.g. "/api/ea/heartbeat" with no query string,
# raw_request_body is the exact bytes sent — an empty body hashes to
# sha256(b"").hexdigest()). A request is rejected if its timestamp is more
# than EA_BRIDGE_TIMESTAMP_TOLERANCE_SECONDS away from server time, if its
# nonce has been seen before within that window, or if the signature doesn't
# match — this is what makes a captured request unreplayable.
#
# EA_BRIDGE_HMAC_SECRET is OFF by default (empty) so an already-deployed EA
# that only sends X-EA-Token keeps working — per rule #17 (preserve backward
# compatibility). Once the MQL5 side is updated to sign its requests, set
# this env var to turn on the stronger mode; a startup warning is logged
# while it's unset as a reminder that the bridge is running in the weaker,
# legacy, token-only mode.
#
# This bridge relays status and manual Start/Pause/Emergency-Stop commands
# ONLY. It does NOT yet send trading signals to the EA for execution — that
# is the Risk Engine + Execution phase (spec §13/§18), which must exist
# before any order gets placed automatically. Nothing here can move money.
EA_BRIDGE_TOKEN = os.environ.get("EA_BRIDGE_TOKEN", "")
EA_BRIDGE_HMAC_SECRET = os.environ.get("EA_BRIDGE_HMAC_SECRET", "")
EA_BRIDGE_TIMESTAMP_TOLERANCE_SECONDS = int(os.environ.get("EA_BRIDGE_TIMESTAMP_TOLERANCE_SECONDS", "120"))
EA_HEARTBEAT_TIMEOUT_SECONDS = 90  # no heartbeat within this window -> mark OFFLINE
EA_LOCK = threading.Lock()

# Replay protection: nonces seen within the tolerance window are remembered
# so the same signed request can't be resent. Pruned lazily on each check.
EA_NONCE_LOCK = threading.Lock()
EA_SEEN_NONCES = {}  # nonce -> expiry epoch seconds

# Basic rate limiting on auth failures, per spec §41. After
# EA_AUTH_MAX_FAILURES failed /api/ea/* requests from the same IP within
# EA_AUTH_FAILURE_WINDOW seconds, that IP gets 429s for EA_AUTH_LOCKOUT_SECONDS.
EA_AUTH_FAIL_LOCK = threading.Lock()
EA_AUTH_FAILURES = {}  # ip -> [failure epoch seconds, ...]
EA_AUTH_MAX_FAILURES = 8
EA_AUTH_FAILURE_WINDOW = 60
EA_AUTH_LOCKOUT_SECONDS = 300

if EA_BRIDGE_TOKEN and not EA_BRIDGE_HMAC_SECRET:
    logger.warning(
        "EA bridge is running in legacy auth mode (X-EA-Token only, no request "
        "signing). Set EA_BRIDGE_HMAC_SECRET and update the EA to sign requests "
        "for replay protection."
    )
EA_STATE = {
    "connected": False,
    "last_heartbeat": None,      # epoch seconds
    "mode": None,                 # "DEMO" / "LIVE" — reported by the EA itself, never set from Telegram
    "broker": None,
    "ea_version": None,
    "account": {},                 # {"balance","equity","margin","free_margin","currency"}
    "positions": [],               # [{"symbol","direction","lot","entry","current","sl","tp","pl","magic"}]
    "spreads": {},                  # {"SYMBOL": current_spread_in_pips} — optional, reported by the EA if it sends it
    "symbol_specs": {},             # {"SYMBOL": {"tick_value","tick_size"/"point","min_lot","max_lot","lot_step","contract_size"}}
                                     # — optional, reported by the EA if it sends it; feeds Smart Lot Size (spec §14)
    "run_state": "PAUSED",         # desired state Telegram sets; the EA must obey it — "RUNNING" / "PAUSED" / "EMERGENCY_STOP"
    "pending_commands": [],        # [{"id","action","params","created"}] — cleared once the EA acks via command-result
    "events": [],                  # recent trade/system events, newest first, capped at EA_EVENTS_MAX
    "was_connected_notified": True,  # avoids duplicate "back ONLINE" notifications
}
EA_EVENTS_MAX = 100

def ea_bridge_owner_id():
    """The EA bridge is single-account/single-tenant for now — its Break-even
    and Trailing settings come from the primary admin's /ea Settings."""
    if ADMIN_ID:
        return ADMIN_ID
    if ADMIN_IDS:
        return next(iter(ADMIN_IDS))
    return None

def ea_check_token(handler) -> bool:
    """Legacy bare-token check, kept only for anything that doesn't go
    through ea_verify_request (there shouldn't be any, but kept as a safe
    fallback primitive)."""
    if not EA_BRIDGE_TOKEN:
        return False
    return handler.headers.get("X-EA-Token") == EA_BRIDGE_TOKEN

def _ea_client_ip(handler) -> str:
    try:
        return handler.client_address[0]
    except Exception:
        return "unknown"

def ea_rate_limited(ip: str) -> bool:
    now = time.time()
    with EA_AUTH_FAIL_LOCK:
        fails = [t for t in EA_AUTH_FAILURES.get(ip, []) if now - t < EA_AUTH_LOCKOUT_SECONDS]
        EA_AUTH_FAILURES[ip] = fails
        recent = [t for t in fails if now - t < EA_AUTH_FAILURE_WINDOW]
        return len(recent) >= EA_AUTH_MAX_FAILURES

def ea_record_auth_failure(ip: str, reason: str):
    with EA_AUTH_FAIL_LOCK:
        EA_AUTH_FAILURES.setdefault(ip, []).append(time.time())
    # Audit log (spec §41) — never log secrets/signatures/tokens themselves,
    # just the reason and source, so this is safe to leave in normal logs.
    logger.warning(f"EA bridge auth failure from {ip}: {reason}")

def _ea_nonce_seen(nonce: str) -> bool:
    """True if this nonce was already used inside the replay window (and
    records it if not). Also lazily prunes expired nonces so this dict can't
    grow unbounded."""
    now = time.time()
    with EA_NONCE_LOCK:
        for stale in [n for n, exp in EA_SEEN_NONCES.items() if exp < now]:
            del EA_SEEN_NONCES[stale]
        if nonce in EA_SEEN_NONCES:
            return True
        EA_SEEN_NONCES[nonce] = now + (EA_BRIDGE_TIMESTAMP_TOLERANCE_SECONDS * 2)
        return False

def ea_verify_request(handler, raw_body: bytes):
    """Full auth check for every /api/ea/* request (spec §41: HMAC signing,
    timestamp validation, nonce/replay protection, rate limiting, audit
    logging). Returns (True, None) on success, or (False, (status, code))
    on failure so the caller can respond appropriately.

    Two modes, chosen by whether EA_BRIDGE_HMAC_SECRET is configured:
      - set (recommended): requires a valid, freshly-signed, non-replayed
        request — see the header/canonical-string contract documented above
        EA_BRIDGE_TOKEN.
      - unset (legacy): falls back to a bare X-EA-Token compare, for EAs not
        yet updated to sign requests. Preserves backward compatibility.
    """
    ip = _ea_client_ip(handler)
    if ea_rate_limited(ip):
        return False, (429, "rate_limited")

    token = handler.headers.get("X-EA-Token")
    if not EA_BRIDGE_TOKEN or token != EA_BRIDGE_TOKEN:
        ea_record_auth_failure(ip, "bad_token")
        return False, (401, "unauthorized")

    if not EA_BRIDGE_HMAC_SECRET:
        return True, None  # legacy mode: token alone is sufficient

    ts_header = handler.headers.get("X-EA-Timestamp")
    nonce = handler.headers.get("X-EA-Nonce")
    sig = handler.headers.get("X-EA-Signature")
    if not (ts_header and nonce and sig):
        ea_record_auth_failure(ip, "missing_signature_headers")
        return False, (401, "missing_signature_headers")

    if len(nonce) > 128:
        ea_record_auth_failure(ip, "bad_nonce")
        return False, (401, "bad_nonce")

    try:
        ts = float(ts_header)
    except ValueError:
        ea_record_auth_failure(ip, "bad_timestamp")
        return False, (401, "bad_timestamp")

    if abs(time.time() - ts) > EA_BRIDGE_TIMESTAMP_TOLERANCE_SECONDS:
        ea_record_auth_failure(ip, "stale_timestamp")
        return False, (401, "stale_timestamp")

    if _ea_nonce_seen(nonce):
        ea_record_auth_failure(ip, "replayed_nonce")
        return False, (401, "replay_detected")

    body_hash = hashlib.sha256(raw_body or b"").hexdigest()
    canonical = f"{handler.command}\n{handler.path}\n{ts_header}\n{nonce}\n{body_hash}"
    expected_sig = hmac.new(
        EA_BRIDGE_HMAC_SECRET.encode("utf-8"), canonical.encode("utf-8"), hashlib.sha256
    ).hexdigest()
    if not hmac.compare_digest(expected_sig, sig):
        ea_record_auth_failure(ip, "bad_signature")
        return False, (401, "bad_signature")

    return True, None

def ea_enqueue_command(action, params=None):
    """Called from the Telegram side (Start/Pause/Emergency Stop). The EA
    picks this up on its next heartbeat call and must POST /api/ea/command-result
    once it has acted on it."""
    cmd = {"id": str(uuid.uuid4())[:8], "action": action, "params": params or {}, "created": time.time()}
    with EA_LOCK:
        EA_STATE["pending_commands"].append(cmd)
        if action in ("START",):
            EA_STATE["run_state"] = "RUNNING"
        elif action in ("PAUSE",):
            EA_STATE["run_state"] = "PAUSED"
        elif action in ("EMERGENCY_STOP",):
            EA_STATE["run_state"] = "EMERGENCY_STOP"
    return cmd

def ea_add_event(event: dict):
    event = dict(event)
    event.setdefault("at", time.time())
    with EA_LOCK:
        EA_STATE["events"].insert(0, event)
        del EA_STATE["events"][EA_EVENTS_MAX:]

def ea_snapshot():
    """Thread-safe copy of EA_STATE for the Telegram handlers to read, with
    'connected' recomputed from the heartbeat timeout rather than trusted
    as a stale flag."""
    with EA_LOCK:
        snap = json.loads(json.dumps(EA_STATE))  # cheap deep copy, all fields are JSON-safe
    if snap["last_heartbeat"] is None:
        snap["connected"] = False
    else:
        snap["connected"] = (time.time() - snap["last_heartbeat"]) <= EA_HEARTBEAT_TIMEOUT_SECONDS
    return snap

def ea_heartbeat_watcher():
    """Background thread: flips ONLINE->OFFLINE (and back) and notifies admins,
    per spec §39 Heartbeat / §40 Connection Recovery. Runs independently of
    the Telegram event loop, same pattern as _notify_admins_sync."""
    while True:
        time.sleep(30)
        with EA_LOCK:
            last = EA_STATE["last_heartbeat"]
            was_notified_online = EA_STATE["was_connected_notified"]
        if last is None:
            continue
        online_now = (time.time() - last) <= EA_HEARTBEAT_TIMEOUT_SECONDS
        if not online_now and was_notified_online:
            with EA_LOCK:
                EA_STATE["was_connected_notified"] = False
            _notify_admins_sync("🔴 *EA OFFLINE* — no heartbeat received for over "
                                 f"{EA_HEARTBEAT_TIMEOUT_SECONDS}s. Existing positions are unaffected; "
                                 "no new trades will open until it reconnects.")
        elif online_now and not was_notified_online:
            with EA_LOCK:
                EA_STATE["was_connected_notified"] = True
            _notify_admins_sync("🟢 *EA back ONLINE* — heartbeat resumed.")


