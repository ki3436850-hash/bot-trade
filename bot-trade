            return True
        row = await db_update_shop(uid, {"description": None})
        _mk_clear_state(ud); save_data()
        await q.message.reply_text(
            "✅ បានលុបការពិពណ៌នា។" if row else "❌ មិនអាចកែប្រែបានទេ សូមសាកល្បងម្តងទៀត។",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("⚙️ ការកំណត់ហាង", callback_data="mk_set")]]))
        return True

    # ---------- shop creation ----------
    if data == "mk_shop_new":
        if not await market_shops_available():
            await safe_alert(q, "⚠️ មុខងារហាងមិនទាន់ត្រូវបាន Setup ទេ។ សូមទាក់ទង Admin។")
