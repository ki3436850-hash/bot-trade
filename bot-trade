async def analyze_run(q, mode, symbol, tf, force=False):
    if symbol not in FOREX_SYMBOLS and symbol not in CRYPTO_SYMBOLS:
        await analyze_send(q, f"❌ Unsupported symbol: {symbol}", analyze_result_keyboard(mode, "XAUUSD", tf))
        return
    try:
        await q.edit_message_text(f"⏳ Analyzing {symbol} {tf} ...", reply_markup=None)
    except Exception:
        pass
    try:
        b = await analyze_gather(symbol, tf, mode, force=force)
        d = AI_INTEL.derive(b)
        if mode == "mkt":
            text = AI_INTEL.render_market(b, d)
        elif mode == "nxt":
            text = AI_INTEL.render_next_candle(b, d)
        elif mode == "news":
