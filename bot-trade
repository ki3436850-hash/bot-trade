# Position management (spec §18 Close/Modify) — every action below reuses the
# same generic ea_enqueue_command() the EA already polls for on heartbeat, so
# the bridge/API surface doesn't change at all, only new "action" values.
#
# The heartbeat position payload has no order ticket in the current contract
# (see EA_STATE comment), so identity is ticket-based when the EA reports one,
# else a best-effort match on symbol+magic+entry+lot. If the companion .mq5
# EA can be updated, having it send a "ticket" field makes Close/Modify
# unambiguous even with several same-symbol positions open at once.
# ------------------------------------------------------------
EA_ACTION_CONFIRM_TTL_SECONDS = 90  # a stale Execute/Close/Modify confirm screen must be regenerated, not blindly sent

def ea_position_identity(p):
    if p.get("ticket") is not None:
        return {"ticket": p["ticket"]}
    return {"symbol": p.get("symbol"), "magic": p.get("magic"),
             "entry": p.get("entry"), "lot": p.get("lot")}

def ea_find_position(snap, ident):
    for p in (snap.get("positions") or []):
        if ident.get("ticket") is not None:
            if p.get("ticket") == ident["ticket"]:
                return p
        elif (p.get("symbol") == ident.get("symbol") and p.get("magic") == ident.get("magic")
              and p.get("entry") == ident.get("entry") and p.get("lot") == ident.get("lot")):
            return p
    return None

