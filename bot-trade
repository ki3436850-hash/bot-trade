        if await market_shops_available():
            shop = await db_get_shop_by_owner(listing["seller_id"])
            if shop and (shop.get("status") or "active") != "active":
                shop = None
        rows = []
        if not is_owner and not sold_out:
            buy_label = "⚡ Apply Now" if listing.get("category") == "job" else "🛒 ស្នើទិញទំនិញនេះ"
            rows.append([InlineKeyboardButton(buy_label, callback_data=f"order_req_{lid}")])
        if not is_owner:
            is_fav = await db_is_favorited(viewer_id, lid)
            fav_label = "💔 ដកចេញពី Saved" if is_fav else "❤️ Save"
            fav_cb = f"dj_unfav_{lid}" if is_fav else f"dj_fav_{lid}"
            rows.append([InlineKeyboardButton(fav_label, callback_data=fav_cb)])
        row2 = []
        if is_owner:
            row2.append(InlineKeyboardButton("✏️ គ្រប់គ្រង", callback_data=f"mk_pm_{lid}"))
        elif shop:
            row2.append(InlineKeyboardButton(f"🏪 {str(shop['name'])[:20]}", callback_data=f"mk_shopv_{shop['id']}"))
        if bot_username:
            row2.append(InlineKeyboardButton(
                "📤 Share", url=market_share_url(market_product_link(bot_username, lid), market_product_label(listing))))
        if row2:
            rows.append(row2)
        if is_admin(viewer_id):
            rows.append([InlineKeyboardButton("🛡️ Admin: លុបចេញ", callback_data=f"mk_arm_{lid}")])
        text = f"ទំនិញ #{lid}"
        if sold_out and not is_owner:
            text += " — ⛔ អស់ស្តុក"
        if shop:
