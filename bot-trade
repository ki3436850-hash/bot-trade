    if state == "awaiting_link_lookup":
        ud["store_state"] = None
        save_data()
        if not store_db_ready():
            await update.message.reply_text(STORE_DB_UNAVAILABLE_MSG)
            return True
        try:
            sm = re.search(r"start=shop_([A-Za-z0-9]{4,16})", text)
            if sm:
                await market_open_shop_by_slug(update.message, context.bot.username, sm.group(1), uid)
                return True
            m = re.search(r"start=store_(\d+)", text)
            if not m:
                await update.message.reply_text(
                    "❌ តំណរភ្ជាប់ (Link) មិនត្រឹមត្រូវទេ។\n"
                    "សូមប្រាកដថាបានចម្លង Link ត្រឹមត្រូវពីអ្នកលក់ (ត្រូវមាន t.me/...?start=store_...) "
                    "រួចផ្ញើវាមកខ្ញុំម្តងទៀត។")
                return True
            listing_id = m.group(1)
            listing = await db_get_listing(listing_id)
            if not listing or listing_is_removed(listing):
                await update.message.reply_text(
                    "❌ តំណរភ្ជាប់ (Link) នេះមិនត្រឹមត្រូវ ឬទំនិញអាចត្រូវបានលុបចោលហើយ។\n"
