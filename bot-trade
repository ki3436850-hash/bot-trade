async def handle_candlestick_photo(update, context):
    ud = get_user_data(update.effective_user.id)
    if not is_admin(update.effective_user.id):
        ud["pending_candlestick"] = False
        return
    if not ud.get("pending_candlestick"):
        await update.message.reply_text(
            "ℹ️ ប្រសិនបើអ្នកចង់ឲ្យ Bot វិភាគរូបភាព Candlestick សូមប្រើ /analyze "
            "ជ្រើសរើស 🕯️ Candlestick Analysis ជាមុនសិន រួចទើបផ្ញើរូបភាព។"
        )
        return
    thinking_msg = await update.message.reply_text("⏳ កំពុងវិភាគរូបភាព Candlestick... សូមរង់ចាំបន្តិច។")
    photo = update.message.photo[-1]
    try:
        file = await context.bot.get_file(photo.file_id)
        image_bytes = await _download_file_bytes(file)
    except Exception as e:
        logger.warning(f"Candlestick analysis: download failed — {e}")
        ud["pending_candlestick"] = False
        ud["candlestick_symbol"] = None
        save_data()
        await thinking_msg.edit_text("❌ មិនអាចទាញយករូបភាពនេះបានទេ។ សូមសាកល្បងផ្ញើម្តងទៀត។")
        return
    symbol = ud.get("candlestick_symbol")
    result_text, error_msg = await analyze_candlestick_image(image_bytes, symbol=symbol)
    ud["pending_candlestick"] = False
    ud["candlestick_symbol"] = None
    save_data()
    if not result_text:
        logger.warning(f"Candlestick analysis failed: {error_msg}")
        is_admin_user = is_admin(update.effective_user.id)
        if is_admin_user:
            # Show the real reason directly to the admin who triggered it —
            # they can act on it immediately instead of hunting server logs.
            await update.message.reply_text(
                f"❌ មិនអាចវិភាគរូបភាពនេះបានទេ។\n\nមូលហេតុ: {error_msg}"
            )
        else:
            await update.message.reply_text(
                "❌ មិនអាចវិភាគរូបភាពនេះបានទេ។ សូមសាកល្បងផ្ញើរូបភាពម្តងទៀត។"
            )
            await notify_admins(context.bot, text=f"🚨 Candlestick Analysis Error:\n{error_msg}")
        return
    await update.message.reply_text(f"🕯️✨ *លទ្ធផលការវិភាគ Candlestick*\n\n{result_text}", parse_mode="Markdown")

