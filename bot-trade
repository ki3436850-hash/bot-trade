async def notify_post_result(app, post, results):
    lines = []
    for plat, r in results.items():
        icon = "✅" if r.get("ok") else "❌"
        label = dict(POST_PLATFORMS).get(plat, plat)
        lines.append(f"{icon} {label}: {r.get('detail')}")
    all_ok = all(r.get("ok") for r in results.values()) if results else False
    any_ok = any(r.get("ok") for r in results.values()) if results else False
    if all_ok:
        header = "🎉 ការផុសបានជោគជ័យទាំងអស់!"
    elif any_ok:
        header = "⚠️ ការផុសបានជោគជ័យខ្លះ"
    else:
        header = "❌ ការផុសបានបរាជ័យទាំងអស់"
    text = f"{header} (Post #{post['id']})\n\n" + "\n".join(lines)
    try:
        await app.bot.send_message(int(post["user_id"]), text)
    except Exception as e:
        logger.error(f"notify_post_result failed for user {post['user_id']}: {e}")

async def process_due_scheduled_posts(app):
    now = datetime.now(PHNOM_PENH_TZ)
    for post in get_due_scheduled_posts(now):
        update_scheduled_post(post["id"], status="posting")
        try:
            with open(post["video_path"], "rb") as f:
                video_bytes = f.read()
        except Exception as e:
            results = {plat: {"ok": False, "detail": f"រកមិនឃើញ Video File: {e}"}
                       for plat in post["platforms"]}
            update_scheduled_post(post["id"], status="failed", results=results)
            await notify_post_result(app, post, results)
            continue

        results = {}
        for plat in post["platforms"]:
            try:
                if plat == "youtube":
                    ok, detail = await publish_to_youtube(video_bytes, post["caption"])
                elif plat == "tiktok":
                    ok, detail = await publish_to_tiktok(video_bytes, post["caption"], post.get("tiktok_account"))
                elif plat == "facebook":
                    ok, detail = await publish_to_facebook(video_bytes, post["caption"])
                else:
                    ok, detail = False, "Platform មិនស្គាល់"
            except Exception as e:
                logger.error(f"publish_to_{plat} crashed: {e}")
                ok, detail = False, str(e)
            results[plat] = {"ok": ok, "detail": detail}

        all_ok = all(r["ok"] for r in results.values())
        any_ok = any(r["ok"] for r in results.values())
        status = "completed" if all_ok else ("partial" if any_ok else "failed")
        update_scheduled_post(post["id"], status=status, results=results)
        await notify_post_result(app, post, results)

        try:
            os.remove(post["video_path"])
        except Exception:
            pass

async def post_scheduler_loop(app):
    await asyncio.sleep(15)  # let the bot finish starting up first
    while True:
        try:
            await process_due_scheduled_posts(app)
        except Exception as e:
            logger.error(f"post_scheduler_loop error: {e}")
        await asyncio.sleep(60)

# ============================================================
# /schedule — Generic Schedule Manager (Message/Photo/Video/Document/Reminder)
# ============================================================
# Fully independent from /post's scheduler above: separate data root
# ("_user_schedules" vs "_scheduled_posts"), separate state key ("schedule_state"
# vs "post_state"), separate background loop (schedule_scheduler_loop vs
# post_scheduler_loop). Nothing here touches /post's code path.
#
# Data lives in the same user_data JSON store (via save_data()/load_data()),
# the same pattern _scheduled_posts already uses — so it survives Railway
# restarts/redeploys without a new database.
#
# Repeat days use Python's Monday=0..Sunday=6 convention internally.
SCHEDULE_DAY_NAMES = ["ច័ន្ទ", "អង្គារ", "ពុធ", "ព្រហស្បតិ៍", "សុក្រ", "សៅរ៍", "អាទិត្យ"]
SCHEDULE_CONTENT_TYPES = [
    ("text", "🔵 Send Message"),
    ("photo", "📷 Send Photo"),
    ("video", "📹 Send Video"),
    ("document", "📄 Send Document"),
    ("reminder", "🔔 Reminder"),
]
SCHEDULE_REPEAT_LABELS = {"once": "🔵 Once", "daily": "🟢 Every Day",
                           "weekly": "🟣 Every Week", "custom": "🟠 Custom"}
SCHEDULE_STATUS_LABELS = {"active": "🟢 Active", "paused": "⏸ Paused",
                           "completed": "✅ Completed", "failed": "❌ Failed"}
SCHEDULE_MAX_RETRIES = 5

def _schedules_root():
    root = user_data.setdefault("_user_schedules", {"next_id": 1, "items": {}})
    root.setdefault("next_id", 1)
    root.setdefault("items", {})
    return root

def create_schedule(user_id, chat_id, content_type, content_text, file_id, caption,
                     run_at_iso, repeat_type, repeat_days):
    root = _schedules_root()
    sid = root["next_id"]
    root["next_id"] += 1
    now_iso = datetime.now(PHNOM_PENH_TZ).isoformat()
    root["items"][str(sid)] = {
        "id": sid,
        "user_id": str(user_id),
        "chat_id": chat_id,
        "content_type": content_type,
        "content_text": content_text,
        "file_id": file_id,
        "caption": caption,
        "timezone": "Asia/Phnom_Penh",
        "repeat_type": repeat_type,
        "repeat_days": repeat_days or [],
        "run_at": run_at_iso,
        "next_run": run_at_iso,
        "last_run": None,
        "retry_count": 0,
        "last_error": None,
        "status": "active",
        "created_at": now_iso,
        "updated_at": now_iso,
    }
    _dirty_uids.add("_user_schedules")
    save_data()
    return sid

def get_schedule(sid):
    return _schedules_root()["items"].get(str(sid))

def update_schedule(sid, **fields):
    root = _schedules_root()
    s = root["items"].get(str(sid))
    if not s:
        return
    s.update(fields)
    s["updated_at"] = datetime.now(PHNOM_PENH_TZ).isoformat()
    _dirty_uids.add("_user_schedules")
    save_data()

def delete_schedule(sid):
    root = _schedules_root()
    root["items"].pop(str(sid), None)
    _dirty_uids.add("_user_schedules")
    save_data()

def get_user_schedules(user_id):
    root = _schedules_root()
    items = [s for s in root["items"].values() if s["user_id"] == str(user_id)]
    return sorted(items, key=lambda s: s["id"])

def get_all_schedules():
    root = _schedules_root()
    return sorted(root["items"].values(), key=lambda s: s["id"])

def get_due_schedules(now_dt):
    root = _schedules_root()
    due = []
    for s in root["items"].values():
        if s.get("status") != "active":
            continue
        try:
            nr = datetime.fromisoformat(s["next_run"])
        except Exception:
            continue
        if nr <= now_dt:
            due.append(s)
    return due

def compute_next_run(current_next_run, repeat_type, repeat_days):
    """ត្រឡប់ next_run បន្ទាប់ (datetime object) សម្រាប់ Schedule ដដែលៗ, ឬ None សម្រាប់ 'once'។"""
    if repeat_type == "once":
        return None
    if repeat_type == "daily":
        return current_next_run + timedelta(days=1)
    if repeat_type == "weekly":
        return current_next_run + timedelta(days=7)
    if repeat_type == "custom" and repeat_days:
        for add_days in range(1, 8):
            cand = current_next_run + timedelta(days=add_days)
            if cand.weekday() in repeat_days:
                return cand
    return current_next_run + timedelta(days=1)  # fallback, shouldn't normally hit

def advance_schedule_to_future(next_run, repeat_type, repeat_days, now_dt):
    """ពេល Resume Schedule ដែល next_run ចាស់ហួសពេលទៅហើយ (Bot ត្រូវបានបិទយូរ) — រុញ
    next_run ទៅមុខរហូតដល់ក្លាយជាពេលអនាគត វិញ (ជៀសវាង Post ថយក្រោយច្រើនក្នុងពេលតែមួយ)។"""
    guard = 0
    while next_run <= now_dt and guard < 400:
        nxt = compute_next_run(next_run, repeat_type, repeat_days)
        if nxt is None:
            return next_run
        next_run = nxt
        guard += 1
    return next_run

