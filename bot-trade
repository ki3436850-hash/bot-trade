    """ទាញយកទិន្នន័យ FRED ថ្មីៗ ដើម្បីបង្ហាញ 'និន្នាការ' (ឡើង/ចុះ/ថេរ) ជំនួសឲ្យលេខឋិតិឋេរតែមួយ។
    ចំណាំ៖ FRED ធ្វើបច្ចុប្បន្នភាព Fed Funds Rate ជា Daily (មិនមែន Real-time ក្នុងគិតជាម៉ោងទេ) ដូច្នេះ
    'រយៈពេល' ដែលបង្ហាញ គឺជាការប៉ាន់ស្មានយ៉ាងសមហេតុផលបំផុត ដោយផ្អែកលើភាពថ្មីនៃទិន្នន័យដែលមាន។"""
    url = (
        "https://api.stlouisfed.org/fred/series/observations"
        f"?series_id={series_id}&api_key={FRED_API_KEY}&file_type=json&sort_order=desc&limit={limit}"
    )
    try:
        res = await async_get(url, timeout=10)
        data = res.json()
        obs = [o for o in data.get("observations", []) if o.get("value") not in (".", None)]
        if not obs:
            logger.warning(f"FRED no observation for {series_id}: {data}")
            return None
        latest = obs[0]
        latest_val = float(latest["value"])
        result = {"latest_value": latest_val, "latest_date": latest["date"], "trend": None, "window_label": None}
        if len(obs) < 2:
            return result
        prev = obs[1]
        prev_val = float(prev["value"])
        diff = latest_val - prev_val
        try:
            latest_dt = datetime.strptime(latest["date"], "%Y-%m-%d")
            hours_elapsed = max((datetime.utcnow() - latest_dt).total_seconds() / 3600, 0)
        except Exception:
            hours_elapsed = 24
        if hours_elapsed <= 6:
            window_label = "4 ម៉ោង"
        elif hours_elapsed <= 18:
            window_label = "12 ម៉ោង"
        else:
            window_label = "24 ម៉ោង"
        if diff > 0.001:
            trend = f"⬆️ កើនឡើង {diff:.2f}%"
        elif diff < -0.001:
            trend = f"⬇️ ថយចុះ {abs(diff):.2f}%"
        else:
            trend = "➖ រក្សាស្ថេរភាព (មិនប្រែប្រួល)"
        result["trend"] = trend
        result["window_label"] = window_label
        return result
    except Exception as e:
        logger.warning(f"FRED trend error for {series_id}: {e}")
        return None

async def get_claude_commentary(prompt):
    """ប្រើ Claude API ដើម្បីបង្កើតការពន្យល់ជាភាសាមនុស្សអំពីទិន្នន័យវិភាគ។"""
    try:
        res = await async_post(
            "https://api.anthropic.com/v1/messages",
            headers={
                "x-api-key": CLAUDE_API_KEY,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json={
                "model": "claude-3-5-haiku-latest",
                "max_tokens": 300,
                "messages": [{"role": "user", "content": prompt}],
            },
            timeout=20,
        )
        data = res.json()
        parts = data.get("content", [])
        text = "".join(p.get("text", "") for p in parts if p.get("type") == "text")
        return text or None
    except Exception as e:
        logger.warning(f"Claude API error: {e}")
        return None

