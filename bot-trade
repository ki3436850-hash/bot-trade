async def db_search_listings(query, category=None, job_type=None, limit=20):
    """Case-insensitive substring search over name/company_name/text. Falls
    back to plain category scan (client-filtered) if ilike/or_ isn't
    supported by the installed supabase-py version."""
    def _run():
        q = supabase.table("listings").select("*") \
            .or_(f"name.ilike.%{query}%,company_name.ilike.%{query}%,text.ilike.%{query}%")
        if category:
            q = q.eq("category", category)
        return q.order("id", desc=True).limit(limit).execute()
    try:
        res = await _sb_call(_run)
        results = res.data or []
    except Exception as e:
        logger.warning(f"db_search_listings (ilike) failed, falling back to scan: {e}")
        def _run_scan():
            q = supabase.table("listings").select("*")
            if category:
                q = q.eq("category", category)
            return q.order("id", desc=True).limit(200).execute()
        try:
            res = await _sb_call(_run_scan)
            ql = query.lower()
            results = [l for l in (res.data or [])
                       if ql in (l.get("name") or "").lower()
                       or ql in (l.get("company_name") or "").lower()
                       or ql in (l.get("text") or "").lower()][:limit]
        except Exception as e2:
            logger.warning(f"db_search_listings scan fallback also failed: {e2}")
            return []
    if job_type:
        results = [l for l in results if l.get("job_type") == job_type]
    return results

async def db_get_listings_by_category(category, limit=10, before_id=None):
    """Keyset pagination: pass the smallest id already seen as before_id to
    fetch the next page. Scales to huge tables — no OFFSET, always uses the
    (category, id) index. Hides removed listings (status='removed'); if the
    status column doesn't exist yet it retries without that filter."""
    async def _try(hide):
        def _run():
            q = supabase.table("listings").select("*").eq("category", category)
            if hide:
                q = q.neq("status", "removed")
            q = q.order("id", desc=True).limit(limit)
            if before_id is not None:
                q = q.lt("id", int(before_id))
            return q.execute()
        return await _sb_call(_run)
    try:
        try:
            res = await _try(True)
        except Exception as e:
            logger.warning(f"db_get_listings_by_category: status filter unavailable, retrying without it: {e}")
            res = await _try(False)
        return res.data or []
    except Exception as e:
        logger.warning(f"db_get_listings_by_category failed: {e}")
        return []

