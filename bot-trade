user_data = {}

# Tracks which users' records have actually changed since the last save, so
# save_data() only needs to persist those — not every registered user.
# get_user_data() marks a user dirty as soon as its record is handed out
# (the caller is about to read/mutate it), which covers virtually every
# save_data() call site in the file without needing to touch all of them.
_dirty_uids = set()

def load_data():
    global user_data
    if supabase:
        try:
            res = supabase.table("users").select("*").execute()
            user_data = {item["user_id"]: item["data"] for item in res.data}
            logger.info("Loaded from Supabase")
        except Exception as e:
            logger.error(f"Supabase load failed: {e}")
            user_data = {}
    else:
        if os.path.exists(DATA_FILE):
            try:
                with open(DATA_FILE, "r", encoding="utf-8") as f:
                    user_data = json.load(f)
            except Exception as e:
                logger.error(f"JSON load failed: {e}")
                user_data = {}

def _do_save_sync(dirty_snapshot):
    """The actual blocking I/O — always run this off the event loop (via a
    background thread), never directly on it. Only touches users that
    changed (dirty_snapshot), instead of looping over every registered user."""
    if supabase:
        try:
            for uid in dirty_snapshot:
                data = user_data.get(uid)
                if data is not None:
                    supabase.table("users").upsert({"user_id": uid, "data": data}).execute()
            logger.info(f"Saved {len(dirty_snapshot)} user(s) to Supabase")
        except Exception as e:
            logger.error(f"Supabase save failed: {e}")
    else:
        try:
            with open(DATA_FILE, "w", encoding="utf-8") as f:
                json.dump(user_data, f, ensure_ascii=False, indent=2)
        except Exception as e:
            logger.error(f"JSON save failed: {e}")

def save_data():
    """Fire-and-forget save: takes a snapshot of whichever users changed,
    then hands the actual network/disk I/O to a background thread so the
    handler that called this can reply to the user immediately instead of
    waiting on Supabase/disk. Falls back to a normal blocking save if there's
    no running event loop yet (e.g. called during startup before polling begins)."""
    global _dirty_uids
    if not supabase:
        # Single local file write is cheap; still keep it off the loop when possible.
        snapshot = None
    else:
        if not _dirty_uids:
            return
        snapshot = set(_dirty_uids)
        _dirty_uids = set()
    try:
        loop = asyncio.get_running_loop()
        loop.run_in_executor(None, _do_save_sync, snapshot)
    except RuntimeError:
        # No running loop (e.g. startup) — just save synchronously.
        _do_save_sync(snapshot)

