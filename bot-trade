_RETRYABLE_MARKERS = ("429", "500", "502", "503", "504", "timeout", "Timeout", "Timed out")

async def _call_with_retry(provider_name, call_fn, retries=2):
    """ហៅ Provider (តាម call_fn គ្មាន Argument — ប្រើ lambda/closure) ជាមួយ Retry +
    Exponential Backoff សម្រាប់ Error បណ្តោះអាសន្ន (Rate-limit 429 / Server 5xx / Timeout)។
    ត្រឡប់ (text, error)។ ប្រើរួមគ្នាទាំង Text Router និង Vision Router។"""
    delay = 1.0
    last_err = None
    for attempt in range(retries + 1):
        try:
            text, err = await call_fn()
        except Exception as e:
            text, err = None, str(e)
        if text:
            _record_success(provider_name)
            return text, None
        last_err = err
        retryable = err and any(marker in str(err) for marker in _RETRYABLE_MARKERS)
        if attempt < retries and retryable:
            await asyncio.sleep(delay)
            delay *= 2
            continue
        break
    _record_failure(provider_name, last_err)
    return None, last_err


async def ai_router_generate(mode, messages, max_tokens=None):
    """ព្យាយាមហៅ Provider តាមលំដាប់ Fallback សម្រាប់ Mode នេះ (រំលងបណ្តោះអាសន្នរាល់ Provider
    ដែលកំពុង Cooldown ដោយសារបរាជ័យជាប់ៗគ្នា)។ ត្រឡប់ (text, provider_used, error_summary) —
    error_summary ជា None ពេលជោគជ័យ។ មិនធ្លាប់ Throw Exception ទេ សូម្បីតែ Provider ទាំងអស់
    បរាជ័យក៏ដោយ។ max_tokens=None ប្រើតម្លៃលំនាំដើមតាម Mode (មើល AI_MODE_MAX_TOKENS)។"""
    if max_tokens is None:
        max_tokens = AI_MODE_MAX_TOKENS.get(mode, 1200)
    chain = AI_PROVIDER_CHAINS.get(mode, [])
    errors = []
    for provider_name in chain:
        func = PROVIDER_CALL_FUNCS.get(provider_name)
        if not func:
            continue
        if _provider_on_cooldown(provider_name):
            errors.append(f"{provider_name}: skip (cooldown ក្រោយបរាជ័យជាប់ៗគ្នា)")
            logger.info(f"AI Router [{mode}] skipping {provider_name} (cooldown)")
            continue
        text, err = await _call_with_retry(provider_name, lambda f=func: f(messages, max_tokens=max_tokens))
        if text:
            return text, provider_name, None
        errors.append(f"{provider_name}: {err}")
        logger.warning(f"AI Router [{mode}] provider {provider_name} failed: {err}")
    return None, None, " | ".join(errors) if errors else "គ្មាន Provider ណាមួយ Config ទេ"


# ---------- Vision Router (Section 11: 📷 Image / Vision) ----------
# Gemini Vision → OpenRouter Vision, per spec. Used inside Teacher modes
# whenever the user sends a photo instead of text (e.g. a code screenshot
# for 💻 Coding Teacher, or a problem photo once 🧮 Math Teacher is wired).

async def call_gemini_vision(image_bytes, mime_type, prompt, max_tokens=1500):
    if not GEMINI_API_KEY:
        return None, "GEMINI_API_KEY មិនទាន់ Setup ទេ"
    try:
        b64 = base64.b64encode(image_bytes).decode("utf-8")
        payload = {
            "contents": [{
                "role": "user",
                "parts": [
                    {"text": prompt},
                    {"inline_data": {"mime_type": mime_type, "data": b64}},
                ],
            }],
            "generationConfig": {"maxOutputTokens": max_tokens},
        }
        url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent"
        r = await async_post(url, params={"key": GEMINI_API_KEY}, json=payload, timeout=45)
        if r.status_code != 200:
            return None, f"Gemini Vision HTTP {r.status_code}: {r.text[:200]}"
        data = r.json()
        return data["candidates"][0]["content"]["parts"][0]["text"], None
    except Exception as e:
        return None, str(e)


async def call_openrouter_vision(image_bytes, mime_type, prompt, max_tokens=1500, model="openrouter/auto"):
    if not OPENROUTER_API_KEY:
        return None, "OPENROUTER_API_KEY មិនទាន់ Setup ទេ"
    try:
        b64 = base64.b64encode(image_bytes).decode("utf-8")
        payload = {
            "model": model,
            "messages": [{
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {"type": "image_url", "image_url": {"url": f"data:{mime_type};base64,{b64}"}},
                ],
            }],
            "max_tokens": max_tokens,
        }
        r = await async_post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers={"Authorization": f"Bearer {OPENROUTER_API_KEY}", "Content-Type": "application/json"},
            json=payload, timeout=45,
        )
        if r.status_code != 200:
            return None, f"OpenRouter Vision HTTP {r.status_code}: {r.text[:200]}"
        data = r.json()
        return data["choices"][0]["message"]["content"], None
    except Exception as e:
        return None, str(e)


VISION_PROVIDER_CHAIN = [
    ("gemini", call_gemini_vision),
    ("openrouter", call_openrouter_vision),
]

async def ai_router_generate_vision(image_bytes, mime_type, prompt, max_tokens=1500):
    """Vision fallback chain៖ Gemini Vision → OpenRouter Vision។
    ត្រឡប់ (text, provider_used, error_summary)។"""
    errors = []
    for provider_name, func in VISION_PROVIDER_CHAIN:
        if _provider_on_cooldown(provider_name):
            errors.append(f"{provider_name}: skip (cooldown)")
            continue
        text, err = await _call_with_retry(
            provider_name, lambda f=func: f(image_bytes, mime_type, prompt, max_tokens))
        if text:
            return text, provider_name, None
        errors.append(f"{provider_name}: {err}")
        logger.warning(f"AI Router [vision] provider {provider_name} failed: {err}")
    return None, None, " | ".join(errors) if errors else "គ្មាន Provider ណាមួយ Config ទេ"


# ---------- Voice Router (Section 10: 🎤 Voice Support) ----------
# Groq Whisper speech-to-text → transcript gets routed into whatever
# Teacher mode the user currently has active, the same as if they had typed it.

async def transcribe_audio(file_bytes, filename="voice.ogg"):
    """បម្លែងសំឡេងទៅជាអត្ថបទ ដោយប្រើ Groq Whisper។ ត្រឡប់ (text, error)។"""
    if not GROQ_API_KEY:
        return None, "GROQ_API_KEY មិនទាន់ Setup ទេ"
    try:
        r = await async_post(
            "https://api.groq.com/openai/v1/audio/transcriptions",
            headers={"Authorization": f"Bearer {GROQ_API_KEY}"},
            files={"file": (filename, file_bytes)},
            data={"model": "whisper-large-v3-turbo"},
            timeout=45,
        )
        if r.status_code != 200:
            return None, f"Whisper HTTP {r.status_code}: {r.text[:200]}"
        data = r.json()
        text = (data.get("text") or "").strip()
        return (text or None), (None if text else "Whisper ត្រឡប់អត្ថបទទទេ")
    except Exception as e:
        return None, str(e)


