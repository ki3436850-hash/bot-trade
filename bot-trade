        await q.message.reply_text(_MK_EDIT_PROMPTS[field], parse_mode="HTML", reply_markup=_mk_edit_kb(field))
        return True

    if data.startswith("mk_pd_"):
        listing = await market_get_owned_listing(q, uid, int(data[len("mk_pd_"):]))
