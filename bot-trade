        )
    ud["teacher_credits_used"] = used + 1
    return True, None

# --- Provider health / usage tracking (in-process; resets on restart) ---
# Section 21/30 ask for "provider health status" + "usage tracking". This is
# a lightweight in-memory version — good enough to skip a provider that's
# currently failing repeatedly within a single bot run. If this needs to
# survive restarts later, persist _provider_stats the same way user_data is
# persisted (e.g. under user_data["_provider_stats"]).
_provider_stats = {}  # name -> {"success": int, "fail": int, "last_error": str|None, "last_fail_ts": float|None}

PROVIDER_COOLDOWN_SECONDS = 60    # skip a failing provider for this long
PROVIDER_COOLDOWN_THRESHOLD = 3   # consecutive fails before cooldown kicks in

# --- Non-blocking HTTP helpers ---
# `requests` is synchronous. Calling it directly inside an `async def` still
# blocks the ONE event loop the whole bot runs on — so while one user's AI
# call is in flight (up to 30-45s), every other user's button clicks and
# messages freeze too. Routing every call through asyncio.to_thread() moves
# the blocking I/O onto a worker thread so the event loop stays free to keep
# serving everyone else. Always use these two helpers (never requests.* directly)
# for any new HTTP call added to the bot.
async def async_get(*args, **kwargs):
    return await asyncio.to_thread(requests.get, *args, **kwargs)

async def async_put(*args, **kwargs):
    return await asyncio.to_thread(requests.put, *args, **kwargs)

async def async_post(*args, **kwargs):
    return await asyncio.to_thread(requests.post, *args, **kwargs)

def _provider_stat(name):
    return _provider_stats.setdefault(name, {"success": 0, "fail": 0, "last_error": None, "last_fail_ts": None})

def _provider_on_cooldown(name):
    st = _provider_stat(name)
    if st["fail"] < PROVIDER_COOLDOWN_THRESHOLD or st["last_fail_ts"] is None:
        return False
    return (time.time() - st["last_fail_ts"]) < PROVIDER_COOLDOWN_SECONDS

def _record_success(name):
    st = _provider_stat(name)
    st["success"] += 1
    st["fail"] = 0

def _record_failure(name, err):
    st = _provider_stat(name)
    st["fail"] += 1
    st["last_error"] = err
    st["last_fail_ts"] = time.time()

def provider_health_summary():
    """អត្ថបទសង្ខេប Provider Health — សម្រាប់ Admin ពិនិត្យបញ្ហា (Section 30)។"""
    if not _provider_stats:
        return "គ្មានទិន្នន័យ Provider នៅឡើយទេ (មិនទាន់មាន Request ណាមួយ)។"
    lines = []
    for name, st in _provider_stats.items():
        status = "🟡 Cooldown" if _provider_on_cooldown(name) else "🟢 OK"
        lines.append(f"{status} *{name}* — success: {st['success']}, fail: {st['fail']}"
                      + (f"\n   Error ចុងក្រោយ: {st['last_error'][:120]}" if st["last_error"] else ""))
    return "\n".join(lines)


async def call_deepseek(messages, max_tokens=1200):
    if not DEEPSEEK_API_KEY:
        return None, "DEEPSEEK_API_KEY មិនទាន់ Setup ទេ"
    try:
        r = await async_post(
            "https://api.deepseek.com/chat/completions",
            headers={"Authorization": f"Bearer {DEEPSEEK_API_KEY}", "Content-Type": "application/json"},
            json={"model": "deepseek-chat", "messages": messages, "max_tokens": max_tokens},
            timeout=30,
        )
        if r.status_code != 200:
            return None, f"DeepSeek HTTP {r.status_code}: {r.text[:200]}"
        data = r.json()
        return data["choices"][0]["message"]["content"], None
    except Exception as e:
        return None, str(e)


async def call_gemini_text(messages, max_tokens=1200):
    if not GEMINI_API_KEY:
        return None, "GEMINI_API_KEY មិនទាន់ Setup ទេ"
    try:
        contents, system_instruction = [], None
        for m in messages:
            if m["role"] == "system":
                system_instruction = m["content"]
                continue
            contents.append({"role": "user" if m["role"] == "user" else "model",
                              "parts": [{"text": m["content"]}]})
        payload = {"contents": contents, "generationConfig": {"maxOutputTokens": max_tokens}}
        if system_instruction:
            payload["system_instruction"] = {"parts": [{"text": system_instruction}]}
        url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent"
        r = await async_post(url, params={"key": GEMINI_API_KEY}, json=payload, timeout=30)
        if r.status_code != 200:
            return None, f"Gemini HTTP {r.status_code}: {r.text[:200]}"
        data = r.json()
        return data["candidates"][0]["content"]["parts"][0]["text"], None
    except Exception as e:
        return None, str(e)


