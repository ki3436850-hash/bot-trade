async def category_admin_handle_text(update, context, ud, text):
    """Text-input side of /categories. Returns True if it consumed the message."""
    state = ud.get("cat_admin_state")
    text = text.strip()

    if state == "awaiting_new_label":
        if not text:
            await update.message.reply_text("❌ សូមវាយឈ្មោះមួយ។")
            return True
        base_key = _slugify_category_key(re.sub(r"[^\w\s]", "", text, flags=re.UNICODE) or text)
        existing = {r["key"] for r in await get_all_categories_admin()}
        key = base_key
        n = 2
        while key in existing:
            key = f"{base_key}_{n}"
            n += 1
        created = await db_create_category(key, text[:80])
        ud["cat_admin_state"] = None
        ud["cat_admin_temp"] = {}
        save_data()
        if created:
            await update.message.reply_text(f"✅ បានបន្ថែមប្រភេទ *{text[:80]}* រួចរាល់។", parse_mode="Markdown")
        else:
            await update.message.reply_text("❌ មិនអាចបន្ថែមបានទេ សូមសាកល្បងម្តងទៀត។")
        await update.message.reply_text(
            "🗂️ *គ្រប់គ្រងប្រភេទទំនិញ (Categories)*",
            parse_mode="Markdown", reply_markup=await category_admin_list_keyboard())
        return True

    if state == "awaiting_rename":
        key = (ud.get("cat_admin_temp") or {}).get("key")
        if not key:
            ud["cat_admin_state"] = None
            save_data()
            await update.message.reply_text("❌ សូមចាប់ផ្ដើមម្តងទៀតតាម /categories។")
