async def schedule_handle_datetime_text(update, context, ud, text):
    try:
        naive = datetime.strptime(text.strip(), "%Y-%m-%d %H:%M")
    except ValueError:
        await update.message.reply_text(
            "❌ ទម្រង់ម៉ោងមិនត្រឹមត្រូវ។ សូមប្រើទម្រង់៖ `YYYY-MM-DD HH:MM`\nឧ. `2026-09-20 18:30`",
            parse_mode="Markdown")
        return
    dt = naive.replace(tzinfo=PHNOM_PENH_TZ)
    now = datetime.now(PHNOM_PENH_TZ)
    if dt <= now:
        await update.message.reply_text("❌ ម៉ោងនេះកន្លងផុតទៅហើយ។ សូមបញ្ចូលម៉ោងនាពេលអនាគត។")
        return
    ud["schedule_temp"]["datetime_iso"] = dt.isoformat()
    ud["schedule_state"] = "awaiting_repeat"
    save_data()
    await update.message.reply_text("🔁 Repeat Options:", reply_markup=schedule_repeat_keyboard())

