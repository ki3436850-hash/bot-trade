            return True
        clear_conversation_modes(ud)
        ud["store_state"] = "mk_shop_name"
        ud["mk_temp"] = {"shop": {}}
        save_data()
        await q.message.reply_text(
            f"🏪 សូមវាយ <b>ឈ្មោះហាង</b> ({MK_SHOP_NAME_MIN}–{MK_SHOP_NAME_MAX} តួអក្សរ)៖\nឧ. ABC Store",
            parse_mode="HTML", reply_markup=_mk_cancel_kb())
        return True

    if data == "mk_shop_skipdesc":
        if ud.get("store_state") != "mk_shop_desc":
            await safe_alert(q, "⚠️ ជំហាននេះផុតកំណត់ហើយ។")
            return True
        ud["store_state"] = "mk_shop_logo"
        save_data()
        await q.message.reply_text(
            "🖼️ ផ្ញើ <b>រូប Logo</b> របស់ហាង (ស្រេចចិត្ត)៖", parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("⏭️ រំលង", callback_data="mk_shop_skiplogo")],
                                               [InlineKeyboardButton("❌ បោះបង់", callback_data="mk_cancel")]]))
        return True

    if data == "mk_shop_skiplogo":
        if ud.get("store_state") != "mk_shop_logo":
            await safe_alert(q, "⚠️ ជំហាននេះផុតកំណត់ហើយ។")
            return True
        await market_finish_shop_creation(q.message, context, ud, uid, None)
        return True

    # ---------- public shop ----------
    if data.startswith("mk_shopv_"):
        shop = await db_get_shop(data[len("mk_shopv_"):])
        if not shop or (shop.get("status") or "active") != "active":
            await safe_alert(q, "❌ រកមិនឃើញហាងនេះទេ ឬហាងត្រូវបានផ្អាក។")
            return True
        await market_show_shop_page(q.message, context.bot.username, shop, uid)
        return True

    if data.startswith("mk_shopp_"):
        _, _, shop_id, before = data.split("_", 3)
        shop = await db_get_shop(shop_id)
        if not shop or (shop.get("status") or "active") != "active":
            await safe_alert(q, "❌ រកមិនឃើញហាងនេះទេ ឬហាងត្រូវបានផ្អាក។")
            return True
        await market_show_shop_products(q.message.chat, context.bot.username, shop, uid,
                                        before_id=int(before) or None)
