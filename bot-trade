def build_job_caption(listing, cat_name):
    """Job Details Screen layout (Master Prompt Section 7) — reuses the same
    'name' column as Job Title so old generic-listing code paths keep working
    unmodified; job_* fields are simply absent (None) for non-job listings."""
    title = listing.get("name") or "ការងារ"
    lines = [f"💼 *{title}*", ""]
    if listing.get("company_name"):
        lines.append(f"🏢 {listing['company_name']}")
    if listing.get("job_location"):
        lines.append(f"📍 {listing['job_location']}")
    if listing.get("salary_text"):
        lines.append(f"💰 {listing['salary_text']}")
    if listing.get("job_type"):
        lines.append(JOB_TYPE_LABELS.get(listing["job_type"], listing["job_type"]))
    positions = listing.get("positions")
    if positions:
        lines.append(f"👥 {positions} positions")
    status = listing.get("status") or "active"
    if status == "closed":
        lines.append("🔴 Closed")
    elif status == "paused":
        lines.append("🟡 Paused")
    lines.append("")
    lines.append("📝 Job Description")
    lines.append(listing.get("text") or "")
    if listing.get("requirements"):
        lines.append("")
        lines.append("Requirements:")
        for r in listing["requirements"].split("\n"):
            if r.strip():
                lines.append(f"• {r.strip()}")
    if listing.get("benefits"):
        lines.append("")
        lines.append("Benefits:")
        for b in listing["benefits"].split("\n"):
            if b.strip():
                lines.append(f"• {b.strip()}")
    return "\n".join(lines)

def build_any_listing_caption(listing, cat_name):
    """សម្រាប់ហៅដោយកន្លែងបង្ហាញទំនិញទូទៅ — ជ្រើសរើស Job Layout ស្វ័យប្រវត្តិ
    ពេល category == 'job', មិនដូច្នេះប្រើ Layout ទំនិញធម្មតា។"""
    if listing.get("category") == "job":
        return build_job_caption(listing, cat_name)
    return build_listing_caption(listing, cat_name)

