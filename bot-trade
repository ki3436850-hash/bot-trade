def calculate_rsi(df, period=14):
    delta = df["close"].diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
    rs = gain / loss
    rsi = 100 - (100 / (1 + rs))
    return rsi.iloc[-1]

def calculate_macd(df):
    exp1 = df["close"].ewm(span=12, adjust=False).mean()
    exp2 = df["close"].ewm(span=26, adjust=False).mean()
    macd_line = exp1 - exp2
    signal_line = macd_line.ewm(span=9, adjust=False).mean()
    hist = macd_line - signal_line
    return macd_line.iloc[-1], signal_line.iloc[-1], hist.iloc[-1]

def calculate_ema(df, period):
    return df["close"].ewm(span=period, adjust=False).mean().iloc[-1]

def calculate_sma(df, period):
    return df["close"].rolling(window=period).mean().iloc[-1]

def calculate_atr(df, period=14):
    """Average True Range — used to size the stop-loss distance (spec §15)."""
    high, low, close = df["high"], df["low"], df["close"]
    prev_close = close.shift(1)
    tr = pd.concat([
        (high - low).abs(),
        (high - prev_close).abs(),
        (low - prev_close).abs(),
    ], axis=1).max(axis=1)
    return tr.rolling(window=period).mean().iloc[-1]

def calculate_bollinger(df, period=20, num_std=2):
    """Bollinger Bands (upper, mid, lower). Returns (None, None, None) when
    there isn't enough history to trust the read, rather than a noisy
    early value — same convention as calculate_stochastic/calculate_adx."""
    if len(df) < period:
        return None, None, None
    sma = df["close"].rolling(window=period).mean()
    std = df["close"].rolling(window=period).std()
    upper = sma + num_std * std
    lower = sma - num_std * std
    u, m, l = upper.iloc[-1], sma.iloc[-1], lower.iloc[-1]
    if pd.isna(u) or pd.isna(m) or pd.isna(l):
        return None, None, None
    return float(u), float(m), float(l)

def calculate_stochastic(df, k_period=14, d_period=3):
    """Stochastic Oscillator %K/%D (spec §8). Returns (None, None) when there
    isn't enough history to trust the read, rather than a noisy early value."""
    if len(df) < k_period + d_period:
        return None, None
    low_min = df["low"].rolling(window=k_period).min()
    high_max = df["high"].rolling(window=k_period).max()
    rng = (high_max - low_min).replace(0, np.nan)
    percent_k = (df["close"] - low_min) / rng * 100
    percent_d = percent_k.rolling(window=d_period).mean()
    k_val, d_val = percent_k.iloc[-1], percent_d.iloc[-1]
    if pd.isna(k_val) or pd.isna(d_val):
        return None, None
    return float(k_val), float(d_val)

def calculate_adx(df, period=14):
    """ADX + DI+/DI- (spec §8), Wilder's smoothing. Returns (None, None, None)
    with too little history rather than a noisy early value."""
    if len(df) < period * 2:
        return None, None, None
    high, low, close = df["high"], df["low"], df["close"]
    prev_high, prev_low, prev_close = high.shift(1), low.shift(1), close.shift(1)
    up_move = high - prev_high
    down_move = prev_low - low
    plus_dm = pd.Series(0.0, index=df.index)
    minus_dm = pd.Series(0.0, index=df.index)
    up_wins = (up_move > down_move) & (up_move > 0)
    down_wins = (down_move > up_move) & (down_move > 0)
    plus_dm[up_wins] = up_move[up_wins]
    minus_dm[down_wins] = down_move[down_wins]
    tr = pd.concat([(high - low).abs(), (high - prev_close).abs(), (low - prev_close).abs()], axis=1).max(axis=1)
    atr = tr.ewm(alpha=1 / period, adjust=False).mean()
    plus_di = 100 * (plus_dm.ewm(alpha=1 / period, adjust=False).mean() / atr)
    minus_di = 100 * (minus_dm.ewm(alpha=1 / period, adjust=False).mean() / atr)
    dx = ((plus_di - minus_di).abs() / (plus_di + minus_di).replace(0, np.nan)) * 100
    adx = dx.ewm(alpha=1 / period, adjust=False).mean()
    a, p, m = adx.iloc[-1], plus_di.iloc[-1], minus_di.iloc[-1]
    if pd.isna(a) or pd.isna(p) or pd.isna(m):
        return None, None, None
    return float(a), float(p), float(m)

def _swing_extremes(values, window, find_min):
    """Positions i (window <= i < n-window) whose value equals the min (or max) of its
    +/-window neighbourhood. Vectorised with numpy: identical result to the old per-bar loop,
    ~50x faster - this is what makes per-bar backtests practical."""
    arr = np.asarray(values, dtype=float)
    n = len(arr)
    if n < 2 * window + 1:
        return arr[:0]
    wins = np.lib.stride_tricks.sliding_window_view(arr, 2 * window + 1)
    ext = wins.min(axis=1) if find_min else wins.max(axis=1)
    centre = arr[window:n - window]
    return centre[centre == ext]

def find_support_resistance(df, window=5):
    supports = [float(v) for v in _swing_extremes(df["low"].to_numpy(), window, True)]
    resistances = [float(v) for v in _swing_extremes(df["high"].to_numpy(), window, False)]
    current_price = df["close"].iloc[-1]
    support = max([s for s in supports if s < current_price], default=current_price*0.98)
    resistance = min([r for r in resistances if r > current_price], default=current_price*1.02)
    return support, resistance

