PDF_MAX_FILE_BYTES = 8 * 1024 * 1024   # 8MB
PDF_MAX_PAGES = 30
PDF_MAX_CHARS = 15000                  # ដកចេញ Text ច្រើនជាងនេះមិនប្រើ — កាត់ Token Usage (Section 31)

PDF_TEACHER_BASE_PROMPT = (
    "អ្នកគឺជាជំនួយការអានឯកសារ PDF។ ខាងក្រោមនេះជាអត្ថបទដែលបានស្រង់ចេញពី PDF របស់ User "
    "(អាចមិនពេញលេញ ព្រោះមានកំណត់ទំហំ)៖\n\n---\n{pdf_text}\n---\n\n"
)

def extract_pdf_text(file_bytes):
    """ត្រឡប់ (text, error, truncated_bool)។ កំណត់ចំនួនទំព័រ និងចំនួនអក្សរ (Section 12: 'Set
    reasonable limits')។"""
    if PdfReader is None:
        return None, "កម្មវិធីអាន PDF (pypdf) មិនទាន់ Setup លើ Server ទេ — សូមប្រាប់ Admin `pip install pypdf`។", False
    try:
        reader = PdfReader(io.BytesIO(file_bytes))
        pages = reader.pages[:PDF_MAX_PAGES]
        chunks = []
        for page in pages:
            chunks.append(page.extract_text() or "")
        text = "\n".join(chunks).strip()
        if not text:
            return None, "មិនអាចស្រង់ Text ចេញពី PDF នេះបានទេ (ប្រហែលជា Scanned Image PDF)។", False
        truncated = len(text) > PDF_MAX_CHARS or len(reader.pages) > PDF_MAX_PAGES
        return text[:PDF_MAX_CHARS], None, truncated
    except Exception as e:
        return None, str(e), False


async def handle_document(update, context):
