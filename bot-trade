# /customer — External Customer Management (CRM for admin's business
# customers, e.g. Signal/service subscribers OUTSIDE this bot's own RPG
# user base). Fully independent data root ("_customers") and state key
# ("customer_state") — does not touch users/orders/store/schedule data.
# Admin-only throughout (reuses is_admin()).
#
# NOTE: This bot has no existing Orders/Payments/Subscription system for
# external business customers (the /store marketplace is peer-to-peer
# between bot users, unrelated) — so this module intentionally ships
# Profile + Notes + Statistics only. total_spent is a manually-edited
# number (admin enters it themselves), not computed from a payment
# gateway. Orders/Payments/Subscription integration can be added later
# without changing this module's shape.
# ============================================================
CUSTOMER_TYPES = [("normal", "👤 Normal"), ("vip", "⭐ VIP"), ("premium", "💎 Premium")]
CUSTOMER_TYPE_LABELS = dict(CUSTOMER_TYPES)
CUSTOMER_PAGE_SIZE = 10

def _customers_root():
    root = user_data.setdefault("_customers", {"next_id": 1, "items": {}})
    root.setdefault("next_id", 1)
    root.setdefault("items", {})
    return root

def find_customer_by_telegram_id(telegram_id):
    if not telegram_id:
        return None
    root = _customers_root()
    for c in root["items"].values():
        if c.get("status") != "deleted" and str(c.get("telegram_user_id") or "") == str(telegram_id):
            return c
    return None

def create_customer(admin_id, name, username, telegram_user_id, phone, email, customer_type):
    root = _customers_root()
    cid = root["next_id"]
    root["next_id"] += 1
    now_iso = datetime.now(PHNOM_PENH_TZ).isoformat()
    root["items"][str(cid)] = {
        "id": cid,
        "name": name,
        "username": username or None,
        "telegram_user_id": str(telegram_user_id) if telegram_user_id else None,
        "phone": phone or None,
        "email": email or None,
        "customer_type": customer_type,
        "status": "active",
        "total_spent": 0.0,
        "notes": [],  # [{id, admin_id, note, created_at}]
        "created_by": str(admin_id),
        "created_at": now_iso,
        "updated_at": now_iso,
    }
    _dirty_uids.add("_customers")
    save_data()
    return cid

def get_customer(cid):
    return _customers_root()["items"].get(str(cid))

def update_customer(cid, **fields):
    root = _customers_root()
    c = root["items"].get(str(cid))
    if not c:
        return
    c.update(fields)
    c["updated_at"] = datetime.now(PHNOM_PENH_TZ).isoformat()
    _dirty_uids.add("_customers")
    save_data()

def soft_delete_customer(cid):
    update_customer(cid, status="deleted")

def add_customer_note(cid, admin_id, note_text):
    root = _customers_root()
    c = root["items"].get(str(cid))
    if not c:
        return
    notes = c.setdefault("notes", [])
    note_id = (max((n["id"] for n in notes), default=0)) + 1
    notes.append({
        "id": note_id, "admin_id": str(admin_id), "note": note_text,
        "created_at": datetime.now(PHNOM_PENH_TZ).isoformat(),
    })
    c["updated_at"] = datetime.now(PHNOM_PENH_TZ).isoformat()
    _dirty_uids.add("_customers")
    save_data()

def delete_customer_note(cid, note_id):
    root = _customers_root()
    c = root["items"].get(str(cid))
    if not c:
        return
    c["notes"] = [n for n in c.get("notes", []) if n["id"] != note_id]
    c["updated_at"] = datetime.now(PHNOM_PENH_TZ).isoformat()
    _dirty_uids.add("_customers")
    save_data()

def list_customers(customer_type=None, active_only=True):
    root = _customers_root()
    items = list(root["items"].values())
    if active_only:
        items = [c for c in items if c.get("status") != "deleted"]
    if customer_type == "vip_premium":
        items = [c for c in items if c.get("customer_type") in ("vip", "premium")]
    elif customer_type:
        items = [c for c in items if c.get("customer_type") == customer_type]
    return sorted(items, key=lambda c: c["id"])

def search_customers(query):
    q = query.strip().lower()
    root = _customers_root()
    results = []
    for c in root["items"].values():
        if c.get("status") == "deleted":
            continue
        haystacks = [
            str(c["id"]), (c.get("name") or "").lower(), (c.get("username") or "").lower(),
            (c.get("telegram_user_id") or ""), (c.get("phone") or ""),
        ]
        if any(q in h.lower() if isinstance(h, str) else q in h for h in haystacks):
            results.append(c)
    return sorted(results, key=lambda c: c["id"])

def customer_statistics():
    root = _customers_root()
    items = [c for c in root["items"].values() if c.get("status") != "deleted"]
    now = datetime.now(PHNOM_PENH_TZ)
    today = now.date()
    week_ago = now - timedelta(days=7)
    month_ago = now - timedelta(days=30)
    new_today = new_week = new_month = 0
    for c in items:
        try:
            created = datetime.fromisoformat(c["created_at"])
        except Exception:
            continue
        if created.date() == today:
            new_today += 1
        if created >= week_ago:
            new_week += 1
        if created >= month_ago:
            new_month += 1
    return {
        "total": len(items),
        "new_today": new_today, "new_week": new_week, "new_month": new_month,
        "vip": sum(1 for c in items if c.get("customer_type") == "vip"),
        "premium": sum(1 for c in items if c.get("customer_type") == "premium"),
        "total_spent": sum(c.get("total_spent") or 0 for c in items),
    }

