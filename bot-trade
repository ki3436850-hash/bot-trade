VIDEO_URL_EXTENSIONS = (".mp4", ".mov", ".avi", ".webm", ".mkv", ".m4v")
VIDEO_FILE_ID_PREFIX = "video:"

def _is_video_url(url):
    """ស្គាល់ថា Link/File ID នេះជា Video ឬអត់។
    ចំពោះ Link ខាងក្រៅ (មាន http/https) សម្គាល់តាម File Extension (.mp4 ។ល។)។
    ចំពោះ Telegram File ID (មិនមែន URL) មិនមាន Extension អ្វីទេ ដូច្នេះត្រូវដាក់
    Prefix 'video:' ខាងមុខ File ID ក្នុង LIBRARY_BOOKS ដើម្បីប្រាប់ថាវាជា Video
    (ឧ. "video:AwACAgIAAxkBAAIC...") — បើគ្មាន Prefix នេះ កូដនឹងសន្មតថាជា Photo ។"""
    if not isinstance(url, str):
        return False
    if url.startswith(VIDEO_FILE_ID_PREFIX):
        return True
    path = url.lower().split("?")[0].split("#")[0]
    return path.endswith(VIDEO_URL_EXTENSIONS)


def _strip_video_prefix(url):
    """លុប Prefix 'video:' ចេញ (បើមាន) មុននឹងបញ្ជូនទៅ Telegram API — Prefix នេះសម្រាប់
    ឲ្យកូដសម្គាល់ប្រភេទ Media ប៉ុណ្ណោះ មិនមែនផ្នែកនៃ File ID/URL ពិតទេ។"""
    if isinstance(url, str) and url.startswith(VIDEO_FILE_ID_PREFIX):
        return url[len(VIDEO_FILE_ID_PREFIX):]
    return url


