async def _youtube_get_access_token():
    refresh_token = get_youtube_refresh_token()
    if not (YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET and refresh_token):
        return None, "YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET / YOUTUBE_REFRESH_TOKEN មិនទាន់ Setup ទេ (ប្រើ /youtubeconnect)"
    try:
        r = await async_post("https://oauth2.googleapis.com/token", data={
            "client_id": YOUTUBE_CLIENT_ID,
            "client_secret": YOUTUBE_CLIENT_SECRET,
            "refresh_token": refresh_token,
            "grant_type": "refresh_token",
        }, timeout=30)
        if r.status_code != 200:
            return None, f"YouTube OAuth Token HTTP {r.status_code}: {r.text[:200]}"
        return r.json().get("access_token"), None
    except Exception as e:
        return None, str(e)

async def publish_to_youtube(video_bytes, caption):
    """YouTube Data API v3 resumable upload. Returns (ok, detail)."""
    access_token, err = await _youtube_get_access_token()
    if not access_token:
        return False, err
    first_line = (caption or "").strip().splitlines()
    title = (first_line[0] if first_line else "Untitled")[:95]
    try:
        init_r = await async_post(
            "https://www.googleapis.com/upload/youtube/v3/videos",
            params={"uploadType": "resumable", "part": "snippet,status"},
            headers={
                "Content-Type": "application/json; charset=UTF-8",
                "Authorization": f"Bearer {access_token}",
                "X-Upload-Content-Type": "video/mp4",
                "X-Upload-Content-Length": str(len(video_bytes)),
            },
            json={
                "snippet": {"title": title, "description": (caption or "")[:4900]},
                "status": {"privacyStatus": "public", "selfDeclaredMadeForKids": False},
            },
            timeout=30,
        )
        if init_r.status_code not in (200, 201):
            return False, f"YouTube Init HTTP {init_r.status_code}: {init_r.text[:200]}"
        upload_url = init_r.headers.get("Location")
        if not upload_url:
            return False, "YouTube: មិនទទួលបាន Upload URL ពី Init Request"
    except Exception as e:
        return False, str(e)
    try:
        up_r = await async_post(upload_url, data=video_bytes,
                                 headers={"Content-Type": "video/mp4"}, timeout=180)
        if up_r.status_code not in (200, 201):
            return False, f"YouTube Upload HTTP {up_r.status_code}: {up_r.text[:200]}"
        video_id = up_r.json().get("id")
        return True, (f"https://youtu.be/{video_id}" if video_id else "បានផុសដោយជោគជ័យ")
    except Exception as e:
        return False, str(e)

async def publish_to_tiktok(video_bytes, caption, account_label=None):
    """TikTok Content Posting API (v2) — init upload, PUT the file, poll status.
    Returns (ok, detail). NOTE: unaudited TikTok apps get routed to the
    user's inbox as a draft (SEND_TO_USER_INBOX) instead of auto-publishing —
    that is still reported here as ok=True since the upload itself succeeded,
    with a note that manual confirmation in the TikTok app is required."""
    access_token = get_tiktok_access_token(account_label)
    if not access_token:
        if account_label:
            return False, f"TikTok Account `{account_label}` រកមិនឃើញ Token ទេ — សូម /tiktokconnect {account_label} ម្តងទៀត"
        return False, "TikTok Account មិនទាន់ភ្ជាប់ទេ (ប្រើ /tiktokconnect ដើម្បីភ្ជាប់)"
    try:
        init_r = await async_post(
            "https://open.tiktokapis.com/v2/post/publish/video/init/",
            headers={
                "Authorization": f"Bearer {access_token}",
                "Content-Type": "application/json; charset=UTF-8",
            },
            json={
                "post_info": {
                    "title": (caption or "")[:150],
                    "privacy_level": TIKTOK_PRIVACY_LEVEL,
                    "disable_duet": False,
                    "disable_stitch": False,
                    "disable_comment": False,
                },
                "source_info": {
                    "source": "FILE_UPLOAD",
                    "video_size": len(video_bytes),
                    "chunk_size": len(video_bytes),
                    "total_chunk_count": 1,
                },
            },
            timeout=30,
        )
        if init_r.status_code != 200:
            return False, f"TikTok Init HTTP {init_r.status_code}: {init_r.text[:200]}"
        init_data = init_r.json()
        err_obj = init_data.get("error") or {}
        if err_obj.get("code") not in (None, "ok"):
            return False, f"TikTok Init Error: {err_obj}"
        publish_id = init_data["data"]["publish_id"]
        upload_url = init_data["data"]["upload_url"]
    except Exception as e:
        return False, str(e)

    try:
        up_r = await async_put(
            upload_url, data=video_bytes,
            headers={
                "Content-Type": "video/mp4",
                "Content-Range": f"bytes 0-{len(video_bytes)-1}/{len(video_bytes)}",
            },
            timeout=180,
        )
        if up_r.status_code not in (200, 201, 206):
            return False, f"TikTok Upload HTTP {up_r.status_code}: {up_r.text[:200]}"
    except Exception as e:
        return False, str(e)

    status = "PROCESSING"
    for _ in range(5):
        await asyncio.sleep(4)
        try:
            st_r = await async_post(
                "https://open.tiktokapis.com/v2/post/publish/status/fetch/",
                headers={
                    "Authorization": f"Bearer {access_token}",
                    "Content-Type": "application/json; charset=UTF-8",
                },
                json={"publish_id": publish_id},
                timeout=20,
            )
            if st_r.status_code == 200:
                status = (st_r.json().get("data") or {}).get("status", status)
                if status in ("PUBLISH_COMPLETE", "SEND_TO_USER_INBOX", "FAILED"):
                    break
        except Exception:
            pass

    if status == "PUBLISH_COMPLETE":
        return True, "បានផុសដោយជោគជ័យ"
    if status == "SEND_TO_USER_INBOX":
        return True, ("បានផ្ញើទៅ TikTok Inbox — App មិនទាន់ត្រូវបាន Audit សម្រាប់ Direct Post, "
                      "សូមបើក TikTok App ដើម្បីចុច Post ចុងក្រោយដោយផ្ទាល់ខ្លួន")
    if status == "FAILED":
        return False, "TikTok បដិសេធ Video នេះ (status=FAILED)"
    return True, f"បានដាក់ស្នើទៅ TikTok ហើយ (កំពុង Processing — status={status}) សូមពិនិត្យក្នុង App/Creator Portal ក្រោយ"

async def publish_to_facebook(video_bytes, caption):
    """Facebook Video API — current 3-step Resumable Upload flow (the old
    single-request graph-video.facebook.com upload Meta deprecated):
      1. POST /<APP_ID>/uploads (with FACEBOOK_USER_ACCESS_TOKEN) → upload session ID
      2. POST /upload:<SESSION_ID> with the raw video bytes → file handle
      3. POST /<PAGE_ID>/videos (with FACEBOOK_PAGE_ACCESS_TOKEN) referencing
         that file handle → publishes it
    Returns (ok, detail)."""
    page_id = get_facebook_page_id()
    page_token = get_facebook_page_token()
    user_token = get_facebook_user_token()
    if not (page_id and page_token):
        return False, "FACEBOOK_PAGE_ID / FACEBOOK_PAGE_ACCESS_TOKEN មិនទាន់ Setup ទេ (ប្រើ /facebookconnect)"
    if not (FACEBOOK_APP_ID and user_token):
        return False, "FACEBOOK_APP_ID / FACEBOOK_USER_ACCESS_TOKEN មិនទាន់ Setup ទេ (ត្រូវការសម្រាប់ Resumable Upload API — ប្រើ /facebookconnect)"
    try:
        v = FACEBOOK_GRAPH_API_VERSION
        # Step 1: start an upload session
        r1 = await async_post(
            f"https://graph.facebook.com/{v}/{FACEBOOK_APP_ID}/uploads",
            params={
                "file_name": "video.mp4",
                "file_length": len(video_bytes),
                "file_type": "video/mp4",
                "access_token": user_token,
            },
            timeout=30,
        )
        d1 = r1.json() if r1.content else {}
        if r1.status_code != 200 or "id" not in d1:
            err = (d1.get("error") or {}).get("message", r1.text[:200])
            return False, f"Facebook Upload-Session HTTP {r1.status_code}: {err}"
        upload_session_id = d1["id"]  # e.g. "upload:1234567890"

        # Step 2: upload the raw bytes to that session
        r2 = await async_post(
            f"https://graph.facebook.com/{v}/{upload_session_id}",
            headers={"Authorization": f"OAuth {user_token}", "file_offset": "0"},
            data=video_bytes,
            timeout=180,
        )
        d2 = r2.json() if r2.content else {}
        if r2.status_code != 200 or "h" not in d2:
            err = (d2.get("error") or {}).get("message", r2.text[:200])
            return False, f"Facebook Upload HTTP {r2.status_code}: {err}"
        file_handle = d2["h"]

        # Step 3: publish the uploaded file handle to the Page
        r3 = await async_post(
            f"https://graph-video.facebook.com/{v}/{page_id}/videos",
            data={
                "access_token": page_token,
                "description": caption or "",
                "fbuploader_video_file_chunk": file_handle,
            },
            timeout=60,
        )
        d3 = r3.json() if r3.content else {}
        if r3.status_code != 200 or "id" not in d3:
            err = (d3.get("error") or {}).get("message", r3.text[:200])
            return False, f"Facebook Publish HTTP {r3.status_code}: {err}"
        video_id = d3.get("id")
        return True, (f"https://www.facebook.com/{video_id}" if video_id else "បានផុសដោយជោគជ័យ")
    except Exception as e:
        return False, str(e)

