            pass
        if not removed:
            await safe_alert(q, "ទំនិញនេះត្រូវបានលុបរួចហើយ ឬមិនអាចលុបបាន។")
            return True
        await q.message.reply_text(
            "✅ បានលុបទំនិញរួចរាល់។",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 ទំនិញរបស់ខ្ញុំ", callback_data="mk_myp_0")]]))
        return True

    # ---------- admin: remove a product (moderation after publishing) ----------
    if data.startswith("mk_arm_"):
        if not is_admin(uid):
            await safe_alert(q, "សម្រាប់តែ Admin ប៉ុណ្ណោះ។")
            return True
        listing = await db_get_listing(int(data[len("mk_arm_"):]))
        if not listing or listing_is_removed(listing):
            await safe_alert(q, "❌ រកមិនឃើញទំនិញនេះ ឬត្រូវបានលុបរួចហើយ។")
            return True
        lid = listing["id"]
        await q.message.reply_text(
            f"🛡️ លុបទំនិញ #{lid} ចេញពីទីផ្សារ?",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("🗑️ លុប", callback_data=f"mk_army_{lid}"),
                InlineKeyboardButton("❌ បោះបង់", callback_data="mk_home")]]))
        return True

    if data.startswith("mk_army_"):
        if not is_admin(uid):
            await safe_alert(q, "សម្រាប់តែ Admin ប៉ុណ្ណោះ។")
            return True
        listing = await db_get_listing(int(data[len("mk_army_"):]))
        if not listing or listing_is_removed(listing):
            await safe_alert(q, "❌ រកមិនឃើញទំនិញនេះ ឬត្រូវបានលុបរួចហើយ។")
            return True
        removed = await db_remove_listing(listing["id"], uid, "removed_by_admin")
        try:
            await q.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass
        if not removed:
            await safe_alert(q, "មិនអាចលុបទំនិញនេះបានទេ (ប្រហែលត្រូវបានលុបរួចហើយ)។")
            return True
        await q.message.reply_text(f"✅ បានលុបទំនិញ #{listing['id']} ចេញពីទីផ្សារ។")
