    if data.startswith("mk_copy_"):
        listing = await market_get_owned_listing(q, uid, int(data[len("mk_copy_"):]))
        if not listing:
            return True
        link = market_product_link(context.bot.username, listing["id"])
        await q.message.reply_text(f"📋 ចុចលើ Link ខាងក្រោមដើម្បី Copy៖\n<code>{_h(link)}</code>",
                                   parse_mode="HTML", disable_web_page_preview=True)
