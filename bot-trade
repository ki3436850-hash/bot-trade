    if data.startswith("mk_pm_"):
        listing = await market_get_owned_listing(q, uid, int(data[len("mk_pm_"):]))
        if listing:
            await market_show_product_manage(q, listing)
        return True

    if data.startswith("mk_pe_"):
        _, _, field, listing_id = data.split("_", 3)
        if field not in _MK_EDIT_PROMPTS:
            await safe_alert(q, "❌ ជម្រើសមិនត្រឹមត្រូវ។")
            return True
        listing = await market_get_owned_listing(q, uid, int(listing_id))
        if not listing:
            return True
        clear_conversation_modes(ud)
        ud["store_state"] = "mk_edit_field"
