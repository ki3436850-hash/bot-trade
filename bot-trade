async def show_store_albums(target, ud, category, before_id=None, bot_username=None):
    """ត្រូវការតែ before_id (cursor) មិនមែន page number ទេ — ប្រើ keyset pagination
    ដែលនៅតែលឿនទោះមានទំនិញរាប់លាន ព្រោះមិនចាំបាច់ OFFSET scan ទាំងអស់។"""
    fetch_limit = STORE_ALBUMS_PER_PAGE + 1  # +1 ដើម្បីដឹងថាមាន page បន្ទាប់ទៀតឬអត់
    page_items = await db_get_listings_by_category(category, limit=fetch_limit, before_id=before_id)
    has_more = len(page_items) > STORE_ALBUMS_PER_PAGE
    page_items = page_items[:STORE_ALBUMS_PER_PAGE]
    cat_name = await get_category_name(category)

    chat = target.message.chat if hasattr(target, "message") else target.chat
    if not page_items:
        await chat.send_message(f"😔 មិនទាន់មានទំនិញក្នុងប្រភេទ {cat_name} នៅឡើយទេ។")
        return
    for l in page_items:
        caption = build_any_listing_caption(l, cat_name)
        await safe_send_listing(chat.send_media_group, chat.send_photo, chat.send_message, l["photos"], caption)
        await market_send_product_actions(chat.send_message, l, chat.id, bot_username)

    ud["store_browse_cursor"] = page_items[-1]["id"]  # smallest id on this page → cursor for "next"
    save_data()
    nav = []
    if has_more:
        nav.append(InlineKeyboardButton("បន្ត ➡️", callback_data="store_browse_next"))
    nav.append(InlineKeyboardButton("⬅️ ថយក្រោយ", callback_data="store_browse_back"))
    await chat.send_message("ចុចដើម្បីមើលបន្ថែម ឬត្រឡប់ក្រោយ", reply_markup=InlineKeyboardMarkup([nav]))

