def build_generic_teacher_prompt(mode, ud):
    """សាងសង់ System Prompt ពេញលេញសម្រាប់ Mode ណាមួយក្នុង GENERIC_TEACHER_MODES។"""
    if mode == "language":
        lang = ud.get("teacher_language") or "english"
        base = LANGUAGE_TEACHER_SYSTEM_PROMPT.get(lang, LANGUAGE_TEACHER_SYSTEM_PROMPT["english"])
        return base + LANGUAGE_TEACHER_INSTRUCTIONS
    base, instructions = GENERIC_TEACHER_PROMPTS[mode]
    return base + instructions


