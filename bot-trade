    ស្វ័យប្រវត្តិនៅថ្ងៃបន្ទាប់។ ត្រឡប់ (False, message) ពេលអស់សិទ្ធិ។"""
    if is_admin(uid):
        return True, None
    today = datetime.now().strftime("%Y-%m-%d")
    if ud.get("teacher_credits_date") != today:
        ud["teacher_credits_date"] = today
        ud["teacher_credits_used"] = 0
    used = ud.get("teacher_credits_used", 0)
    if used >= DAILY_TEACHER_CREDIT_LIMIT:
        return False, (
            f"⚠️ អ្នកបានប្រើ AI Teacher គ្រប់ចំនួន {DAILY_TEACHER_CREDIT_LIMIT} សំណួរសម្រាប់ថ្ងៃនេះហើយ។\n"
