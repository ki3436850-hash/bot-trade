async def _teacher_call_openai(provider, messages, temperature=0.7, max_tokens=2048):
    api_key = os.environ.get(provider["api_key_env"], "").strip()
    if not api_key or len(api_key) < 8:
        return None, f"{provider['name']}: No API Key"

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }
    if provider["name"] == "openrouter":
        headers["HTTP-Referer"] = "https://t.me/yourbot"
        headers["X-Title"] = "LifeRPG Teacher"

    payload = {
        "model": provider["model"],
        "messages": messages,
        "temperature": temperature,
        "max_tokens": max_tokens,
    }

    try:
        res = await asyncio.to_thread(
            requests.post, provider["base_url"],
            headers=headers, json=payload, timeout=50
        )
        data = res.json()
        if res.status_code != 200:
            err = data.get("error", {}).get("message") or str(data)
            return None, f"{provider['name']}: {err}"
        return data["choices"][0]["message"]["content"].strip(), None
    except Exception as e:
        return None, f"{provider['name']}: {e}"


