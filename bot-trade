    try:
        res = await asyncio.to_thread(
            requests.post, provider["base_url"],
            headers=headers, json=payload, timeout=50
        )
        data = res.json()
        if res.status_code != 200:
            err = data.get("error", {}).get("message") or str(data)
            return None, f"claude: {err}"
        return data["content"][0]["text"].strip(), None
    except Exception as e:
        return None, f"claude: {e}"


async def teacher_ai_router(mode: str, messages: list, temperature: float = 0.7, max_tokens: int = 2048):
    """
    AI Router សម្រាប់ /teacher តែប៉ុណ្ណោះ (មិនប៉ះកូដចាស់)
    ត្រឡប់: (answer, provider_name, error)
    """
    global _teacher_ai_index

    available = []
    for p in TEACHER_AI_PROVIDERS:
        key = os.environ.get(p["api_key_env"], "").strip()
        if key and len(key) > 8 and not _teacher_is_cooldown(p["name"]):
            available.append(p)

    if not available:
        return None, None, "គ្មាន AI Provider ណាអាចប្រើបានទេ"

    start = _teacher_ai_index % len(available)
    errors = []

    for i in range(len(available)):
        idx = (start + i) % len(available)
        provider = available[idx]

        logger.info(f"Teacher AI [{mode}] trying → {provider['name']}")

        if provider.get("is_claude"):
            answer, err = await _teacher_call_claude(provider, messages, temperature, max_tokens)
        else:
            answer, err = await _teacher_call_openai(provider, messages, temperature, max_tokens)

        if answer:
            _teacher_ai_index = (idx + 1) % len(available)
            logger.info(f"Teacher AI [{mode}] success → {provider['name']}")
            return answer, provider["name"], None
        else:
            errors.append(err)
            _teacher_set_cooldown(provider["name"])
            logger.warning(f"Teacher AI [{mode}] failed → {err}")

    return None, None, " | ".join(errors)

