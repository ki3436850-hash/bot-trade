            await safe_alert(q, "រកមិនឃើញការបញ្ជាទិញនេះទេ។", show_alert=True)
            return True
        if str(uid) != str(order["seller_id"]) and not is_admin(uid):
            await safe_alert(q, "សម្រាប់តែអ្នកលក់ប៉ុណ្ណោះទើបអាចឆ្លើយតបការបញ្ជាទិញនេះបាន។", show_alert=True)
            return True
        new_status = "confirmed" if approving else "rejected"
        # atomic conditional update — if another admin already handled it,
        # this returns None and we tell this admin without double-notifying the buyer.
        updated = await db_update_order_status(order_id, new_status, expected_status="pending")
        if not updated:
            await safe_alert(q, "ការបញ្ជាទិញនេះត្រូវបានឆ្លើយតបរួចហើយ។", show_alert=True)
            try:
                await q.edit_message_reply_markup(reply_markup=None)
            except Exception:
                pass
            return True
        try:
            await q.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass
        buyer_id = order["buyer_id"]
        if approving:
            seller_contact = await get_contact_line(context.bot, order["seller_id"])
            await q.message.reply_text(f"✅ អ្នកបានបញ្ជាក់ការបញ្ជាទិញ #{order_id}។")
            notify_text = (f"✅ អ្នកលក់បានបញ្ជាក់ការបញ្ជាទិញ #{order_id} របស់អ្នកហើយ!\n"
                           f"👤 ទំនាក់ទំនងអ្នកលក់៖ {seller_contact}\n"
                           f"សូមទាក់ទងអ្នកលក់ដើម្បីរៀបចំការទូទាត់/ដឹកជញ្ជូន។")
        else:
            await q.message.reply_text(f"❌ អ្នកបានបដិសេធការបញ្ជាទិញ #{order_id}។")
            notify_text = f"❌ អ្នកលក់បានបដិសេធការបញ្ជាទិញ #{order_id}។"
        try:
            await context.bot.send_message(chat_id=int(buyer_id), text=notify_text)
        except Exception as e:
            logger.warning(f"Notify buyer of order response failed: {e}")
        return True

    if data.startswith("order_complete_"):
        if not store_db_ready():
            await safe_alert(q, "Marketplace database មិនទាន់ Setup ទេ។", show_alert=True)
            return True
        order_id = data[len("order_complete_"):]
        order = await db_get_order(order_id)
        if not order:
            await safe_alert(q, "រកមិនឃើញការបញ្ជាទិញនេះទេ។", show_alert=True)
            return True
        if str(uid) not in (order["buyer_id"], order["seller_id"]) and not is_admin(uid):
            await safe_alert(q, "អ្នកមិនមានសិទ្ធិលើការបញ្ជាទិញនេះទេ។", show_alert=True)
            return True
        updated = await db_update_order_status(order_id, "completed", expected_status="confirmed")
        if not updated:
            await safe_alert(q, "ការបញ្ជាទិញនេះមិននៅក្នុងស្ថានភាព confirmed ទេ (ប្រហែលមាននរណាម្នាក់ផ្សេងបានធ្វើរួច)។", show_alert=True)
            return True
        await db_decrement_listing_stock(order["listing_id"])
        try:
            await q.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass
        await q.message.reply_text(f"📦 ការបញ្ជាទិញ #{order_id} ត្រូវបានសម្គាល់ថាបានប្រគល់ជូនរួច។")
        other_id = order["seller_id"] if str(uid) == order["buyer_id"] else order["buyer_id"]
        try:
            await context.bot.send_message(chat_id=int(other_id),
                text=f"📦 ការបញ្ជាទិញ #{order_id} ត្រូវបានសម្គាល់ថាបានប្រគល់ជូនរួច។")
        except Exception as e:
            logger.warning(f"Notify order completion failed: {e}")
        return True

    return False

async def _finalize_store_photos(update, context, ud):
    """ត្រូវបានហៅបន្ទាប់ពី User ឈប់ផ្ញើរូបភាពមួយរយៈ (Debounce) — ប្តូរទៅដំណាក់កាល
    សុំឈ្មោះផលិតផលជាដំបូង (Phase 2 wizard: name → price → discount → stock →
    delivery type → description → preview → publish), ដោយស្វ័យប្រវត្តិ គ្មានតម្រូវឲ្យ
    User ចុចប៊ូតុង "ចប់" ទេ។"""
    if ud.get("store_state") != "awaiting_photos":
        return
    ud["store_state"] = "awaiting_name"
    save_data()
    if ud["store_temp"].get("category") == "job":
        await update.message.reply_text("💼 ចំណងជើងការងារ (Job Title)?\nឧ. Sales Assistant")
    else:
        await update.message.reply_text(
            "🛍️ សូមវាយ *ឈ្មោះទំនិញ* (ខ្លី ច្បាស់លាស់)៖\nឧ. កាបូបស្បែកម្នាក់",
            parse_mode="Markdown")

async def _debounced_finalize_photos(update, context, ud, uid):
    try:
        await asyncio.sleep(PHOTO_DEBOUNCE_SECONDS)
    except asyncio.CancelledError:
        return
    _pending_photo_tasks.pop(uid, None)
    await _finalize_store_photos(update, context, ud)

def _cancel_pending_photo_task(uid):
    task = _pending_photo_tasks.pop(uid, None)
    if task and not task.done():
        task.cancel()

_photo_limit_notified = {}

async def _notify_photo_limit(update, uid):
    """One notice per burst (an album of 12 photos would otherwise send 2 messages)."""
    now = time.time()
    if now - _photo_limit_notified.get(uid, 0) < 5:
        return
    _photo_limit_notified[uid] = now
    if len(_photo_limit_notified) > 5000:
        _photo_limit_notified.clear()
    await update.message.reply_text(
        "⚠️ អតិបរមា ១០ រូបភាពក្នុងមួយទំនិញ — រូបភាពបន្ថែមមិនត្រូវបានទទួលទេ។\n"
        "សូមបន្តវាយឈ្មោះទំនិញ។")

async def store_handle_photo(update, context, ud):
    """ត្រឡប់ True ប្រសិនបើរូបភាពនេះត្រូវបានប្រើសម្រាប់ Marketplace flow ។

    User អាចផ្ញើរូបភាព ១ រហូតដល់ ១០ សន្លឹក — ផ្ញើជា Album (ច្រើនសន្លឹកម្ដង)
    ឬម្ដងមួយៗក៏បាន។ ពេល User ឈប់ផ្ញើមួយសន្ទុះ (មិនចាំបាច់ចុចប៊ូតុង "ចប់")
    Bot នឹងសួរព័ត៌មានផលិតផលដោយស្វ័យប្រវត្តិ។"""
    state = ud.get("store_state")
    uid = update.effective_user.id
    if state == "awaiting_photos":
        photos = ud["store_temp"].setdefault("photos", [])
        if len(photos) >= 10:
            await _notify_photo_limit(update, uid)
            return True  # បានគ្រប់ ១០ សន្លឹករួច មិនទទួលបន្ថែមទៀត
        photo = update.message.photo[-1]
        photos.append(photo.file_id)
        save_data()
        count = len(photos)
        _cancel_pending_photo_task(uid)
        if count >= 10:
            await _finalize_store_photos(update, context, ud)
        else:
            await update.message.reply_text(f"✅ បានទទួលរូបភាព {count}/10 ។")
            task = asyncio.ensure_future(_debounced_finalize_photos(update, context, ud, uid))
            _pending_photo_tasks[uid] = task
        return True
    if state == "awaiting_name":
        # Photos that arrive after the wizard has moved on (e.g. the 11th+ photo of an
        # album, or a late one after the debounce fired) — tell the seller instead of ignoring them.
        await _notify_photo_limit(update, uid)
        return True
    if state == "awaiting_receipt":
        photo = update.message.photo[-1]
        ud["store_pending_receipt"] = photo.file_id
        ud["store_state"] = "awaiting_link"
        save_data()
        await update.message.reply_text("🔗 សូមផ្ញើ Link ដែលអ្នកបានពី Bot មកវិញ (ចម្លងពីសារ Get link)។")
        return True
    return False

