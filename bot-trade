# ============================================================
# Categories (Marketplace V2 — Phase 1: dynamic categories)
# ------------------------------------------------------------
# Categories now live in a "categories" table (see categories_schema.sql)
# instead of the hardcoded STORE_CATEGORIES list. STORE_CATEGORIES /
# STORE_CATEGORY_NAMES above are kept as-is and now serve two purposes:
#   1. A guaranteed fallback when the DB is unreachable or the migration
#      hasn't been run yet — /store keeps working exactly like before.
#   2. The seed data for the migration (see the SQL file).
# Every place that used to read STORE_CATEGORIES/STORE_CATEGORY_NAMES
# directly now goes through get_active_categories()/get_category_name()
# below, so nothing about existing listings, orders, or links changes.
# ============================================================

_categories_cache = {"data": None, "ts": 0.0}
CATEGORIES_CACHE_TTL = 30  # seconds — avoids hitting Supabase on every keyboard render

async def db_fetch_categories(include_disabled=True):
    """Raw fetch from the categories table, sorted for display. Returns None
    (not []) if the table is missing/unreachable, so callers can tell
    'DB has zero categories' apart from 'DB/table not available yet'."""
    if not store_db_ready():
        return None
    def _run():
        q = supabase.table("categories").select("*")
        if not include_disabled:
            q = q.eq("enabled", True)
        return q.order("sort_order", desc=False).order("id", desc=False).execute()
    try:
        res = await _sb_call(_run)
        return res.data if res.data is not None else []
    except Exception as e:
        logger.warning(f"db_fetch_categories failed (table may not exist yet): {e}")
        return None

async def get_active_categories(force_refresh=False):
    """Returns [(key, label), ...] for enabled categories, admin-orderable.
    Falls back to the hardcoded STORE_CATEGORIES list whenever the DB table
    isn't available yet or is empty, so this is always safe to call."""
    now = time.time()
    if not force_refresh and _categories_cache["data"] is not None \
            and (now - _categories_cache["ts"]) < CATEGORIES_CACHE_TTL:
        return _categories_cache["data"]
    rows = await db_fetch_categories(include_disabled=False)
    if not rows:
        result = list(STORE_CATEGORIES)
    else:
        result = [(r["key"], r["label"]) for r in rows]
    _categories_cache["data"] = result
    _categories_cache["ts"] = now
    return result

async def get_all_categories_admin(force_refresh=True):
    """Enabled + disabled, for the admin management screen. Falls back to the
    hardcoded list (all treated as enabled) if the DB table doesn't exist yet."""
    rows = await db_fetch_categories(include_disabled=True)
    if rows is None:
        return [{"key": k, "label": v, "enabled": True, "sort_order": i}
                 for i, (k, v) in enumerate(STORE_CATEGORIES)]
    return rows

async def get_category_name(key):
    for k, label in await get_active_categories():
        if k == key:
            return label
    # category might be disabled/deleted but still referenced by an old listing
    admin_rows = await get_all_categories_admin()
    for r in admin_rows:
        if r["key"] == key:
            return r["label"]
    return STORE_CATEGORY_NAMES.get(key, key)

def _invalidate_categories_cache():
    _categories_cache["data"] = None
    _categories_cache["ts"] = 0.0

async def db_create_category(key, label, sort_order=None):
    if sort_order is None:
        existing = await get_all_categories_admin()
        sort_order = (max([r.get("sort_order", 0) for r in existing], default=0) + 1)
    def _run():
        return supabase.table("categories").insert({
            "key": key, "label": label, "enabled": True, "sort_order": sort_order,
        }).execute()
    try:
        res = await _sb_call(_run)
        _invalidate_categories_cache()
        return res.data[0] if res.data else None
    except Exception as e:
        logger.warning(f"db_create_category failed: {e}")
        return None

async def db_update_category(key, **fields):
    def _run():
        return supabase.table("categories").update(fields).eq("key", key).execute()
    try:
        res = await _sb_call(_run)
        _invalidate_categories_cache()
        return res.data[0] if res.data else None
    except Exception as e:
        logger.warning(f"db_update_category failed: {e}")
        return None

async def db_category_in_use(key):
    """Whether any listing still references this category — used to block a
    hard delete (admin should disable instead) so product data never orphans."""
    def _run():
        return supabase.table("listings").select("id", count="exact").eq("category", key).limit(1).execute()
    try:
        res = await _sb_call(_run)
        return (res.count or 0) > 0
    except Exception as e:
        logger.warning(f"db_category_in_use failed: {e}")
        return True  # fail safe: assume in-use so we never delete on a DB error

async def db_delete_category(key):
    def _run():
        return supabase.table("categories").delete().eq("key", key).execute()
    try:
        await _sb_call(_run)
        _invalidate_categories_cache()
        return True
    except Exception as e:
        logger.warning(f"db_delete_category failed: {e}")
        return False

