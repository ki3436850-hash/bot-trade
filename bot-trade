        await q.edit_message_text(text, reply_markup=kb)
        return True

    if data.startswith("cust_addnote_"):
        cid = int(data[len("cust_addnote_"):])
        ud["customer_temp"] = {"mode": "note", "customer_id": cid}
        ud["customer_state"] = "note_add"
        save_data()
        await q.edit_message_text("📝 វាយ Note ថ្មី៖")
        return True

    if data.startswith("cust_schedule_"):
        cid = int(data[len("cust_schedule_"):])
        c = get_customer(cid)
        if not c:
            await safe_alert(q, "Customer នេះលែងមានទៀតហើយ។", show_alert=True)
            return True
        if not c.get("telegram_user_id"):
            await safe_alert(q, "Customer នេះមិនទាន់មាន Telegram ID ទេ — មិនអាច Schedule Message ដោយផ្ទាល់បានទេ។", show_alert=True)
            return True
        ud["schedule_temp"] = {"repeat_days": [], "content_type": "text",
                                "_customer_chat_id": int(c["telegram_user_id"])}
        ud["schedule_state"] = "awaiting_content"
        ud["customer_state"] = None
        ud["customer_temp"] = {}
        save_data()
        await q.edit_message_text(
            f"📝 What should I send to {c['name']}? សូមវាយអត្ថបទ។")
        return True

    if data.startswith("cust_delete_confirm_"):
        cid = int(data[len("cust_delete_confirm_"):])
        soft_delete_customer(cid)
        logger.info(f"Customer {cid} deleted by admin {uid}")
        await q.edit_message_text("✅ Customer deleted.",
                                    reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="cust_menu")]]))
        return True

    if data.startswith("cust_delete_"):
        cid = int(data[len("cust_delete_"):])
        c = get_customer(cid)
        if not c:
            await safe_alert(q, "Customer នេះលែងមានទៀតហើយ។", show_alert=True)
            return True
        await q.edit_message_text(
            f"⚠️ Delete Customer?\n\nCustomer: {c['name']}\nCustomer ID: #{cid}",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("❌ Cancel", callback_data=f"cust_view_{cid}")],
                [InlineKeyboardButton("🗑 Confirm Delete", callback_data=f"cust_delete_confirm_{cid}")],
            ]))
        return True

    return False

async def customer_handle_text(update, context, ud, text):
    """ត្រឡប់ True បើបាន Handle — ហៅពី handle_text() មុន Handler ដទៃទៀត។"""
    state = ud.get("customer_state")
    if not state:
        return False
    if not is_admin(update.effective_user.id):
        return False
    temp = ud.get("customer_temp") or {}

    if state == "add_name":
        temp["name"] = text[:100]
        ud["customer_temp"] = temp
        ud["customer_state"] = "add_username"
        save_data()
        await update.message.reply_text("📱 Telegram Username? (គ្មាន @ — ឬចុច ⏭️ Skip)", reply_markup=_cust_skip_kb("username"))
        return True

    if state == "add_username":
        temp["username"] = None if text.lower() == "skip" else text.lstrip("@")[:64]
        ud["customer_temp"] = temp
        ud["customer_state"] = "add_telegram_id"
        save_data()
        await update.message.reply_text("🆔 Telegram User ID? (ជាលេខ — ឬចុច ⏭️ Skip)", reply_markup=_cust_skip_kb("tid"))
        return True

    if state == "add_telegram_id":
        if text.lower() == "skip":
            temp["telegram_user_id"] = None
        elif text.strip().isdigit():
            existing = find_customer_by_telegram_id(text.strip())
            if existing:
                ud["customer_state"] = None
                ud["customer_temp"] = {}
                save_data()
                await update.message.reply_text(
                    f"ℹ️ Customer នេះមានរួចហើយ — Customer #{existing['id']} ({existing['name']})។ បង្ហាញ Profile:")
                await _customer_show_profile(update.message, existing["id"], edit=False)
                return True
            temp["telegram_user_id"] = text.strip()
        else:
            await update.message.reply_text("❌ Telegram ID ត្រូវជាលេខ។ សូមព្យាយាមម្តងទៀត ឬចុច ⏭️ Skip។", reply_markup=_cust_skip_kb("tid"))
            return True
        ud["customer_temp"] = temp
        ud["customer_state"] = "add_phone"
        save_data()
        await update.message.reply_text("📞 Phone Number? (Optional — ឬចុច ⏭️ Skip)", reply_markup=_cust_skip_kb("phone"))
        return True

    if state == "add_phone":
        temp["phone"] = None if text.lower() == "skip" else text[:30]
        ud["customer_temp"] = temp
        ud["customer_state"] = "add_email"
        save_data()
        await update.message.reply_text("📧 Email? (Optional — ឬចុច ⏭️ Skip)", reply_markup=_cust_skip_kb("email"))
        return True

    if state == "add_email":
        temp["email"] = None if text.lower() == "skip" else text[:100]
        ud["customer_temp"] = temp
        ud["customer_state"] = None
        save_data()
        await update.message.reply_text("🏷️ Customer Type", reply_markup=customer_type_keyboard())
        return True

    if state == "add_note":
        temp["note"] = None if text.lower() == "skip" else text[:500]
        ud["customer_temp"] = temp
        ud["customer_state"] = None
        save_data()
        lines = [
            "━━━━━━━━━━━━━━━━", "👤 CUSTOMER PREVIEW", "━━━━━━━━━━━━━━━━", "",
            f"Name: {temp.get('name')}",
            f"Telegram: @{temp['username']}" if temp.get("username") else "Telegram: —",
            f"User ID: {temp.get('telegram_user_id') or '—'}",
            f"Phone: {temp.get('phone') or '—'}",
            f"Email: {temp.get('email') or '—'}",
            f"Type: {CUSTOMER_TYPE_LABELS.get(temp.get('customer_type'), '👤 Normal')}",
            f"Note: {temp.get('note') or '—'}",
        ]
        await update.message.reply_text("\n".join(lines), reply_markup=customer_preview_keyboard())
        return True

    if state == "edit_field":
        cid = temp.get("customer_id")
        field = temp.get("field")
        if not cid or not get_customer(cid):
            ud["customer_state"] = None
            ud["customer_temp"] = {}
            save_data()
            await update.message.reply_text("❌ Customer not found.")
            return True
        value = text.strip()
        if field == "total_spent":
            try:
                value = float(value.replace(",", ""))
            except ValueError:
                await update.message.reply_text("❌ សូមបញ្ចូលលេខត្រឹមត្រូវ។")
                return True
        elif field == "username":
            value = value.lstrip("@")[:64]
        update_customer(cid, **{field: value})
        ud["customer_state"] = None
        ud["customer_temp"] = {}
        save_data()
        await update.message.reply_text("✅ Customer updated successfully.")
        await _customer_show_profile(update.message, cid, edit=False)
        return True

    if state == "note_add":
        cid = temp.get("customer_id")
        if not cid or not get_customer(cid):
            ud["customer_state"] = None
            ud["customer_temp"] = {}
            save_data()
            await update.message.reply_text("❌ Customer not found.")
            return True
        add_customer_note(cid, update.effective_user.id, text[:500])
        ud["customer_state"] = None
        ud["customer_temp"] = {}
        save_data()
        await update.message.reply_text("✅ Note added.")
        await _customer_show_profile(update.message, cid, edit=False)
        return True

    if state == "search":
        ud["customer_state"] = None
        save_data()
        results = search_customers(text)
        if not results:
            await update.message.reply_text("❌ No customers found.")
            return True
        lines = ["🔎 Search Results", ""]
        kb = []
        for i, c in enumerate(results[:20], 1):
            icon = {"normal": "👤", "vip": "⭐", "premium": "💎"}.get(c.get("customer_type"), "👤")
            uname = f" @{c['username']}" if c.get("username") else ""
            lines.append(f"{i}️⃣ {icon} {c['name']}{uname}")
            kb.append([InlineKeyboardButton(f"{icon} {c['name']}", callback_data=f"cust_view_{c['id']}")])
        kb.append([InlineKeyboardButton("🔙 Back", callback_data="cust_menu")])
        await update.message.reply_text("\n".join(lines), reply_markup=InlineKeyboardMarkup(kb))
        return True

    return False

