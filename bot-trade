    try:
        await send_photo_fn(photo=photo, caption=caption, parse_mode="Markdown")
        return
    except Exception as e:
        logger.warning(f"Send photo (Markdown) failed: {e}")
    try:
        await send_photo_fn(photo=photo, caption=caption)
        return
    except Exception as e:
        logger.warning(f"Send photo (plain) failed: {e}")
    try:
        await send_text_fn(caption)
    except Exception as e:
        logger.warning(f"Fallback text send also failed: {e}")

async def safe_send_listing(send_media_group_fn, send_photo_fn, send_text_fn, photos, caption):
    """ផ្ញើរូបភាព *ទាំងអស់* របស់ទំនិញមួយ (រហូតដល់ ១០ សន្លឹក) ជា Album (Media Group)
    ក្នុងសារតែមួយ — មិនមែនបង្ហាញតែសន្លឹកទី ១ ទៀតទេ។ Caption ត្រូវភ្ជាប់លើសន្លឹកទី ១។
    បើមានតែសន្លឹកតែមួយ ផ្ញើជារូបភាពធម្មតា។ បើ Markdown ខុស ឬការផ្ញើ Album បរាជ័យ
    ព្យាយាម fallback ជាបន្តបន្ទាប់ ដើម្បីកុំឲ្យ User គ្មានចម្លើយត្រឡប់ទាល់តែសោះ។"""
    photos = (photos or [])[:10]
    if not photos:
        try:
            await send_text_fn(caption, parse_mode="Markdown")
        except Exception:
            try:
                await send_text_fn(caption)
            except Exception as e:
                logger.warning(f"Send text-only listing failed: {e}")
        return
    if len(photos) == 1:
        await safe_send_product(send_photo_fn, send_text_fn, photos[0], caption)
        return
    for parse_mode in ("Markdown", None):
        try:
            media = [InputMediaPhoto(media=p) for p in photos]
            if parse_mode:
                media[0] = InputMediaPhoto(media=photos[0], caption=caption, parse_mode=parse_mode)
            else:
                media[0] = InputMediaPhoto(media=photos[0], caption=caption)
            await send_media_group_fn(media=media)
            return
        except Exception as e:
            logger.warning(f"send_media_group ({parse_mode}) failed: {e}")
    # Album ទាំងមូលបរាជ័យ (ឧ. File_id ខូច) — យ៉ាងហោចណាស់ព្យាយាមផ្ញើសន្លឹកទី ១ ជាមួយ caption
    await safe_send_product(send_photo_fn, send_text_fn, photos[0], caption)

