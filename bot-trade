    def _parse_multipart_file(self, content_type, body: bytes):
        """Parser Multipart/form-data អប្បបរមា — រកតែផ្នែកដំបូងដែលមាន filename (មិនប្រើ cgi
        ព្រោះ Module នេះត្រូវបានលុបចេញពី Python 3.13)។ ត្រឡប់ (filename, file_bytes) ឬ (None, None)។"""
        m = re.search(r'boundary="?([^";]+)"?', content_type or "")
        if not m:
            return None, None
        boundary = ("--" + m.group(1)).encode("utf-8")
        parts = body.split(boundary)
        for part in parts:
            if b'filename="' not in part:
                continue
            header_end = part.find(b"\r\n\r\n")
            if header_end == -1:
                continue
            headers = part[:header_end].decode("utf-8", errors="ignore")
            fm = re.search(r'filename="([^"]*)"', headers)
            filename = fm.group(1) if fm else "upload.mp4"
            data = part[header_end + 4:]
            # ដកយក trailing \r\n មុន boundary បន្ទាប់
            if data.endswith(b"\r\n"):
                data = data[:-2]
            return filename, data
        return None, None

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if path == "/api/ea/heartbeat":
            self._handle_ea_heartbeat(); return
        if path == "/api/ea/event":
            self._handle_ea_event(); return
        if path == "/api/ea/command-result":
            self._handle_ea_command_result(); return
        if not path.startswith("/upload/"):
            self._send(404, "text/plain; charset=utf-8", b"Not Found")
            return
        token = path[len("/upload/"):]
        entry = UPLOAD_TOKENS.get(token)
        if not entry or (time.time() - entry["created"] > UPLOAD_TOKEN_TTL_SECONDS):
            UPLOAD_TOKENS.pop(token, None)
            self._send(410, "text/html; charset=utf-8",
                        UPLOAD_RESULT_HTML_TMPL.format(
                            icon="⌛", message="Link នេះផុតកំណត់ ឬប្រើរួចហើយ។ សូមវាយ /uploadvideo ក្នុង Telegram ម្តងទៀត។"
                        ).encode("utf-8"))
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        max_bytes = WEB_UPLOAD_MAX_MB * 1024 * 1024
        if length <= 0 or length > max_bytes:
            self._send(413, "text/html; charset=utf-8",
                        UPLOAD_RESULT_HTML_TMPL.format(
                            icon="❌", message=f"File ធំពេក ឬទទេ (កំណត់ត្រឹម {WEB_UPLOAD_MAX_MB}MB)។"
                        ).encode("utf-8"))
            return
        body = self.rfile.read(length)
        filename, data = self._parse_multipart_file(self.headers.get("Content-Type", ""), body)
        if not data:
            self._send(400, "text/html; charset=utf-8",
                        UPLOAD_RESULT_HTML_TMPL.format(
                            icon="❌", message="រកមិនឃើញ Video ក្នុង Upload ទេ។ សូមសាកល្បងម្តងទៀត។"
                        ).encode("utf-8"))
            return
        user_id = entry["user_id"]
        ext = os.path.splitext(filename or "")[1] or ".mp4"
        try:
            os.makedirs(POST_VIDEO_DIR, exist_ok=True)
            save_path = os.path.join(POST_VIDEO_DIR, f"{user_id}_{int(time.time())}{ext}")
            with open(save_path, "wb") as f:
                f.write(data)
        except Exception as e:
            self._send(500, "text/html; charset=utf-8",
                        UPLOAD_RESULT_HTML_TMPL.format(icon="❌", message=f"មិនអាចរក្សាទុកបានទេ: {e}").encode("utf-8"))
            return
        UPLOAD_TOKENS.pop(token, None)
        PENDING_UPLOADS[user_id] = save_path
        self._send(200, "text/html; charset=utf-8",
                    UPLOAD_RESULT_HTML_TMPL.format(
                        icon="✅", message="Upload ជោគជ័យ! អាចត្រឡប់ទៅ Telegram វិញ ហើយវាយ /usevideo ដើម្បីបន្ត។"
                    ).encode("utf-8"))
        _notify_user_sync(
            user_id,
            f"✅ *Video Upload ជោគជ័យ!* ({len(data) // (1024*1024)}MB)\n\nវាយ /usevideo ដើម្បីបន្ត Schedule Post។"
        )

