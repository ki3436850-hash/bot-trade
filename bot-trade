            err_msg = data.get("error", {}).get("message", str(data))
            logger.warning(f"Groq vision API error ({res.status_code}): {err_msg}")
            return None, err_msg
        choices = data.get("choices")
        if not choices:
            logger.warning(f"Groq vision no choices: {data}")
            return None, "Groq មិនបានត្រឡប់លទ្ធផលអ្វីមកទេ (choices ទទេ)"
        return choices[0]["message"]["content"], None
    except Exception as e:
        logger.warning(f"Groq vision error: {e}")
        return None, str(e)

async def _reply_file_id_and_url(update, context, file_id, label):
    """ឆ្លើយតបទាំង File ID និង URL ផ្ទាល់ (សម្រាប់ /getfileid) ដើម្បីឲ្យបងជ្រើសយក
    មួយណាក៏បាន — File ID សម្រាប់ដាក់ក្នុង LIBRARY_BOOKS ជាធម្មតា (លឿន មិនផុតសុពលភាព),
    URL សម្រាប់ Copy ទៅមើលផ្ទាល់ក្នុង Browser ឬប្រើកន្លែងផ្សេង (URL Telegram ផុតសុពលភាព
    ក្រោយពេលខ្លះ ដូច្នេះកុំយក URL ទៅដាក់អចិន្ត្រៃយ៍ក្នុងកូដ)។"""
    is_video = (label == "Video")
    lib_value = f"{VIDEO_FILE_ID_PREFIX}{file_id}" if is_video else file_id
    lines = [f"🆔 File ID ({label}):", f"`{file_id}`"]
    if is_video:
        lines += ["", "📚 សម្រាប់ដាក់ក្នុង `LIBRARY_BOOKS` Field 'image' (ត្រូវមាន Prefix video: ដើម្បីឲ្យដឹងថាជា Video):", f"`{lib_value}`"]
    try:
        file = await context.bot.get_file(file_id)
        file_url = f"https://api.telegram.org/file/bot{BOT_TOKEN}/{file.file_path}"
        lines += ["", f"🔗 URL ({label}):", f"`{file_url}`"]
    except Exception as e:
        logger.warning(f"_reply_file_id_and_url: get_file failed — {e}")
        lines += ["", "⚠️ មិនអាចទាញ URL បានទេ (File ប្រហែលធំជាង 20MB ដែល Telegram Bot API មិនអនុញ្ញាត)។"]
    await update.message.reply_text("\n".join(lines), parse_mode="Markdown")


