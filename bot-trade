async def teacher_handle_text(update, context, ud, text):
    """ត្រឡប់ True បើបាន Handle (User កំពុងនៅក្នុង AI Teacher Mode ណាមួយ)។
    ចែកចាយទៅតាម Mode៖ coding (មាន Level ផ្ទាល់ខ្លួន), pdf (មាន State ផ្ទាល់ខ្លួន),
    ឬ Generic 5 Mode ផ្សេងទៀត (language/math/prediction/psychology/casual)។"""
    mode = ud.get("teacher_mode")
    if not mode:
        return False

    if mode == "coding":
        level = ud.get("teacher_coding_level") or "beginner"
        system_prompt = CODING_TEACHER_SYSTEM_PROMPT.get(level, CODING_TEACHER_SYSTEM_PROMPT["beginner"]) + CODING_TEACHER_INSTRUCTIONS
        await run_generic_teacher_turn(
            update, mode="coding", system_prompt=system_prompt, history_field="teacher_coding_history",
            ud=ud, text=text, thinking_text="🤔 គ្រូកូដកំពុងគិត...",
            error_hint="(Admin: ពិនិត្យ DEEPSEEK_API_KEY/GEMINI_API_KEY/OPENROUTER_API_KEY)")
        return True

    if mode in GENERIC_TEACHER_MODES:
        label, history_field = GENERIC_TEACHER_MODES[mode]
        system_prompt = build_generic_teacher_prompt(mode, ud)
        await run_generic_teacher_turn(
            update, mode=mode, system_prompt=system_prompt, history_field=history_field,
            ud=ud, text=text, thinking_text=f"🤔 {label} កំពុងគិត...",
            error_hint="(Admin: ពិនិត្យ GEMINI_API_KEY/DEEPSEEK_API_KEY/OPENROUTER_API_KEY/GROQ_API_KEY/CEREBRAS_API_KEY)")
        return True

    if mode == "pdf":
        await teacher_pdf_handle_text(update, context, ud, text)
        return True

    return False


