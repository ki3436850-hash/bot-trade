async def ea_chart_vision_bias(symbol, timeframe):
    """Structured Chart Vision cross-check (spec §9) for the EA's automated
    signal pipeline — separate from the free-text Khmer narrative used by the
    manual /analyze flow (analyze_candlestick_image below), because that one
    returns prose meant for a person to read, not a tag ea_generate_signal can
    compare numerically against its indicator-based Confluence Engine.
    Fetches the same chart-img.com image already used elsewhere, asks the
    vision model for ONLY a bias + confidence, and never raises — a failed,
    slow, or unconfigured vision call must never block signal generation
    (spec §16 fail-safe), so any problem here just returns None and the
    caller proceeds on indicators alone."""
    if not GROQ_API_KEY or GROQ_API_KEY == "YOUR_KEY":
        return None
    try:
        chart_bytes = await asyncio.wait_for(fetch_chart_image(symbol, timeframe), timeout=12)
    except Exception as e:
        logger.info(f"Chart Vision skipped (image fetch failed, non-blocking): {e}")
        return None
    if not chart_bytes:
        return None
    prompt = (
        f"Look at this {symbol} ({timeframe}) candlestick chart image only. Base your read "
        "purely on what is visible in the image (trend, pattern, support/resistance) — you have "
        "no live market data. Reply with EXACTLY these two lines and nothing else:\n"
        "BIAS: BULL or BEAR or NEUTRAL\n"
        "CONFIDENCE: <integer 0-100>"
    )
    b64_image = base64.b64encode(chart_bytes).decode("utf-8")
    url = "https://api.groq.com/openai/v1/chat/completions"
    headers = {"Authorization": f"Bearer {GROQ_API_KEY}", "Content-Type": "application/json"}
    payload = {
        "model": "qwen/qwen3.6-27b",
        "messages": [{"role": "user", "content": [
            {"type": "text", "text": prompt},
            {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64_image}"}},
        ]}],
        "temperature": 0.2,
        "max_completion_tokens": 40,
    }
    try:
        res = await asyncio.wait_for(async_post(url, headers=headers, json=payload, timeout=12), timeout=14)
        data = res.json()
        if res.status_code != 200:
            logger.info(f"Chart Vision skipped (API {res.status_code}, non-blocking)")
            return None
        content = data["choices"][0]["message"]["content"]
    except Exception as e:
        logger.info(f"Chart Vision skipped (non-blocking): {e}")
        return None
    bias_m = re.search(r"BIAS:\s*(BULL|BEAR|NEUTRAL)", content, re.IGNORECASE)
    if not bias_m:
        return None
    conf_m = re.search(r"CONFIDENCE:\s*(\d{1,3})", content)
    confidence = max(0, min(100, int(conf_m.group(1)))) if conf_m else 60
    return {"bias": bias_m.group(1).upper(), "confidence": confidence}

