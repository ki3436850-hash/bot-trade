async def dodojob_button_handler(update, context, data, q, uid, ud):
    if data == "dj_home":
        ud["dj_state"] = None
        save_data()
        await q.message.reply_text("💼 DodoJob", reply_markup=dj_home_keyboard(is_admin(uid)))
        return True

    if data == "dj_interviews":
        if not store_db_ready():
            await q.message.reply_text(STORE_DB_UNAVAILABLE_MSG)
            return True
        as_candidate = await db_get_orders_by_buyer(uid, limit=50)
        as_employer = await db_get_orders_by_seller(uid, limit=50)
        rows = []
        for o, role in [(x, "candidate") for x in as_candidate] + [(x, "employer") for x in as_employer]:
            if not o.get("interview_status") or not o.get("interview_datetime"):
                continue
            listing = await db_get_listing(o["listing_id"])
            title = (listing.get("name") if listing else None) or f"ការងារ #{o['listing_id']}"
