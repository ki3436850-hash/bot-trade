            text = AI_INTEL.render_combined(b, d, ai_text=ai_text, ai_err=ai_err)
    except Exception as e:
        logger.exception(f"analyze_run failed ({mode} {symbol} {tf}): {e}")
        text = f"❌ Analysis failed for {symbol} {tf} (unexpected error). Nothing was fabricated — please try again."
    await analyze_send(q, text, analyze_result_keyboard(mode, symbol, tf))

