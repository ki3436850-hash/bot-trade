def _ea_bias_from_points(bull, bear):
    if bull > bear:
        return "BULL"
    if bear > bull:
        return "BEAR"
    return "NEUTRAL"

def ea_score_trend(df):
    """Trend component (spec §5/§6) — EMA20/EMA50 slope, price vs EMA200 when
    there's enough history, plus ADX/DI+/DI- (spec §8) for direction and
    trend-strength. 0-100 score = strength of agreement."""
    ema20 = calculate_ema(df, 20)
    ema50 = calculate_ema(df, 50)
    price = df["close"].iloc[-1]
    bull, bear, reasons = 0, 0, []
    if ema20 > ema50:
        bull += 1; reasons.append("EMA20>EMA50 (uptrend)")
    else:
        bear += 1; reasons.append("EMA20<EMA50 (downtrend)")
    if len(df) >= 100:
        ema200 = calculate_ema(df, 200)
        if price > ema200:
            bull += 1; reasons.append("Price>EMA200")
        else:
            bear += 1; reasons.append("Price<EMA200")
    adx, plus_di, minus_di = calculate_adx(df)
    if adx is not None:
        if plus_di > minus_di:
            bull += 1; reasons.append(f"+DI>-DI (ADX {adx:.1f})")
        else:
            bear += 1; reasons.append(f"-DI>+DI (ADX {adx:.1f})")
    total = bull + bear
    score = round(max(bull, bear) / total * 100) if total else 50
    # ADX strength gate: a weak/ranging ADX pulls the score toward neutral so
    # a "trend" reading during a genuinely flat market can't dominate the
    # confluence; a strong ADX is noted but doesn't override the vote count.
    if adx is not None:
        if adx < 20:
            score = round(score * 0.6 + 50 * 0.4)
            reasons.append(f"Weak trend strength (ADX {adx:.1f} < 20)")
        elif adx >= 25:
            reasons.append(f"Strong trend strength (ADX {adx:.1f} ≥ 25)")
    return {"bias": _ea_bias_from_points(bull, bear), "score": score, "reasons": reasons, "adx": adx}

def ea_score_momentum(df, trend=None):
    """Momentum component — RSI extremes + MACD cross + Stochastic %K (spec §8).
    Trend-aware: in a strong trend (ADX >= 25) an RSI/Stochastic extreme AGAINST
    that trend (e.g. RSI overbought in an uptrend) is noted but no longer votes
    for a reversal - overbought/oversold is not a standalone BUY/SELL signal.
    Pullback-direction extremes (oversold in an uptrend) still vote."""
    strong_trend = None
    if trend and trend.get("adx") is not None and trend["adx"] >= 25 and trend.get("bias") in ("BULL", "BEAR"):
        strong_trend = trend["bias"]
    rsi_val = calculate_rsi(df)
    macd_line, signal_line, _hist = calculate_macd(df)
    stoch_k, stoch_d = calculate_stochastic(df)
    bull, bear, reasons = 0, 0, []
    if rsi_val <= 35:
        if strong_trend == "BEAR":
            reasons.append(f"RSI oversold ({rsi_val:.1f}) - ignored, strong downtrend")
        else:
            bull += 1; reasons.append(f"RSI oversold ({rsi_val:.1f})")
    elif rsi_val >= 65:
        if strong_trend == "BULL":
            reasons.append(f"RSI overbought ({rsi_val:.1f}) - ignored, strong uptrend")
        else:
            bear += 1; reasons.append(f"RSI overbought ({rsi_val:.1f})")
    else:
        reasons.append(f"RSI neutral ({rsi_val:.1f})")
    if macd_line > signal_line:
        bull += 1; reasons.append("MACD bullish")
    else:
        bear += 1; reasons.append("MACD bearish")
    if stoch_k is not None:
        if stoch_k <= 20:
            if strong_trend == "BEAR":
                reasons.append(f"Stochastic oversold (%K {stoch_k:.1f}) - ignored, strong downtrend")
            else:
                bull += 1; reasons.append(f"Stochastic oversold (%K {stoch_k:.1f})")
        elif stoch_k >= 80:
            if strong_trend == "BULL":
                reasons.append(f"Stochastic overbought (%K {stoch_k:.1f}) - ignored, strong uptrend")
            else:
                bear += 1; reasons.append(f"Stochastic overbought (%K {stoch_k:.1f})")
        else:
            reasons.append(f"Stochastic neutral (%K {stoch_k:.1f})")
    total = bull + bear
    bias = _ea_bias_from_points(bull, bear) if total else "NEUTRAL"
    score = round(max(bull, bear) / total * 100) if total else 50
    return {"bias": bias, "score": score, "reasons": reasons, "rsi": rsi_val, "stoch_k": stoch_k, "stoch_d": stoch_d}

def ea_score_structure(df, window=3):
    """Market Structure component (spec §6) — swing highs/lows -> HH/HL vs
    LH/LL. Returns NEUTRAL/UNCLEAR when there isn't a clean two-swing read."""
    highs, lows = df["high"], df["low"]
    n = len(df)
    if n < window * 2 + 4:
        return {"bias": "NEUTRAL", "score": 50, "reasons": ["Not enough bars for structure"]}
    swing_highs = [float(v) for v in _swing_extremes(highs.to_numpy(), window, False)]
    swing_lows = [float(v) for v in _swing_extremes(lows.to_numpy(), window, True)]
    if len(swing_highs) < 2 or len(swing_lows) < 2:
        return {"bias": "NEUTRAL", "score": 50, "reasons": ["No clear swing structure"]}
    hh, hl = swing_highs[-1] > swing_highs[-2], swing_lows[-1] > swing_lows[-2]
    lh, ll = swing_highs[-1] < swing_highs[-2], swing_lows[-1] < swing_lows[-2]
    if hh and hl:
        return {"bias": "BULL", "score": 80, "reasons": ["HH/HL (uptrend structure)"]}
    if lh and ll:
        return {"bias": "BEAR", "score": 80, "reasons": ["LH/LL (downtrend structure)"]}
    return {"bias": "NEUTRAL", "score": 45, "reasons": ["Mixed swing structure"]}

def ea_last_swing_level(df, direction, swing_window=3):
    """Most recent CONFIRMED swing low (for BUY) / swing high (for SELL) in
    df, for structure-based SL (spec §15). A swing point at index i needs
    swing_window bars on BOTH sides to confirm, so only bars up to
    len(df)-1-swing_window can ever be returned — callers that must stay
    causal (the backtester) pass an already-truncated df (df.iloc[:i+1]),
    which makes this automatically no-look-ahead. Returns None if there's
    no confirmed swing yet."""
    highs, lows = df["high"], df["low"]
    n = len(df)
    if n < swing_window * 2 + 2:
        return None
    lo_idx, hi_idx = swing_window, n - 1 - swing_window
    if direction == "BUY":
        for i in range(hi_idx, lo_idx - 1, -1):
            seg = lows.iloc[i - swing_window: i + swing_window + 1]
            if lows.iloc[i] == seg.min():
                return float(lows.iloc[i])
    else:
        for i in range(hi_idx, lo_idx - 1, -1):
            seg = highs.iloc[i - swing_window: i + swing_window + 1]
            if highs.iloc[i] == seg.max():
                return float(highs.iloc[i])
    return None

def ea_compute_sl_distance(df, direction, price, atr, risk):
    """SL distance per the configured mode (spec §15: ATR / Structure / Fixed).
    Structure and Fixed both fall back to ATR (with a note) if they can't
    produce a sane positive distance, so a plan is never built on an unusable
    stop. Returns (distance, mode_actually_used, note_or_None)."""
    mode = risk.get("sl_mode", "atr")
    atr_distance = atr * risk.get("sl_atr_mult", 1.5)
    if mode == "fixed":
        pct = risk.get("fixed_sl_pct", 0.5)
        distance = price * (pct / 100.0)
        if distance > 0:
            return distance, "fixed", None
        return atr_distance, "atr", "Fixed SL % invalid — used ATR instead"
    if mode == "structure":
        level = ea_last_swing_level(df, direction)
        if level is not None:
            buffer = atr * 0.25  # small buffer beyond the swing point so a wick doesn't instantly stop it out
            distance = (price - level) + buffer if direction == "BUY" else (level - price) + buffer
            if distance > 0:
                return distance, "structure", None
        return atr_distance, "atr", "No clear swing structure yet — used ATR instead"
    return atr_distance, "atr", None

def ea_calculate_lot_size(balance, risk_pct, sl_distance_price, specs):
    """Smart Lot Size (spec §14): risk_amount ÷ (loss per 1.0 lot at this SL
    distance), rounded DOWN to the broker's lot_step, then clamped into
    [min_lot, max_lot]. Requires specs (tick_value + tick_size/point) that
    only the EA can report — returns None rather than guessing a lot size
    when they aren't available yet. Returns {"lot", "note"}; note explains
    when clamping to min/max means the actual risk differs from risk_pct."""
    if not specs or balance is None or not sl_distance_price or sl_distance_price <= 0:
        return None
    tick_value = specs.get("tick_value")
    tick_size = specs.get("tick_size") or specs.get("point")
    if not tick_value or not tick_size or tick_value <= 0 or tick_size <= 0:
        return None
    min_lot = specs.get("min_lot", 0.01) or 0.01
    max_lot = specs.get("max_lot")
    lot_step = specs.get("lot_step", 0.01) or 0.01
    risk_amount = balance * (risk_pct / 100.0)
    loss_per_lot = sl_distance_price * (tick_value / tick_size)
    if loss_per_lot <= 0:
        return None
    raw_lot = risk_amount / loss_per_lot
    lot = round(math.floor(raw_lot / lot_step) * lot_step, 8)
    note = None
    if lot < min_lot:
        lot = min_lot
        note = f"Risk-sized lot rounds below the broker minimum ({min_lot}) — using the minimum; actual risk is higher than {risk_pct}%."
    elif max_lot and lot > max_lot:
        lot = max_lot
        note = f"Risk-sized lot exceeds the broker maximum ({max_lot}) — capped; actual risk is lower than {risk_pct}%."
    lot = round(lot, 2)
    return {"lot": lot, "note": note} if lot > 0 else None

def ea_score_price_action(df):
    """Price Action component (spec §7) — last-candle pattern only, never used
    alone as a trigger (it's one weighted component of many, per spec)."""
    o, h, l, c = df["open"].iloc[-1], df["high"].iloc[-1], df["low"].iloc[-1], df["close"].iloc[-1]
    po, pc = df["open"].iloc[-2], df["close"].iloc[-2]
    body = abs(c - o)
    rng = max(h - l, 1e-9)
    upper_wick = h - max(c, o)
    lower_wick = min(c, o) - l
    if c > o and o <= pc and c >= po and pc < po:
        return {"bias": "BULL", "score": 75, "reasons": ["Bullish engulfing"]}
    if c < o and o >= pc and c <= po and pc > po:
        return {"bias": "BEAR", "score": 75, "reasons": ["Bearish engulfing"]}
    if lower_wick > body * 2 and c > o:
        return {"bias": "BULL", "score": 70, "reasons": ["Bullish pin bar / rejection"]}
    if upper_wick > body * 2 and c < o:
        return {"bias": "BEAR", "score": 70, "reasons": ["Bearish pin bar / rejection"]}
    if body / rng > 0.7:
        return {"bias": "BULL" if c > o else "BEAR", "score": 60, "reasons": ["Momentum candle"]}
    return {"bias": "NEUTRAL", "score": 50, "reasons": ["Indecision candle"]}

def ea_score_volatility(df, period=14):
    """Volatility component (spec §16/§32) — current ATR vs its own recent
    average. Not directional: extremes reduce confidence regardless of side."""
    atr_now = calculate_atr(df, period)
    high, low, close = df["high"], df["low"], df["close"]
    prev_close = close.shift(1)
    tr = pd.concat([(high - low).abs(), (high - prev_close).abs(), (low - prev_close).abs()], axis=1).max(axis=1)
    atr_series = tr.rolling(window=period).mean()
    lookback = atr_series.iloc[-40:] if len(atr_series) >= 40 else atr_series
    atr_avg = lookback.mean()
    if not atr_avg or atr_avg != atr_avg or atr_avg == 0:
        return {"label": "UNKNOWN", "ratio": 1.0, "score": 60}
    ratio = atr_now / atr_avg
    if ratio >= 2.5:
        return {"label": "EXTREME", "ratio": round(ratio, 2), "score": 20}
    if ratio >= 1.6:
        return {"label": "HIGH", "ratio": round(ratio, 2), "score": 45}
    if ratio <= 0.5:
        return {"label": "LOW (quiet)", "ratio": round(ratio, 2), "score": 55}
    return {"label": "NORMAL", "ratio": round(ratio, 2), "score": 75}

def ea_detect_abnormal_price(df, spike_ratio=5.0):
    """Abnormal Market Detector (spec §32) — per-timeframe, non-directional
    check for a sudden move or gap that's way out of line with the symbol's
    own recent bar-to-bar behavior (a ratio, not a fixed pip/point value, so
    it self-scales across symbols with very different tick sizes). An
    abnormal read on ANY analyzed timeframe is enough to block a new entry
    (see ea_generate_signal) — it does not by itself close existing positions."""
    if len(df) < 15:
        return {"abnormal": False, "detail": None}
    close = df["close"]
    recent_changes = close.diff().abs().iloc[-15:-2]
    avg_change = recent_changes.mean()
    if not avg_change or avg_change != avg_change or avg_change == 0:
        return {"abnormal": False, "detail": None}
    last_change = abs(close.iloc[-1] - close.iloc[-2])
    if last_change / avg_change >= spike_ratio:
        return {"abnormal": True,
                "detail": f"Sudden price move ({last_change / avg_change:.1f}x the recent average bar-to-bar move)"}
    gap = abs(df["open"].iloc[-1] - close.iloc[-2])
    if gap / avg_change >= spike_ratio:
        return {"abnormal": True,
                "detail": f"Price gap between bars ({gap / avg_change:.1f}x the recent average bar-to-bar move)"}
    return {"abnormal": False, "detail": None}

def ea_score_bbands_width(df, period=20):
    """Bollinger-Band-width read used by the Market Regime Detector (spec §16)
    to tell a genuine expansion (breakout) from a squeeze (low volatility /
    ranging) — current width vs its own recent average, same self-scaling
    ratio approach as ea_score_volatility."""
    close = df["close"]
    if len(close) < period + 5:
        return {"width": None, "ratio": 1.0}
    sma = close.rolling(period).mean()
    std = close.rolling(period).std()
    width = (4 * std) / sma  # (upper-lower)/sma with upper/lower = sma +/- 2*std
    width_now = width.iloc[-1]
    lookback = width.iloc[-60:-1] if len(width) >= 61 else width.iloc[:-1]
    width_avg = lookback.mean() if len(lookback) else width_now
    if width_now != width_now or not width_avg or width_avg != width_avg or width_avg == 0:
        return {"width": None, "ratio": 1.0}
    return {"width": round(float(width_now), 6), "ratio": round(float(width_now / width_avg), 2)}

def ea_detect_market_regime(df, trend=None, structure=None, volatility=None, anomaly=None):
    """Market Regime Detection (spec §16) — classifies the current market as
    TRENDING / RANGING / HIGH_VOLATILITY / LOW_VOLATILITY / BREAKOUT /
    UNSTABLE, reusing the same Trend/Structure/Volatility/Anomaly components
    the Confluence Engine already computes (pass them in to avoid recomputing;
    each is computed fresh if omitted). This is a regime LABEL, not a
    direction call — 'Allow different strategy settings depending on regime'
    (spec) is left to the caller (e.g. the Risk Engine's optional regime
    filter), not decided here."""
    if len(df) < 25:
        return {"regime": "UNKNOWN", "label": "❔ Unknown", "bias": "NEUTRAL", "detail": "Not enough bars"}
    trend = trend or ea_score_trend(df)
    structure = structure or ea_score_structure(df)
    volatility = volatility or ea_score_volatility(df)
    anomaly = anomaly if anomaly is not None else ea_detect_abnormal_price(df)
    bbw = ea_score_bbands_width(df)

    # UNSTABLE outranks everything — an anomalous move or extreme ATR means
    # the read itself isn't trustworthy, regardless of what trend/structure say.
    if anomaly.get("abnormal") or volatility["label"] == "EXTREME":
        detail = anomaly.get("detail") or f"ATR {volatility['ratio']}x its recent average"
        return {"regime": "UNSTABLE", "label": "⚠️ Unstable/Abnormal", "bias": "NEUTRAL", "detail": detail}

    # BREAKOUT — bands expanding sharply out of a squeeze, with trend AND
    # structure agreeing on direction (price is actually moving, not just noisy).
    if (bbw["ratio"] >= 1.5 and trend["score"] >= 60
            and trend["bias"] == structure["bias"] and structure["bias"] != "NEUTRAL"):
        return {"regime": "BREAKOUT", "label": f"🚀 Breakout ({trend['bias']})", "bias": trend["bias"],
                "detail": f"Bands expanding {bbw['ratio']}x vs average, trend+structure both {trend['bias']}"}

    # HIGH_VOLATILITY — elevated ATR without a clean directional read yet.
    if volatility["label"] == "HIGH":
        return {"regime": "HIGH_VOLATILITY", "label": "🌪️ High Volatility", "bias": "NEUTRAL",
                "detail": f"ATR {volatility['ratio']}x its recent average"}

    # TRENDING — trend and structure agree and are reasonably strong.
    if trend["bias"] == structure["bias"] and structure["bias"] != "NEUTRAL" and trend["score"] >= 60:
        return {"regime": "TRENDING", "label": f"📈 Trending ({trend['bias']})", "bias": trend["bias"],
                "detail": f"Trend {trend['score']}/100 and structure agree ({trend['bias']})"}

    # LOW_VOLATILITY — quiet tape (often a pre-breakout squeeze).
    if volatility["label"].startswith("LOW"):
        return {"regime": "LOW_VOLATILITY", "label": "😴 Low Volatility (quiet)", "bias": "NEUTRAL",
                "detail": f"ATR {volatility['ratio']}x its recent average"}

    return {"regime": "RANGING", "label": "↔️ Ranging", "bias": "NEUTRAL",
            "detail": "No clear trend/structure agreement"}

def ea_analyze_timeframe_bias(df, tf):
    """Score ONE timeframe by running the full Confluence Engine (spec §11) on
    it: Trend, Momentum, Structure, Price Action, Volatility. The per-component
    breakdown is kept under 'components' (for the signal-level engine and for
    future performance-by-category storage, per spec's 'store every component')
    while 'bias'/'strength'/'reasons' stay in the original shape so existing
    callers (ea_generate_signal, ea_format_signal_text) keep working."""
    price = df["close"].iloc[-1]
    trend = ea_score_trend(df)
    momentum = ea_score_momentum(df, trend=trend)
    structure = ea_score_structure(df)
    price_action = ea_score_price_action(df)
    volatility = ea_score_volatility(df)
    anomaly = ea_detect_abnormal_price(df)
    regime = ea_detect_market_regime(df, trend=trend, structure=structure, volatility=volatility, anomaly=anomaly)

    directional = [trend, momentum, structure, price_action]
    bull = sum(1 for c in directional if c["bias"] == "BULL")
    bear = sum(1 for c in directional if c["bias"] == "BEAR")
    bias = _ea_bias_from_points(bull, bear)

    # Overall per-timeframe strength = weighted blend of the directional
    # components that agree with the timeframe's own dominant bias, scaled by
    # the (non-directional) volatility score so a noisy tape can't score high.
    dir_weights = {"trend": 0.35, "momentum": 0.25, "structure": 0.25, "price_action": 0.15}
    comps = {"trend": trend, "momentum": momentum, "structure": structure, "price_action": price_action}
    agree_weight = sum(dir_weights[k] for k, c in comps.items() if c["bias"] == bias) or 1e-9
    directional_score = sum(dir_weights[k] * c["score"] for k, c in comps.items() if c["bias"] == bias) / agree_weight
    strength = round(directional_score * 0.8 + volatility["score"] * 0.2)

    reasons = [r for c in (trend, momentum, structure, price_action) for r in c["reasons"]]
    # Additive fields (support/resistance/atr) for the S/R + Liquidity
    # component and signal-output "Invalidation"/"Support"/"Resistance" lines
    # — reuses the same find_support_resistance/calculate_atr already used
    # elsewhere, no second S/R engine.
    support, resistance = find_support_resistance(df)
    atr_val = calculate_atr(df)
    return {
        "timeframe": tf, "bias": bias, "strength": strength, "reasons": reasons,
        "price": price, "rsi": momentum.get("rsi"), "adx": trend.get("adx"),
        "stoch_k": momentum.get("stoch_k"),
        "support": support, "resistance": resistance, "atr": atr_val,
        "components": {"trend": trend, "momentum": momentum, "structure": structure,
                        "price_action": price_action, "volatility": volatility, "anomaly": anomaly,
                        "regime": regime},
    }

async def ea_fetch_and_score(symbol, tf):
    if tf not in TIMEFRAME_TO_INTERVAL and tf not in EA_RESAMPLE_MAP:
        return {"timeframe": tf, "error": True, "providers_tried": [], "reason": "unsupported_timeframe"}
    df, providers_tried = await ea_get_ohlc(symbol, tf)
    if df is not None:
        df, bar_meta = ea_prepare_df(df, tf)
    if df is None or len(df) < 30:
        return {"timeframe": tf, "error": True, "providers_tried": providers_tried}
    res = ea_score_df(df, tf)
    res["bar_meta"] = bar_meta
    return res

def ea_score_df(df, tf):
    """ONE per-timeframe scoring path for live signals AND the backtester:
    indicator/structure bias + strategy-ensemble evidence, on closed candles."""
    res = ea_analyze_timeframe_bias(df, tf)
    try:  # strategy ensemble (strategy_ensemble.py): structured evidence, regime-gated
        comps = res.get("components") or {}
        sctx = {"tf": tf, "atr": res.get("atr"), "regime": comps.get("regime"), "adx": res.get("adx"),
                "structure_bias": (comps.get("structure") or {}).get("bias"),
                "support": res.get("support"), "resistance": res.get("resistance")}
        res["strategies"] = SE.evaluate_all(df, sctx)
        res["recent_bars"] = [(str(t), float(c)) for t, c in zip(df["datetime"].iloc[-8:], df["close"].iloc[-8:])]
    except Exception as e:
        logger.warning(f"strategy ensemble failed on {tf}: {e}")
        res["strategies"] = None
    return res

# ------------------------------------------------------------
# News Risk Layer (spec §8) — uses the free, no-key ForexFactory weekly
# calendar feed (title/country/date/impact). Cached for 15 minutes so the
# calendar isn't refetched on every signal request.
# ------------------------------------------------------------
EA_NEWS_CACHE = {"data": None, "fetched_at": 0}
EA_NEWS_CACHE_TTL = 900  # seconds

def ea_symbol_currencies(symbol):
    """EURUSD -> ['EUR','USD']; anything that isn't a clean 6-letter FX pair
    (crypto symbols, etc.) returns [] and the news filter is skipped for it —
    the calendar has no crypto coverage worth blocking on."""
    s = (symbol or "").upper()
    if len(s) == 6 and s.isalpha():
        return [s[:3], s[3:]]
    return []

async def ea_fetch_calendar():
    now = time.time()
    if EA_NEWS_CACHE["data"] is not None and (now - EA_NEWS_CACHE["fetched_at"]) < EA_NEWS_CACHE_TTL:
        return EA_NEWS_CACHE["data"]
    try:
        res = await async_get("https://nfs.faireconomy.media/ff_calendar_thisweek.json", timeout=10)
        data = res.json()
        EA_NEWS_CACHE["data"] = data
        EA_NEWS_CACHE["fetched_at"] = now
    except Exception as e:
        logger.warning(f"Economic calendar fetch error: {e}")
        data = EA_NEWS_CACHE["data"] or []
    return data

async def ea_news_risk(symbol, pre_minutes=30, post_minutes=15):
    """Returns {'level': LOW/MEDIUM/HIGH, 'blocking': bool, 'detail': str|None}.
    HIGH-impact events for the traded currencies block within the pre/post
    window (spec's 'XAUUSD HIGH IMPACT NEWS 15 minutes before -> BLOCK' example);
    MEDIUM is surfaced as a caution only, never blocking."""
    currencies = ea_symbol_currencies(symbol)
    if not currencies:
        return {"level": "LOW", "blocking": False, "detail": None}
    events = await ea_fetch_calendar()
    now = datetime.now(timezone.utc)
    worst = None
    for ev in events:
        if ev.get("country") not in currencies:
            continue
        impact = ev.get("impact")
        if impact not in ("High", "Medium"):
            continue
        try:
            ev_time = datetime.fromisoformat(ev["date"])
        except Exception:
            continue
        if ev_time.tzinfo is None:
            continue
        delta_min = (ev_time - now).total_seconds() / 60.0
        if not (-post_minutes <= delta_min <= pre_minutes):
            continue
        when = f"in {round(delta_min)}min" if delta_min >= 0 else f"{round(-delta_min)}min ago"
        actual = (ev.get("actual") or "").strip() if delta_min < 0 else ""   # never expose Actual before the release time
        candidate = {"level": "HIGH" if impact == "High" else "MEDIUM",
                     "blocking": impact == "High",
                     "detail": f"{ev.get('title')} ({ev.get('country')}) {when}",
                     "minutes_to_event": round(delta_min, 1),
                     "event": {"title": ev.get("title"), "currency": ev.get("country"), "impact": impact,
                               "forecast": (ev.get("forecast") or "").strip() or None,
                               "previous": (ev.get("previous") or "").strip() or None,
                               "actual": actual or None}}
        if candidate["blocking"]:
            return candidate  # HIGH wins immediately, no need to keep scanning
        worst = worst or candidate
    return worst or {"level": "LOW", "blocking": False, "detail": None}


def ea_split_htf_ltf(tfs):
    """Split a preset's timeframe list into HTF (bias/direction) and LTF
    (entry/confirmation) halves (spec §4/§6), replacing simple cross-
    timeframe majority voting as the main decision system. EA_MTF_PRESETS
    lists each preset fastest→slowest (see its definition above), so the
    back half of the list is HTF and the front half is LTF. A 1-timeframe
    list (e.g. Live Chart's single selected timeframe) is used as both —
    that single read has to serve as its own bias AND its own confirmation,
    which is exactly what the pre-existing single-timeframe behavior did."""
    n = len(tfs)
    if n <= 1:
        return tfs, tfs
    split = max(1, n // 2)
    ltf, htf = tfs[:split], tfs[split:]
    return htf, ltf

def ea_compute_htf_bias(htf_results):
    """HTF BIAS (spec §6): strength-weighted vote across the higher
    timeframes only — NOT a simple count, so one strong H4 read outweighs a
    weak, barely-directional one. Requires a real margin (15%) before
    calling BULLISH/BEARISH; otherwise NEUTRAL, which the caller treats as
    'insufficient higher-timeframe direction', never guessed."""
    if not htf_results:
        return {"bias": "NEUTRAL", "bull_weight": 0, "bear_weight": 0,
                "reasons": ["No higher-timeframe data available"]}
    bull_w = sum(r["strength"] for r in htf_results if r["bias"] == "BULL")
    bear_w = sum(r["strength"] for r in htf_results if r["bias"] == "BEAR")
    if bull_w == 0 and bear_w == 0:
        bias = "NEUTRAL"
    elif bull_w > bear_w * 1.15:
        bias = "BULLISH"
    elif bear_w > bull_w * 1.15:
        bias = "BEARISH"
    else:
        bias = "NEUTRAL"
    reasons = [f"{r['timeframe']}: {r['bias']} ({r['strength']}/100)" for r in htf_results]
    return {"bias": bias, "bull_weight": bull_w, "bear_weight": bear_w, "reasons": reasons}

def ea_compute_entry_confirmation(ltf_results, htf_bias):
    """ENTRY CONFIRMATION - delegates to direction_core.entry_confirmation (shared
    Direction Validator). A strong opposing LTF read now beats a lone agreeing one."""
    return DC.entry_confirmation(ltf_results, htf_bias)

def ea_score_htf_bias(htf):
    total = htf.get("bull_weight", 0) + htf.get("bear_weight", 0)
    if total <= 0:
        return 50
    return round(max(htf["bull_weight"], htf["bear_weight"]) / total * 100)

def ea_score_entry_confirmation(entry_conf):
    return {"CONFIRMED": 85, "PULLBACK": 55, "CONFLICT": 15,
            "NEUTRAL": 50, "NONE": 45}.get(entry_conf["status"], 50)

def ea_score_sr_proximity(direction_bias, price, support, resistance, atr):
    """S/R + LIQUIDITY component (spec §8, lightweight pass): scores an entry
    down when it sits immediately against opposing structure with no
    breakout confirmation — reuses the existing find_support_resistance/
    calculate_atr values already carried on the per-timeframe result, no new
    S/R engine. Returns (score, note_or_None). Full breakout-state
    classification (§12) and liquidity-sweep detection (§9) are NOT
    implemented by this pass — see the audit notes for what this covers."""
    if not atr or atr != atr or atr <= 0 or support is None or resistance is None or direction_bias not in ("BULL", "BEAR"):
        return 60, None
    dist = (resistance - price) if direction_bias == "BULL" else (price - support)
    if dist is None or dist != dist:
        return 60, None
    if dist <= 0:
        return 60, None  # price already through the level — proximity check doesn't apply, breakout logic (not yet implemented) would
    ratio = dist / atr
    if ratio < 0.3:
        opp = "resistance" if direction_bias == "BULL" else "support"
        return 20, f"Entry sits immediately against {opp} with no breakout confirmation"
    if ratio < 0.6:
        opp = "resistance" if direction_bias == "BULL" else "support"
        return 45, f"Entry is close to opposing {opp}"
    return 80, None

async def ea_generate_signal(symbol, preset_key, risk=None, snap=None, timeframes_override=None):
    """Confluence + Confidence + Smart No-Trade engine, analysis-only. Fetches
    every timeframe in the chosen preset concurrently, scores each one's bias,
    then requires broad agreement across timeframes before naming a direction —
    otherwise it returns NO TRADE with the specific reason (e.g. 'MTF
    Conflict', 'Weak Momentum'), rather than guessing. `snap` (an ea_snapshot())
    is optional and only used for the spread leg of the Abnormal Market check
    (spec §32) — callers without live EA state (e.g. the backtester) simply
    skip that one leg.

    timeframes_override lets a caller analyze an explicit list of timeframes
    instead of an EA_MTF_PRESETS preset — used by Live Chart, which scores the
    single timeframe the user picked rather than a fixed multi-timeframe
    preset. preset_key is then just a label carried through on the result
    (not looked up in EA_MTF_PRESETS) and such results must not be passed to
    ea_format_signal_text, which does look it up."""
    tfs = timeframes_override if timeframes_override else EA_MTF_PRESETS[preset_key]["timeframes"]
    risk = risk or {}

    tf_tasks = [ea_fetch_and_score(symbol, tf) for tf in tfs]
    vision_task = asyncio.ensure_future(ea_chart_vision_bias(symbol, tfs[0])) \
        if risk.get("chart_vision_enabled", False) else None
    results = await asyncio.gather(*tf_tasks)
    vision = await vision_task if vision_task else None

    if not [r for r in results if not r.get("error")]:
        return {"ok": False, "failed": [r["timeframe"] for r in results if r.get("error")]}

    news = {"level": "LOW", "blocking": False, "detail": None}
    if risk.get("news_filter_enabled", True):
        news = await ea_news_risk(symbol, risk.get("news_pre_minutes", 30), risk.get("news_post_minutes", 15))
    return ea_decide_signal(symbol, preset_key, tfs, results, news, vision, risk, snap)

def ea_decide_signal(symbol, preset_key, tfs, results, news, vision, risk, snap=None):
    """THE decision core (pure, no I/O): per-timeframe results + news + vision -> BUY / SELL /
    WAIT / NO TRADE. Live signals (/ea, Live Chart, /analyze cards) and the backtester call
    this exact function, so a backtest replays the same HTF/LTF model, Direction Validator,
    strategy ensemble and thresholds as live trading."""
    valid = [r for r in results if not r.get("error")]
    failed = [r["timeframe"] for r in results if r.get("error")]
    if not valid:
        return {"ok": False, "failed": failed}

    bulls = sum(1 for r in valid if r["bias"] == "BULL")
    bears = sum(1 for r in valid if r["bias"] == "BEAR")
    avg_strength = sum(r["strength"] for r in valid) / len(valid)

    # --- Hierarchical HTF/LTF model (spec §3/§4/§6) replacing simple
    # cross-timeframe majority voting as the main decision system. HTF
    # (slower) timeframes set direction; LTF (faster) timeframes confirm
    # entry timing — a neutral/pullback LTF read no longer forces "MTF
    # Conflict" the way raw bulls>0-and-bears>0 majority voting used to. ---
    htf_tfs, ltf_tfs = ea_split_htf_ltf(tfs)
    htf_results = [r for r in valid if r["timeframe"] in htf_tfs] or valid
    ltf_results = [r for r in valid if r["timeframe"] in ltf_tfs] or valid
    htf = ea_compute_htf_bias(htf_results)
    entry_conf = ea_compute_entry_confirmation(ltf_results, htf["bias"])

    # dominant_bias now follows the HTF read (falls back to raw majority only
    # when HTF itself is NEUTRAL) — everything below that used to align to a
    # majority-vote dominant_bias (component scoring, chart-vision compare)
    # now aligns to the hierarchical HTF bias instead.
    if htf["bias"] == "BULLISH":
        dominant_bias = "BULL"
    elif htf["bias"] == "BEARISH":
        dominant_bias = "BEAR"
    else:
        dominant_bias = "BULL" if bulls >= bears else "BEAR"

    # --- Confluence Engine (spec §11): aggregate each component across every
    # timeframe in the preset, scored toward whichever side is dominant. This
    # is the transparent, storable breakdown behind the final Confidence Score
    # — it is explicitly NOT a win-probability (see disclaimer in the format
    # function below). ---
    def _agg(component_key):
        scores = []
        for r in valid:
            c = r["components"][component_key]
            # Score counts fully if it agrees with the dominant bias, is
            # halved if it disagrees (a dissenting timeframe still matters,
            # just less), and counts fully if it's a non-directional read.
            if c["bias"] == dominant_bias:
                scores.append(c["score"])
            elif c["bias"] == "NEUTRAL":
                scores.append(c["score"])
            else:
                scores.append(c["score"] * 0.5)
        return round(sum(scores) / len(scores)) if scores else 50

    mtf_agreement = round(max(bulls, bears) / len(valid) * 100)
    avg_volatility = round(sum(r["components"]["volatility"]["score"] for r in valid) / len(valid))
    news_score = {"LOW": 100, "MEDIUM": 60, "HIGH": 0}.get(news["level"], 100)

    # Primary (fastest available) timeframe's raw price/support/resistance/
    # ATR, reused for the S/R + Liquidity component — same values Live
    # Chart's Technical Confirmation shows, no separate fetch/engine.
    primary = next((r for r in valid if r["timeframe"] == tfs[0]), valid[0])
    sr_score, sr_note = ea_score_sr_proximity(
        dominant_bias, primary.get("price"), primary.get("support"), primary.get("resistance"), primary.get("atr")
    )

    components = {
        "trend": _agg("trend"),
        "momentum": _agg("momentum"),
        "structure": _agg("structure"),
        "price_action": _agg("price_action"),
        "mtf": mtf_agreement,
        "news": news_score,
        "volatility": avg_volatility,
        "htf_bias": ea_score_htf_bias(htf),
        "entry_confirmation": ea_score_entry_confirmation(entry_conf),
        "sr_proximity": sr_score,
    }

    # --- Chart Vision cross-check (spec §9): compare the vision model's read
    # against the indicator-based dominant_bias. Agreement nudges the score
    # up a little; a strong, confident disagreement both drags the weighted
    # score down AND (below) forces an explicit NO TRADE reason — the spec's
    # "Reduce Confidence OR NO TRADE" becomes "reduce, and also refuse when
    # the conflict is confident enough to matter". Never let image analysis
    # override the Risk Engine itself — this only ever adjusts/blocks the
    # signal that risk checks run on top of, per spec §9's own instruction. ---
    chart_vision_conflict = None
    if vision:
        if vision["bias"] == dominant_bias:
            components["chart_vision"] = 60 + round(vision["confidence"] * 0.4)
        elif vision["bias"] == "NEUTRAL":
            components["chart_vision"] = 50
        else:
            components["chart_vision"] = max(0, 40 - round(vision["confidence"] * 0.4))
            if vision["confidence"] >= 55:
                chart_vision_conflict = (
                    f"Chart Vision Conflict — image reads {vision['bias']} "
                    f"({vision['confidence']}% confidence) vs indicators' {dominant_bias}"
                )
        weights = EA_CONFLUENCE_WEIGHTS_WITH_VISION
    else:
        weights = EA_CONFLUENCE_WEIGHTS

    confluence_score = round(sum(components[k] * w for k, w in weights.items()))
    confluence_score = max(0, min(100, confluence_score))

    # --- Abnormal Market Detector (spec §32): a hard gate, not a soft score —
    # extreme spread or a sudden/gapped move means the read itself is
    # unreliable, so this blocks a new entry outright rather than just
    # discounting confidence. Configurable so it can be turned off, but
    # defaults ON (unlike Chart Vision) since it's a safety check, not an
    # optional enhancement. ---
    abnormal_reasons = []
    if risk.get("abnormal_market_filter_enabled", True):
        for r in valid:
            a = r["components"].get("anomaly") or {}
            if a.get("abnormal"):
                abnormal_reasons.append(f"Abnormal Market ({r['timeframe']}): {a['detail']}")
                break  # one flagged timeframe is enough; avoid a wall of near-duplicate reasons
        if snap:
            spread = (snap.get("spreads") or {}).get(symbol)
            spread_cap = risk.get("max_spread_pips")
            if spread is not None and spread_cap and spread > spread_cap * 3:
                abnormal_reasons.append(
                    f"Abnormal Market: extreme spread on {symbol} ({spread} pips, "
                    f"3x+ your normal max of {spread_cap})"
                )

    no_trade_reasons = []
    if failed:
        no_trade_reasons.append(f"Data unavailable for: {', '.join(failed)}")
    if avg_strength < 50:
        no_trade_reasons.append("Weak Momentum")
    if news["blocking"]:
        no_trade_reasons.append(f"News Risk HIGH: {news['detail']}")
    if avg_volatility <= 20:
        no_trade_reasons.append("Extreme Volatility")
    if chart_vision_conflict:
        no_trade_reasons.append(chart_vision_conflict)
    if sr_note and sr_score <= 20:
        no_trade_reasons.append(f"S/R: {sr_note}")
    no_trade_reasons.extend(abnormal_reasons)

    # --- WAIT reasons (spec §17: "WAIT must be a real signal state" and must
    # explain why) — driven by the HTF/LTF hierarchy instead of the old
    # "bulls>0 and bears>0 -> MTF Conflict" majority check. These are softer
    # than no_trade_reasons above (data/news/volatility/abnormal-market hard
    # blocks): HTF/LTF non-confirmation means "not qualified yet", not "risk
    # blocked". ---
    # --- Shared Direction Validator (direction_core): HTF direction + strict entry
    # confirmation + HTF consistency + MTF alignment + S/R room + regime fit +
    # score floor. It may veto the direction (WAIT) or block on stale data. ---
    strat_all, strat_summary = None, None
    prim_s = next((r for r in valid if r["timeframe"] == tfs[0]), None)
    if prim_s and prim_s.get("strategies") is not None:
        news_ev = SE.news_event(news, prim_s.get("recent_bars"), prim_s.get("atr"),
                                TIMEFRAME_SECONDS.get(prim_s["timeframe"]),
                                bar_utc_offset_hours=EA_BAR_UTC_OFFSET_HOURS)
        news_ev["tf"] = prim_s["timeframe"]
        strat_all = list(prim_s["strategies"]) + [news_ev]
        want_side = {"BULLISH": "BUY", "BEARISH": "SELL"}.get(htf["bias"])
        if want_side:
            strat_summary = SE.regime_support(prim_s["strategies"], want_side, news_ev,
                                              min_score=(risk or {}).get("dv_min_strategy_score", 60))
    verdict = DC.validate_direction(
        valid=valid, tfs=tfs, htf_tfs=htf_tfs, ltf_tfs=ltf_tfs, htf=htf,
        entry_conf=entry_conf, confluence_score=confluence_score, risk=risk,
        strategy_summary=strat_summary)
    wait_reasons = verdict["wait_reasons"]
    no_trade_reasons.extend(verdict["block_reasons"])

    # --- Market Regime (spec §16): a label, not a directional score — read off
    # the fastest (most granular) timeframe in the preset since that's the one
    # entry timing actually depends on. Optional filter blocks entries during
    # regimes the user has flagged as unsuitable for their strategy (defaults
    # to just UNSTABLE, which mostly duplicates the Abnormal check above but
    # also catches extreme-ATR cases that aren't a sudden spike/gap). ---
    regime = valid[0]["components"]["regime"]
    if risk.get("regime_filter_enabled", True) and regime["regime"] in (risk.get("blocked_regimes") or ["UNSTABLE"]):
        no_trade_reasons.append(f"Market Regime: {regime['label']} — {regime['detail']}")

    if no_trade_reasons:
        direction = "NO TRADE"
    elif wait_reasons:
        direction = "WAIT"
        no_trade_reasons = wait_reasons  # reused by ea_format_signal_text / the unified Signal Output as the WAIT explanation
    else:
        direction = "BUY" if dominant_bias == "BULL" else "SELL"

    return {
        "ok": True, "symbol": symbol, "preset": preset_key, "direction": direction,
        "confidence": confluence_score, "components": components, "per_tf": valid,
        "failed": failed, "bulls": bulls, "bears": bears, "news": news,
        "chart_vision": vision, "no_trade_reasons": no_trade_reasons, "regime": regime,
        "htf_bias": htf, "entry_confirmation": entry_conf,
        "mtf": verdict["mtf"], "validator": {"checks": verdict["checks"], "proposed": verdict["proposed"]},
        "strategies": strat_all, "strategy_summary": strat_summary,
    }

def ea_format_signal_text(result):
    symbol = result["symbol"]
    preset = EA_MTF_PRESETS[result["preset"]]
    direction = result["direction"]
    confidence = result["confidence"]
    icon = {"BUY": "🟢", "SELL": "🔴", "WAIT": "🟡", "NO TRADE": "🚫"}.get(direction, "⚪")

    lines = [
        f"{icon} *{direction}* — {symbol}",
        f"MTF Preset: {preset['label']} ({preset['desc']})",
        "",
        f"🧠 *Confidence: {confidence}/100* (SIGNAL CONFIDENCE — analytical confluence only, NOT a win rate or probability of profit)",
        "",
    ]
    htf_bias = result.get("htf_bias")
    entry_conf = result.get("entry_confirmation")
    if htf_bias:
        lines.append(f"📐 HTF Bias: *{htf_bias['bias']}*")
        if entry_conf:
            lines.append(f"📍 Entry Confirmation: *{entry_conf['status']}*")
        lines.append("")
    comp = result.get("components")
    if comp:
        lines.append("🧩 *Confluence breakdown:*")
        comp_labels = {"htf_bias": "HTF Bias", "structure": "Structure",
                       "entry_confirmation": "Entry Confirmation", "momentum": "Momentum",
                       "price_action": "Price Action", "sr_proximity": "S/R + Liquidity",
                       "mtf": "MTF Agreement", "news": "News", "volatility": "Volatility",
                       "trend": "Trend (info only, not weighted in Confidence)",
                       "chart_vision": "Chart Vision"}
        for key, label in comp_labels.items():
            if key in comp:
                lines.append(f"   {label}: {comp[key]}")
        lines.append(f"   *Final: {confidence}/100*")
        lines.append("")
    vision = result.get("chart_vision")
    if vision:
        v_icon = {"BULL": "🟢", "BEAR": "🔴", "NEUTRAL": "🟡"}.get(vision["bias"], "⚪")
        lines.append(f"📸 Chart Vision: {v_icon} {vision['bias']} ({vision['confidence']}% confidence)")
        lines.append("")
    lines.append("📊 *Per-timeframe:*")
    for r in result["per_tf"]:
        tf_icon = {"BULL": "🟢", "BEAR": "🔴", "NEUTRAL": "🟡"}.get(r["bias"], "⚪")
        lines.append(f"   {tf_icon} {r['timeframe']}: {r['bias']} ({r['strength']}/100) — {', '.join(r['reasons'])}")
    if result.get("failed"):
        lines.append(f"   ⚠️ No data: {', '.join(result['failed'])}")

    news = result.get("news") or {"level": "LOW", "detail": None}
    news_icon = {"LOW": "🟢", "MEDIUM": "🟡", "HIGH": "🔴"}.get(news["level"], "⚪")
    news_line = f"📰 News Risk: {news_icon} {news['level']}"
    if news.get("detail"):
        news_line += f" — {news['detail']}"
    lines.append("")
    lines.append(news_line)

    regime = result.get("regime")
    if regime:
        lines.append(f"🌐 Market Regime: {regime['label']}")

    strat = result.get("strategies")
    if strat:
        lines.append("")
        lines.append("\U0001F9E0 *Strategy evidence* (only strategies that suit the regime can count)")
        clean = lambda t: str(t).replace("_", " ").replace("*", "").replace("`", "")
        for e in sorted(strat, key=lambda x: (not x["active"], not x["valid"], -x["score"])):
            if not e["active"]:
                lines.append(f"\u26AA {clean(e['strategy'])}: off in this regime")
            elif e["valid"] and e["direction"] in ("BUY", "SELL"):
                lines.append(f"\u2705 {clean(e['strategy'])}: {e['direction']} {e['score']}/100 - {clean(e['reason'])}")
            else:
                lines.append(f"\u2796 {clean(e['strategy'])}: {clean(e['reason'])}")
    lines.append("")
    if direction in ("BUY", "SELL"):
        lines.append(f"🧠 *WHY {direction}?*")
        for r in result["per_tf"]:
            agrees = (r["bias"] == "BULL" and direction == "BUY") or (r["bias"] == "BEAR" and direction == "SELL")
            mark = "✓" if agrees else "⚠️"
            lines.append(f"{mark} {r['timeframe']}: {', '.join(r['reasons'])}")
    else:
        lines.append(f"🚫 *WHY {direction}?*")
        lines.append(f"• Bullish timeframes: {result['bulls']} | Bearish timeframes: {result['bears']}")
        for reason in result.get("no_trade_reasons") or []:
            lines.append(f"• {reason}")

    lines.append("")
    lines.append(
        "⚠️ *ការព្រមាន៖* Confidence Score មិនមែនជាភាគរយនៃឱកាសឈ្នះទេ — "
        "នេះជាការវិភាគបច្ចេកទេសសម្រាប់ជាព័ត៌មានប៉ុណ្ណោះ មិនមែនជាការណែនាំហិរញ្ញវត្ថុ "
        "ហើយ Bot មិនទាន់ភ្ជាប់ទៅ MT5/Broker ដើម្បីធ្វើការ Trade ស្វ័យប្រវត្តិទេ (Phase 1)។"
    )
    return "\n".join(lines)

# ------------------------------------------------------------
# 🎯 Unified Signal Output (Signals + Analysis + Live Chart) — a thin,
# additive layer on top of the existing engine above. It does NOT recompute
# direction/confidence (ea_generate_signal), SL/TP (ea_build_execution_plan/
# ea_compute_sl_distance), or indicators (ea_technical_readout, itself the
# same computation ea_build_live_chart already used) — it only assembles
# those three existing results into the Entry/SL/TP1-3/Technical
# Confirmation/Market Condition/Risk Status layout, so Signals, Analysis and
# Live Chart can never show contradictory numbers for the same
# symbol/timeframe/snapshot.
# ------------------------------------------------------------

def ea_format_trade_signal_block(symbol, tf_label, result, plan, risk_ok, risk_reasons, tech):
    """Full 'Analyze'/'Signals'-style block: direction, confidence, Entry/SL/
    TP1-3 + R:R, Technical Confirmation, Market Condition, Risk Status. Used
    where the surrounding message doesn't already show the indicator readout
    (Signals, Analysis) — Live Chart uses the shorter ea_format_compact_signal
    instead, since it already prints Trend/RSI/MACD/etc. itself."""
    direction = result["direction"]
    confidence = result["confidence"]
    icon = {"BUY": "🟢", "SELL": "🔴", "WAIT": "🟡", "NO TRADE": "🟡"}.get(direction, "⚪")
    htf_bias = result.get("htf_bias") or {}
    entry_conf = result.get("entry_confirmation") or {}

    lines = [f"🎯 *TRADE SIGNAL — {symbol} {tf_label}*", ""]

    if direction in ("BUY", "SELL") and plan:
        lines.append(f"{icon} *{direction}*")
        lines.append(f"Confidence: {confidence}%  (analytical confluence — NOT a win rate)")
        if htf_bias.get("bias"):
            lines.append(f"HTF Bias: {htf_bias['bias']}   Entry Confirmation: {entry_conf.get('status', 'N/A')}")
        lines.append("")
        lines.append(f"💰 Entry: {plan['reference_price']}")
        lines.append(f"🛑 Stop Loss: {plan['sl']}")
        lines.append("")
        lines.append("🎯 *TAKE PROFIT*")
        lines.append(f"TP1: {plan['tp1']}")
        lines.append(f"TP2: {plan['tp2']}")
        lines.append(f"TP3: {plan['tp3']}")
        lines.append("")
        lines.append("📊 *Risk/Reward*")
        lines.append(f"TP1: 1:{plan['rr1']:.2f}")
        lines.append(f"TP2: 1:{plan['rr2']:.2f}")
        lines.append(f"TP3: 1:{plan['rr3']:.2f}")
        lines.append("")
        lines.append("⚠️ *INVALIDATION*")
        invalid_verb = "closes below" if direction == "BUY" else "closes above"
        lines.append(f"{direction} setup invalid if price {invalid_verb}: {plan['sl']}")
    elif direction in ("BUY", "SELL") and not plan:
        # Directional signal fired but SL/TP couldn't be computed (e.g. ATR
        # unavailable) — never invent numbers, say so plainly instead.
        lines.append(f"{icon} *{direction}*")
        lines.append(f"Confidence: {confidence}%")
        lines.append("")
        lines.append("⚠️ Signal unavailable")
        lines.append("Reason: Could not compute Entry/Stop Loss/Take Profit (insufficient candle data on the execution timeframe).")
    else:
        lines.append("🟡 *WAIT*")
        lines.append(f"Confidence: {confidence}%")
        if htf_bias.get("bias"):
            lines.append(f"HTF Bias: {htf_bias['bias']}   Entry Confirmation: {entry_conf.get('status', 'N/A')}")
        lines.append("")
        lines.append("💰 Entry: —")
        lines.append("🛑 Stop Loss: —")
        lines.append("🎯 TP1: —")
        lines.append("🎯 TP2: —")
        lines.append("🎯 TP3: —")
        lines.append("")
        reasons = result.get("no_trade_reasons") or []
        if not reasons:
            reasons = [f"No majority direction — {result.get('bulls', 0)} bullish vs {result.get('bears', 0)} bearish timeframes"]
        lines.append("Reason:")
        for r in reasons:
            lines.append(f"• {r}")

    lines.append("")
    lines.append("📈 *Technical Confirmation*")
    if tech:
        comps = tech["bias"]["components"]
        rsi_val = tech["bias"].get("rsi")
        lines.append(f"• Trend: {comps['trend']['bias']} ({comps['trend']['score']}/100)")
        lines.append(f"• RSI: {rsi_val:.2f}" if rsi_val is not None else "• RSI: N/A")
        lines.append(f"• MACD: {'Bullish' if tech['macd_bullish'] else 'Bearish'}")
        lines.append(f"• EMA: EMA20 {tech['ema20']:.5f} / EMA50 {tech['ema50']:.5f}")
        if tech["atr"] is not None and not pd.isna(tech["atr"]):
            lines.append(f"• ATR: {tech['atr']:.5f}")
        else:
            lines.append("• ATR: N/A")
        if tech["bb_upper"] is not None:
            lines.append(f"• Bollinger Bands: {tech['bb_lower']:.5f} / {tech['bb_mid']:.5f} / {tech['bb_upper']:.5f}")
        else:
            lines.append("• Bollinger Bands: N/A (not enough history)")
        if tech["stoch_k"] is not None:
            lines.append(f"• Stochastic: %K {tech['stoch_k']:.1f} / %D {tech['stoch_d']:.1f}")
        else:
            lines.append("• Stochastic: N/A (not enough history)")
        lines.append(f"• Market Structure: {comps['structure']['bias']} — {', '.join(comps['structure']['reasons'])}")
    else:
        lines.append("_Unavailable — insufficient candle data on the primary timeframe._")

    lines.append("")
    lines.append("🧠 *Market Condition*")
    regime = result.get("regime")
    lines.append(f"{regime['label']} — {regime['detail']}" if regime else "N/A")

    if direction in ("BUY", "SELL"):
        lines.append("")
        lines.append("🧠 *REASON*")
        reason_bits = [f"HTF {htf_bias.get('bias', 'N/A')}"]
        if entry_conf.get("status"):
            reason_bits.append(f"entry-timeframe {entry_conf['status'].lower()}")
        sr_score_val = (result.get("components") or {}).get("sr_proximity")
        if sr_score_val is not None and sr_score_val <= 45:
            reason_bits.append("near opposing structure — reduced confidence")
        lines.append(" + ".join(reason_bits) + ".")

    lines.append("")
    lines.append("⚠️ *Risk Status*")
    if risk_ok is None:
        lines.append("_Not evaluated for this direction._")
    elif risk_ok:
        lines.append("✅ No blocking issues from your current Risk Engine settings.")
    else:
        lines.append("🛑 *TRADE BLOCKED*")
        lines.append("Reason:")
        for r in risk_reasons:
            lines.append(f"• {r}")

    return "\n".join(lines)

def ea_format_compact_signal(result, plan, risk_ok, risk_reasons, acc=None):
    """Tail block appended to Live Chart (which already prints its own indicators).
    Same decision as Signals/Analysis: Signal Score, MTF, Validated Accuracy, and
    Entry/SL/TP only for a validated BUY/SELL with a real plan."""
    direction = result["direction"]
    icon = {"BUY": "\U0001F7E2", "SELL": "\U0001F534"}.get(direction, "\U0001F7E1")
    mtf = result.get("mtf") or {}
    lines = ["", "\U0001F3AF *SIGNAL*", f"{icon} *{direction}*   Signal Score: {result['confidence']}/100"]
    lines.append(f"Validated Accuracy: {acc['pct']} (sample {acc['n']})" if acc else "Validated Accuracy: Insufficient validation data")
    if mtf.get("label"):
        lines.append(f"MTF Alignment: {mtf['label']}" + (f" - {mtf['status']}" if mtf.get("status") else ""))
    lines.append("")
    if direction in ("BUY", "SELL") and plan:
        lines.append(f"ENTRY {plan['reference_price']}   SL {plan['sl']}")
        lines.append(f"TP1 {plan['tp1']}   TP2 {plan['tp2']}   TP3 {plan['tp3']}")
        lines.append(f"\u26A0\uFE0F Invalid if a candle closes {'below' if direction == 'BUY' else 'above'} {plan['sl']}")
    elif direction in ("BUY", "SELL"):
        lines.append("Entry/SL/TP unavailable (insufficient candle data) - no levels shown.")
    else:
        reasons = result.get("no_trade_reasons") or []
        lines.append("No Entry / SL / TP - waiting is a valid result.")
        if reasons:
            lines.append("Reason: " + "; ".join(reasons[:3]))
    if risk_ok is False:
        lines.append("")
        lines.append("\u26D4 Risk Engine: " + "; ".join(risk_reasons))
    return "\n".join(lines)

# ------------------------------------------------------------
# Modern compact signal card (master prompt sections 28-30). It only RENDERS what
# ea_generate_signal / the Direction Validator / ea_build_execution_plan already
# decided - no direction logic lives here. Entry/SL/TP are shown only for a
# validated BUY/SELL that has a real plan; WAIT and NO TRADE never show levels.
# ------------------------------------------------------------
_EA_DOT = {"BULL": "\U0001F7E2", "BEAR": "\U0001F534", "NEUTRAL": "\U0001F7E1"}
_EA_WORD = {"BULL": "BUY", "BEAR": "SELL", "NEUTRAL": "NEUTRAL"}

def ea_accuracy_for_card(ud, symbol, tf):
    """Validated Accuracy for the card: symbol+timeframe when its sample is reliable,
    else overall; None -> caller prints 'Insufficient validation data'."""
    if not ud:
        return None
    try:
        preds, arch = ud.get("ea_predictions") or [], ud.get("ea_pred_archive")
        for sym, t in ((symbol, tf), (None, None)):
            st = PT.compute_stats(preds, arch if sym is None else None, symbol=sym, tf=t)
            line = PT.accuracy_line(st["overall"])
            if line:
                return {"pct": line[0], "n": line[1], "scope": "this symbol and timeframe" if sym else "all signals"}
    except Exception as e:
        logger.warning(f"accuracy for card failed: {e}")
    return None

def _ea_mtf_lines(result):
    rows = (result.get("mtf") or {}).get("rows") or [
        {"tf": r["timeframe"], "bias": r["bias"]} for r in (result.get("per_tf") or [])]
    return [f"{r['tf']:<4} {_EA_DOT.get(r['bias'], chr(0x26AA))} {_EA_WORD.get(r['bias'], r['bias'])}" for r in rows]

def _ea_event_lines(news):
    """Pre/post-news block: only what the calendar feed actually provided. Missing values are
    shown as 'not provided' - never guessed. Actual appears only after the release time."""
    ev = (news or {}).get("event")
    if not ev:
        return []
    mins = news.get("minutes_to_event")
    clean = lambda t: str(t).replace("_", " ").replace("*", "").replace("`", "")
    when = "" if mins is None else (f"in {round(mins)} min" if mins >= 0 else f"{round(-mins)} min ago")
    lines = ["", "\U0001F4F0 *EVENT*", f"{clean(ev['title'])} ({ev['currency']}) - {ev['impact']} impact" + (f" - {when}" if when else "")]
    lines.append(f"Forecast: {clean(ev['forecast']) if ev.get('forecast') else 'not provided'}   "
                 f"Previous: {clean(ev['previous']) if ev.get('previous') else 'not provided'}")
    if mins is not None and mins < 0:
        lines.append(f"Actual: {clean(ev['actual']) if ev.get('actual') else 'not available from the data feed'}")
    else:
        lines.append("Actual: not released yet")
    return lines

def ea_format_signal_card(symbol, tf_label, result, plan, risk_ok=None, risk_reasons=None, acc=None):
    direction = result["direction"]
    score = result.get("confidence")
    mtf = result.get("mtf") or {}
    news = result.get("news") or {"level": "LOW", "detail": None}
    news_icon = {"LOW": "\U0001F7E2", "MEDIUM": "\U0001F7E1", "HIGH": "\U0001F534"}.get(news.get("level"), "\u26AA")
    regime = result.get("regime")
    acc_lines = ([f"Validated Accuracy: {acc['pct']}", f"Sample: {acc['n']} ({acc['scope']})"] if acc
                 else ["Validated Accuracy: Insufficient validation data"])
    mtf_block = ["\U0001F4CA MTF"] + [f"`{l}`" for l in _ea_mtf_lines(result)]
    if mtf.get("label"):
        mtf_block.append(f"Alignment: {mtf['label']}" + (f" - {mtf['status']}" if mtf.get("status") else ""))
    ctx = [f"Regime: {regime['label']}" if regime else "Regime: N/A", f"News Risk: {news_icon} {news.get('level', 'N/A')}"] + _ea_event_lines(news)

    if direction in ("BUY", "SELL") and plan:
        icon = "\U0001F7E2" if direction == "BUY" else "\U0001F534"
        lines = ["\U0001F3AF *TRADE SIGNAL*", "", f"*{symbol}* \u00b7 {tf_label}", "", f"{icon} *{direction}*", "",
                 f"Signal Score: {score}/100 (heuristic, not a probability)"] + acc_lines + ["", *mtf_block, "", *ctx, "",
                 f"ENTRY\n{plan['reference_price']}", "", f"STOP LOSS\n{plan['sl']}", "",
                 f"TAKE PROFIT\nTP1 {plan['tp1']}\nTP2 {plan['tp2']}\nTP3 {plan['tp3']}",
                 f"R:R  1:{plan['rr1']:.1f} / 1:{plan['rr2']:.1f} / 1:{plan['rr3']:.1f}", "",
                 f"\u26A0\uFE0F *INVALIDATION*\nClose {'below' if direction == 'BUY' else 'above'} {plan['sl']}"]
        if risk_ok is False:
            lines += ["", "\u26D4 *TRADE BLOCKED by Risk Engine*"] + [f"\u2022 {r}" for r in (risk_reasons or [])]
        return "\n".join(lines)

    if direction in ("BUY", "SELL"):  # validated direction but no SL/TP -> never invent levels
        return "\n".join(["\U0001F3AF *TRADE SIGNAL*", "", f"*{symbol}* \u00b7 {tf_label}", "",
                          f"\U0001F7E1 *{direction} - levels unavailable*", "",
                          f"Signal Score: {score}/100", *acc_lines, "", *mtf_block, "",
                          "Entry / Stop Loss / Take Profit could not be computed (insufficient candle data). No levels shown."])

    head = "\U0001F6D1 *NO TRADE*" if direction == "NO TRADE" else "\u26A0\uFE0F *NO TRADE / WAIT*"
    reasons = result.get("no_trade_reasons") or []
    if not reasons:
        reasons = [f"No majority direction - {result.get('bulls', 0)} bullish vs {result.get('bears', 0)} bearish timeframes"]
    lines = [head, "", f"*{symbol}* \u00b7 {tf_label}", "", *mtf_block, "", *ctx, "",
             f"Decision:\n\U0001F7E1 *{'NO TRADE' if direction == 'NO TRADE' else 'WAIT'}*", "", "Reason:"]
    lines += [f"\u2022 {r}" for r in reasons[:5]]
    if len(reasons) > 5:
        lines.append(f"\u2022 +{len(reasons) - 5} more (see Details)")
    lines += ["", f"Signal Score: {score}/100", *acc_lines, "", "Waiting is a valid result - no Entry / SL / TP is shown."]
    return "\n".join(lines)

def ea_signal_card_keyboard(symbol, preset_key, primary_tf, direction=None, back=None):
    refresh_cb = f"ea_analysis_preset_{symbol}_{preset_key}" if back else f"ea_preset_{symbol}_{preset_key}"
