def ea_format_journal(ud, limit=15):
    """Per-entry trade journal view (spec §27) — lists the most recent
    ea_trade_journal entries individually, newest first. Complements
    ea_format_performance, which only shows aggregated stats."""
    journal = ud.get("ea_trade_journal", [])[:limit]
    lines = ["━━━━━━━━━━━━━━━━", "📔 *TRADE JOURNAL*", "━━━━━━━━━━━━━━━━", ""]
    if not journal:
        lines.append("No trade requests recorded yet.")
        return "\n".join(lines)
    status_icon = {"REQUESTED": "⏳", "OPEN": "🟢", "CLOSED": "⚪"}
    for t in journal:
        when = datetime.fromtimestamp(t["requested_at"]).strftime("%Y-%m-%d %H:%M")
        icon = status_icon.get(t.get("status"), "•")
        line = (f"{icon} [{when}] {t.get('symbol', '?')} {t.get('direction', '?')} "
                f"({t.get('preset', '?')}) — conf {t.get('confidence', '?')}")
        if t.get("status") == "CLOSED":
            pl = t.get("pl")
            rr = t.get("rr_realized")
            line += f" | P/L {pl:+.2f}" if isinstance(pl, (int, float)) else " | P/L N/A"
            if rr is not None:
                line += f" | R:R {rr}"
        else:
            line += f" | {t.get('status', '?')}"
        lines.append(line)
    if len(ud.get("ea_trade_journal", [])) > limit:
        lines.append("")
        lines.append(f"(showing latest {limit} of {len(ud.get('ea_trade_journal', []))})")
    return "\n".join(lines)

def ea_daily_pl(snap, balance):
    """Sum today's TRADE_CLOSED events' P/L, for the daily-loss-limit check."""
    if not balance:
        return 0.0
    today = datetime.now().date()
    total = 0.0
    for e in snap.get("events", []):
        if e.get("type") != "TRADE_CLOSED":
            continue
        try:
            if datetime.fromtimestamp(e["at"]).date() != today:
                continue
            total += float(e.get("pl", 0) or 0)
        except Exception:
            continue
    return total

def ea_journal_pl_since(ud, since_ts):
    """Sum CLOSED trade-journal P/L for trades closed at/after since_ts (spec
    §23 Today/Weekly/Monthly P/L). Uses ea_trade_journal (linked, per-owner
    records) rather than the raw EA_STATE event feed, since that's the same
    source of truth Performance Analytics already relies on."""
    total = 0.0
    for t in ud.get("ea_trade_journal", []):
        if t.get("status") != "CLOSED" or t.get("pl") is None or not t.get("closed_at"):
            continue
        if t["closed_at"] >= since_ts:
            total += float(t["pl"] or 0)
    return round(total, 2)

def ea_floating_pl(positions):
    """Sum of all open positions' reported P/L (spec §21/§23 Floating P/L).
    Returns None (not 0) if no position reports a usable pl, so the caller
    can distinguish 'flat' from 'unknown'."""
    total, seen = 0.0, False
    for p in positions or []:
        try:
            total += float(p.get("pl", 0) or 0)
            seen = True
        except (TypeError, ValueError):
            continue
    return round(total, 2) if seen else None

EA_EQUITY_CURVE_MAX = 2000
EA_EQUITY_CURVE_MIN_INTERVAL = 900  # seconds — throttle snapshots so heartbeats every 15-30s don't flood storage

def ea_record_equity_snapshot(ud, equity):
    """Append an equity snapshot for the curve (spec §22), throttled to at
    most one point per EA_EQUITY_CURVE_MIN_INTERVAL. Capped list, oldest
    dropped first."""
    if equity is None:
        return
    curve = ud.setdefault("ea_equity_curve", [])
    now = time.time()
    if curve and (now - curve[-1]["at"]) < EA_EQUITY_CURVE_MIN_INTERVAL:
        return
    curve.append({"at": now, "equity": round(float(equity), 2)})
    if len(curve) > EA_EQUITY_CURVE_MAX:
        del curve[: len(curve) - EA_EQUITY_CURVE_MAX]

def ea_equity_change_over(ud, seconds):
    """Change in equity from the oldest snapshot within the window to the
    latest snapshot overall. Returns None if there's no snapshot old enough
    to anchor the comparison (not enough history yet — never fabricated)."""
    curve = ud.get("ea_equity_curve", [])
    if len(curve) < 2:
        return None
    cutoff = time.time() - seconds
    anchor = None
    for point in curve:
        if point["at"] >= cutoff:
            anchor = point
            break
    if anchor is None:
        anchor = curve[0]
    latest = curve[-1]
    if anchor is latest:
        return None
    return round(latest["equity"] - anchor["equity"], 2)

def ea_format_equity_curve(ud):
    curve = ud.get("ea_equity_curve", [])
    lines = ["📈 *EQUITY CURVE*", ""]
    if len(curve) < 2:
        lines.append("Not enough equity snapshots yet — this fills in as the EA sends heartbeats "
                      f"(one point recorded roughly every {EA_EQUITY_CURVE_MIN_INTERVAL // 60} min).")
        return "\n".join(lines)
    latest = curve[-1]
    day_chg = ea_equity_change_over(ud, 86400)
    week_chg = ea_equity_change_over(ud, 7 * 86400)
    month_chg = ea_equity_change_over(ud, 30 * 86400)
    lines += [
        f"Current Equity: {latest['equity']}",
        f"24h: {'+' if day_chg and day_chg > 0 else ''}{day_chg if day_chg is not None else '—'}",
        f"7d: {'+' if week_chg and week_chg > 0 else ''}{week_chg if week_chg is not None else '—'}",
        f"30d: {'+' if month_chg and month_chg > 0 else ''}{month_chg if month_chg is not None else '—'}",
        "",
        f"Snapshots recorded: {len(curve)} (oldest {datetime.fromtimestamp(curve[0]['at']).strftime('%Y-%m-%d %H:%M')})",
    ]
    return "\n".join(lines)

def ea_format_exposure(snap):
    """Symbol/total/directional exposure over currently open positions (spec
    §24). Exposure here is summed lot size — the EA doesn't currently report
    notional/contract value, so lots is the only honest unit available."""
    if not snap["connected"]:
        return ea_not_connected_text()
    positions = snap.get("positions") or []
    if not positions:
        return "📊 *EXPOSURE*\n\nNo open positions reported."
    by_symbol = {}
    total_buy, total_sell = 0.0, 0.0
    for p in positions:
        sym = p.get("symbol", "?")
        try:
            lot = float(p.get("lot", 0) or 0)
        except (TypeError, ValueError):
            lot = 0.0
        d = by_symbol.setdefault(sym, {"buy": 0.0, "sell": 0.0, "count": 0})
        d["count"] += 1
        if (p.get("direction") or "").upper() == "SELL":
            d["sell"] += lot
            total_sell += lot
        else:
            d["buy"] += lot
            total_buy += lot
    lines = ["📊 *EXPOSURE*", ""]
    for sym, d in sorted(by_symbol.items()):
        lines.append(f"*{sym}* ({d['count']} pos): BUY {round(d['buy'], 2)} lot | SELL {round(d['sell'], 2)} lot")
    lines += [
        "",
        f"Total BUY exposure: {round(total_buy, 2)} lot",
        f"Total SELL exposure: {round(total_sell, 2)} lot",
        f"Net directional exposure: {round(total_buy - total_sell, 2)} lot",
        f"Total open exposure: {round(total_buy + total_sell, 2)} lot",
    ]
    return "\n".join(lines)

def ea_update_peak_equity(ud, equity):
    """Track the highest equity ever observed for this account, so Maximum
    Drawdown (spec §13) is measured from a real peak, not just today's balance.
    Only ever increases — a deliberate withdrawal isn't a 'loss' and must be
    reset explicitly (via /ea Settings) rather than silently rebased here."""
    try:
        equity = float(equity)
    except (TypeError, ValueError):
        return
    peak = ud.get("ea_peak_equity")
    if peak is None or equity > peak:
        ud["ea_peak_equity"] = equity

def ea_current_drawdown_pct(ud, equity):
    """Current drawdown from the recorded peak, as a percentage. Returns 0 if
    there's no peak yet (e.g. before the first heartbeat with equity data)."""
    peak = ud.get("ea_peak_equity")
    if not peak or not equity:
        return 0.0
    return max(0.0, (peak - equity) / peak * 100.0)

def ea_consecutive_losses(ud):
    """Count the most recent CLOSED trades, newest first, that are losses in
    a row — stops at the first win/breakeven or at a non-closed trade."""
    journal = ud.get("ea_trade_journal", [])
    closed = sorted([t for t in journal if t.get("status") == "CLOSED" and t.get("pl") is not None],
                     key=lambda t: t.get("closed_at") or 0, reverse=True)
    count = 0
    for t in closed:
        if t["pl"] < 0:
            count += 1
        else:
            break
    return count

def ea_cooldown_remaining_minutes(ud, cooldown_minutes):
    """Spec §34 Cooldown System — after ANY closed loss, block new entries for
    cooldown_minutes. Returns 0 if no cooldown is active, else minutes left."""
    if not cooldown_minutes:
        return 0
    journal = ud.get("ea_trade_journal", [])
    losses = [t for t in journal if t.get("status") == "CLOSED" and t.get("pl") is not None and t["pl"] < 0]
    if not losses:
        return 0
    last_loss_at = max(t.get("closed_at") or 0 for t in losses)
    if not last_loss_at:
        return 0
    elapsed_min = (time.time() - last_loss_at) / 60.0
    remaining = cooldown_minutes - elapsed_min
    return max(0, round(remaining, 1))

def ea_total_exposure_lots(positions):
    total = 0.0
    for p in positions or []:
        try:
            total += abs(float(p.get("lot", 0) or 0))
        except (TypeError, ValueError):
            continue
    return total

def ea_risk_check(ud, snap, signal_result):
    """Smart No-Trade + Risk Engine (spec §12/§13) — runs BEFORE any execution
    command is ever queued. Returns (ok, reasons[])."""
    reasons = []
    risk = ud.get("ea_risk", {})

    if not snap["connected"]:
        return False, ["EA Offline"]
    if snap["run_state"] != "RUNNING":
        return False, [f"EA is {snap['run_state']} — press ▶️ Start EA first"]
    if signal_result["direction"] not in ("BUY", "SELL"):
        return False, [f"Signal is {signal_result['direction']}, nothing to execute"]
    if signal_result["confidence"] < risk.get("min_confidence", 70):
        reasons.append(f"Confidence {signal_result['confidence']} below your minimum {risk.get('min_confidence', 70)}")

    mode = (snap.get("mode") or "").upper()
    if mode == "LIVE" and not risk.get("live_trading_enabled"):
        reasons.append("Live trading is disabled in ⚙️ Settings — this account is LIVE, not DEMO")

    positions = snap.get("positions") or []
    if len(positions) >= risk.get("max_open_trades", 3):
        reasons.append(f"Maximum open trades reached ({risk.get('max_open_trades', 3)})")
    same_symbol = [p for p in positions if p.get("symbol") == signal_result["symbol"]]
    if len(same_symbol) >= risk.get("max_trades_per_symbol", 1):
        reasons.append(f"Maximum exposure on {signal_result['symbol']} already reached")

    max_total_exposure = risk.get("max_total_exposure_lots")
    if max_total_exposure:
        total_lots = ea_total_exposure_lots(positions)
        if total_lots >= max_total_exposure:
            reasons.append(f"Maximum total exposure reached ({total_lots:.2f}/{max_total_exposure:.2f} lots)")

    max_spread = risk.get("max_spread_pips")
    if max_spread:
        spread = (snap.get("spreads") or {}).get(signal_result["symbol"])
        if spread is not None and spread > max_spread:
            reasons.append(f"High Spread on {signal_result['symbol']} ({spread} > {max_spread} pips)")

    acct = snap.get("account") or {}
    balance = acct.get("balance")
    equity = acct.get("equity", balance)
    if balance:
        daily_pl = ea_daily_pl(snap, balance)
        max_loss = balance * (risk.get("max_daily_loss_pct", 5.0) / 100.0)
        if daily_pl <= -max_loss:
            reasons.append(f"Daily Loss Limit reached ({daily_pl:.2f} / -{max_loss:.2f})")

    max_dd = risk.get("max_drawdown_pct")
    if max_dd and equity:
        dd_pct = ea_current_drawdown_pct(ud, equity)
        if dd_pct >= max_dd:
            reasons.append(f"Maximum Drawdown reached ({dd_pct:.1f}% / {max_dd:.1f}%)")

    max_losses = risk.get("max_consecutive_losses")
    if max_losses:
        streak = ea_consecutive_losses(ud)
        if streak >= max_losses:
            reasons.append(f"Maximum Consecutive Losses reached ({streak}/{max_losses})")

    cooldown_remaining = ea_cooldown_remaining_minutes(ud, risk.get("cooldown_after_loss_minutes", 10))
    if cooldown_remaining > 0:
        reasons.append(f"Cooldown Active ({cooldown_remaining}min remaining after last loss)")

    allowed_sessions = risk.get("allowed_sessions") or []
    if allowed_sessions:
        current_session = ea_session_for_ts(time.time())
        if current_session not in allowed_sessions:
            reasons.append(f"Trading Session Disabled ({current_session} not in {', '.join(allowed_sessions)})")

    return (len(reasons) == 0), reasons

# Tiered-target multipliers for the unified Signal Output's TP1/TP2/TP3 (spec:
# "add-only... extend it to support three targets rather than replacing it").
# TP1 stays IDENTICAL to the pre-existing single "tp" field (multiplier 1.0),
# so every current consumer of plan["tp"]/plan["rr"] (the EA EXECUTE payload,
# ea_format_execution_confirm, ea_record_signal/ea_evaluate_signal_outcome) is
# completely unaffected. TP2/TP3 are additional, purely-informational, wider
# targets at the same SL distance and the same configured base R:R — never a
# second/competing risk system, just further multiples of the one that
# already exists (spec: "must respect... Existing R:R settings").
EA_TP_TIER_MULTIPLIERS = (1.0, 1.6, 2.4)

async def ea_build_execution_plan(symbol, preset_key, direction, risk, snap=None, timeframe_override=None):
    """Fetch the fastest timeframe in the preset fresh (price moves), compute
    an SL per the configured mode (ATR/Structure/Fixed, spec §15) and an
    R:R-based TP (spec §14/§15). Lot size is computed here ONLY as a preview
    when the EA has reported this symbol's specs (tick_value/tick_size/lot
    step) via heartbeat — the EA remains the authority on the actual order,
    since it alone can re-check broker restrictions at execution time.

    timeframe_override lets a caller that isn't working from an EA_MTF_PRESETS
    preset (e.g. Live Chart, which analyzes one specific timeframe the user
    picked rather than a preset) supply that timeframe directly instead of
    preset_key being looked up — preset_key is otherwise unused in that case."""
    fastest_tf = timeframe_override or EA_MTF_PRESETS[preset_key]["timeframes"][0]
    interval = TIMEFRAME_TO_INTERVAL.get(fastest_tf, "1h")
    df, _ = await fetch_market_data(symbol, interval=interval, timeframe=fastest_tf)
    if df is None or len(df) < 20:
        return None
    price = df["close"].iloc[-1]
    atr = calculate_atr(df)
    if not atr or atr <= 0:
        return None
    sl_distance, sl_mode_used, sl_note = ea_compute_sl_distance(df, direction, price, atr, risk)
    base_rr = risk.get("tp_rr", 2.0)
    tp_distance = sl_distance * base_rr  # unchanged — this is still TP1/"tp" exactly as before
    if direction == "BUY":
        sl, tp = price - sl_distance, price + tp_distance
    else:
        sl, tp = price + sl_distance, price - tp_distance
    # TP1/TP2/TP3 — same SL, increasingly distant targets (further above price
    # for BUY, further below price for SELL), all derived from the same
    # sl_distance/base_rr the single-TP path above already uses.
    tier_prices = []
    for mult in EA_TP_TIER_MULTIPLIERS:
        d = sl_distance * base_rr * mult
        tier_prices.append(price + d if direction == "BUY" else price - d)
    lot_info = None
    if snap is not None:
        balance = (snap.get("account") or {}).get("balance")
        specs = (snap.get("symbol_specs") or {}).get(symbol)
        lot_info = ea_calculate_lot_size(balance, risk.get("risk_per_trade_pct", 1.0), sl_distance, specs)
    return {
        "symbol": symbol, "direction": direction, "reference_price": round(float(price), 5),
        "sl": round(float(sl), 5), "tp": round(float(tp), 5),
        "risk_pct": risk.get("risk_per_trade_pct", 1.0),
        "rr": base_rr,
        "sl_mode": sl_mode_used, "sl_note": sl_note,
        "lot_size": lot_info["lot"] if lot_info else None,
        "lot_note": lot_info["note"] if lot_info else None,
        # Additive tiered-target fields — nothing above this line changed shape.
        "tp1": round(float(tier_prices[0]), 5),
        "tp2": round(float(tier_prices[1]), 5),
        "tp3": round(float(tier_prices[2]), 5),
        "rr1": round(base_rr * EA_TP_TIER_MULTIPLIERS[0], 2),
        "rr2": round(base_rr * EA_TP_TIER_MULTIPLIERS[1], 2),
        "rr3": round(base_rr * EA_TP_TIER_MULTIPLIERS[2], 2),
    }

