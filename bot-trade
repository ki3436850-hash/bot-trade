async def market_button_handler(update, context, data, q, uid, ud):
    """Returns True when the callback was handled."""

    if data == "mk_home":
        _mk_clear_state(ud); save_data()
        await market_show(q, market_home_text(), market_home_keyboard())
        return True

    if data == "mk_cancel":
        _mk_clear_state(ud); save_data()
        await market_seller_center(q, context, uid)
        return True

    if data == "mk_sc":
        _mk_clear_state(ud); save_data()
        await market_seller_center(q, context, uid)
        return True

    if data == "mk_add":
        await q.message.reply_text("🏷️ សូមជ្រើសរើសប្រភេទទំនិញ សម្រាប់ទំនិញថ្មី៖",
                                   reply_markup=await store_seller_entry_keyboard())
        return True

    if data in ("mk_orders", "mk_myorders"):
        if not store_db_ready():
            await safe_alert(q, STORE_DB_UNAVAILABLE_MSG)
            return True
        seller_only = data == "mk_orders"
        await send_orders_view(q.message, context.bot, str(uid), show_buyer=not seller_only, show_seller=True)
        return True

    # ---------- Skip buttons for the add-product wizard ----------
    if data in ("mk_ws_price", "mk_ws_disc", "mk_ws_stock"):
        step = {"mk_ws_price": "awaiting_price", "mk_ws_disc": "awaiting_discount", "mk_ws_stock": "awaiting_stock"}[data]
        if ud.get("store_state") != step:
            await safe_alert(q, "ℹ️ ជំហាននេះបានបញ្ចប់ ឬផុតកំណត់ហើយ។")
            return True
        temp = ud.setdefault("store_temp", {})
        if data == "mk_ws_price":
            temp["price"] = None
            ud["store_state"] = "awaiting_discount"; save_data()
            await _wizard_ask_discount(q.message)
        elif data == "mk_ws_disc":
            temp["discount_price"] = None
            ud["store_state"] = "awaiting_stock"; save_data()
            await _wizard_ask_stock(q.message)
        else:
            temp["stock"] = None
            ud["store_state"] = "awaiting_delivery"; save_data()
            await _wizard_ask_delivery(q.message)
        try:
            await q.edit_message_reply_markup(reply_markup=None)   # stop the old Skip button being tapped twice
        except Exception:
            pass
        return True

    # ---------- Skip buttons for the Job Post wizard ----------
    if data in ("mk_ws_jobsalary", "mk_ws_jobpos", "mk_ws_jobreq", "mk_ws_jobben"):
        step = {"mk_ws_jobsalary": "awaiting_job_salary", "mk_ws_jobpos": "awaiting_job_positions",
                "mk_ws_jobreq": "awaiting_job_requirements", "mk_ws_jobben": "awaiting_job_benefits"}[data]
        if ud.get("store_state") != step:
            await safe_alert(q, "ℹ️ ជំហាននេះបានបញ្ចប់ ឬផុតកំណត់ហើយ។")
            return True
        temp = ud.setdefault("store_temp", {})
        try:
            await q.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass
        if data == "mk_ws_jobsalary":
            temp["salary_text"] = None
            ud["store_state"] = None; save_data()
            kb = InlineKeyboardMarkup([
                [InlineKeyboardButton(JOB_TYPE_LABELS["fulltime"], callback_data="store_jobtype_fulltime"),
                 InlineKeyboardButton(JOB_TYPE_LABELS["parttime"], callback_data="store_jobtype_parttime")],
                [InlineKeyboardButton(JOB_TYPE_LABELS["remote"], callback_data="store_jobtype_remote"),
                 InlineKeyboardButton(JOB_TYPE_LABELS["internship"], callback_data="store_jobtype_internship")],
                [InlineKeyboardButton(JOB_TYPE_LABELS["contract"], callback_data="store_jobtype_contract")],
            ])
            await q.message.reply_text("🕐 ប្រភេទការងារ (Job Type)?", reply_markup=kb)
        elif data == "mk_ws_jobpos":
            temp["positions"] = 1
            ud["store_state"] = "awaiting_details"; save_data()
            await q.message.reply_text(
                "📝 សូម Type ការពិពណ៌នាការងារ (Job Description)៖ (សរសេរក្នុងសារតែមួយ)")
        elif data == "mk_ws_jobreq":
            temp["requirements"] = None
            ud["store_state"] = "awaiting_job_benefits"; save_data()
            await q.message.reply_text(
                "🎁 អត្ថប្រយោជន៍ (Benefits)? វាយម្តងមួយបន្ទាត់ ឬចុច ⏭️ រំលង៖",
