# ---------------- storage: shops ----------------

_shops_state = {"ok": None, "ts": 0.0}

async def market_shops_available():
    """True when the shops table exists (migration run). Cached so it costs
    almost nothing; a negative result is re-checked every 30s."""
    if not store_db_ready():
        return False
    now = time.time()
    if _shops_state["ok"] is not None and (now - _shops_state["ts"]) < (300 if _shops_state["ok"] else 30):
        return _shops_state["ok"]
    def _run():
        return supabase.table("shops").select("id").limit(1).execute()
    try:
        await _sb_call(_run)
        ok = True
    except Exception as e:
        logger.warning(f"shops table not available yet (run marketplace_v2_phase3_schema.sql): {e}")
        ok = False
    _shops_state["ok"] = ok
    _shops_state["ts"] = now
    return ok

_shop_cache = {}  # owner_id -> (ts, shop_row | None)
SHOP_CACHE_TTL = 60

def _shop_cache_drop(owner_id):
    _shop_cache.pop(str(owner_id), None)

async def db_get_shop_by_owner(owner_id, use_cache=True):
    key = str(owner_id)
    if use_cache:
        hit = _shop_cache.get(key)
        if hit and (time.time() - hit[0]) < SHOP_CACHE_TTL:
            return hit[1]
    def _run():
        res = supabase.table("shops").select("*").eq("owner_id", key).limit(1).execute()
        return res.data[0] if res.data else None
    try:
        shop = await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_get_shop_by_owner failed: {e}")
        return None
    if len(_shop_cache) > 2000:
        _shop_cache.clear()
    _shop_cache[key] = (time.time(), shop)
    return shop

async def db_get_shop_by_slug(slug):
    def _run():
        res = supabase.table("shops").select("*").eq("slug", str(slug).upper()).limit(1).execute()
        return res.data[0] if res.data else None
    try:
        return await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_get_shop_by_slug failed: {e}")
        return None

async def db_get_shop(shop_id):
    def _run():
        res = supabase.table("shops").select("*").eq("id", int(shop_id)).limit(1).execute()
        return res.data[0] if res.data else None
    try:
        return await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_get_shop failed: {e}")
        return None

async def db_create_shop(owner_id, name, description=None, logo_file_id=None):
    """One shop per owner (unique owner_id). A double-tap / race that hits the
    unique constraint simply returns the shop that already exists. A random
    slug collision is retried with a fresh slug."""
    owner = str(owner_id)
    for _ in range(6):
        payload = {"slug": generate_shop_slug(), "owner_id": owner, "name": name,
                   "description": description, "logo_file_id": logo_file_id}
        def _run(p=payload):
            res = supabase.table("shops").insert(p).execute()
            return res.data[0] if res.data else None
        try:
            row = await _sb_call(_run)
            if row:
                _shop_cache_drop(owner)
                return row
        except Exception as e:
            existing = await db_get_shop_by_owner(owner, use_cache=False)
            if existing:
                return existing
            logger.warning(f"db_create_shop attempt failed (retrying with a new slug): {e}")
    return None

async def db_update_shop(owner_id, fields):
    """Ownership is enforced in the query itself (owner_id), not just in the caller."""
    def _run():
        res = supabase.table("shops").update(fields).eq("owner_id", str(owner_id)).execute()
        return res.data[0] if res.data else None
    try:
        row = await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_update_shop failed: {e}")
        return None
    _shop_cache_drop(owner_id)
    return row

# ---------------- storage: listings (seller-side) ----------------

async def db_get_listings_by_seller_page(seller_id, limit=6, before_id=None):
    """Keyset-paginated, newest first, hides removed listings."""
    async def _try(hide):
        def _run():
            q = supabase.table("listings").select("*").eq("seller_id", str(seller_id))
            if hide:
                q = q.neq("status", "removed")
            q = q.order("id", desc=True).limit(limit)
            if before_id:
                q = q.lt("id", int(before_id))
            return q.execute()
        return await _sb_call(_run)
    try:
        try:
            res = await _try(True)
        except Exception as e:
            logger.warning(f"status filter unavailable, retrying without it: {e}")
            res = await _try(False)
        return res.data or []
    except Exception as e:
        logger.warning(f"db_get_listings_by_seller_page failed: {e}")
        return []

async def db_update_listing_owned(listing_id, owner_id, fields):
    """Ownership enforced at the DB level (seller_id) — a forged callback for
    someone else's product matches zero rows. Removed listings can't be edited."""
    def _run():
        res = supabase.table("listings").update(fields).eq("id", int(listing_id)) \
            .eq("seller_id", str(owner_id)).neq("status", "removed").execute()
        return res.data[0] if res.data else None
    try:
        return await _sb_call(_run)
    except Exception as e:
        logger.warning(f"db_update_listing_owned failed: {e}")
        return None

async def db_remove_listing(listing_id, by_id, reason, owner_id=None):
    """Soft delete (status='removed') — never a hard delete, because orders
    reference listings. Returns the row, or None if it was already removed /
    not owned (owner_id given) / the update failed. Falls back to status-only
    if the removed_* columns from the phase-3 migration don't exist yet."""
    full = {"status": "removed", "removed_by": str(by_id), "removed_reason": reason,
            "removed_at": datetime.now(timezone.utc).isoformat()}
    for fields in (full, {"status": "removed"}):
        def _run(f=fields):
            q = supabase.table("listings").update(f).eq("id", int(listing_id)).neq("status", "removed")
            if owner_id is not None:
                q = q.eq("seller_id", str(owner_id))
            res = q.execute()
            return res.data[0] if res.data else None
        try:
            return await _sb_call(_run)
        except Exception as e:
            logger.warning(f"db_remove_listing attempt failed: {e}")
    return None

