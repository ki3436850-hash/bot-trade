    def _send_json(self, status, obj: dict):
        # separators=(",", ":") is REQUIRED here, not cosmetic: the EA's MQL5
        # side (ExtractStringField/ExtractDoubleField/ExtractBoolField in
        # TradeMind_Bridge.mq5) is a minimal substring-based JSON reader that
        # looks for `"key":value` with NO space after the colon. json.dumps()
        # defaults to `"key": value` (space after colon), which silently
        # breaks every field the EA reads back from a heartbeat response —
        # run_state, breakeven/trailing settings, and the pending command's
        # id/action/symbol/sl/tp/etc all read back as "" / 0.0 / false. This
        # is what was making Start/Pause and EXECUTE never actually reach
        # the EA despite both sides otherwise being correctly wired.
        body = json.dumps(obj, separators=(",", ":")).encode("utf-8")
        self._send(status, "application/json; charset=utf-8", body)

    def _read_raw_body(self):
        """Raw request bytes, unparsed — needed as-is (not re-serialized)
        because the HMAC signature is computed over the exact bytes sent."""
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > 2_000_000:  # 2MB is generous for an account+positions payload
            return None
        try:
            return self.rfile.read(length)
        except Exception:
            return None

    def _handle_ea_heartbeat(self):
        raw = self._read_raw_body()
        if raw is None:
            self._send_json(400, {"error": "invalid_body"}); return
        ok, err = ea_verify_request(self, raw)
        if not ok:
            status, code = err
            self._send_json(status, {"error": code}); return
        try:
            body = json.loads(raw.decode("utf-8"))
        except Exception:
            body = None
        if body is None:
            self._send_json(400, {"error": "invalid_json"}); return
        with EA_LOCK:
            EA_STATE["last_heartbeat"] = time.time()
            EA_STATE["connected"] = True
            EA_STATE["mode"] = body.get("mode") or EA_STATE["mode"]
            EA_STATE["broker"] = body.get("broker") or EA_STATE["broker"]
            EA_STATE["ea_version"] = body.get("ea_version") or EA_STATE["ea_version"]
            if isinstance(body.get("account"), dict):
                EA_STATE["account"] = body["account"]
            if isinstance(body.get("positions"), list):
                EA_STATE["positions"] = body["positions"]
            if isinstance(body.get("spreads"), dict):
                EA_STATE["spreads"] = body["spreads"]
            if isinstance(body.get("symbol_specs"), dict):
                EA_STATE["symbol_specs"].update(body["symbol_specs"])
            commands = list(EA_STATE["pending_commands"])
            run_state = EA_STATE["run_state"]
        owner_id = ea_bridge_owner_id()
        owner_risk = get_user_data(owner_id).get("ea_risk", {}) if owner_id else {}
        if isinstance(body.get("account"), dict) and body["account"].get("equity") is not None and owner_id:
            owner_ud = get_user_data(owner_id)
            ea_update_peak_equity(owner_ud, body["account"]["equity"])
            ea_record_equity_snapshot(owner_ud, body["account"]["equity"])
            save_data()
        management = {
            "breakeven_enabled": bool(owner_risk.get("breakeven_enabled", True)),
            "breakeven_trigger_rr": float(owner_risk.get("breakeven_trigger_rr", 1.0)),
            "trailing_enabled": bool(owner_risk.get("trailing_enabled", False)),
            "trailing_mult": float(owner_risk.get("trailing_mult", 1.5)),
            "sl_mode": owner_risk.get("sl_mode", "atr"),
            "fixed_sl_pct": float(owner_risk.get("fixed_sl_pct", 0.5)),
            "partial_tp_enabled": bool(owner_risk.get("partial_tp_enabled", False)),
            "partial_tp_trigger_rr": float(owner_risk.get("partial_tp_trigger_rr", 1.0)),
            "partial_tp_close_pct": float(owner_risk.get("partial_tp_close_pct", 50)),
        }
        self._send_json(200, {"ok": True, "run_state": run_state, "commands": commands, "management": management})

    def _handle_ea_event(self):
        raw = self._read_raw_body()
        if raw is None:
            self._send_json(400, {"error": "invalid_body"}); return
        ok, err = ea_verify_request(self, raw)
        if not ok:
            status, code = err
            self._send_json(status, {"error": code}); return
        try:
            body = json.loads(raw.decode("utf-8"))
        except Exception:
            body = None
        if body is None or not body.get("type"):
            self._send_json(400, {"error": "invalid_json"}); return
        ea_add_event(body)
        if body.get("type") in ("TRADE_OPENED", "TRADE_CLOSED"):
            owner_id = ea_bridge_owner_id()
            if owner_id:
                owner_ud = get_user_data(owner_id)
                ea_apply_trade_event(owner_ud, body)
                save_data()
        notify_types = set(get_user_data(ea_bridge_owner_id()).get("ea_notify_types", [])) if ea_bridge_owner_id() else set()
        if body.get("type") in notify_types:
            _notify_admins_sync(f"🤖 *EA Event: {body.get('type')}*\n{body.get('detail', '')}")
        self._send_json(200, {"ok": True})

    def _handle_ea_command_result(self):
        raw = self._read_raw_body()
        if raw is None:
            self._send_json(400, {"error": "invalid_body"}); return
        ok, err = ea_verify_request(self, raw)
        if not ok:
            status, code = err
            self._send_json(status, {"error": code}); return
        try:
            body = json.loads(raw.decode("utf-8"))
        except Exception:
            body = None
        if body is None or not body.get("command_id"):
            self._send_json(400, {"error": "invalid_json"}); return
        with EA_LOCK:
            EA_STATE["pending_commands"] = [c for c in EA_STATE["pending_commands"] if c["id"] != body["command_id"]]
        ea_add_event({"type": f"COMMAND_{body.get('status', 'DONE')}".upper(),
                      "detail": f"cmd={body['command_id']} {body.get('detail', '')}"})
        self._send_json(200, {"ok": True})

