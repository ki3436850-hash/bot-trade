# Marketplace V2 — Phase A: Shops, Seller Center, product management, share links
# ------------------------------------------------------------
# An additive layer on top of the existing /store. Everything here uses its
# own namespace so it cannot collide with the old flows:
#   • callback_data prefix  "mk_"         (routed in _button_handler_dispatch)
#   • conversation states   "mk_*" stored in ud["store_state"] (so /cancel,
#     /start and clear_conversation_modes() already reset them)
#   • temp data             ud["mk_temp"]
# Needs marketplace_v2_phase3_schema.sql (shops table + removed_* columns).
# Every piece degrades gracefully if that migration has not been run yet:
# shop features are hidden and product removal falls back to status only.
# A shop is the seller's storefront: one shop per owner, and its products are
# simply that owner's listings — no data on "listings" is rewritten.
# ============================================================

MK_SHOP_PRODUCTS_PER_PAGE = 5
MK_LIST_PER_PAGE = 6
MK_SHOP_NAME_MIN, MK_SHOP_NAME_MAX = 2, 60
MK_SHOP_DESC_MAX = 300
MK_PRODUCT_DESC_MAX = 900
_SHOP_SLUG_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"  # no 0/O/1/I — easy to read aloud
_SHOP_SLUG_RE = re.compile(r"^[A-Za-z0-9]{4,16}$")

def _h(value):
    """HTML-escape user text for parse_mode='HTML' (shop names etc. may contain _ * < >)."""
    return _html.escape(str(value if value is not None else ""), quote=False)

def _parse_money(text):
    """float() that also rejects NaN/inf/negatives (float('nan') and float('-5') parse fine)."""
    v = float(text)
    if not math.isfinite(v) or v < 0:
        raise ValueError("invalid amount")
    return v

def generate_shop_slug(n=6):
    return "".join(secrets.choice(_SHOP_SLUG_ALPHABET) for _ in range(n))

