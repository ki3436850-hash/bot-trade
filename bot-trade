# 📈 STRATEGY PERFORMANCE — 100% Telegram/Python, no MT5 (rebuild master
# spec). Distinct from the 📊 PERFORMANCE ANALYTICS above: that section is
# real-trade performance sourced from ea_trade_journal, which only fills in
# once the EA reports TRADE_CLOSED — it stays exactly as it was and keeps
# powering 📊 Live Dashboard. Strategy Performance below is sourced ONLY from
# ea_signal_journal (every signal 🎯 Signals ever generated, each evaluated
# against real historical OHLC by ea_evaluate_signal_outcome) and works
# fully whether or not any EA/broker is ever connected.
# ------------------------------------------------------------
EA_PERF_PERIODS = ["24H", "7D", "30D", "90D", "ALL"]
EA_PERF_PERIOD_SECONDS = {"24H": 86400, "7D": 7 * 86400, "30D": 30 * 86400, "90D": 90 * 86400, "ALL": None}
EA_PERF_DEFAULT_FILTERS = {"period": "7D", "symbol": "ALL", "timeframe": "ALL", "direction": "ALL", "preset": "ALL"}
EA_PERF_LOW_SAMPLE = 5  # below this many evaluated signals, breakdown rows get a LOW SAMPLE warning (spec §9/§21)

def ea_perf_filtered_signals(ud, filters):
    """Every ea_signal_journal entry matching the current Performance filters
    (spec §8) — newest first, same order the journal is already kept in."""
    journal = ud.get("ea_signal_journal", [])
    period_secs = EA_PERF_PERIOD_SECONDS.get(filters.get("period", "ALL"))
    now = time.time()
    out = []
    for s in journal:
        if period_secs is not None and (now - s.get("at", 0)) > period_secs:
            continue
        if filters.get("symbol", "ALL") != "ALL" and s.get("symbol") != filters["symbol"]:
            continue
        if filters.get("timeframe", "ALL") != "ALL" and s.get("timeframe") != filters["timeframe"]:
            continue
        if filters.get("direction", "ALL") != "ALL" and s.get("direction") != filters["direction"]:
            continue
        if filters.get("preset", "ALL") != "ALL" and s.get("preset") != filters["preset"]:
            continue
        out.append(s)
    return out

def ea_compute_strategy_performance(signals):
    """Real calculations only (spec §7) over a list of ea_signal_journal
    entries — never fabricated. Reuses _ea_backtest_stats for the P/L-curve
    math (profit factor / max drawdown / avg R) exactly as the Backtester
    computes it, since a RESOLVED signal's r_multiple is the same kind of
    number a backtest trade's 'r' is (spec §13: reuse rather than duplicate).
    """
    total = len(signals)
    buys = sum(1 for s in signals if s.get("direction") == "BUY")
    sells = sum(1 for s in signals if s.get("direction") == "SELL")
    waits = sum(1 for s in signals if s.get("direction") in ("WAIT", "NO TRADE"))
    resolved = [s for s in signals if s.get("status") == "RESOLVED"]
    pending = [s for s in signals if s.get("status") == "PENDING"]
    expired = [s for s in signals if s.get("status") == "EXPIRED"]
    trades = [{"direction": s["direction"], "r": s["r_multiple"]} for s in resolved if s.get("r_multiple") is not None]
    bt = _ea_backtest_stats(trades)
    wins = [t for t in trades if t["r"] > 0]
    losses = [t for t in trades if t["r"] <= 0]
    confidences = [s["confidence"] for s in signals if s.get("confidence") is not None]
    rr_values = [s["rr_target"] for s in signals if s.get("rr_target") is not None]
    pf = bt["profit_factor"]
    return {
        "total_signals": total, "buy_signals": buys, "sell_signals": sells, "wait_signals": waits,
        "evaluated": len(trades), "pending": len(pending), "expired": len(expired),
        "wins": len(wins), "losses": len(losses), "breakeven": 0,  # never fabricated — see Known limitations
        "win_rate": round(len(wins) / len(trades) * 100, 2) if trades else None,
        "loss_rate": round(len(losses) / len(trades) * 100, 2) if trades else None,
        "avg_confidence": round(sum(confidences) / len(confidences), 1) if confidences else None,
        "total_pl_r": round(sum(t["r"] for t in trades), 2) if trades else None,
        "avg_win_r": round(sum(t["r"] for t in wins) / len(wins), 2) if wins else None,
        "avg_loss_r": round(sum(t["r"] for t in losses) / len(losses), 2) if losses else None,
        "profit_factor": (round(pf, 2) if isinstance(pf, (int, float)) and pf != float("inf") else pf),
        "max_drawdown_r": round(bt["max_dd_r"], 2) if trades else None,
        "avg_rr": round(sum(rr_values) / len(rr_values), 2) if rr_values else None,
        "sample_size": len(trades),
    }

def ea_group_strategy_performance(signals, key_fn):
    groups = {}
    for s in signals:
        k = key_fn(s)
        if k is None:
            continue
        groups.setdefault(k, []).append(s)
    return {k: ea_compute_strategy_performance(v) for k, v in groups.items()}

def _ea_pf_label(pf):
    if pf is None:
        return "—"
    if pf == float("inf"):
        return "∞"
    return str(pf)

def ea_format_strategy_performance(stats, filters):
    header = (
        "📈 *STRATEGY PERFORMANCE*\n"
        "_Signal-based, historical-simulation performance — no MT5/broker required._\n\n"
        f"Period: {filters.get('period', 'ALL')}   "
        f"Symbol: {filters.get('symbol', 'ALL')}   "
        f"TF: {filters.get('timeframe', 'ALL')}"
    )
    if filters.get("direction", "ALL") != "ALL":
        header += f"   Dir: {filters['direction']}"
    if filters.get("preset", "ALL") != "ALL":
        header += f"   Preset: {EA_MTF_PRESETS.get(filters['preset'], {}).get('label', filters['preset'])}"
    lines = [header, "━━━━━━━━━━━━━━"]

    if stats["total_signals"] == 0:
        lines.append("\n📭 No signal history yet for this filter.\nGenerate signals via 🎯 Signals to build the dataset.")
        return "\n".join(lines)

    lines += [
        "", "📊 *OVERVIEW*", "",
        f"Signals: {stats['total_signals']}  (BUY {stats['buy_signals']} · SELL {stats['sell_signals']} · WAIT/NO TRADE {stats['wait_signals']})",
        f"Evaluated: {stats['evaluated']}   Pending: {stats['pending']}   Expired/Unresolved: {stats['expired']}",
    ]
    if not stats["evaluated"]:
        lines += ["", "No resolved signals yet — evaluation runs each time you open Performance, "
                       "once enough new candles have printed since a signal was generated."]
        return "\n".join(lines)

    lines += [
        "", f"🟢 Wins: {stats['wins']}   🔴 Losses: {stats['losses']}   ⚪ Breakeven: {stats['breakeven']}", "",
        f"Win Rate: {stats['win_rate']}%   Loss Rate: {stats['loss_rate']}%",
        "", "━━━━━━━━━━━━━━", "", "💰 *SIMULATION (R-multiples)*", "",
        f"Total P/L: {stats['total_pl_r']:+.2f}R" if stats['total_pl_r'] is not None else "Total P/L: —",
        f"Profit Factor: {_ea_pf_label(stats['profit_factor'])}",
        f"Avg Win: {stats['avg_win_r']:+.2f}R" if stats['avg_win_r'] is not None else "Avg Win: —",
        f"Avg Loss: {stats['avg_loss_r']:+.2f}R" if stats['avg_loss_r'] is not None else "Avg Loss: —",
        f"Max Drawdown: {stats['max_drawdown_r']:.2f}R" if stats['max_drawdown_r'] is not None else "Max Drawdown: —",
        "", "━━━━━━━━━━━━━━", "", "🎯 *SIGNAL QUALITY*", "",
        f"Avg Confidence: {stats['avg_confidence']}%" if stats['avg_confidence'] is not None else "Avg Confidence: —",
        f"Avg R:R (target): {stats['avg_rr']}" if stats['avg_rr'] is not None else "Avg R:R (target): —",
    ]
    if stats["sample_size"] < EA_PERF_LOW_SAMPLE:
        lines += ["", f"⚠️ Sample size is LOW ({stats['sample_size']} evaluated signal(s)) — "
                       "treat these stats as preliminary, not a reliable edge yet."]
    lines += ["", "_Simulated/backtest-style performance from the signal engine — not a real trading account. "
                   "See 📊 Live Dashboard for actual MT5 account P/L once your EA is connected._"]
    return "\n".join(lines)

def ea_format_strategy_breakdown(groups, label):
    lines = [f"📊 *Strategy Performance by {label}*", ""]
    rows = [(k, s) for k, s in groups.items() if s["total_signals"]]
    if not rows:
        lines.append("📭 No signal history yet.")
        return "\n".join(lines)
    # Sort by evaluated sample size first (so real edges surface before
    # thin ones), then win rate — never rank a near-empty sample as "best".
    rows.sort(key=lambda kv: (-(kv[1]["sample_size"] or 0), -(kv[1]["win_rate"] or 0)))
    for key, s in rows:
        if not s["evaluated"]:
            lines.append(f"*{key}* — Signals: {s['total_signals']}, no evaluated results yet")
            continue
        warn = "  ⚠️ LOW SAMPLE" if s["sample_size"] < EA_PERF_LOW_SAMPLE else ""
        lines.append(
            f"*{key}*{warn}\n"
            f"   Signals: {s['total_signals']}  |  Win Rate: {s['win_rate']}%  |  "
            f"P/L: {s['total_pl_r']:+.2f}R  |  Sample: {s['sample_size']}"
        )
    return "\n".join(lines)

def ea_format_signal_history(signals, limit=15):
    lines = ["📜 *SIGNAL HISTORY*", ""]
    if not signals:
        lines.append("📭 No signal history yet for this filter.")
        return "\n".join(lines)
    icon_map = {"WIN": "🟢", "LOSS": "🔴", "UNRESOLVED": "⚪"}
    for s in signals[:limit]:
        ts = datetime.fromtimestamp(s["at"], tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
        if s.get("status") == "RESOLVED":
            result_line = f"Result: {icon_map.get(s['outcome'], '⚪')} {s['outcome']} ({s.get('r_multiple', 0):+.2f}R)"
        elif s.get("status") == "EXPIRED":
            result_line = "Result: ⚪ EXPIRED / UNRESOLVED"
        elif s.get("status") == "PENDING":
            result_line = "Result: ⏳ PENDING"
        else:
            result_line = "Result: — (WAIT/NO TRADE — not a tradeable signal)"
        block = [f"{ts} — {s['symbol']} {s.get('timeframe') or ''}".rstrip(),
                 f"{s['direction']}   Confidence: {s['confidence']}"]
        if s.get("reference_price") is not None:
            block.append(f"Entry: {s['reference_price']}   SL: {s['sl']}   TP: {s['tp']}")
        block.append(result_line)
        lines.append("\n".join(block))
        lines.append("")
    if len(signals) > limit:
        lines.append(f"(showing latest {limit} of {len(signals)})")
    return "\n".join(lines)

