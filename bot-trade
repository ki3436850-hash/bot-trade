async def process_due_schedules(app):
    now = datetime.now(PHNOM_PENH_TZ)
    for s in get_due_schedules(now):
        sid = s["id"]
        try:
            if s["content_type"] in ("text", "reminder"):
                prefix = "🔔 " if s["content_type"] == "reminder" else ""
                await app.bot.send_message(chat_id=s["chat_id"], text=prefix + (s.get("content_text") or ""))
            elif s["content_type"] == "photo":
                await app.bot.send_photo(chat_id=s["chat_id"], photo=s["file_id"], caption=s.get("caption") or None)
            elif s["content_type"] == "video":
                await app.bot.send_video(chat_id=s["chat_id"], video=s["file_id"], caption=s.get("caption") or None)
            elif s["content_type"] == "document":
                await app.bot.send_document(chat_id=s["chat_id"], document=s["file_id"], caption=s.get("caption") or None)
            else:
                raise ValueError(f"Unknown content_type: {s['content_type']}")
        except Exception as e:
            logger.error(f"Schedule {sid} execution failed: {e}")
            retry_count = s.get("retry_count", 0) + 1
            if retry_count >= SCHEDULE_MAX_RETRIES:
                update_schedule(sid, status="failed", retry_count=retry_count, last_error=str(e))
                try:
                    await app.bot.send_message(
                        chat_id=s["chat_id"],
                        text=f"❌ Schedule #{sid} បរាជ័យ {SCHEDULE_MAX_RETRIES} ដងជាប់ៗគ្នា ហើយត្រូវបាន បញ្ឈប់។\nមូលហេតុ: {e}")
                except Exception:
                    pass
            else:
                # ពន្យារពេលព្យាយាមម្តងទៀត ៥ នាទី ជៀសវាង Retry លឿនពេក
                update_schedule(sid, next_run=(now + timedelta(minutes=5)).isoformat(),
                                 retry_count=retry_count, last_error=str(e))
            continue

        next_run_dt = compute_next_run(datetime.fromisoformat(s["next_run"]), s["repeat_type"], s.get("repeat_days") or [])
        if next_run_dt is None:
            update_schedule(sid, status="completed", last_run=now.isoformat(), retry_count=0, last_error=None)
            logger.info(f"Schedule {sid} executed and completed for chat {s['chat_id']}")
        else:
            update_schedule(sid, next_run=next_run_dt.isoformat(), last_run=now.isoformat(),
                             retry_count=0, last_error=None)
            logger.info(f"Schedule {sid} executed for chat {s['chat_id']}, next run {next_run_dt.isoformat()}")

async def schedule_scheduler_loop(app):
    await asyncio.sleep(20)  # let the bot finish starting up first
    while True:
        try:
            await process_due_schedules(app)
        except Exception as e:
            logger.error(f"schedule_scheduler_loop error: {e}")
        await asyncio.sleep(30)

async def _post_init(application):
    application.create_task(post_scheduler_loop(application))
    application.create_task(schedule_scheduler_loop(application))

