# ============================================================
# Marketplace storage — dedicated Supabase Postgres tables
# ============================================================
# Listings and orders can grow without bound (millions of rows), so they
# are NOT stored inside the per-user JSON blob anymore. They live in two
# real Postgres tables ("listings", "orders") queried with indexes and
# keyset pagination, so lookups stay fast no matter how large the tables
# get. Run store_schema.sql (shared alongside this file) once in the
# Supabase SQL editor before using /store or /orders.
#
# The supabase-py client is synchronous under the hood, so every call is
# run in a worker thread via asyncio.to_thread — this keeps a slow/laggy
# database query from freezing the bot for every other user.

STORE_DB_UNAVAILABLE_MSG = (
    "⚠️ Marketplace ត្រូវការ Supabase ដើម្បីដំណើរការ (SUPABASE_URL/SUPABASE_KEY)។\n"
    "សូមទាក់ទង Admin ដើម្បី Setup Database ជាមុនសិន។"
)

def store_db_ready() -> bool:
    return supabase is not None

async def _sb_call(fn, *args, **kwargs):
    """Run a blocking supabase-py call off the event loop."""
    return await asyncio.to_thread(fn, *args, **kwargs)

async def db_create_listing(seller_id, category, photos, text, name=None, price=None,
                             discount_price=None, stock=None, delivery_type="manual",
                             extra_fields=None):
    """Creates a listing with the Phase 2 product fields (name/price/discount/
    stock/delivery_type/status). If the DB migration hasn't been run yet and
    those columns don't exist, the first insert raises — we catch that and
    silently retry with just the original columns, so listing creation NEVER
    breaks regardless of deploy order. Run listings_phase2_schema.sql in
    Supabase to start actually storing/using the new fields.

    extra_fields: optional dict of additional columns (e.g. Job Post fields —
    company_name/job_location/salary_text/job_type/positions/requirements/
    benefits — see listings_jobs_schema.sql). Tried first merged into the
    payload; if that insert fails (columns not migrated yet), we drop
    extra_fields and retry with just the Phase 2 columns, then legacy-only —
    so a listing is never lost, it just won't carry the extra data until the
    migration is run."""
    base_payload = {
        "seller_id": str(seller_id), "category": category, "photos": photos, "text": text,
        "name": name, "price": price, "discount_price": discount_price,
        "stock": stock, "delivery_type": delivery_type or "manual", "status": "active",
    }
    if extra_fields:
        full_payload = {**base_payload, **extra_fields}
        def _run_extra():
            return supabase.table("listings").insert(full_payload).execute()
        try:
            res = await _sb_call(_run_extra)
            return res.data[0] if res.data else None
        except Exception as e:
            logger.warning(f"db_create_listing: extra-field insert failed ({e}) — falling back "
                            "to Phase 2 columns. Run listings_jobs_schema.sql to enable Job fields.")
    def _run_full():
        return supabase.table("listings").insert(base_payload).execute()
    try:
        res = await _sb_call(_run_full)
        return res.data[0] if res.data else None
    except Exception as e:
        logger.warning(f"db_create_listing: product-field insert failed ({e}) — falling back to "
                        "legacy columns. Run listings_phase2_schema.sql to enable product fields.")
    legacy_payload = {"seller_id": str(seller_id), "category": category, "photos": photos, "text": text}
    def _run_legacy():
        return supabase.table("listings").insert(legacy_payload).execute()
    try:
        res = await _sb_call(_run_legacy)
        return res.data[0] if res.data else None
    except Exception as e:
        logger.warning(f"db_create_listing: legacy insert also failed: {e}")
        return None

async def db_decrement_listing_stock(listing_id):
    """Best-effort: called when an order is marked completed. Decrements
    tracked stock by 1 and flips status to sold_out at zero. A no-op if this
    listing doesn't track stock (stock is None) or the phase-2 columns/table
    aren't there yet — never raises into the caller.
    Compare-and-swap: the UPDATE only applies if stock is still the value we
    read (.eq("stock", old)); if another order changed it in between, we
    re-read and retry, so two simultaneous completions can't lose a decrement."""
    for _attempt in range(4):
        listing = await db_get_listing(listing_id)
        if not listing or listing.get("stock") is None:
            return
        try:
            old_stock = int(listing["stock"])
        except (TypeError, ValueError):
            return
        new_stock = max(0, old_stock - 1)
        fields = {"stock": new_stock}
        if new_stock == 0:
            fields["status"] = "sold_out"
        def _run():
            return supabase.table("listings").update(fields).eq("id", int(listing_id)) \
                .eq("stock", old_stock).execute()
        try:
            res = await _sb_call(_run)
        except Exception as e:
            logger.warning(f"db_decrement_listing_stock failed: {e}")
            return
        if res.data:
            return
    logger.warning(f"db_decrement_listing_stock: gave up on listing {listing_id} after repeated stock conflicts")

def build_listing_caption(listing, cat_name):
    """Structured caption for a listing. Old listings (created before Phase 2)
    have name/price/stock/delivery_type as None, so this renders exactly like
    the old plain '🏷️ category\\n\\ntext' caption for them — nothing about
    existing listings changes on screen."""
    lines = [f"🏷️ *{cat_name}*"]
    name = listing.get("name")
    if name:
        lines.append(f"🛍️ *{name}*")
    price = listing.get("price")
    if price is not None:
        try:
            price_f = float(price)
            discount = listing.get("discount_price")
            discount_f = float(discount) if discount is not None else None
            if discount_f is not None and discount_f < price_f:
                lines.append(f"💰 ~${price_f:g}~ → *${discount_f:g}*")
            else:
                lines.append(f"💰 ${price_f:g}")
        except (TypeError, ValueError):
            pass
    stock = listing.get("stock")
    status = listing.get("status") or "active"
    if status == "sold_out" or stock == 0:
        lines.append("⛔ អស់ស្តុក (Out of stock)")
    elif stock is not None:
        lines.append(f"📦 នៅសល់: {stock}")
    delivery_type = listing.get("delivery_type")
    if delivery_type and delivery_type != "manual":
        lines.append(f"🚚 {DELIVERY_TYPE_LABELS.get(delivery_type, delivery_type)}")
    lines.append("")
    lines.append(listing.get("text") or "")
    return "\n".join(lines)

