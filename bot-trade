def ea_sparkline(values):
    if not values:
        return ""
    blocks = "▁▂▃▄▅▆▇█"
    lo, hi = min(values), max(values)
    if hi == lo:
        return blocks[0] * len(values)
    return "".join(blocks[int((v - lo) / (hi - lo) * (len(blocks) - 1))] for v in values)

BACKTEST_TIMEFRAMES = ["M1", "M5", "M15", "M30", "H1", "H2", "H4", "H8", "D1", "W1"]
BACKTEST_MIN_BARS = 60  # lookback each decision bar needs before it can be scored at all

def _ea_backtest_stats(trades):
    """win_rate/profit_factor/avg_r/max_dd/equity from a trade list — pure
    aggregation, no data access, so it's shared by single-run, per-fold, and
    per-variant results."""
    if not trades:
        return {"trades": [], "win_rate": None, "profit_factor": None, "avg_r": None,
                 "max_dd_r": None, "equity": []}
    wins = [t for t in trades if t["r"] > 0]
    losses = [t for t in trades if t["r"] <= 0]
    sum_win = sum(t["r"] for t in wins)
    sum_loss = abs(sum(t["r"] for t in losses))
    equity, cum, peak, max_dd = [], 0.0, 0.0, 0.0
    for t in trades:
        cum += t["r"]
        equity.append(cum)
        peak = max(peak, cum)
        max_dd = max(max_dd, peak - cum)
    return {
        "trades": trades,
        "win_rate": len(wins) / len(trades) * 100,
        "profit_factor": (sum_win / sum_loss) if sum_loss > 0 else float("inf"),
        "avg_r": sum(t["r"] for t in trades) / len(trades),
        "max_dd_r": max_dd, "equity": equity,
    }

# ---------------------------------------------------------------------------
# Backtester v2 - replays the SAME decision core as live trading.
#   * every decision bar goes through ea_score_df + ea_decide_signal (HTF/LTF model,
#     Direction Validator, strategy ensemble, thresholds) - nothing is re-implemented;
#   * only closed candles are used, and bar i is decided from df.iloc[:i+1] only (no look-ahead);
#   * PREDICTION ACCURACY (next-candle direction, prediction_tracker's outcome rule) is reported
#     separately from TRADE PROFITABILITY (SL/TP replay) - a correct direction is not a profitable trade;
#   * the news filter is NOT replayed: the free calendar feed only holds the current week.
# ---------------------------------------------------------------------------
_EA_BT_NEWS = {"level": "LOW", "blocking": False, "detail": None}
_EA_BT_DV_KEYS = ("abnormal_market_filter_enabled", "regime_filter_enabled", "blocked_regimes")

def _ea_bt_signature(risk):
    """Risk keys that change the DIRECTION decision (dv_* thresholds, regime/abnormal filters).
    min_confidence / SL / TP do not, so two runs with equal signatures can share decisions."""
    r = risk or {}
    return repr(sorted((k, repr(v)) for k, v in r.items() if k.startswith("dv_") or k in _EA_BT_DV_KEYS))

def _ea_bt_decide(df, symbol, timeframe, risk, i, memo):
    """Compact decision at bar i from df.iloc[:i+1] (cached in memo). Never raises."""
    if i in memo:
        return memo[i]
    dec = None
    try:
        window = df.iloc[:i + 1]
        res = ea_score_df(window, timeframe)
        close = float(window["close"].iloc[-1])
        prev_close = float(window["close"].iloc[-2]) if len(window) >= 2 else close
        prev_dir = "BULLISH" if close > prev_close else ("BEARISH" if close < prev_close else "NEUTRAL")
        # A NEUTRAL single-timeframe bias can only ever end as WAIT/NO TRADE in the decision core,
        # so skip the (expensive) full pass - identical outcome, much faster.
        if res.get("bias") == "NEUTRAL":
            dec = {"direction": "WAIT", "proposed": None, "score": None, "atr": res.get("atr"),
                   "close": close, "prev_dir": prev_dir, "regime": None, "supporters": []}
        else:
            out = ea_decide_signal(symbol, "backtest", [timeframe], [res], _EA_BT_NEWS, None, risk or {}, None)
            if out.get("ok"):
                dec = {"direction": out["direction"], "proposed": (out.get("validator") or {}).get("proposed"),
                       "score": out["confidence"], "atr": res.get("atr"), "close": close, "prev_dir": prev_dir,
                       "regime": ((res.get("components") or {}).get("regime") or {}).get("regime"),
                       "supporters": list((out.get("strategy_summary") or {}).get("supporters") or [])}
    except Exception as e:
        logger.warning(f"backtest decide failed at bar {i}: {e}")
    memo[i] = dec
    return dec

def _ea_backtest_scan(df, timeframe, risk, i_start, i_end, symbol="BT", memo=None):
    """No-look-ahead trade replay driven by the shared decision core. One position at a time;
    SL is checked before TP when both are touched in one candle (conservative). i_start/i_end
    limit which bars may OPEN a trade (walk-forward segments); exits may land later."""
    memo = {} if memo is None else memo
    n = len(df)
    trades = []
    i = max(i_start, BACKTEST_MIN_BARS)
    i_end = min(i_end, n - 1)
    min_conf = (risk or {}).get("min_confidence", 70)
    while i < i_end:
        dec = _ea_bt_decide(df, symbol, timeframe, risk, i, memo)
        if dec and dec["direction"] in ("BUY", "SELL") and dec["score"] is not None and dec["score"] >= min_conf:
            window = df.iloc[:i + 1]
            atr = calculate_atr(window)
            if not atr or atr <= 0 or pd.isna(atr):
                i += 1
                continue
            entry = window["close"].iloc[-1]
            direction = dec["direction"]
            sl_dist, _, _ = ea_compute_sl_distance(window, direction, entry, atr, risk)
            tp_rr = (risk or {}).get("tp_rr", 2.0)
            tp_dist = sl_dist * tp_rr
            sl = entry - sl_dist if direction == "BUY" else entry + sl_dist
            tp = entry + tp_dist if direction == "BUY" else entry - tp_dist
            exit_r, exit_j = None, None
            for j in range(i + 1, n):
                hi_j, lo_j = df["high"].iloc[j], df["low"].iloc[j]
                hit_sl = (lo_j <= sl) if direction == "BUY" else (hi_j >= sl)
                hit_tp = (hi_j >= tp) if direction == "BUY" else (lo_j <= tp)
                if hit_sl:
                    exit_r, exit_j = -1.0, j
                    break
                if hit_tp:
                    exit_r, exit_j = tp_rr, j
                    break
            if exit_r is None:
                break  # still open at the end of the data - stop rather than guess
            trades.append({"direction": direction, "entry_i": i, "exit_i": exit_j, "r": exit_r})
            i = exit_j + 1
        else:
            i += 1
    return trades

def _ea_bt_predictions(df, symbol, timeframe, risk, i_start, i_end, memo):
    """Next-candle prediction records for every bar in [i_start, i_end) where the core called
    BUY/SELL (taken) or the Direction Validator vetoed a proposed BUY/SELL (not taken).
    Outcome = prediction_tracker's rule: next CLOSED bar's close vs this close, +/- k*ATR noise band."""
    n = len(df)
    out = []
    closes = df["close"].to_numpy(dtype=float)
    for i in range(max(i_start, BACKTEST_MIN_BARS), min(i_end, n - 1)):
        dec = _ea_bt_decide(df, symbol, timeframe, risk, i, memo)
        if not dec:
            continue
        taken = dec["direction"] in ("BUY", "SELL")
        side_src = dec["direction"] if taken else dec["proposed"]
        if side_src not in ("BUY", "SELL"):
            continue
        atr = dec.get("atr")
        if not atr or atr != atr or atr <= 0:
            continue
        pred = "BULLISH" if side_src == "BUY" else "BEARISH"
        move = closes[i + 1] - closes[i]
        thr = PT.NEUTRAL_ATR_K * atr
        actual = "BULLISH" if move > thr else ("BEARISH" if move < -thr else "NEUTRAL")
        out.append({"status": "RESOLVED", "pred": pred, "actual": actual, "result": PT.classify(pred, actual),
                    "taken": taken, "score": dec["score"], "regime": dec["regime"], "prev_dir": dec["prev_dir"],
                    "symbol": symbol, "tf": timeframe, "strat": dec["supporters"], "i": i})
    return out

def _ea_bt_prediction_report(preds, bars_evaluated):
    """Prediction-accuracy block: accuracy (+95% range), balanced accuracy, BUY/SELL precision,
    confusion matrix, neutral rate, coverage, baselines, validator-vetoed accuracy."""
    st = PT.compute_stats(preds, None)
    taken = [p for p in preds if p["taken"] and p["result"] in ("CORRECT", "WRONG", "INCONCLUSIVE")]
    cm = {"BUY": {"BULLISH": 0, "BEARISH": 0, "NEUTRAL": 0}, "SELL": {"BULLISH": 0, "BEARISH": 0, "NEUTRAL": 0}}
    for p in taken:
        cm["BUY" if p["pred"] == "BULLISH" else "SELL"][p["actual"]] += 1
    dec_bull = cm["BUY"]["BULLISH"] + cm["SELL"]["BULLISH"]
    dec_bear = cm["BUY"]["BEARISH"] + cm["SELL"]["BEARISH"]
    recall_bull = cm["BUY"]["BULLISH"] / dec_bull if dec_bull else None
    recall_bear = cm["SELL"]["BEARISH"] / dec_bear if dec_bear else None
    bal = (recall_bull + recall_bear) / 2 if (recall_bull is not None and recall_bear is not None) else None
    return {"stats": st, "confusion": cm, "balanced_accuracy": bal,
            "calls": len(taken), "bars_evaluated": bars_evaluated,
            "coverage": (len(taken) / bars_evaluated) if bars_evaluated else None}

async def _ea_backtest_fetch(symbol, timeframe, outputsize="500"):
    df, _ = await ea_get_ohlc(symbol, timeframe, outputsize=outputsize)
    if df is not None:
        df, _meta = ea_prepare_df(df, timeframe)   # closed candles only - drop the still-forming bar
    if df is None or len(df) < 80:
        return None
    return df

def _ea_bt_run_sync(df, symbol, timeframe, risk, bounds):
    """CPU-heavy part (one decision per bar). Runs in a worker thread so the bot's event loop
    keeps answering other users. bounds = [(name, i_start, i_end), ...]; the decision memo is
    shared, so every bar is decided exactly once across prediction + trade passes."""
    memo = {}
    segs = []
    for name, a, b in bounds:
        preds = _ea_bt_predictions(df, symbol, timeframe, risk, a, b, memo)
        trades = _ea_backtest_scan(df, timeframe, risk, a, b, symbol=symbol, memo=memo)
        segs.append({"name": name, "bar_range": (a, b), "pred": _ea_bt_prediction_report(preds, max(0, min(b, len(df) - 1) - max(a, BACKTEST_MIN_BARS))),
                     **_ea_backtest_stats(trades)})
    return segs

async def ea_run_backtest(symbol, timeframe, risk):
    """Single-configuration backtest over the most recent ~500 closed bars."""
    df = await _ea_backtest_fetch(symbol, timeframe)
    if df is None:
        return {"ok": False}
    n = len(df)
    loop = asyncio.get_event_loop()
    segs = await loop.run_in_executor(None, _ea_bt_run_sync, df, symbol, timeframe, risk, [("all", BACKTEST_MIN_BARS, n - 1)])
    s = segs[0]
    return {"ok": True, "symbol": symbol, "timeframe": timeframe, "bars_used": n,
            "pred": s["pred"], **{k: s[k] for k in ("trades", "win_rate", "profit_factor", "avg_r", "max_dd_r", "equity")}}

WALKFORWARD_FOLDS = 3
WALKFORWARD_BARS = "1000"
WALKFORWARD_SPLIT = (("Development", 0.50), ("Validation", 0.25), ("Out-of-sample test", 0.25))

async def ea_run_walkforward(symbol, timeframe, risk, folds=WALKFORWARD_FOLDS):
    """Chronological walk-forward: development -> validation -> out-of-sample test (50/25/25 of the
    usable history). The configuration is FIXED - nothing is fitted or tuned on any segment, and
    each bar is decided from earlier bars only, so the later segments are genuinely unseen.
    Indicators are computed per bar from past data only (no normalisation across the whole sample)."""
    df = await _ea_backtest_fetch(symbol, timeframe, outputsize=WALKFORWARD_BARS)
    if df is None:
        return {"ok": False}
    n = len(df)
    usable_start, usable_end = BACKTEST_MIN_BARS, n - 1
    if usable_end - usable_start < 60:
        return {"ok": False, "reason": "not_enough_bars"}
    cuts, acc = [usable_start], 0.0
    for _name, frac in WALKFORWARD_SPLIT:
        acc += frac
        cuts.append(int(round(usable_start + (usable_end - usable_start) * acc)))
    bounds = [(WALKFORWARD_SPLIT[k][0], cuts[k], cuts[k + 1]) for k in range(len(WALKFORWARD_SPLIT))]
    loop = asyncio.get_event_loop()
    segs = await loop.run_in_executor(None, _ea_bt_run_sync, df, symbol, timeframe, risk, bounds)
    all_trades = sorted([t for s in segs for t in s["trades"]], key=lambda t: t["entry_i"])
    return {"ok": True, "symbol": symbol, "timeframe": timeframe, "bars_used": n,
            "segments": segs, "overall": _ea_backtest_stats(all_trades)}

def ea_build_comparison_risk(base_risk, variant="conservative"):
    """Builds a second risk config to compare against the user's current
    settings for A/B testing (spec §29), without needing a separate
    settings UI. 'conservative' raises the confidence bar and widens the
    stop; the base config is always Strategy A so the comparison is always
    against what the user is actually configured to trade."""
    risk = dict(base_risk or {})
    if variant == "conservative":
        risk["min_confidence"] = min(95, risk.get("min_confidence", 70) + 10)
        risk["sl_atr_mult"] = round(risk.get("sl_atr_mult", 1.5) * 1.3, 2)
    elif variant == "aggressive":
        risk["min_confidence"] = max(50, risk.get("min_confidence", 70) - 10)
        risk["sl_atr_mult"] = round(risk.get("sl_atr_mult", 1.5) * 0.8, 2)
    return risk

async def ea_run_ab_test(symbol, timeframe, risk_a, risk_b):
    """A/B comparison on the SAME fetched bars. Direction decisions are shared whenever the two
    settings agree on the decision-relevant keys (min_confidence / SL / TP don't change direction),
    so neither side gets a data advantage and the run is not computed twice."""
    df = await _ea_backtest_fetch(symbol, timeframe)
    if df is None:
        return {"ok": False}
    n = len(df)

    def _work():
        store = {}
        mem_a = store.setdefault(_ea_bt_signature(risk_a), {})
        mem_b = store.setdefault(_ea_bt_signature(risk_b), {})
        ta = _ea_backtest_scan(df, timeframe, risk_a, BACKTEST_MIN_BARS, n - 1, symbol=symbol, memo=mem_a)
        tb = _ea_backtest_scan(df, timeframe, risk_b, BACKTEST_MIN_BARS, n - 1, symbol=symbol, memo=mem_b)
        return ta, tb

    trades_a, trades_b = await asyncio.get_event_loop().run_in_executor(None, _work)
    return {
        "ok": True, "symbol": symbol, "timeframe": timeframe, "bars_used": n,
        "a": {"risk": risk_a, **_ea_backtest_stats(trades_a)},
        "b": {"risk": risk_b, **_ea_backtest_stats(trades_b)},
    }

def _ea_bt_pct(v):
    return "n/a" if v is None else f"{v * 100:.1f}%"

def _ea_bt_pred_lines(rep, title="PREDICTION ACCURACY", detail=True):
    st = rep["stats"]
    o = st["overall"]
    lines = [f"\U0001F52E *{title}* (next candle, closed bars only)"]
    if not o["n"]:
        return lines + ["No BUY/SELL calls here - the core stayed on WAIT / NO TRADE."]
    if o["reliable"]:
        lo, hi = o["ci"]
        lines.append(f"Accuracy: {_ea_bt_pct(o['accuracy'])}  (95% range {_ea_bt_pct(lo)} - {_ea_bt_pct(hi)})")
    else:
        lines.append(f"Accuracy: Insufficient validation data ({o['decided']} decided, need {PT.MIN_SAMPLE})")
        if o["decided"]:
            lines.append(f"Raw so far: {_ea_bt_pct(o['accuracy'])} - not reliable")
    lines.append(f"Sample: {o['decided']} decided, {o['inconclusive']} inside the noise band ({_ea_bt_pct(o['neutral_rate'])})")
    base = st["baseline"]
    if base.get("n"):
        parts = []
        if "majority" in base:
            parts.append(f"always-majority {_ea_bt_pct(base['majority'])}")
        if "prev_dir" in base:
            parts.append(f"repeat-previous-candle {_ea_bt_pct(base['prev_dir'])}")
        e = o.get("edge_vs_best_baseline")
        tail = (f"  ->  edge {e * 100:+.1f} pts" if (e is not None and o["reliable"]) else "  ->  edge not meaningful yet")
        lines.append("Baselines: " + ", ".join(parts) + tail)
    if not detail:
        return lines
    if rep.get("balanced_accuracy") is not None:
        lines.append(f"Balanced accuracy: {_ea_bt_pct(rep['balanced_accuracy'])}")
    b, s = st["buy"], st["sell"]
    pr = []
    if b["decided"]:
        pr.append(f"BUY precision {_ea_bt_pct(b['accuracy'])} ({b['decided']})")
    if s["decided"]:
        pr.append(f"SELL precision {_ea_bt_pct(s['accuracy'])} ({s['decided']})")
    if pr:
        lines.append("  |  ".join(pr))
    cm = rep["confusion"]
    lines.append("Confusion (call -> next candle up / down / flat):")
    lines.append(f"  BUY:  {cm['BUY']['BULLISH']} / {cm['BUY']['BEARISH']} / {cm['BUY']['NEUTRAL']}")
    lines.append(f"  SELL: {cm['SELL']['BULLISH']} / {cm['SELL']['BEARISH']} / {cm['SELL']['NEUTRAL']}")
    if rep.get("coverage") is not None:
        lines.append(f"Coverage: {rep['calls']} calls over {rep['bars_evaluated']} bars ({_ea_bt_pct(rep['coverage'])})")
    v = st["vetoed"]
    if v["decided"]:
        lines.append(f"Calls the validator blocked: {_ea_bt_pct(v['accuracy'])} ({v['decided']})"
                     + ("" if v["reliable"] else " - small sample"))
        lines.append("  (lower than issued calls = the validator is filtering out weaker setups)")
    return lines

def _ea_bt_trade_lines(r, title="TRADE RESULTS"):
    lines = [f"\U0001F4B0 *{title}* (separate from accuracy - right direction is not always profit)"]
    if not r["trades"]:
        return lines + ["No qualifying trades (signal + your min confidence + risk rules)."]
    pf = r["profit_factor"]
    pf_text = "no losses" if pf == float("inf") else f"{pf:.2f}"
    lines += [f"Trades: {len(r['trades'])}   Win rate: {r['win_rate']:.1f}%",
              f"Profit factor: {pf_text}   Avg R: {r['avg_r']:+.2f}R   Max drawdown: -{r['max_dd_r']:.2f}R"]
    if len(r["trades"]) < 30:
        lines.append("Small sample - treat these numbers as indicative only.")
    return lines

def ea_format_backtest(result):
    if not result.get("ok"):
        return "\U0001F4CA *BACKTEST*\n\nNot enough historical data to run this."
    lines = [f"\U0001F4CA *BACKTEST* - {result['symbol']} {result['timeframe']} ({result['bars_used']} closed bars)", "",
             "Replays the SAME decision core as live signals: closed candles, Direction Validator and strategy ensemble.", ""]
    lines += _ea_bt_pred_lines(result["pred"])
    lines += [""] + _ea_bt_trade_lines(result)
    if result["trades"]:
        lines += ["", f"Equity (cumulative R): {ea_sparkline(result['equity'])}"]
    lines += ["", "\u26A0\uFE0F Not modelled: news filter (the free calendar only covers this week), spread, slippage, commission. "
              "If SL and TP are touched in one candle, SL is assumed first. A sanity check of the logic, not a forecast."]
    return "\n".join(lines)

def ea_format_walkforward(result):
    if not result.get("ok"):
        reason = result.get("reason")
        msg = ("Not enough historical bars to split into segments - try a slower timeframe."
               if reason == "not_enough_bars" else "Not enough historical data to run this.")
        return f"\U0001F9EA *WALK-FORWARD*\n\n{msg}"
    lines = [f"\U0001F9EA *WALK-FORWARD* - {result['symbol']} {result['timeframe']} ({result['bars_used']} closed bars)", "",
             "Chronological split, same decision core as live: Development -> Validation -> Out-of-sample test. "
             "Settings are fixed - nothing is tuned on any segment, and every bar is decided from earlier bars only.", ""]
    accs = {}
    for seg in result["segments"]:
        a, b = seg["bar_range"]
        lines.append(f"*{seg['name']}* (bars {a}-{b})")
        lines += _ea_bt_pred_lines(seg["pred"], title="Accuracy", detail=False)
        tr = seg["trades"]
        if tr:
            pf = seg["profit_factor"]
            lines.append(f"Trades: {len(tr)}, win {seg['win_rate']:.1f}%, PF {'inf' if pf == float('inf') else f'{pf:.2f}'}, avg {seg['avg_r']:+.2f}R")
        else:
            lines.append("Trades: 0")
        lines.append("")
        accs[seg["name"]] = seg["pred"]["stats"]["overall"]
    dev, test = accs.get("Development"), accs.get("Out-of-sample test")
    lines.append("*Verdict (out-of-sample)*")
    if not test or not test["decided"]:
        lines.append("No out-of-sample calls - cannot judge.")
    elif not test["reliable"]:
        lines.append(f"Out-of-sample sample too small ({test['decided']} decided, need {PT.MIN_SAMPLE}) - no conclusion.")
    else:
        e = test.get("edge_vs_best_baseline")
        lines.append(f"Out-of-sample accuracy {_ea_bt_pct(test['accuracy'])} over {test['decided']} decided calls"
                     + (f"; {e * 100:+.1f} pts vs the best naive baseline." if e is not None else "."))
        if e is not None and e <= 0:
            lines.append("It does NOT beat a naive baseline out-of-sample.")
        if dev and dev["reliable"] and dev["accuracy"] is not None and (dev["accuracy"] - test["accuracy"]) >= 0.10:
            lines.append(f"Accuracy fell {(dev['accuracy'] - test['accuracy']) * 100:.1f} pts from development to test - a sign the result may not hold on new data.")
    overall = result["overall"]
    if overall["trades"]:
        pf = overall["profit_factor"]
        lines += ["", f"All segments, trades: {len(overall['trades'])}, win {overall['win_rate']:.1f}%, "
                  f"PF {'inf' if pf == float('inf') else f'{pf:.2f}'}, avg {overall['avg_r']:+.2f}R, max DD -{overall['max_dd_r']:.2f}R"]
    lines += ["", "\u26A0\uFE0F Same caveats as the backtest: no news replay, spread, slippage or commission. History is limited to the bars the data provider returns."]
    return "\n".join(lines)

def ea_format_ab_test(result, label_a="A (your current settings)", label_b="B (conservative variant)"):
    if not result.get("ok"):
        return "🆚 *A/B TEST*\n\nNot enough historical data to run this."

    def _side(r, label):
        n_trades = len(r["trades"])
        risk = r["risk"]
        header = (f"*Strategy {label}*\n"
                  f"min confidence {risk.get('min_confidence', 70)}, "
                  f"SL×{risk.get('sl_atr_mult', 1.5)} ATR, TP R:R 1:{risk.get('tp_rr', 2.0)}")
        if n_trades == 0:
            return header + "\n0 qualifying trades"
        pf = r["profit_factor"]
        pf_text = "∞" if pf == float("inf") else f"{pf:.2f}"
        return (header + f"\n{n_trades} trades, {r['win_rate']:.1f}% win rate, PF {pf_text}, "
                f"avg {r['avg_r']:+.2f}R, max DD -{r['max_dd_r']:.2f}R")

    lines = [
        f"🆚 *A/B TEST* — {result['symbol']} {result['timeframe']} ({result['bars_used']} bars, same data for both)",
        "",
        _side(result["a"], label_a),
        "",
        _side(result["b"], label_b),
        "",
    ]
    a_trades, b_trades = len(result["a"]["trades"]), len(result["b"]["trades"])
    if a_trades < 15 or b_trades < 15:
        lines.append("⚠️ Small sample size on one or both sides — treat any difference here as "
                      "noise, not a verdict.")
    lines.append("⚠️ This compares the same fixed logic with two settings on one historical window. "
                 "It doesn't pick a winner for you — same caveats as a standard backtest apply "
                 "(no spread/slippage/commission modeled).")
    return "\n".join(lines)


async def ea_handle_text(update, context, ud, text):
    """Text-input leg of the Modify SL/TP wizard (custom price entry) and the
    Partial Close wizard (lot-size entry). Returns True if this text was
    consumed by an /ea flow, False otherwise — mirrors the
    store_handle_text/dj_handle_text pattern so handle_text() can chain it."""
    state = ud.get("ea_state")
    if state not in ("awaiting_sl", "awaiting_tp", "awaiting_partial_lot"):
        return False
    target = ud.get("ea_modify_target")
    if not target:
        ud["ea_state"] = None
        save_data()
        return False
    try:
        value = float(text.replace(",", "."))
        if value <= 0:
            raise ValueError
    except ValueError:
        kind = "lot size" if state == "awaiting_partial_lot" else "price"
        await update.message.reply_text(f"❌ Please send a valid positive number for the {kind}, or /cancel.")
        return True

    if state == "awaiting_partial_lot":
        full_lot = target.get("full_lot")
        if isinstance(full_lot, (int, float)) and value >= full_lot:
            await update.message.reply_text(
                f"❌ That's the full position ({full_lot} lot) or more — use ❌ Close instead of Partial, "
                "or send a smaller lot size, or /cancel."
            )
            return True
        ud["ea_state"] = None
        ud["ea_modify_target"] = None
        ud["ea_pending_partial"] = {"identity": target["identity"], "lot": value, "label": target["label"]}
        ud["ea_pending_partial_ts"] = time.time()
        save_data()
        await update.message.reply_text(
            f"➗ *CLOSE {value} LOT?*\n\n{target['label']}\n\n⚠️ This sends a real partial close request. Confirm?",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("✅ Yes, close it", callback_data="ea_pospartial_go")],
                [InlineKeyboardButton("🔙 Cancel", callback_data="ea_positions")],
            ])
        )
        return True

    field = "sl" if state == "awaiting_sl" else "tp"
    ud["ea_state"] = None
    ud["ea_modify_target"] = None
    ud["ea_pending_modify"] = {"identity": target["identity"], "field": field, "value": value, "label": target["label"]}
    ud["ea_pending_modify_ts"] = time.time()
    save_data()
    await update.message.reply_text(
        f"✏️ *SET {field.upper()} = {value}?*\n\n{target['label']}\n\n⚠️ This sends a real modify request. Confirm?",
        parse_mode="Markdown",
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Yes, set it", callback_data="ea_posmod_go")],
            [InlineKeyboardButton("🔙 Cancel", callback_data="ea_positions")],
        ])
    )
    return True


