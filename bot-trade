async def dj_render_job_results(message, context, uid, results, title):
    active_results = [r for r in results if (r.get("status") or "active") == "active"]
    if not active_results:
        await message.reply_text(
            f"{title}\n\nគ្មានលទ្ធផលទេ។",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="dj_findjobs")]]))
        return
    await message.reply_text(f"{title} — {len(active_results)} ការងារ")
    bot_username = context.bot.username
    for l in active_results[:15]:
        cat_name = await get_category_name("job")
        caption = build_any_listing_caption(l, cat_name)
        await safe_send_listing(message.reply_media_group, message.reply_photo, message.reply_text,
                                  l.get("photos") or [], caption)
        await market_send_product_actions(message.reply_text, l, uid, bot_username)
    await message.reply_text("🔙", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back to Find Jobs", callback_data="dj_findjobs")]]))

