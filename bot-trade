def start_health_server():
    port = int(os.environ.get("PORT", "10000"))
    # ThreadingHTTPServer (មិនមែន HTTPServer ធម្មតា) ព្រោះ /tiktok/callback ត្រូវហៅ TikTok
    # API ដែលចំណាយពេលខ្លះ (Network Call) — ដូច្នេះកុំឲ្យ Request នេះទប់ស្កាត់ Health Check
    # ឬ Request ផ្សេងទៀតដែលចូលមកក្នុងពេលដំណាលគ្នា។
    server = ThreadingHTTPServer(("0.0.0.0", port), HealthHandler)
    logger.info("Health server on %s", port)
    server.serve_forever()

