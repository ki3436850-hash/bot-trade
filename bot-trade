            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("🗑️ បាទ/ចាស លុប", callback_data=f"mk_pdy_{lid}"),
                InlineKeyboardButton("❌ បោះបង់", callback_data=f"mk_pm_{lid}")]]))
        return True

    if data.startswith("mk_pdy_"):
        listing = await market_get_owned_listing(q, uid, int(data[len("mk_pdy_"):]))
        if not listing:
            return True
        removed = await db_remove_listing(listing["id"], uid, "deleted_by_seller", owner_id=uid)
        try:
            await q.edit_message_reply_markup(reply_markup=None)
