async def button_handler(update, context):
    """Thin wrapper: sets up q/uid/ud, answers the callback immediately, then
    delegates to _button_handler_dispatch(). Any ValueError/IndexError/KeyError/
    TypeError raised while parsing callback_data (malformed, stale, or
    deliberately tampered — e.g. 'shop_buy_abc') is caught HERE in one place
    instead of at each of the many individual int()/split() call sites inside
    the dispatcher, so a bad callback_data can never crash the update; it just
    shows the user a clear 'invalid/expired button' message. Unexpected
    exception types still propagate to the global error handler as before."""
    q = update.callback_query
    data = q.data
    uid = q.from_user.id
    try:
        await q.answer()
    except Exception as e:
        logger.warning(f"q.answer() (immediate) failed: {e}")
    ud = get_user_data(uid)
    logger.info(f"Callback: {data}")
    try:
        await _button_handler_dispatch(update, context, q, data, uid, ud)
    except (ValueError, IndexError, KeyError, TypeError) as e:
        logger.warning(f"button_handler: malformed callback_data {data!r} — {type(e).__name__}: {e}")
        await safe_alert(q, "⚠️ ប៊ូតុងនេះហួសសុពលភាព ឬមិនត្រឹមត្រូវ។ សូមសាកល្បងម្តងទៀត។", show_alert=True)


